<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Lead ========== -->
    <entity entity-name="Lead" package="zenith.erp.crm">
        <field name="leadId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="firstName" type="text-medium"/>
        <field name="lastName" type="text-medium"/>
        <field name="companyName" type="text-medium"/>
        <field name="designation" type="text-medium"/>
        <field name="email" type="text-medium"/>
        <field name="phone" type="text-short"/>
        <field name="mobile" type="text-short"/>
        <field name="website" type="text-medium"/>
        <field name="address" type="text-long"/>
        <field name="city" type="text-medium"/>
        <field name="regionCode" type="text-short"><description>State/province/region code</description></field>
        <field name="postalCode" type="text-short"/>
        <field name="countryGeoId" type="id"/>
        <field name="taxRegistrationNumber" type="text-short"><description>GSTIN/VAT/EIN etc.</description></field>
        <field name="taxIdNumber" type="text-short"><description>PAN/SSN/Tax ID etc.</description></field>
        <field name="leadSourceId" type="id"/>
        <field name="sourceDetail" type="text-medium"/>
        <field name="campaignId" type="id"/>
        <field name="utmSource" type="text-medium"/>
        <field name="utmMedium" type="text-medium"/>
        <field name="utmCampaign" type="text-medium"/>
        <field name="utmContent" type="text-medium"/>
        <field name="utmTerm" type="text-medium"/>
        <field name="firstTouchSourceId" type="id"/>
        <field name="firstTouchDate" type="date-time"/>
        <field name="latestTouchSourceId" type="id"/>
        <field name="latestTouchDate" type="date-time"/>
        <field name="landingPageUrl" type="text-medium"/>
        <field name="referrerUrl" type="text-medium"/>
        <field name="captureMethod" type="text-short"/>
        <field name="externalSubmissionId" type="text-medium"/>
        <field name="duplicateAcknowledged" type="text-indicator" default="'N'"/>
        <field name="statusId" type="id"/>
        <field name="rating" type="text-short"><description>Hot, Warm, Cold</description></field>
        <field name="score" type="number-integer"><description>0-100 lead score</description></field>
        <field name="assignedToUserId" type="id"/>
        <field name="estimatedAmount" type="currency-amount"/>
        <field name="estimatedCloseDate" type="date"/>
        <field name="description" type="text-long"/>
        <field name="createdDate" type="date-time"/>
        <field name="convertedDate" type="date-time"/>
        <field name="convertedPartyId" type="id"/>
        <field name="convertedOpportunityId" type="id"/>
        <field name="lostReason" type="text-medium"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="zenith.erp.crm.LeadSource"/>
        <relationship type="one" related="zenith.erp.crm.CrmCampaign"/>
        <relationship type="one" title="AssignedTo" related="moqui.security.UserAccount">
            <key-map field-name="assignedToUserId" related="userId"/></relationship>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="CrmLead" description="CRM Lead"/>
            <moqui.basic.StatusItem statusId="LeadNew" statusTypeId="CrmLead" description="New" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="LeadContacted" statusTypeId="CrmLead" description="Contacted" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="LeadQualified" statusTypeId="CrmLead" description="Qualified" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="LeadConverted" statusTypeId="CrmLead" description="Converted" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="LeadLost" statusTypeId="CrmLead" description="Lost" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LeadNew" toStatusId="LeadContacted" transitionName="Contact"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LeadContacted" toStatusId="LeadQualified" transitionName="Qualify"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LeadQualified" toStatusId="LeadConverted" transitionName="Convert"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LeadNew" toStatusId="LeadLost" transitionName="Lose"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LeadContacted" toStatusId="LeadLost" transitionName="Lose"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LeadQualified" toStatusId="LeadLost" transitionName="Lose"/>
        </seed-data>
    </entity>

    <!-- ========== Lead Source ========== -->
    <entity entity-name="LeadSource" package="zenith.erp.crm">
        <field name="leadSourceId" type="id" is-pk="true"/>
        <field name="description" type="text-medium"/>
        <field name="organizationPartyId" type="id"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <seed-data>
            <zenith.erp.crm.LeadSource leadSourceId="Instagram" description="Instagram" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="YouTube" description="YouTube" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="Facebook" description="Facebook" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="LinkedIn" description="LinkedIn" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="X" description="X" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="GoogleSearch" description="Google Search" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="GoogleAds" description="Google Ads" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="WhatsApp" description="WhatsApp" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="Phone" description="Phone" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="Partner" description="Partner / Reseller" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="Event" description="Event / Exhibition" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="Import" description="Import" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="Unknown" description="Unknown" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="Website" description="Company Website" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="Referral" description="Referral" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="Marketplace" description="Online Marketplace" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="Exhibition" description="Trade Exhibition" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="ColdCall" description="Cold Call" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="SocialMedia" description="Social Media" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="SearchAds" description="Search Ads" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="Email" description="Email Campaign" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="WalkIn" description="Walk-in" isActive="Y"/>
            <zenith.erp.crm.LeadSource leadSourceId="Other" description="Other" isActive="Y"/>
        </seed-data>
    </entity>

    <entity entity-name="CrmCampaign" package="zenith.erp.crm">
        <field name="campaignId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="campaignName" type="text-medium"/>
        <field name="campaignKey" type="text-short"/>
        <field name="leadSourceId" type="id"/>
        <field name="medium" type="text-short"/>
        <field name="startDate" type="date"/>
        <field name="endDate" type="date"/>
        <field name="budgetAmount" type="currency-amount"/>
        <field name="landingPageUrl" type="text-medium"/>
        <field name="ownerUserId" type="id"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.crm.LeadSource"/>
    </entity>

    <entity entity-name="CrmAuditEvent" package="zenith.erp.crm">
        <field name="auditEventId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="recordType" type="text-short"/>
        <field name="recordId" type="id"/>
        <field name="action" type="text-short"/>
        <field name="previousValue" type="text-medium"/>
        <field name="newValue" type="text-medium"/>
        <field name="actorUserId" type="id"/>
        <field name="eventDate" type="date-time"/>
        <field name="note" type="text-medium"/>
    </entity>

    <entity entity-name="LeadSubmission" package="zenith.erp.crm">
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="externalSubmissionId" type="text-medium" is-pk="true"/>
        <field name="leadId" type="id"/>
    </entity>

    <entity entity-name="LeadTouch" package="zenith.erp.crm">
        <field name="leadId" type="id" is-pk="true"/>
        <field name="touchId" type="text-short" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="leadSourceId" type="id"/>
        <field name="utmSource" type="text-medium"/>
        <field name="utmMedium" type="text-medium"/>
        <field name="utmCampaign" type="text-medium"/>
        <field name="touchDate" type="date-time"/>
    </entity>

    <entity entity-name="CrmSavedFilter" package="zenith.erp.crm">
        <field name="filterId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="userId" type="id"/>
        <field name="screenName" type="text-short"/>
        <field name="filterName" type="text-medium"/>
        <field name="filterJson" type="text-long"/>
        <field name="createdDate" type="date-time"/>
    </entity>

    <entity entity-name="CrmStageSetting" package="zenith.erp.crm">
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="opportunityStageId" type="id" is-pk="true"/>
        <field name="displayName" type="text-medium"/>
        <field name="defaultProbability" type="number-decimal"/>
        <field name="sequenceNum" type="number-integer"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <entity entity-name="CrmStageWorkflow" package="zenith.erp.crm">
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="opportunityStageId" type="id" is-pk="true"/>
        <field name="taskSubject" type="text-medium"/>
        <field name="daysUntilDue" type="number-integer"/>
        <field name="isActive" type="text-indicator"/>
    </entity>

    <entity entity-name="ActivitySubmission" package="zenith.erp.crm">
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="externalSubmissionId" type="text-medium" is-pk="true"/>
        <field name="activityId" type="id"/>
    </entity>

    <!-- ========== CRM Activity ========== -->
    <entity entity-name="CrmActivity" package="zenith.erp.crm">
        <field name="activityId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="activityType" type="text-short"><description>Call, Email, Meeting, Chat, Note, Task</description></field>
        <field name="subject" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="activityDate" type="date-time"/>
        <field name="dueDate" type="date-time"/>
        <field name="completedDate" type="date-time"/>
        <field name="statusId" type="text-short"/>
        <field name="externalSubmissionId" type="text-medium"/>
        <field name="priority" type="text-short"/>
        <field name="assignedToUserId" type="id"/>
        <field name="durationMinutes" type="number-integer"/>
        <field name="leadId" type="id"/>
        <field name="salesOpportunityId" type="id"/>
        <field name="contactPartyId" type="id"/>
        <field name="performedByUserId" type="id"/>
        <field name="outcome" type="text-medium"/>
        <field name="nextFollowUpDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.crm.Lead"/>
        <relationship type="one" related="mantle.sales.opportunity.SalesOpportunity"/>
        <relationship type="one" title="Contact" related="mantle.party.Party">
            <key-map field-name="contactPartyId" related="partyId"/></relationship>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="CrmActivity" description="CRM Activity"/>
            <moqui.basic.StatusItem statusId="Scheduled" statusTypeId="CrmActivity" description="Scheduled"/>
            <moqui.basic.StatusItem statusId="Completed" statusTypeId="CrmActivity" description="Completed"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="Scheduled" toStatusId="Completed" transitionName="Complete"/>
        </seed-data>
    </entity>

    <!-- ========== Sales Opportunity Extension ========== -->
    <extend-entity entity-name="SalesOpportunity" package="mantle.sales.opportunity">
        <field name="organizationPartyId" type="id"/>
        <field name="pipelineId" type="id"/>
        <field name="leadId" type="id"/>
        <field name="assignedToUserId" type="id"/>
        <field name="lostReason" type="text-medium"/>
        <field name="wonDate" type="date-time"/>
        <field name="lostDate" type="date-time"/>
        <field name="expectedRevenue" type="currency-amount"/>
        <field name="leadSourceId" type="id"/>
        <field name="campaignId" type="id"/>
        <field name="sourceDetail" type="text-medium"/>
        <field name="utmSource" type="text-medium"/>
        <field name="utmMedium" type="text-medium"/>
        <field name="utmCampaign" type="text-medium"/>
        <field name="utmContent" type="text-medium"/>
        <field name="utmTerm" type="text-medium"/>
        <relationship type="one" related="zenith.erp.crm.Pipeline"/>
        <relationship type="one" related="zenith.erp.crm.Lead"/>
    </extend-entity>

    <!-- ========== Pipeline ========== -->
    <entity entity-name="Pipeline" package="zenith.erp.crm">
        <field name="pipelineId" type="id" is-pk="true"/>
        <field name="pipelineName" type="text-medium"/>
        <field name="description" type="text-medium"/>
        <field name="isDefault" type="text-indicator" default="'N'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <seed-data>
            <zenith.erp.crm.Pipeline pipelineId="DefaultPipeline" pipelineName="Default Pipeline"
                                     description="Standard sales pipeline" isDefault="Y"/>
        </seed-data>
    </entity>

    <!-- ========== Lead Scoring Rule ========== -->
    <entity entity-name="LeadScoringRule" package="zenith.erp.crm">
        <field name="scoringRuleId" type="id" is-pk="true"/>
        <field name="ruleName" type="text-medium"/>
        <field name="fieldName" type="text-short"/>
        <field name="operator" type="text-short"/>
        <field name="fieldValue" type="text-medium"/>
        <field name="scorePoints" type="number-integer"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- ========== Customer Segment ========== -->
    <entity entity-name="CustomerSegment" package="zenith.erp.crm" short-alias="CustomerSegments">
        <field name="segmentId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="segmentName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="segmentTypeEnumId" type="id"/>
        <field name="isAutoEvaluate" type="text-indicator" default="'N'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="lastEvaluatedDate" type="date-time"/>
        <field name="memberCount" type="number-integer"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="CustomerSegmentType" description="Customer Segment Type"/>
            <moqui.basic.Enumeration enumId="CstSpendBased" enumTypeId="CustomerSegmentType" description="Spend-Based" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="CstFrequency" enumTypeId="CustomerSegmentType" description="Purchase Frequency" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="CstGeographic" enumTypeId="CustomerSegmentType" description="Geographic" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="CstProductPref" enumTypeId="CustomerSegmentType" description="Product Preference" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="CstRecency" enumTypeId="CustomerSegmentType" description="Recency (RFM)" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="CstCustom" enumTypeId="CustomerSegmentType" description="Custom/Manual" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="CstDynamic" enumTypeId="CustomerSegmentType" description="Dynamic (rules)" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="CstStatic" enumTypeId="CustomerSegmentType" description="Static (manual)" sequenceNum="8"/>
        </seed-data>
    </entity>

    <!-- ========== Customer Segment Criteria ========== -->
    <entity entity-name="SegmentCriteria" package="zenith.erp.crm" short-alias="SegmentCriteria">
        <field name="criteriaId" type="id" is-pk="true"/>
        <field name="segmentId" type="id"/>
        <field name="criteriaTypeEnumId" type="id"/>
        <field name="operator" type="text-short"><description>eq, neq, gt, gte, lt, lte, in, between, contains</description></field>
        <field name="joinOperator" type="text-short" default="'AND'"/>
        <field name="fieldValue" type="text-medium"/>
        <field name="fieldValueTo" type="text-medium"><description>For 'between' operator</description></field>
        <field name="sequenceNum" type="number-integer"/>
        <relationship type="one" related="zenith.erp.crm.CustomerSegment"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="SegmentCriteriaType" description="Segment Criteria Type"/>
            <moqui.basic.Enumeration enumId="SctTotalSpend" enumTypeId="SegmentCriteriaType" description="Total Spend" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="SctOrderCount" enumTypeId="SegmentCriteriaType" description="Order Count" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="SctAvgOrderValue" enumTypeId="SegmentCriteriaType" description="Average Order Value" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="SctLastPurchase" enumTypeId="SegmentCriteriaType" description="Days Since Last Purchase" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="SctCountry" enumTypeId="SegmentCriteriaType" description="Country" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="SctRegion" enumTypeId="SegmentCriteriaType" description="Region/State" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="SctProductCategory" enumTypeId="SegmentCriteriaType" description="Purchased Product Category" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="SctCustomerGroup" enumTypeId="SegmentCriteriaType" description="Customer Group" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="SctChannel" enumTypeId="SegmentCriteriaType" description="Sales Channel" sequenceNum="9"/>
            <moqui.basic.Enumeration enumId="SctRegistrationDate" enumTypeId="SegmentCriteriaType" description="Registration Date" sequenceNum="10"/>
            <moqui.basic.Enumeration enumId="SctLeadSource" enumTypeId="SegmentCriteriaType" description="Original Lead Source" sequenceNum="11"/>
            <moqui.basic.Enumeration enumId="SctLeadCampaign" enumTypeId="SegmentCriteriaType" description="Lead Campaign" sequenceNum="12"/>
        </seed-data>
    </entity>

    <!-- ========== Customer Segment Member ========== -->
    <entity entity-name="SegmentMember" package="zenith.erp.crm" short-alias="SegmentMembers">
        <field name="segmentId" type="id" is-pk="true"/>
        <field name="partyId" type="id" is-pk="true"/>
        <field name="addedDate" type="date-time"/>
        <field name="addedMethod" type="text-short"><description>Auto or Manual</description></field>
        <relationship type="one" related="zenith.erp.crm.CustomerSegment"/>
        <relationship type="one" related="mantle.party.Party"/>
    </entity>

    <!-- ========== Segment Member Detail View ========== -->
    <view-entity entity-name="SegmentMemberDetail" package="zenith.erp.crm">
        <member-entity entity-alias="SM" entity-name="zenith.erp.crm.SegmentMember"/>
        <member-entity entity-alias="CS" entity-name="zenith.erp.crm.CustomerSegment" join-from-alias="SM">
            <key-map field-name="segmentId"/></member-entity>
        <member-entity entity-alias="PER" entity-name="mantle.party.Person" join-from-alias="SM" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <member-entity entity-alias="ORG" entity-name="mantle.party.Organization" join-from-alias="SM" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <alias entity-alias="SM" name="segmentId"/>
        <alias entity-alias="SM" name="partyId"/>
        <alias entity-alias="SM" name="addedDate"/>
        <alias entity-alias="SM" name="addedMethod"/>
        <alias entity-alias="CS" name="segmentName"/>
        <alias entity-alias="CS" name="organizationPartyId"/>
        <alias entity-alias="CS" name="segmentTypeEnumId"/>
        <alias entity-alias="PER" name="firstName"/>
        <alias entity-alias="PER" name="lastName"/>
        <alias entity-alias="ORG" name="organizationName"/>
    </view-entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="LeadListView" package="zenith.erp.crm">
        <member-entity entity-alias="LD" entity-name="zenith.erp.crm.Lead"/>
        <member-entity entity-alias="LS" entity-name="zenith.erp.crm.LeadSource" join-from-alias="LD" join-optional="true">
            <key-map field-name="leadSourceId"/></member-entity>
        <member-entity entity-alias="CMP" entity-name="zenith.erp.crm.CrmCampaign" join-from-alias="LD" join-optional="true">
            <key-map field-name="campaignId"/></member-entity>
        <alias entity-alias="LD" name="leadId"/>
        <alias entity-alias="LD" name="organizationPartyId"/>
        <alias entity-alias="LD" name="firstName"/>
        <alias entity-alias="LD" name="lastName"/>
        <alias entity-alias="LD" name="companyName"/>
        <alias entity-alias="LD" name="email"/>
        <alias entity-alias="LD" name="phone"/>
        <alias entity-alias="LD" name="mobile"/>
        <alias entity-alias="LD" name="city"/>
        <alias entity-alias="LD" name="regionCode"/>
        <alias entity-alias="LD" name="countryGeoId"/>
        <alias entity-alias="LD" name="taxRegistrationNumber"/>
        <alias entity-alias="LD" name="leadSourceId"/>
        <alias entity-alias="LD" name="campaignId"/>
        <alias entity-alias="LD" name="sourceDetail"/>
        <alias entity-alias="LD" name="utmSource"/>
        <alias entity-alias="LD" name="utmMedium"/>
        <alias entity-alias="LD" name="utmCampaign"/>
        <alias entity-alias="LD" name="utmContent"/>
        <alias entity-alias="LD" name="utmTerm"/>
        <alias entity-alias="LD" name="landingPageUrl"/>
        <alias entity-alias="LD" name="captureMethod"/>
        <alias entity-alias="LD" name="firstTouchSourceId"/>
        <alias entity-alias="LD" name="latestTouchSourceId"/>
        <alias entity-alias="LD" name="statusId"/>
        <alias entity-alias="LD" name="rating"/>
        <alias entity-alias="LD" name="score"/>
        <alias entity-alias="LD" name="assignedToUserId"/>
        <alias entity-alias="LD" name="estimatedAmount"/>
        <alias entity-alias="LD" name="estimatedCloseDate"/>
        <alias entity-alias="LD" name="createdDate"/>
        <alias entity-alias="LS" name="sourceName" field="description"/>
        <alias entity-alias="CMP" name="campaignName"/>
    </view-entity>

    <view-entity entity-name="OpportunityListView" package="zenith.erp.crm">
        <member-entity entity-alias="OPP" entity-name="mantle.sales.opportunity.SalesOpportunity"/>
        <member-entity entity-alias="STG" entity-name="mantle.sales.opportunity.SalesOpportunityStage" join-from-alias="OPP" join-optional="true">
            <key-map field-name="opportunityStageId"/></member-entity>
        <member-entity entity-alias="ACCT" entity-name="mantle.party.Organization" join-from-alias="OPP" join-optional="true">
            <key-map field-name="accountPartyId" related="partyId"/></member-entity>
        <alias entity-alias="OPP" name="salesOpportunityId"/>
        <alias entity-alias="OPP" name="organizationPartyId"/>
        <alias entity-alias="OPP" name="opportunityName"/>
        <alias entity-alias="OPP" name="accountPartyId"/>
        <alias entity-alias="OPP" name="estimatedAmount"/>
        <alias entity-alias="OPP" name="estimatedProbability"/>
        <alias entity-alias="OPP" name="estimatedCloseDate"/>
        <alias entity-alias="OPP" name="opportunityStageId"/>
        <alias entity-alias="OPP" name="pipelineId"/>
        <alias entity-alias="OPP" name="assignedToUserId"/>
        <alias entity-alias="OPP" name="expectedRevenue"/>
        <alias entity-alias="OPP" name="wonDate"/>
        <alias entity-alias="OPP" name="leadSourceId"/>
        <alias entity-alias="OPP" name="campaignId"/>
        <alias entity-alias="OPP" name="lostDate"/>
        <alias entity-alias="OPP" name="lostReason"/>
        <alias entity-alias="OPP" name="leadId"/>
        <alias entity-alias="STG" name="stageName" field="description"/>
        <alias entity-alias="STG" name="stageSequence" field="sequenceNum"/>
        <alias entity-alias="ACCT" name="accountName" field="organizationName"/>
    </view-entity>

</entities>
