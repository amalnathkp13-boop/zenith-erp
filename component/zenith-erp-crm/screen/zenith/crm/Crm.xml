<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="CRM" default-menu-index="6">

    <always-actions>
        <service-call name="zenith.contacts.ContactServices.get#AuthorizedActiveOrganization" out-map="crmOrganization"/>
        <set field="html_title" value="CRM"/>
    </always-actions>

    <transition name="goSales"><default-response url="../sales/SalesDashboard"/></transition>
    <transition name="goContacts"><default-response url="../Contacts/FindContact"/></transition>
    <transition name="goMarketing"><default-response url="../marketing/Campaigns"/></transition>
    <transition name="goHelpdesk"><default-response url="../helpdesk/Tickets"/></transition>
    <transition name="goEcommerce"><default-response url="../ecommerce/EcomOrders"/></transition>
    <transition name="goEvents"><default-response url="../events/AllEvents"/></transition>

    <subscreens default-item="Dashboard">
        <subscreens-item name="Dashboard" location="component://zenith-erp-crm/screen/zenith/crm/Crm/Dashboard.xml"
                         menu-title="Dashboard" menu-index="1"/>
        <subscreens-item name="Contacts" location="component://zenith-erp-crm/screen/zenith/crm/Crm/Contacts.xml"
                         menu-title="Contacts" menu-index="5"/>
        <subscreens-item name="SourcesCampaigns" location="component://zenith-erp-crm/screen/zenith/crm/Crm/SourcesCampaigns.xml"
                         menu-title="Sources &amp; Campaigns" menu-index="6"/>
        <subscreens-item name="Segments" location="component://zenith-erp-crm/screen/zenith/crm/Crm/Segments.xml"
                         menu-title="Segments" menu-index="7"/>
        <subscreens-item name="Reports" location="component://zenith-erp-crm/screen/zenith/crm/Crm/Reports.xml"
                         menu-title="Reports" menu-index="8"/>
        <subscreens-item name="Workflows" location="component://zenith-erp-crm/screen/zenith/crm/Crm/Workflows.xml"
                         menu-title="Workflows" menu-index="9"/>
        <subscreens-item name="EditSegment" location="component://zenith-erp-crm/screen/zenith/crm/Crm/EditSegment.xml" menu-include="false"/>
        <subscreens-item name="EditOpportunity" location="component://zenith-erp-crm/screen/zenith/crm/Crm/EditOpportunity.xml" menu-include="false"/>
        <subscreens-item name="ContactDetail" location="component://zenith-erp-crm/screen/zenith/crm/Crm/ContactDetail.xml" menu-include="false"/>
        <subscreens-item name="ActivityDetail" location="component://zenith-erp-crm/screen/zenith/crm/Crm/ActivityDetail.xml" menu-include="false"/>
        <subscreens-item name="ImportLeads" location="component://zenith-erp-crm/screen/zenith/crm/Crm/ImportLeads.xml" menu-include="false"/>
        <subscreens-item name="CrmSettings" location="component://zenith-erp-crm/screen/zenith/crm/Crm/CrmSettings.xml" menu-include="false"/>
    </subscreens>

    <widgets>
        <container style="zcrm-page">
        <subscreens-active/>
        </container>
    </widgets>
</screen>
