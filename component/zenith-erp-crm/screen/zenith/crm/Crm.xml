<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="CRM" default-menu-index="6">

    <always-actions>
        <set field="html_title" value="CRM"/>
    </always-actions>

    <subscreens default-item="Dashboard">
        <subscreens-item name="Dashboard" location="component://zenith-erp-crm/screen/zenith/crm/Crm/Dashboard.xml"
                         menu-title="Dashboard" menu-index="0"/>
        <subscreens-item name="Segments" location="component://zenith-erp-crm/screen/zenith/crm/Crm/Segments.xml"
                         menu-title="Segments" menu-index="5"/>
        <subscreens-item name="EditSegment" location="component://zenith-erp-crm/screen/zenith/crm/Crm/EditSegment.xml" menu-include="false"/>
    </subscreens>

    <transition name="goSales"><default-response url="../sales/SalesDashboard"/></transition>
    <transition name="goContacts"><default-response url="../Contacts/FindContact"/></transition>
    <transition name="goMarketing"><default-response url="../marketing/Campaigns"/></transition>
    <transition name="goHelpdesk"><default-response url="../helpdesk/Tickets"/></transition>
    <transition name="goEcommerce"><default-response url="../ecommerce/EcomOrders"/></transition>
    <transition name="goEvents"><default-response url="../events/AllEvents"/></transition>

    <widgets>
        <container style="zcrm-page">
        <subscreens-active/>
        </container>
    </widgets>
</screen>
