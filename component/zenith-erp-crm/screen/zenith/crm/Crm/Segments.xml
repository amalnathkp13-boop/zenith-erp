<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Segments" default-menu-index="7">

    <transition name="editSegment"><default-response url="../EditSegment"/></transition>
    <transition name="createSegment">
        <service-call name="zenith.crm.CrmServices.create#CustomerSegment"/>
        <default-response url="../EditSegment"/>
        <error-response url="."/>
    </transition>

    <transition-include name="exportList" location="component://zenith-erp-crm/screen/include/CrmExport.xml"/>

    <actions>
        <entity-find entity-name="zenith.erp.crm.CustomerSegment" list="summarySegments">
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.crm.SegmentMemberDetail" list="segmentMembers">
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
        <script><![CDATA[
            totalSegments = summarySegments.size()
            totalMembers = summarySegments.sum { it.memberCount ?: 0 } ?: 0
            totalCustomers = segmentMembers*.partyId.findAll { it }.unique().size()
            averageMembers = totalSegments ? (totalMembers / totalSegments).intValue() : 0
            largestSegment = summarySegments.max { it.memberCount ?: 0 }
        ]]></script>
        <entity-find entity-name="zenith.erp.crm.CustomerSegment" list="segments">
            <search-form-inputs default-order-by="segmentName" skip-fields="organizationPartyId"/>
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="zcrm-intro"><label text="Customer Segments" type="h3"/><label text="Group your customers for targeted communication and better sales." type="p"/></container>
        <container style="zcrm-segment-actions">
            <section name="CreateSegment_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="CreateSegment" button-text="New Segment" type="success">
                <form-single name="CreateSegmentForm" transition="createSegment">
                    <field name="segmentName"><default-field title="Segment Name"><text-line size="30"/></default-field></field>
                    <field name="segmentTypeEnumId"><default-field title="Type">
                        <drop-down><option key="CstDynamic" text="Dynamic (rules)"/><option key="CstStatic" text="Static (manual members)"/></drop-down></default-field></field>
                    <field name="description"><default-field><text-area rows="2" cols="40"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </container>
        <container style="zcrm-metrics zcrm-reference-metrics">
            <container style="zcrm-metric"><label text="Total Segments" type="span"/><label text="${totalSegments}" type="h4"/><label text="Customer groups" type="span" style="zcrm-muted"/></container>
            <container style="zcrm-metric"><label text="Total Customers" type="span"/><label text="${totalCustomers}" type="h4"/><label text="Unique segment members" type="span" style="zcrm-muted"/></container>
            <container style="zcrm-metric"><label text="Avg. Customers / Segment" type="span"/><label text="${averageMembers}" type="h4"/><label text="Across all groups" type="span" style="zcrm-muted"/></container>
            <container style="zcrm-metric"><label text="Largest Segment" type="span"/><label text="${largestSegment?.segmentName ?: '—'}" type="h4"/><label text="${largestSegment?.memberCount ?: 0} customers" type="span" style="zcrm-muted"/></container>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome zcrm-reference-list">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Segments..." style="display:none"></span>]]></text></render-mode>
            <section name="NoSegments" condition="segments.isEmpty()"><widgets><container style="zcrm-empty"><label text="No segments match this search. Clear filters or create a segment." type="p"/></container></widgets></section>
            <link url="exportList" condition="crmCanExport" text="Export CSV" link-type="anchor" target-window="_blank"
                  parameter-map="crmExportFilters + [dataset:'segments', format:'csv']"/>
            <link url="exportList" condition="crmCanExport" text="Export XLSX" link-type="anchor" target-window="_blank"
                  parameter-map="crmExportFilters + [dataset:'segments', format:'xlsx']"/>
            <form-list name="SegmentsForm" list="segments" skip-form="true" header-dialog="true"
                       select-columns="true">
                <field name="segmentName"><header-field show-order-by="true"><text-find size="20"/></header-field>
                    <default-field title="Segment">
                        <link url="editSegment" text="${segmentName}" parameter-map="[segmentId:segmentId]"/>
                    </default-field></field>
                <field name="segmentTypeEnumId"><header-field title="Type">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="CustomerSegmentType"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                <field name="description"><default-field title="Description"><display/></default-field></field>
                <field name="memberCount"><header-field show-order-by="true"/>
                    <default-field title="Customers"><display/></default-field></field>
                <field name="lastEvaluatedDate"><default-field title="Last Evaluated"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                <field name="isActive"><header-field title="Status"><drop-down allow-empty="true"><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down></header-field><default-field title="Status"><display/></default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
