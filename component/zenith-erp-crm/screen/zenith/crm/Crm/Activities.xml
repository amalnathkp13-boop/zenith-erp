<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Activities" default-menu-index="3">

    <transition name="logActivity">
        <service-call name="zenith.crm.CrmServices.log#Activity"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <!-- ZE-SEC-JSON f/u: org-scoped party picker (stock SimpleScreens searchPartyList leaks cross-tenant). -->
    <transition-include name="searchPartyList" location="component://zenith-erp-base/screen/include/PartyPicker.xml"/>

    <actions>
        <entity-find entity-name="zenith.erp.crm.CrmActivity" list="activityList">
            <search-form-inputs default-order-by="-activityDate" skip-fields="organizationPartyId"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="zcrm-intro"><label text="Activities" type="h3"/><label text="A history of calls, meetings, tasks and follow-ups recorded for this organization." type="p"/></container>
        <container-box><box-header title="CRM Activities"/><box-toolbar>
            <section name="LogActivity_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="LogActivityDialog" button-text="Log Activity">
                <form-single name="LogActivityForm" transition="logActivity">
                    <field name="activityType"><default-field title="Type">
                        <drop-down>
                            <option key="Call" text="Phone Call"/>
                            <option key="Email" text="Email"/>
                            <option key="Meeting" text="Meeting"/>
                            <option key="WhatsApp" text="WhatsApp"/>
                            <option key="Note" text="Note"/>
                            <option key="Task" text="Task"/>
                            <option key="SiteVisit" text="Site Visit"/>
                        </drop-down>
                    </default-field></field>
                    <field name="subject"><default-field><text-line size="40"/></default-field></field>
                    <field name="description"><default-field><text-area rows="3" cols="50"/></default-field></field>
                    <field name="contactPartyId"><default-field title="Contact">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="searchPartyList" server-search="true" min-length="2"/>
                        </drop-down>
                    </default-field></field>
                    <field name="outcome"><default-field><text-line size="30"/></default-field></field>
                    <field name="durationMinutes"><default-field title="Duration (min)"><text-line size="6"/></default-field></field>
                    <field name="nextFollowUpDate"><default-field title="Next Follow-up"><date-time type="date-time"/></default-field></field>
                    <field name="submitButton"><default-field title="Log Activity"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Activities..." style="display:none"></span>]]></text></render-mode>
            <section name="NoActivities" condition="activityList.isEmpty()"><widgets><container style="zcrm-empty"><label text="No activities match this search. Clear filters or log a new activity." type="p"/></container></widgets></section>
            <form-list name="ActivityListForm" list="activityList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-page-size="true">
                <field name="activityDate">
                    <header-field title="Date" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="dd/MM/yyyy HH:mm"/></default-field>
                </field>
                <field name="activityType">
                    <header-field title="Type">
                        <drop-down allow-empty="true">
                            <option key="Call"/><option key="Email"/><option key="Meeting"/>
                            <option key="WhatsApp"/><option key="Note"/><option key="Task"/><option key="SiteVisit"/>
                        </drop-down>
                    </header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="subject">
                    <header-field><text-find size="25" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="contactPartyId">
                    <default-field title="Contact"><display/></default-field>
                </field>
                <field name="leadId">
                    <default-field title="Lead"><display/></default-field>
                </field>
                <field name="outcome"><default-field><display/></default-field></field>
                <field name="durationMinutes"><default-field title="Dur(m)"><display/></default-field></field>
                <field name="nextFollowUpDate">
                    <default-field title="Follow-up"><display format="dd/MM/yyyy"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
