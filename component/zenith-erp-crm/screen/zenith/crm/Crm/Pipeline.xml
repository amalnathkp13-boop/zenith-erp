<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Pipeline" default-menu-index="2">

    <transition name="createOpportunity">
        <service-call name="zenith.crm.CrmServices.create#Opportunity"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="advanceStage">
        <service-call name="zenith.crm.CrmServices.advance#OpportunityStage"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <!-- ZE-SEC-JSON f/u: org-scoped party picker (stock SimpleScreens searchPartyList leaks cross-tenant). -->
    <transition-include name="searchPartyList" location="component://zenith-erp-base/screen/include/PartyPicker.xml"/>

    <actions>
        <entity-find entity-name="zenith.erp.crm.OpportunityListView" list="summaryOppList">
            <search-form-inputs default-order-by="stageSequence,-estimatedAmount" skip-fields="organizationPartyId"
                                input-fields-map="ec.context + [pageIndex:null, pageSize:null]" paginate="false"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.crm.OpportunityListView" list="oppList">
            <search-form-inputs default-order-by="stageSequence,-estimatedAmount" skip-fields="organizationPartyId"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
        <entity-find entity-name="mantle.sales.opportunity.SalesOpportunityStage" list="stages">
            <order-by field-name="sequenceNum"/></entity-find>

        <!-- Pipeline summary by stage -->
        <set field="stageSummary" from="[:]"/>
        <iterate list="stages" entry="stg">
            <set field="stageSummary[stg.opportunityStageId]" from="[name:stg.description, count:0, value:0]"/>
        </iterate>
        <iterate list="summaryOppList" entry="opp">
            <if condition="opp.opportunityStageId &amp;&amp; stageSummary.containsKey(opp.opportunityStageId)">
                <set field="s" from="stageSummary[opp.opportunityStageId]"/>
                <set field="s.count" from="s.count + 1"/>
                <set field="s.value" from="s.value + (opp.estimatedAmount ?: 0)"/>
            </if>
        </iterate>
    </actions>

    <widgets>
        <container style="zcrm-intro"><label text="Pipeline" type="h3"/><label text="Track opportunities by their actual sales stage and expected close date." type="p"/></container>
        <!-- Pipeline Summary -->
        <container-row>
            <iterate list="stages" entry="stg">
                <row-col lg="2" condition="stageSummary.containsKey(stg.opportunityStageId)">
                    <container-box><box-header title="${stg.description}"/><box-body>
                        <label text="${stageSummary[stg.opportunityStageId].count} deals" type="div"/>
                        <label text="${currSymbol}${zinr.inr(ec.l10n.format(stageSummary[stg.opportunityStageId].value, '#,##,##0'))}" type="div" style="text-primary"/>
                    </box-body></container-box>
                </row-col>
            </iterate>
        </container-row>

        <!-- Opportunities List -->
        <container-box><box-header title="Sales Opportunities"/><box-toolbar>
            <section name="NewOpp_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="NewOppDialog" button-text="New Opportunity">
                <form-single name="NewOppForm" transition="createOpportunity">
                    <field name="opportunityName"><default-field title="Name"><text-line size="40"/></default-field></field>
                    <field name="accountPartyId"><default-field title="Account">
                        <drop-down>
                            <dynamic-options transition="searchPartyList" server-search="true" min-length="2"/>
                        </drop-down>
                    </default-field></field>
                    <field name="estimatedAmount"><default-field title="Amount (${currSymbol})"><text-line size="12"/></default-field></field>
                    <field name="estimatedCloseDate"><default-field title="Expected Close"><date-time type="date"/></default-field></field>
                    <field name="opportunityStageId"><default-field title="Stage">
                        <drop-down>
                            <list-options list="stages" key="${opportunityStageId}" text="${description}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Pipeline..." style="display:none"></span>]]></text></render-mode>
            <section name="NoOpportunities" condition="oppList.isEmpty()"><widgets><container style="zcrm-empty"><label text="No opportunities match this search. Clear filters or create an opportunity." type="p"/></container></widgets></section>
            <form-list name="OppListForm" list="oppList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="salesOpportunityId">
                    <default-field title="ID"><display/></default-field>
                </field>
                <field name="opportunityName">
                    <header-field title="Opportunity"><text-find size="25" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="accountName">
                    <header-field title="Account"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="estimatedAmount">
                    <header-field title="Amount" show-order-by="true"/>
                    <default-field><display format="#,##,##0"/></default-field>
                </field>
                <field name="estimatedProbability">
                    <default-field title="Prob%"><display format="0%"/></default-field>
                </field>
                <field name="expectedRevenue">
                    <header-field title="Weighted" show-order-by="true"/>
                    <default-field><display format="#,##,##0"/></default-field>
                </field>
                <field name="stageName">
                    <header-field title="Stage">
                        <drop-down allow-empty="true">
                            <list-options list="stages" key="${opportunityStageId}" text="${description}"/>
                        </drop-down>
                    </header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="estimatedCloseDate">
                    <header-field title="Close Date" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="dd/MM/yyyy"/></default-field>
                </field>
                <field name="assignedToUserId"><default-field title="Owner"><display/></default-field></field>
                <field name="stageAction">
                    <conditional-field name="stageAction_write" condition="modCanWrite" title="Action">
                    <drop-down allow-empty="true" submit-on-change="true" transition="advanceStage"
                               parameter-map="[salesOpportunityId:salesOpportunityId]" parameter-name="opportunityStageId">
                        <list-options list="stages" key="${opportunityStageId}" text="${description}"/>
                    </drop-down>
                    </conditional-field>
                    <default-field><label text="" type="span"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
