<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Pipeline" default-menu-index="3">
    <parameter name="period"/>
    <parameter name="ownerId"/>
    <parameter name="searchText"/>

    <transition name="createOpportunity">
        <service-call name="zenith.crm.CrmServices.create#Opportunity"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="advanceStage">
        <service-call name="zenith.crm.CrmServices.advance#OpportunityStage"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="saveView"><service-call name="zenith.crm.CrmServices.save#CrmFilter"/><default-response url="."/><error-response url="."/></transition>
    <!-- ZE-SEC-JSON f/u: org-scoped party picker (stock SimpleScreens searchPartyList leaks cross-tenant). -->
    <transition-include name="searchPartyList" location="component://zenith-erp-base/screen/include/PartyPicker.xml"/>

    <actions>
        <entity-find entity-name="zenith.erp.crm.OpportunityListView" list="summaryOppList">
            <search-form-inputs default-order-by="stageSequence,-estimatedAmount" skip-fields="organizationPartyId"
                                input-fields-map="ec.context + [pageIndex:null, pageSize:null]" paginate="false"/>
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.crm.OpportunityListView" list="oppList">
            <search-form-inputs default-order-by="stageSequence,-estimatedAmount" skip-fields="organizationPartyId"/>
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
        <entity-find entity-name="mantle.sales.opportunity.SalesOpportunityStage" list="stages">
            <order-by field-name="sequenceNum"/></entity-find>
        <entity-find entity-name="zenith.erp.crm.CrmStageSetting" list="stageSettings">
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
        <script><![CDATA[
            def byId = stageSettings.collectEntries { [(it.opportunityStageId):it] }
            stages = stages.collect { stage ->
                def setting = byId[stage.opportunityStageId]
                [opportunityStageId:stage.opportunityStageId,
                 description:setting?.displayName ?: stage.description,
                 sequenceNum:setting?.sequenceNum ?: stage.sequenceNum,
                 isActive:setting?.isActive ?: 'Y']
            }.sort { it.sequenceNum ?: 0 }
            openStages = stages.findAll { !['SoClosedWon','SoClosedLost'].contains(it.opportunityStageId) && it.isActive == 'Y' }
        ]]></script>
        <entity-find entity-name="zenith.erp.crm.CrmActivity" list="opportunityActivities">
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="statusId" value="Scheduled"/>
            <order-by field-name="dueDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.crm.CrmSavedFilter" list="savedFilters">
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="userId" from="ec.user.userId"/><econdition field-name="screenName" value="Pipeline"/>
            <order-by field-name="filterName"/>
        </entity-find>

        <!-- Pipeline summary by stage -->
        <set field="stageSummary" from="[:]"/>
        <iterate list="stages" entry="stg">
            <set field="stageSummary[stg.opportunityStageId]" from="[name:stg.description, count:0, value:0]"/>
        </iterate>
        <iterate list="summaryOppList" entry="opp">
            <if condition="opp.opportunityStageId &amp;&amp; stageSummary.containsKey(opp.opportunityStageId)">
                <set field="s" from="stageSummary[opp.opportunityStageId]"/>
                <set field="s.count" from="s.count + 1"/>
                <set field="s.value" from="s.value + (opp.estimatedAmount ?: 0)"/>
            </if>
        </iterate>
        <script><![CDATA[
            def rows = summaryOppList ?: []
            def ownerIds = rows*.assignedToUserId.findAll { it }.unique().sort()
            ownerOptions = ownerIds.collect { [id:it, label:it] }
            ownerId = ownerIds.contains(ownerId) ? ownerId : ''
            searchText = (searchText ?: '').toString().trim().take(80)
            period = period == 'all' ? 'all' : 'month'
            def query = searchText.toLowerCase(java.util.Locale.ROOT)
            boardRows = rows.findAll { row ->
                (!ownerId || row.assignedToUserId == ownerId) &&
                (!query || [row.opportunityName, row.accountName, row.salesOpportunityId].any {
                    it?.toString()?.toLowerCase(java.util.Locale.ROOT)?.contains(query)
                })
            }
            def today = java.time.LocalDate.parse(new java.text.SimpleDateFormat('yyyy-MM-dd').format(ec.user.nowTimestamp))
            def monthStart = java.sql.Date.valueOf(today.withDayOfMonth(1))
            def nextMonth = java.sql.Date.valueOf(today.withDayOfMonth(1).plusMonths(1))
            def inPeriod = { date -> period == 'all' || (date && date >= monthStart && date < nextMonth) }
            def openRows = boardRows.findAll { !['SoClosedWon', 'SoClosedLost'].contains(it.opportunityStageId) }
            openCount = openRows.size()
            openValue = openRows.sum { it.estimatedAmount ?: 0G } ?: 0G
            weightedValue = openRows.sum { it.expectedRevenue ?: ((it.estimatedAmount ?: 0G) * (it.estimatedProbability ?: 0G)) } ?: 0G
            closingRows = openRows.findAll { inPeriod(it.estimatedCloseDate) }
            closingValue = closingRows.sum { it.estimatedAmount ?: 0G } ?: 0G
            wonRows = boardRows.findAll { it.opportunityStageId == 'SoClosedWon' && inPeriod(it.wonDate) }
            wonValue = wonRows.sum { it.estimatedAmount ?: 0G } ?: 0G
            boardStages = stages.findAll { !['SoClosedWon', 'SoClosedLost'].contains(it.opportunityStageId) }.collect { stage ->
                def deals = openRows.findAll { it.opportunityStageId == stage.opportunityStageId }
                [id:stage.opportunityStageId, name:stage.description, deals:deals, count:deals.size(), value:(deals.sum { it.estimatedAmount ?: 0G } ?: 0G)]
            }
            nextActivityByOpportunity = [:]
            opportunityActivities.each { activity ->
                if (activity.salesOpportunityId && !nextActivityByOpportunity.containsKey(activity.salesOpportunityId))
                    nextActivityByOpportunity[activity.salesOpportunityId] = activity.dueDate
            }
        ]]></script>
    </actions>

    <widgets>
        <container style="zcrm-intro"><label text="Pipeline" type="h3"/><label text="Track and manage your sales opportunities." type="p"/></container>
        <container style="zcrm-pipeline-actions">
            <section name="NewOpp_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="NewOppDialog" button-text="New Opportunity">
                    <form-single name="NewOppForm" transition="createOpportunity">
                        <field name="opportunityName"><default-field title="Name"><text-line size="40"/></default-field></field>
                        <field name="accountPartyId"><default-field title="Account"><drop-down>
                            <dynamic-options transition="searchPartyList" server-search="true" min-length="2"/>
                        </drop-down></default-field></field>
                        <field name="estimatedAmount"><default-field title="Amount (${currSymbol})"><text-line size="12"/></default-field></field>
                        <field name="estimatedCloseDate"><default-field title="Expected Close"><date-time type="date"/></default-field></field>
                        <field name="opportunityStageId"><default-field title="Stage"><drop-down>
                            <list-options list="openStages" key="${opportunityStageId}" text="${description}"/>
                        </drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </widgets></section>
        </container>
        <container style="zcrm-board-toolbar">
            <form-single name="PipelineFilters" transition="." type="find">
                <field name="period"><default-field title="Close date"><drop-down>
                    <option key="month" text="This month"/><option key="all" text="All time"/>
                </drop-down></default-field></field>
                <field name="ownerId"><default-field title="Owner"><drop-down allow-empty="true">
                    <list-options list="ownerOptions" key="${id}" text="${label}"/>
                </drop-down></default-field></field>
                <field name="searchText"><default-field title="Search"><text-line size="24" default-value="${searchText}"/></default-field></field>
                <field name="submitButton"><default-field title=" "><submit text="Filter"/></default-field></field>
                <field name="resetButton"><default-field title=" "><link url="." text="Reset"/></default-field></field>
                <field-layout><field-row><field-ref name="period"/><field-ref name="ownerId"/><field-ref name="searchText"/><field-ref name="submitButton"/><field-ref name="resetButton"/></field-row></field-layout>
            </form-single>
        </container>
        <container style="zcrm-period zcrm-saved-views">
            <section-iterate name="PipelineSavedViews" list="savedFilters" entry="saved"><widgets><link url="." text="${saved.filterName}" parameter-map="new groovy.json.JsonSlurper().parseText(saved.filterJson)"/></widgets></section-iterate>
            <section name="SavePipelineView" condition="modCanWrite"><widgets><form-single name="SavePipelineFilter" transition="saveView">
                <field name="screenName"><default-field><hidden default-value="Pipeline"/></default-field></field>
                <field name="period"><default-field><hidden default-value="${period}"/></default-field></field>
                <field name="ownerId"><default-field><hidden default-value="${ownerId ?: ''}"/></default-field></field>
                <field name="searchText"><default-field><hidden default-value="${searchText ?: ''}"/></default-field></field>
                <field name="filterName"><default-field title="Save current view as"><text-line size="20"/></default-field></field>
                <field name="submitButton"><default-field title="Save view"><submit/></default-field></field>
            </form-single></widgets></section>
        </container>
        <container style="zcrm-metrics zcrm-reference-metrics">
            <container style="zcrm-metric"><label text="Open Pipeline" type="span"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(openValue, '#,##,##0'))}" type="h4"/><label text="${openCount} deals" type="span" style="zcrm-muted"/></container>
            <container style="zcrm-metric"><label text="Weighted Value" type="span"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(weightedValue, '#,##,##0'))}" type="h4"/><label text="Expected revenue" type="span" style="zcrm-muted"/></container>
            <container style="zcrm-metric"><label text="Closing ${period == 'month' ? 'This Month' : 'All Time'}" type="span"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(closingValue, '#,##,##0'))}" type="h4"/><label text="${closingRows.size()} deals" type="span" style="zcrm-muted"/></container>
            <container style="zcrm-metric"><label text="Won ${period == 'month' ? 'This Month' : 'All Time'}" type="span"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(wonValue, '#,##,##0'))}" type="h4"/><label text="${wonRows.size()} deals" type="span" style="zcrm-muted"/></container>
        </container>
        <container style="zcrm-board" id="pipeline-board">
            <section-iterate name="crmPipelineStages" list="boardStages" entry="column"><widgets>
                <container style="zcrm-board-column" id="crm-stage-${column.id}">
                    <container style="zcrm-board-stage-head"><label text="${column.name}" type="h4"/><label text="${column.count} deals · ${currSymbol}${zinr.inr(ec.l10n.format(column.value, '#,##,##0'))}" type="span"/></container>
                    <section name="EmptyStage" condition="column.deals.isEmpty()"><widgets><label text="No opportunities in this stage" type="p" style="zcrm-board-empty"/></widgets></section>
                    <section-iterate name="crmStageDeals" list="column.deals" entry="deal"><widgets>
                        <container style="zcrm-deal-card" id="crm-deal-${deal.salesOpportunityId}">
                            <link url="../EditOpportunity" text="${deal.opportunityName}" parameter-map="[salesOpportunityId:deal.salesOpportunityId]"/>
                            <label text="${deal.accountName ?: 'No account'}" type="span" style="zcrm-muted"/>
                            <label text="${currSymbol}${zinr.inr(ec.l10n.format(deal.estimatedAmount ?: 0, '#,##,##0'))}" type="strong" style="zcrm-deal-amount"/>
                            <label text="${deal.estimatedCloseDate ? ec.l10n.format(deal.estimatedCloseDate, 'dd MMM yyyy') : 'No close date'}" type="span" style="zcrm-muted"/>
                            <label text="Source: ${deal.leadSourceId ?: 'Unknown'}" type="span" style="zcrm-muted"/>
                            <label text="Next activity: ${nextActivityByOpportunity[deal.salesOpportunityId] ? ec.l10n.format(nextActivityByOpportunity[deal.salesOpportunityId], 'dd MMM yyyy') : 'None scheduled'}" type="span" style="zcrm-muted"/>
                            <container style="zcrm-deal-foot"><label text="${deal.assignedToUserId ?: 'Unassigned'}" type="span"/><label text="${deal.estimatedProbability != null ? (deal.estimatedProbability * 100).intValue() : 0}%" type="span"/></container>
                        </container>
                    </widgets></section-iterate>
                </container>
            </widgets></section-iterate>
        </container>
        <section name="DragStageWrite" condition="modCanWrite"><widgets><container style="zcrm-drag-form">
            <form-single name="DragStageForm" transition="advanceStage">
                <field name="salesOpportunityId"><default-field><hidden/></default-field></field>
                <field name="opportunityStageId"><default-field><hidden/></default-field></field>
                <field name="submitButton"><default-field><submit/></default-field></field>
            </form-single>
        </container></widgets></section>

        <!-- Opportunities List -->
        <container-box><box-header title="Manage opportunities"/><box-body>
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Pipeline..." style="display:none"></span>]]></text></render-mode>
            <section name="NoOpportunities" condition="oppList.isEmpty()"><widgets><container style="zcrm-empty"><label text="No opportunities match this search. Clear filters or create an opportunity." type="p"/></container></widgets></section>
            <form-list name="OppListForm" list="oppList" transition="advanceStage" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="salesOpportunityId">
                    <default-field title="ID"><display/></default-field>
                </field>
                <field name="opportunityName">
                    <header-field title="Opportunity"><text-find size="25" hide-options="true"/></header-field>
                    <default-field><link url="../EditOpportunity" text="${opportunityName}" parameter-map="[salesOpportunityId:salesOpportunityId]"/></default-field>
                </field>
                <field name="accountName">
                    <header-field title="Account"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="estimatedAmount">
                    <header-field title="Amount" show-order-by="true"/>
                    <default-field><display format="#,##,##0"/></default-field>
                </field>
                <field name="estimatedProbability">
                    <default-field title="Prob%"><display format="0%"/></default-field>
                </field>
                <field name="expectedRevenue">
                    <header-field title="Weighted" show-order-by="true"/>
                    <default-field><display format="#,##,##0"/></default-field>
                </field>
                <field name="stageName">
                    <header-field title="Stage">
                        <drop-down allow-empty="true">
                            <list-options list="stages" key="${opportunityStageId}" text="${description}"/>
                        </drop-down>
                    </header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="estimatedCloseDate">
                    <header-field title="Close Date" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="dd/MM/yyyy"/></default-field>
                </field>
                <field name="assignedToUserId"><default-field title="Owner"><display/></default-field></field>
                <field name="leadSourceId"><default-field title="Source"><display text="${leadSourceId ?: 'Unknown'}"/></default-field></field>
                <field name="opportunityStageId">
                    <conditional-field name="stageAction_write" condition="modCanWrite" title="Move to stage">
                        <drop-down><list-options list="openStages" key="${opportunityStageId}" text="${description}"/></drop-down>
                    </conditional-field>
                    <default-field><label text="" type="span"/></default-field>
                </field>
                <field name="submitButton">
                    <header-field title="Find"><submit/></header-field>
                    <conditional-field name="saveStage_write" condition="modCanWrite" title="Action"><submit text="Move"/></conditional-field>
                    <default-field><label text="" type="span"/></default-field>
                </field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
