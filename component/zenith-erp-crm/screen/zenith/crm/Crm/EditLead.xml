<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Lead Detail" default-menu-index="0" default-menu-include="false">

    <parameter name="leadId" required="true"/>

    <transition name="updateLead">
        <actions>
            <service-call name="zenith.crm.CrmServices.update#Lead" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="convertLead">
        <actions>
            <service-call name="zenith.crm.CrmServices.convert#Lead" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="logActivity">
        <service-call name="zenith.crm.CrmServices.log#Activity"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.crm.Lead" value-field="lead"/>
        <!-- Org-isolation: block IDOR read of another tenant's lead by guessing leadId -->
        <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <if condition="lead == null || !activeOrg || activeOrg == '_NA_' || lead.organizationPartyId != activeOrg">
            <return error="true" message="Lead not found for your account."/>
        </if>
        <entity-find entity-name="zenith.erp.crm.LeadSource" list="leadSources">
            <econdition field-name="isActive" value="Y"/><order-by field-name="description"/></entity-find>
        <entity-find entity-name="zenith.erp.india.IndiaState" list="stateList">
            <order-by field-name="stateName"/></entity-find>
        <entity-find entity-name="zenith.erp.crm.CrmActivity" list="activities">
            <econdition field-name="leadId"/>
            <order-by field-name="-activityDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="zcrm-intro"><label text="Lead details" type="h3"/><label text="Update qualification, contact details and the activity history." type="p"/><link url="../Leads" text="Back to leads"/></container>
        <container-row>
            <row-col lg="7">
                <container-box><box-header title="Lead Details"/><box-toolbar>
                    <link url="convertLead" text="Convert to Contact" parameter-map="[leadId:leadId]"
                          condition="lead.statusId != 'LeadConverted' &amp;&amp; lead.statusId != 'LeadLost' &amp;&amp; modCanWrite"
                          confirmation="Convert this lead? A Contact and Opportunity will be created."/>
                </box-toolbar><box-body>
                    <form-single name="EditLeadForm" map="lead" transition="updateLead">
                        <field name="leadId"><default-field><hidden/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down>
                                <option key="LeadNew" text="New"/>
                                <option key="LeadContacted" text="Contacted"/>
                                <option key="LeadQualified" text="Qualified"/>
                                <option key="LeadConverted" text="Converted (use Convert to Contact)"/>
                                <option key="LeadLost" text="Lost"/>
                            </drop-down>
                        </default-field></field>
                        <field name="firstName"><default-field><text-line size="20"/></default-field></field>
                        <field name="lastName"><default-field><text-line size="20"/></default-field></field>
                        <field name="companyName"><default-field title="Company"><text-line size="30"/></default-field></field>
                        <field name="designation"><default-field><text-line size="20"/></default-field></field>
                        <field name="email"><default-field><text-line size="30"/></default-field></field>
                        <field name="mobile"><default-field><text-line size="15"/></default-field></field>
                        <field name="phone"><default-field><text-line size="15"/></default-field></field>
                        <field name="website"><default-field><text-line size="30"/></default-field></field>
                        <field name="address"><default-field><text-area rows="2" cols="50"/></default-field></field>
                        <field name="city"><default-field><text-line size="20"/></default-field></field>
                        <field name="regionCode"><default-field title="State">
                            <drop-down allow-empty="true">
                                <list-options list="stateList" key="${stateCode}" text="${stateCode} - ${stateName}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="postalCode"><default-field title="PIN Code"><text-line size="8"/></default-field></field>
                        <field name="taxRegistrationNumber"><default-field title="GSTIN"><text-line size="20"/></default-field></field>
                        <field name="taxIdNumber"><default-field title="PAN"><text-line size="12"/></default-field></field>
                        <field name="leadSourceId"><default-field title="Source">
                            <drop-down allow-empty="true">
                                <list-options list="leadSources" key="${leadSourceId}" text="${description}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="rating"><default-field>
                            <drop-down><option key="Hot"/><option key="Warm"/><option key="Cold"/></drop-down>
                        </default-field></field>
                        <field name="estimatedAmount"><default-field title="Est. Deal (${currSymbol})"><text-line size="12"/></default-field></field>
                        <field name="estimatedCloseDate"><default-field title="Est. Close"><date-time type="date"/></default-field></field>
                        <field name="description"><default-field title="Notes"><text-area rows="3" cols="50"/></default-field></field>
                        <field name="lostReason" condition="lead.statusId == 'LeadLost'"><default-field title="Lost Reason"><text-line size="40"/></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="save_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                            <default-field title="Update"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                    <label text="Score: ${lead.score ?: 0}/100" type="div" style="text-info"/>
                    <label text="Converted to Party: ${lead.convertedPartyId}" type="div" style="text-success" condition="lead.convertedPartyId"/>
                </box-body></container-box>
            </row-col>
            <row-col lg="5">
                <container-box><box-header title="Activities"/><box-toolbar>
                    <section name="LeadLogActivity_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container-dialog id="LogActivityDialog" button-text="Log Activity">
                        <form-single name="LogActivityForm" transition="logActivity">
                            <field name="leadId"><default-field><hidden/></default-field></field>
                            <field name="activityType"><default-field title="Type">
                                <drop-down>
                                    <option key="Call" text="Phone Call"/>
                                    <option key="Email" text="Email"/>
                                    <option key="Meeting" text="Meeting"/>
                                    <option key="WhatsApp" text="WhatsApp"/>
                                    <option key="Note" text="Note"/>
                                    <option key="Task" text="Task"/>
                                </drop-down>
                            </default-field></field>
                            <field name="subject"><default-field><text-line size="30"/></default-field></field>
                            <field name="description"><default-field><text-area rows="3" cols="40"/></default-field></field>
                            <field name="outcome"><default-field><text-line size="30"/></default-field></field>
                            <field name="nextFollowUpDate"><default-field title="Next Follow-up"><date-time type="date-time"/></default-field></field>
                            <field name="submitButton"><default-field title="Log"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </box-toolbar><box-body>
                    <form-list name="ActivityListForm" list="activities" skip-form="true">
                        <field name="activityDate"><default-field title="Date"><display format="dd/MM/yy HH:mm"/></default-field></field>
                        <field name="activityType"><default-field title="Type"><display/></default-field></field>
                        <field name="subject"><default-field><display/></default-field></field>
                        <field name="outcome"><default-field><display/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
