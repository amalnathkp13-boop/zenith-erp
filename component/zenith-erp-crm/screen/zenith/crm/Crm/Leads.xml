<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Leads" default-menu-index="1">

    <transition name="createLead">
        <service-call name="zenith.crm.CrmServices.create#Lead"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="editLead">
        <default-response url="../EditLead"/>
    </transition>

    <actions>
        <entity-find-count entity-name="zenith.erp.crm.Lead" count-field="organizationLeadCount">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
        </entity-find-count>
        <entity-find entity-name="zenith.erp.crm.LeadListView" list="leadList">
            <search-form-inputs default-order-by="-createdDate" skip-fields="organizationPartyId"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
        <service-call name="zenith.base.SecurityServices.get#ActiveOrgList" out-map="context"/>
        <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_hasActiveOrg" from="(_ao != null &amp;&amp; _ao != '_NA_')"/>
        <if condition="_hasActiveOrg"><set field="organizationPartyId" from="_ao"/></if>
        <entity-find entity-name="zenith.erp.crm.LeadSource" list="leadSources">
            <econdition field-name="isActive" value="Y"/>
            <order-by field-name="description"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.india.IndiaState" list="stateList">
            <order-by field-name="stateName"/></entity-find>
    </actions>

    <widgets>
        <container style="zcrm-intro"><label text="Leads" type="h3"/><label text="Find, qualify, and follow up with potential customers." type="p"/></container>
        <container-box><box-header title="Lead directory"/><box-toolbar>
            <section name="NewLead_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="NewLeadDialog" button-text="New Lead" condition="_hasActiveOrg">
                <form-single name="NewLeadForm" transition="createLead">
                    <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                    <field name="firstName"><default-field title="First Name"><text-line size="20"/></default-field></field>
                    <field name="lastName"><default-field title="Last Name"><text-line size="20"/></default-field></field>
                    <field name="companyName"><default-field title="Company"><text-line size="30"/></default-field></field>
                    <field name="designation"><default-field><text-line size="20"/></default-field></field>
                    <field name="email"><default-field><text-line size="30"/></default-field></field>
                    <field name="mobile"><default-field title="Mobile"><text-line size="15"/></default-field></field>
                    <field name="city"><default-field><text-line size="20"/></default-field></field>
                    <field name="regionCode"><default-field title="State">
                        <drop-down allow-empty="true">
                            <list-options list="stateList" key="${stateCode}" text="${stateCode} - ${stateName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="taxRegistrationNumber"><default-field title="GSTIN"><text-line size="20"/></default-field></field>
                    <field name="leadSourceId"><default-field title="Source">
                        <drop-down allow-empty="true">
                            <list-options list="leadSources" key="${leadSourceId}" text="${description}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="rating"><default-field>
                        <drop-down><option key="Hot"/><option key="Warm"/><option key="Cold"/></drop-down>
                    </default-field></field>
                    <field name="estimatedAmount"><default-field title="Est. Deal Value (${currSymbol})"><text-line size="12"/></default-field></field>
                    <field name="description"><default-field title="Notes"><text-area rows="3" cols="50"/></default-field></field>
                    <field name="submitButton"><default-field title="Create Lead"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
            <section name="NoOrg" condition="!_hasActiveOrg"><widgets><label text="Select an organization to create or view leads." type="span" style="text-grey-7"/></widgets></section>
        </box-toolbar><box-body>
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Leads..." style="display:none"></span>]]></text></render-mode>
            <label text="${organizationLeadCount} leads in this organization" type="p" style="zcrm-list-count"/>
            <section name="NoLeads" condition="leadList.isEmpty() &amp;&amp; organizationLeadCount == 0"><widgets><container style="zcrm-empty"><label text="No leads yet. Add the first lead to start tracking opportunities." type="p"/></container></widgets></section>
            <section name="NoLeadMatches" condition="leadList.isEmpty() &amp;&amp; organizationLeadCount &gt; 0"><widgets><container style="zcrm-empty"><label text="No leads match this search. Clear the filters or try a different term." type="p"/></container></widgets></section>
            <form-list name="LeadListForm" list="leadList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="leadId">
                    <default-field title="ID"><link url="editLead" text="${leadId}" parameter-map="[leadId:leadId]"/></default-field>
                </field>
                <field name="firstName">
                    <header-field title="Name"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><link url="editLead" text="${firstName} ${lastName ?: ''}" parameter-map="[leadId:leadId]"/></default-field>
                </field>
                <field name="companyName">
                    <header-field title="Company"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="email"><header-field><text-find size="25" hide-options="true"/></header-field><default-field><display/></default-field></field>
                <field name="mobile"><header-field title="Phone"><text-find size="18" hide-options="true"/></header-field><default-field title="Phone"><display text="${mobile ?: phone ?: ''}"/></default-field></field>
                <field name="city"><header-field><text-find size="18" hide-options="true"/></header-field><default-field><display/></default-field></field>
                <field name="sourceName"><header-field title="Source"><text-find size="18" hide-options="true"/></header-field><default-field title="Source"><display/></default-field></field>
                <field name="rating">
                    <header-field>
                        <drop-down allow-empty="true"><option key="Hot"/><option key="Warm"/><option key="Cold"/></drop-down>
                    </header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="score">
                    <header-field show-order-by="true"/>
                    <default-field><display/></default-field>
                </field>
                <field name="estimatedAmount">
                    <header-field title="Est. Value" show-order-by="true"/>
                    <default-field><display format="#,##,##0"/></default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="LeadNew" text="New"/>
                            <option key="LeadContacted" text="Contacted"/>
                            <option key="LeadQualified" text="Qualified"/>
                            <option key="LeadConverted" text="Converted"/>
                            <option key="LeadLost" text="Lost"/>
                        </drop-down>
                    </header-field>
                    <default-field><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field>
                </field>
                <field name="createdDate">
                    <header-field title="Created" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="dd/MM/yyyy"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
