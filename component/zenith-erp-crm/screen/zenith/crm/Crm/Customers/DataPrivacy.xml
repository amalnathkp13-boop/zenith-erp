<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="GDPR &amp; Data Privacy" default-menu-index="90">

    <transition name="anonymizeData">
        <service-call name="zenith.crm.CrmServices.anonymize#CustomerData" in-map="context"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <!-- ORG ISOLATION: scope the GDPR customer list to the caller's active org so a tenant
             can never see (or anonymize) another tenant's customers. ownerPartyId is the per-Party
             org field; PartyDetailAndRole exposes both roleTypeId and ownerPartyId. -->
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="customers" limit="20">
            <econdition field-name="roleTypeId" value="Customer"/>
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
            <order-by field-name="firstName"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Data Privacy &amp; GDPR Control Center" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container-row>
            <row-col lg="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="Right to be Forgotten (Irreversible Anonymization)" type="h5" style="text-danger text-weight-bold q-mb-md"/>
                    <label text="Warning: This action permanently scrambles PII (Name, Phone, Email) for compliance. Financial ledgers attached to the Party ID will remain mathematically intact." type="p" style="text-grey-7 q-mb-lg"/>
                    
                    <form-list name="CustomerList" list="customers" transition="anonymizeData">
                        <field name="partyId"><default-field title="ID"><display/></default-field></field>
                        <field name="firstName"><default-field title="First Name"><display/></default-field></field>
                        <field name="lastName"><default-field title="Last Name"><display/></default-field></field>
                        
                        <field name="anonymizeBtn">
                            <conditional-field name="anonymize_write" condition="modCanWrite" title="Compliance Action">
                            <submit text="Execute Right to be Forgotten" type="danger" confirmation="IRREVERSIBLE ACTION: Are you sure you want to permanently scramble this customer's PII?"/>
                            </conditional-field>
                            <default-field title="Compliance Action"><label text="View-only" type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-list>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
