<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Contact Detail" default-menu-include="false">
    <parameter name="partyId" required="true"/>
    <parameter name="editPersonId"/>
    <transition name="saveContact">
        <actions>
            <if condition="ec.web.request.method != 'POST'"><return error="true" message="Submit the contact form to save changes."/></if>
            <service-call name="zenith.crm.CrmServices.save#AccountContact" in-map="[accountPartyId:partyId,personPartyId:personPartyId,
                designation:designation,preferredChannel:preferredChannel,primaryContact:primaryContact]"/>
        </actions>
        <default-response url="."/><error-response url="."/>
    </transition>
    <transition name="findAccountPerson" read-only="true">
        <parameter name="term"/>
        <actions>
            <set field="query" from="term?.trim()"/>
            <if condition="!query || !crmOrganization.activeOrgId || crmOrganization.activeOrgId == '_NA_'"><script>ec.web.sendJsonResponse([])</script><return/></if>
            <entity-find entity-name="mantle.party.PartyDetail" list="people" limit="25">
                <econdition field-name="ownerPartyId" from="crmOrganization.activeOrgId"/><econdition field-name="partyTypeEnumId" value="PtyPerson"/>
                <econditions combine="or"><econdition field-name="disabled" operator="is-null"/><econdition field-name="disabled" value="N"/></econditions>
                <econditions combine="or"><econdition field-name="partyId" from="query"/>
                    <econdition field-name="firstName" operator="like" value="%${query}%" ignore-case="true"/>
                    <econdition field-name="lastName" operator="like" value="%${query}%" ignore-case="true"/></econditions>
                <order-by field-name="firstName,lastName,partyId"/>
            </entity-find>
            <script>ec.web.sendJsonResponse(people.collect { [value:it.partyId,label:([it.firstName,it.lastName].findAll().join(' ') ?: it.partyId)] })</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="addNote">
        <actions>
            <if condition="ec.web.request.method != 'POST'"><return error="true" message="Submit the note form to save a note."/></if>
            <service-call name="zenith.crm.CrmServices.log#Activity"
                          in-map="[activityType:'Note', subject:subject, description:description, contactPartyId:partyId]"/>
        </actions>
        <default-response url="."/><error-response url="."/>
    </transition>
    <actions>
        <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
        <entity-find-one entity-name="mantle.party.Party" value-field="contact"/>
        <if condition="!contact || !activeOrg || activeOrg == '_NA_' || contact.ownerPartyId != activeOrg">
            <return error="true" message="Contact not found for your organization."/>
        </if>
        <service-call name="zenith.crm.CrmServices.get#CrmSalesAccess" out-map="salesAccess"/>
        <entity-find-one entity-name="mantle.party.PartyRole" value-field="customerRole"><field-map field-name="partyId"/><field-map field-name="roleTypeId" value="Customer"/></entity-find-one>
        <set field="isBusinessCustomer" from="customerRole &amp;&amp; contact.partyTypeEnumId == 'PtyOrganization'"/>
        <script><![CDATA[
            accountPeople = []
            if (isBusinessCustomer) {
                def links = ec.entity.find('mantle.party.PartyRelationship').condition('toPartyId',partyId)
                        .condition('relationshipTypeEnumId','PrtContact').conditionDate('fromDate','thruDate',ec.user.nowTimestamp).list()
                def people = links ? ec.entity.find('mantle.party.PartyDetail').condition('partyId','in',links*.fromPartyId)
                        .condition('ownerPartyId',activeOrg).condition('partyTypeEnumId','PtyPerson').list().findAll { it.disabled != 'Y' } : []
                if (people) {
                    def peopleById = people.collectEntries { [(it.partyId):it] }
                    def currentMethods = { entity, purpose, field ->
                        ec.entity.find(entity).condition('partyId','in',peopleById.keySet() as List).condition('contactMechPurposeId',purpose)
                            .conditionDate('fromDate','thruDate',ec.user.nowTimestamp).orderBy('fromDate,contactMechId').list()
                            .collectEntries { [(it.partyId):it.get(field)] }
                    }
                    def emails = currentMethods('mantle.party.contact.PartyContactMechInfo','EmailPrimary','infoString')
                    def phones = currentMethods('mantle.party.contact.PartyContactMechTelecomNumber','PhonePrimary','contactNumber')
                    accountPeople = links.findAll { peopleById.containsKey(it.fromPartyId) }.collect { rel ->
                        def person = peopleById[rel.fromPartyId]
                        [personPartyId:rel.fromPartyId,personName:([person.firstName,person.lastName].findAll().join(' ') ?: person.partyId),
                         designation:rel.relationshipName,preferredChannel:rel.crmPreferredChannel,primaryContact:rel.crmPrimaryContact ?: 'N',
                         email:emails[person.partyId],phone:phones[person.partyId]]
                    }.sort { a,b -> (b.primaryContact <=> a.primaryContact) ?: (a.personName <=> b.personName) }
                }
            }
            editingPerson = accountPeople.find { it.personPartyId == editPersonId }
        ]]></script>
        <set field="canViewCases" from="customerRole &amp;&amp; (!navRestricted || saasVisibleModules?.contains('helpdesk')) &amp;&amp; (!customRoleNavigation || roleNavSections?.any { section -> section.screens?.any { it.id == '/helpdesk/Tickets' } })"/>
        <script><![CDATA[
            receivables = []
            if (customerRole && salesAccess.routes.contains('EditInvoice')) {
                def balances = ec.entity.find('mantle.account.invoice.Invoice')
                balances.makeEntityDynamicView().addMemberEntity('INV','mantle.account.invoice.Invoice',null,null,null)
                    .addAlias('INV','fromPartyId').addAlias('INV','toPartyId').addAlias('INV','invoiceTypeEnumId')
                    .addAlias('INV','statusId').addAlias('INV','currencyUomId').addAlias('INV','balance','unpaidTotal','sum')
                receivables = balances.condition('fromPartyId',activeOrg).condition('toPartyId',partyId)
                    .condition('invoiceTypeEnumId','InvoiceSales')
                    .condition('statusId','in',['InvoiceFinalized','InvoiceApproved','InvoiceSent','InvoiceAcked','InvoicePmtRecvd'])
                    .selectFields(['currencyUomId','balance']).orderBy('currencyUomId').list()
            }
        ]]></script>
        <entity-find entity-name="zenith.erp.contacts.ContactListView" list="contactRows"><econdition field-name="partyId"/></entity-find>
        <set field="contactRow" from="contactRows ? contactRows[0] : null"/>
        <entity-find entity-name="zenith.erp.crm.Lead" list="linkedLeads">
            <econdition field-name="organizationPartyId" from="activeOrg"/>
            <econdition field-name="convertedPartyId" from="partyId"/>
            <order-by field-name="-createdDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.crm.OpportunityListView" list="linkedOpportunities">
            <econdition field-name="organizationPartyId" from="activeOrg"/>
            <econdition field-name="accountPartyId" from="partyId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.crm.CrmActivity" list="linkedActivities">
            <econdition field-name="organizationPartyId" from="activeOrg"/>
            <econdition field-name="contactPartyId" from="partyId"/>
            <order-by field-name="-activityDate"/>
        </entity-find>
    </actions>
    <widgets>
        <container style="zcrm-intro"><label text="${contactRow?.organizationName ?: ((contactRow?.firstName ?: '') + ' ' + (contactRow?.lastName ?: '')).trim() ?: partyId}" type="h3"/>
            <label text="Contact history and linked CRM records." type="p"/><link url="../Contacts" text="Back to contacts"/></container>
        <container style="zcrm-metrics zcrm-reference-metrics">
            <container style="zcrm-metric"><label text="Linked leads" type="span"/><label text="${linkedLeads.size()}" type="h4"/></container>
            <container style="zcrm-metric"><label text="Opportunities" type="span"/><label text="${linkedOpportunities.size()}" type="h4"/></container>
            <container style="zcrm-metric"><label text="Activities" type="span"/><label text="${linkedActivities.size()}" type="h4"/></container>
        </container>
        <container-box><box-header title="Contact details"/><box-body>
            <label text="Email: ${contactRow?.emailAddress ?: '—'}" type="p"/>
            <link url="../../helpdesk/Tickets" text="Support cases" parameter-map="[customerPartyId:partyId]" condition="canViewCases"/>
            <label text="Phone: ${contactRow?.phoneNumber ?: '—'}" type="p"/>
        </box-body></container-box>
        <section name="BusinessPeople" condition="isBusinessCustomer"><widgets>
            <container-box><box-header title="Account contacts"/><box-body>
                <section name="EmptyAccountContacts" condition="accountPeople.isEmpty()"><widgets><label text="No people linked to this business yet." type="p"/></widgets></section>
                <form-list name="AccountPeople" list="accountPeople" skip-form="true">
                    <field name="personPartyId"><default-field title="Person"><link url="../ContactDetail" text="${personName}" parameter-map="[partyId:personPartyId]"/></default-field></field>
                    <field name="designation"><default-field title="Designation"><display/></default-field></field>
                    <field name="email"><default-field title="Email"><display/></default-field></field>
                    <field name="phone"><default-field title="Phone"><display/></default-field></field>
                    <field name="preferredChannel"><default-field title="Preferred channel"><display/></default-field></field>
                    <field name="primaryContact"><default-field title="Primary"><display text="${primaryContact == 'Y' ? 'Yes' : '—'}"/></default-field></field>
                    <field name="editContact"><default-field title=" "><link url="." text="Edit" condition="modCanWrite &amp;&amp; contact.disabled != 'Y'" parameter-map="[partyId:contact.partyId,editPersonId:personPartyId]"/></default-field></field>
                </form-list>
                <section name="ManageAccountContact" condition="modCanWrite &amp;&amp; contact.disabled != 'Y'"><widgets>
                    <form-single name="AccountContactDetails" transition="saveContact" map="editingPerson">
                        <field name="partyId"><default-field><hidden default-value="${contact.partyId}"/></default-field></field>
                        <field name="personPartyId"><conditional-field condition="editingPerson" title="Person"><display text="${editingPerson?.personName}" also-hidden="true"/></conditional-field>
                            <default-field title="Link existing person"><drop-down><dynamic-options transition="findAccountPerson" server-search="true" min-length="2"/></drop-down></default-field></field>
                        <field name="designation"><default-field title="Designation"><text-line maxlength="100"/></default-field></field>
                        <field name="preferredChannel"><default-field title="Preferred channel"><drop-down allow-empty="true"><option key="Email"/><option key="Phone"/><option key="WhatsApp"/><option key="SMS"/></drop-down></default-field></field>
                        <field name="primaryContact"><default-field title="Primary contact"><drop-down no-current-selected-key="N"><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Save contact"><submit/></default-field></field>
                    </form-single>
                    <link url="." text="Cancel edit" condition="editingPerson" parameter-map="[partyId:contact.partyId,editPersonId:'']"/>
                </widgets></section>
            </box-body></container-box>
        </widgets></section>
        <section name="CustomerSales" condition="customerRole &amp;&amp; (salesAccess.routes || salesAccess.canCreateQuote)"><widgets>
            <container-box><box-header title="Sales documents"/><box-body>
                <section-iterate name="CustomerBalances" list="receivables" entry="total"><widgets>
                    <label text="Outstanding · ${total.currencyUomId ?: 'Unspecified currency'} ${ec.l10n.format(total.balance ?: 0, '#,##0.00')}" type="p"/>
                </widgets></section-iterate>
                <section name="CustomerNewQuote" condition="salesAccess.canCreateQuote &amp;&amp; contact.disabled != 'Y'"><widgets><link url="../../sales/CreateQuotation" text="Create quotation" parameter-map="[customerPartyId:partyId]"/></widgets></section>
                <section name="CustomerQuotes" condition="salesAccess.routes.contains('FindQuotation')"><widgets><link url="../../sales/FindQuotation" text="Quotations" parameter-map="[customerPartyId:partyId]"/></widgets></section>
                <section name="CustomerOrders" condition="salesAccess.routes.contains('FindOrder')"><widgets><link url="../../sales/FindOrder" text="Sales orders" parameter-map="[customerPartyId:partyId]"/></widgets></section>
                <section name="CustomerInvoices" condition="salesAccess.routes.contains('FindInvoice')"><widgets><link url="../../sales/FindInvoice" text="Invoices and payments" parameter-map="[toPartyId:partyId]"/></widgets></section>
            </box-body></container-box>
        </widgets></section>
        <container-box><box-header title="Leads"/><box-body>
            <section name="NoLinkedLeads" condition="linkedLeads.isEmpty()"><widgets><label text="No converted leads linked to this contact." type="p"/></widgets></section>
            <form-list name="ContactLeads" list="linkedLeads" skip-form="true">
                <field name="leadId"><default-field title="Lead"><link url="../EditLead" text="${firstName} ${lastName ?: ''}" parameter-map="[leadId:leadId]"/></default-field></field>
                <field name="leadSourceId"><default-field title="Original source"><display/></default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
            </form-list>
        </box-body></container-box>
        <container-box><box-header title="Opportunities"/><box-body>
            <section name="NoLinkedOpps" condition="linkedOpportunities.isEmpty()"><widgets><label text="No opportunities linked to this contact." type="p"/></widgets></section>
            <form-list name="ContactOpps" list="linkedOpportunities" skip-form="true">
                <field name="salesOpportunityId"><default-field title="Opportunity"><link url="../EditOpportunity" text="${opportunityName}" parameter-map="[salesOpportunityId:salesOpportunityId]"/></default-field></field>
                <field name="estimatedAmount"><default-field title="Amount"><display text="${currencyUomId ?: 'Unspecified'} ${ec.l10n.format(estimatedAmount ?: 0, '#,##0.00')}"/></default-field></field>
                <field name="stageName"><default-field title="Stage"><display/></default-field></field>
            </form-list>
        </box-body></container-box>
        <container-box><box-header title="Activity history"/><box-toolbar>
            <section name="ContactNote_write" condition="modCanWrite"><widgets>
                <container-dialog id="ContactNoteDialog" button-text="Add Note">
                    <form-single name="ContactNoteForm" transition="addNote">
                        <field name="partyId"><default-field><hidden default-value="${partyId}"/></default-field></field>
                        <field name="subject"><default-field title="Title"><text-line size="36" maxlength="100"/></default-field></field>
                        <field name="description"><default-field title="Note"><text-area rows="4" cols="45"/></default-field></field>
                        <field name="submitButton"><default-field title="Save note"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <section name="NoLinkedActivities" condition="linkedActivities.isEmpty()"><widgets><label text="No activities linked to this contact." type="p"/></widgets></section>
            <form-list name="ContactActivities" list="linkedActivities" skip-form="true">
                <field name="activityDate"><default-field title="Date"><display format="dd MMM yyyy HH:mm"/></default-field></field>
                <field name="activityType"><default-field title="Type"><display/></default-field></field>
                <field name="subject"><default-field><link url="../ActivityDetail" text="${subject}" parameter-map="[activityId:activityId]"/></default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
