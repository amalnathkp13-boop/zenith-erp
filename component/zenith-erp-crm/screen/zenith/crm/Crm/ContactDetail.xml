<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Contact Detail" default-menu-include="false">
    <parameter name="partyId" required="true"/>
    <transition name="addNote">
        <actions>
            <if condition="ec.web.request.method != 'POST'"><return error="true" message="Submit the note form to save a note."/></if>
            <service-call name="zenith.crm.CrmServices.log#Activity"
                          in-map="[activityType:'Note', subject:subject, description:description, contactPartyId:partyId]"/>
        </actions>
        <default-response url="."/><error-response url="."/>
    </transition>
    <actions>
        <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
        <entity-find-one entity-name="mantle.party.Party" value-field="contact"/>
        <if condition="!contact || !activeOrg || activeOrg == '_NA_' || contact.ownerPartyId != activeOrg">
            <return error="true" message="Contact not found for your organization."/>
        </if>
        <entity-find entity-name="zenith.erp.contacts.ContactListView" list="contactRows"><econdition field-name="partyId"/></entity-find>
        <set field="contactRow" from="contactRows ? contactRows[0] : null"/>
        <entity-find entity-name="zenith.erp.crm.Lead" list="linkedLeads">
            <econdition field-name="organizationPartyId" from="activeOrg"/>
            <econdition field-name="convertedPartyId" from="partyId"/>
            <order-by field-name="-createdDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.crm.OpportunityListView" list="linkedOpportunities">
            <econdition field-name="organizationPartyId" from="activeOrg"/>
            <econdition field-name="accountPartyId" from="partyId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.crm.CrmActivity" list="linkedActivities">
            <econdition field-name="organizationPartyId" from="activeOrg"/>
            <econdition field-name="contactPartyId" from="partyId"/>
            <order-by field-name="-activityDate"/>
        </entity-find>
    </actions>
    <widgets>
        <container style="zcrm-intro"><label text="${contactRow?.organizationName ?: ((contactRow?.firstName ?: '') + ' ' + (contactRow?.lastName ?: '')).trim() ?: partyId}" type="h3"/>
            <label text="Contact history and linked CRM records." type="p"/><link url="../Contacts" text="Back to contacts"/></container>
        <container style="zcrm-metrics zcrm-reference-metrics">
            <container style="zcrm-metric"><label text="Linked leads" type="span"/><label text="${linkedLeads.size()}" type="h4"/></container>
            <container style="zcrm-metric"><label text="Opportunities" type="span"/><label text="${linkedOpportunities.size()}" type="h4"/></container>
            <container style="zcrm-metric"><label text="Activities" type="span"/><label text="${linkedActivities.size()}" type="h4"/></container>
        </container>
        <container-box><box-header title="Contact details"/><box-body>
            <label text="Email: ${contactRow?.emailAddress ?: '—'}" type="p"/>
            <label text="Phone: ${contactRow?.phoneNumber ?: '—'}" type="p"/>
        </box-body></container-box>
        <container-box><box-header title="Leads"/><box-body>
            <section name="NoLinkedLeads" condition="linkedLeads.isEmpty()"><widgets><label text="No converted leads linked to this contact." type="p"/></widgets></section>
            <form-list name="ContactLeads" list="linkedLeads" skip-form="true">
                <field name="leadId"><default-field title="Lead"><link url="../EditLead" text="${firstName} ${lastName ?: ''}" parameter-map="[leadId:leadId]"/></default-field></field>
                <field name="leadSourceId"><default-field title="Original source"><display/></default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
            </form-list>
        </box-body></container-box>
        <container-box><box-header title="Opportunities"/><box-body>
            <section name="NoLinkedOpps" condition="linkedOpportunities.isEmpty()"><widgets><label text="No opportunities linked to this contact." type="p"/></widgets></section>
            <form-list name="ContactOpps" list="linkedOpportunities" skip-form="true">
                <field name="salesOpportunityId"><default-field title="Opportunity"><link url="../EditOpportunity" text="${opportunityName}" parameter-map="[salesOpportunityId:salesOpportunityId]"/></default-field></field>
                <field name="estimatedAmount"><default-field title="Amount"><display format="#,##,##0"/></default-field></field>
                <field name="stageName"><default-field title="Stage"><display/></default-field></field>
            </form-list>
        </box-body></container-box>
        <container-box><box-header title="Activity history"/><box-toolbar>
            <section name="ContactNote_write" condition="modCanWrite"><widgets>
                <container-dialog id="ContactNoteDialog" button-text="Add Note">
                    <form-single name="ContactNoteForm" transition="addNote">
                        <field name="partyId"><default-field><hidden default-value="${partyId}"/></default-field></field>
                        <field name="subject"><default-field title="Title"><text-line size="36" maxlength="100"/></default-field></field>
                        <field name="description"><default-field title="Note"><text-area rows="4" cols="45"/></default-field></field>
                        <field name="submitButton"><default-field title="Save note"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <section name="NoLinkedActivities" condition="linkedActivities.isEmpty()"><widgets><label text="No activities linked to this contact." type="p"/></widgets></section>
            <form-list name="ContactActivities" list="linkedActivities" skip-form="true">
                <field name="activityDate"><default-field title="Date"><display format="dd MMM yyyy HH:mm"/></default-field></field>
                <field name="activityType"><default-field title="Type"><display/></default-field></field>
                <field name="subject"><default-field><link url="../ActivityDetail" text="${subject}" parameter-map="[activityId:activityId]"/></default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
