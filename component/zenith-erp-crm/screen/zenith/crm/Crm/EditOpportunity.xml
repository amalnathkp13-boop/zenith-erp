<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Opportunity Detail" default-menu-include="false">
    <parameter name="salesOpportunityId" required="true"/>
    <transition name="addNote">
        <actions>
            <if condition="ec.web.request.method != 'POST'"><return error="true" message="Submit the note form to save a note."/></if>
            <service-call name="zenith.crm.CrmServices.log#Activity"
                          in-map="[activityType:'Note', subject:subject, description:description, salesOpportunityId:salesOpportunityId]"/>
        </actions>
        <default-response url="."/><error-response url="."/>
    </transition>
    <transition name="updateOpportunity">
        <service-call name="zenith.crm.CrmServices.update#Opportunity"/>
        <default-response url="."/><error-response url="."/>
    </transition>
    <transition name="advanceStage">
        <service-call name="zenith.crm.CrmServices.advance#OpportunityStage"/>
        <default-response url="."/><error-response url="."/>
    </transition>
    <transition name="scheduleActivity">
        <service-call name="zenith.crm.CrmServices.schedule#Activity"/>
        <default-response url="."/><error-response url="."/>
    </transition>
    <actions>
        <entity-find-one entity-name="mantle.sales.opportunity.SalesOpportunity" value-field="opp"/>
        <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
        <if condition="!opp || !activeOrg || activeOrg == '_NA_' || opp.organizationPartyId != activeOrg">
            <return error="true" message="Opportunity not found for your organization."/>
        </if>
        <entity-find entity-name="mantle.sales.opportunity.SalesOpportunityStage" list="stages"><order-by field-name="sequenceNum"/></entity-find>
        <entity-find entity-name="zenith.erp.crm.CrmActivity" list="activities"><econdition field-name="organizationPartyId" from="activeOrg"/><econdition field-name="salesOpportunityId"/><order-by field-name="-activityDate"/></entity-find>
        <entity-find entity-name="zenith.erp.crm.CrmAuditEvent" list="auditEvents"><econdition field-name="organizationPartyId" from="activeOrg"/><econdition field-name="recordType" value="Opportunity"/><econdition field-name="recordId" from="salesOpportunityId"/><order-by field-name="-eventDate"/></entity-find>
    </actions>
    <widgets>
        <container style="zcrm-intro"><label text="${opp.opportunityName}" type="h3"/><label text="Opportunity details, stage and history." type="p"/><link url="../Pipeline" text="Back to pipeline"/></container>
        <container style="zcrm-metrics zcrm-reference-metrics">
            <container style="zcrm-metric"><label text="Amount" type="span"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(opp.estimatedAmount ?: 0, '#,##,##0'))}" type="h4"/></container>
            <container style="zcrm-metric"><label text="Original source" type="span"/><label text="${opp.leadSourceId ?: 'Unknown'}" type="h4"/></container>
            <container style="zcrm-metric"><label text="Expected close" type="span"/><label text="${opp.estimatedCloseDate ? ec.l10n.format(opp.estimatedCloseDate, 'dd MMM yyyy') : 'Not set'}" type="h4"/></container>
        </container>
        <container-row><row-col lg="6"><container-box><box-header title="Forecast"/><box-body>
            <form-single name="OpportunityForm" map="opp" transition="updateOpportunity">
                <field name="salesOpportunityId"><default-field><hidden/></default-field></field>
                <field name="opportunityName"><default-field title="Opportunity"><text-line size="36"/></default-field></field>
                <field name="estimatedAmount"><default-field title="Amount"><text-line size="16"/></default-field></field>
                <field name="estimatedProbability"><default-field title="Probability (0–1)"><text-line size="8"/></default-field></field>
                <field name="estimatedCloseDate"><default-field title="Expected close"><date-time type="date"/></default-field></field>
                <field name="submitButton"><conditional-field name="edit_write" condition="modCanWrite" title="Save forecast"><submit/></conditional-field><default-field><label text="View only" type="span"/></default-field></field>
            </form-single>
            <label text="Lead: ${opp.leadId ?: 'Not linked'} · Campaign: ${opp.campaignId ?: 'None'}" type="p"/>
            <label text="UTM: ${opp.utmSource ?: '—'} / ${opp.utmMedium ?: '—'} / ${opp.utmCampaign ?: '—'}" type="p"/>
        </box-body></container-box></row-col>
        <row-col lg="6"><container-box><box-header title="Stage and outcome"/><box-body>
            <form-single name="OpportunityStageForm" transition="advanceStage">
                <field name="salesOpportunityId"><default-field><hidden default-value="${salesOpportunityId}"/></default-field></field>
                <field name="opportunityStageId"><default-field title="Move to stage"><drop-down><list-options list="stages" key="${opportunityStageId}" text="${description}"/></drop-down></default-field></field>
                <field name="lostReason"><default-field title="Lost reason (required when lost)"><text-line size="36"/></default-field></field>
                <field name="confirmOutcome"><default-field title="Outcome confirmation"><drop-down><option key="N" text="Keep open"/><option key="Y" text="Confirm Won or Lost"/></drop-down></default-field></field>
                <field name="submitButton"><conditional-field name="stage_write" condition="modCanWrite" title="Save stage"><submit/></conditional-field><default-field><label text="View only" type="span"/></default-field></field>
            </form-single>
            <label text="Closing an opportunity requires confirmation. Lost opportunities require a reason." type="p"/>
        </box-body></container-box></row-col></container-row>
        <container-box><box-header title="Activities"/><box-toolbar>
            <section name="ScheduleWrite" condition="modCanWrite"><widgets>
                <container-dialog id="OppActivityDialog" button-text="Schedule Activity">
                    <form-single name="OppActivityForm" transition="scheduleActivity">
                        <field name="salesOpportunityId"><default-field><hidden default-value="${salesOpportunityId}"/></default-field></field>
                        <field name="activityType"><default-field title="Type"><drop-down><option key="Call"/><option key="Email"/><option key="Meeting"/><option key="Demo"/><option key="Task"/><option key="FollowUp"/><option key="SiteVisit"/></drop-down></default-field></field>
                        <field name="subject"><default-field><text-line size="36"/></default-field></field>
                        <field name="dueDate"><default-field title="Due"><date-time type="date-time"/></default-field></field>
                        <field name="priority"><default-field><drop-down><option key="Normal"/><option key="High"/><option key="Low"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Schedule"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                <container-dialog id="OpportunityNoteDialog" button-text="Add Note">
                    <form-single name="OpportunityNoteForm" transition="addNote">
                        <field name="salesOpportunityId"><default-field><hidden default-value="${salesOpportunityId}"/></default-field></field>
                        <field name="subject"><default-field title="Title"><text-line size="36" maxlength="100"/></default-field></field>
                        <field name="description"><default-field title="Note"><text-area rows="4" cols="45"/></default-field></field>
                        <field name="submitButton"><default-field title="Save note"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <section name="NoOppActivities" condition="activities.isEmpty()"><widgets><label text="No activities linked to this opportunity." type="p"/></widgets></section>
            <form-list name="OpportunityActivities" list="activities" skip-form="true">
                <field name="activityDate"><default-field title="Created"><display format="dd MMM yyyy HH:mm"/></default-field></field>
                <field name="subject"><default-field><link url="../ActivityDetail" text="${subject}" parameter-map="[activityId:activityId]"/></default-field></field>
                <field name="activityType"><default-field title="Type"><display/></default-field></field>
                <field name="dueDate"><default-field title="Due"><display format="dd MMM yyyy HH:mm"/></default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
                <field name="outcome"><default-field><display/></default-field></field>
            </form-list>
        </box-body></container-box>
        <container-box><box-header title="Stage history"/><box-body>
            <section name="NoStageEvents" condition="auditEvents.isEmpty()"><widgets><label text="No stage changes recorded yet." type="p"/></widgets></section>
            <form-list name="OpportunityAudit" list="auditEvents" skip-form="true">
                <field name="eventDate"><default-field title="When"><display format="dd MMM yyyy HH:mm"/></default-field></field>
                <field name="previousValue"><default-field title="From"><display/></default-field></field>
                <field name="newValue"><default-field title="To"><display/></default-field></field>
                <field name="actorUserId"><default-field title="By"><display/></default-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
