<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Activity Detail" default-menu-include="false">
    <parameter name="activityId" required="true"/>
    <transition name="completeActivity"><service-call name="zenith.crm.CrmServices.complete#Activity"/>
        <default-response url="."/><error-response url="."/></transition>
    <transition name="rescheduleActivity"><service-call name="zenith.crm.CrmServices.reschedule#Activity"/>
        <default-response url="."/><error-response url="."/></transition>
    <transition name="cancelActivity"><service-call name="zenith.crm.CrmServices.cancel#Activity"/>
        <default-response url="."/><error-response url="."/></transition>
    <transition name="reassignActivity"><service-call name="zenith.crm.CrmServices.reassign#Activity"/>
        <default-response url="."/><error-response url="."/></transition>
    <actions>
        <entity-find-one entity-name="zenith.erp.crm.CrmActivity" value-field="activity"/>
        <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
        <if condition="!activity || !activeOrg || activeOrg == '_NA_' || activity.organizationPartyId != activeOrg">
            <return error="true" message="Activity not found for your organization."/>
        </if>
        <set field="mayAssign" from="modCanWrite &amp;&amp; activity.statusId == 'Scheduled' &amp;&amp; ['ADMIN','ZENITH_ADMIN','ZENITH_SALES_MGR'].any { ec.user.isInGroup(it) }"/>
        <set field="mayEdit" from="mayAssign || (modCanWrite &amp;&amp; activity.statusId == 'Scheduled' &amp;&amp; activity.assignedToUserId == ec.user.userId)"/>
        <set field="inboxStatus" from="null"/>
        <if condition="activity.dueDate &amp;&amp; activity.assignedToUserId &amp;&amp; (activity.assignedToUserId == ec.user.userId || ['ADMIN','ZENITH_ADMIN','ZENITH_SALES_MGR'].any { ec.user.isInGroup(it) })">
            <entity-find-one entity-name="zenith.erp.crm.CrmFollowUpReminder" value-field="reminder" disable-authz="true">
                <field-map field-name="activityId"/><field-map field-name="assignedToUserId" from="activity.assignedToUserId"/>
                <field-map field-name="dueDate" from="activity.dueDate"/>
            </entity-find-one>
            <set field="inboxStatus" from="reminder?.notificationMessageId ? ('Delivered to the assignee’s ERP inbox on ' + ec.l10n.format(reminder.processedAt,'dd MMM yyyy HH:mm')) :
                (reminder ? 'No inbox reminder was sent for this due time.' : (activity.statusId == 'Scheduled' ? 'Awaiting the due-time reminder.' : null))"/>
        </if>
        <if condition="mayAssign"><service-call name="zenith.crm.CrmServices.get#AssignmentCandidates" in-map="[recordType:'Activity']" out-map="available"/></if>
        <entity-find entity-name="zenith.erp.crm.CrmAuditEvent" list="auditEvents"><econdition field-name="organizationPartyId" from="activeOrg"/><econdition field-name="recordType" value="Activity"/><econdition field-name="recordId" from="activityId"/><order-by field-name="-eventDate"/></entity-find>
    </actions>
    <widgets>
        <container style="zcrm-intro"><label text="${activity.subject}" type="h3"/><label text="${activity.activityType} · ${activity.statusId ?: 'Completed'}" type="p"/><link url="../Activities" text="Back to activities"/></container>
        <container style="zcrm-metrics zcrm-reference-metrics">
            <container style="zcrm-metric"><label text="Due" type="span"/><label text="${activity.dueDate ? ec.l10n.format(activity.dueDate, 'dd MMM yyyy HH:mm') : 'Not scheduled'}" type="h4"/><label condition="inboxStatus" text="${inboxStatus}" type="span"/></container>
            <container style="zcrm-metric"><label text="Owner" type="span"/><label text="${activity.assignedToUserId ?: activity.performedByUserId ?: 'Unassigned'}" type="h4"/></container>
            <container style="zcrm-metric"><label text="Priority" type="span"/><label text="${activity.priority ?: 'Normal'}" type="h4"/></container>
        </container>
        <container-box><box-header title="Linked record and notes"/><box-body>
            <label text="Lead: ${activity.leadId ?: '—'} · Opportunity: ${activity.salesOpportunityId ?: '—'} · Contact: ${activity.contactPartyId ?: '—'}" type="p"/>
            <label text="${activity.description ?: 'No notes'}" type="p"/>
            <label text="Outcome: ${activity.outcome ?: 'Pending'}" type="p"/>
        </box-body></container-box>
        <section name="ActivityActions" condition="mayEdit"><widgets>
            <container-row><row-col lg="6"><container-box><box-header title="Complete activity"/><box-body>
                <form-single name="CompleteActivityForm" transition="completeActivity">
                    <field name="activityId"><default-field><hidden default-value="${activityId}"/></default-field></field>
                    <field name="outcome"><default-field title="Outcome"><text-line size="32"/></default-field></field>
                    <field name="description"><default-field title="Notes"><text-area rows="3" cols="40"/></default-field></field>
                    <field name="durationMinutes"><default-field title="Duration (minutes)"><text-line size="8"/></default-field></field>
                    <field name="nextFollowUpDate"><default-field title="Next follow-up (optional)"><date-time type="date-time"/></default-field></field>
                    <field name="submitButton"><default-field title="Complete"><submit/></default-field></field>
                </form-single>
            </box-body></container-box></row-col>
            <row-col lg="6"><container-box><box-header title="Reschedule"/><box-body>
                <form-single name="RescheduleActivityForm" transition="rescheduleActivity">
                    <field name="activityId"><default-field><hidden default-value="${activityId}"/></default-field></field>
                    <field name="dueDate"><default-field title="New due date"><date-time type="date-time"/></default-field></field>
                    <field name="note"><default-field title="Reason (optional)"><text-area rows="2" cols="40"/></default-field></field>
                    <field name="submitButton"><default-field title="Reschedule"><submit/></default-field></field>
                </form-single>
            </box-body></container-box></row-col></container-row>
            <container-row>
                <row-col lg="6"><section name="AssignActivity" condition="mayAssign &amp;&amp; available.candidates"><widgets>
                    <container-box><box-header title="Assign follow-up"/><box-body>
                        <form-single name="ReassignActivityForm" transition="reassignActivity">
                            <field name="activityId"><default-field><hidden default-value="${activityId}"/></default-field></field>
                            <field name="assignedToUserId"><default-field title="Team member"><drop-down allow-empty="true" current="selected">
                                <list-options list="available.candidates" key="${userId}" text="${userFullName ?: username}"/>
                            </drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Assign"><submit/></default-field></field>
                        </form-single>
                    </box-body></container-box>
                </widgets></section></row-col>
                <row-col lg="6"><container-dialog id="CancelActivityDialog" button-text="Cancel follow-up">
                    <form-single name="CancelActivityForm" transition="cancelActivity">
                        <field name="activityId"><default-field><hidden default-value="${activityId}"/></default-field></field>
                        <field name="note"><default-field title="Reason for cancellation"><text-area rows="2" cols="40"/></default-field></field>
                        <field name="submitButton"><default-field title="Confirm cancellation"><submit/></default-field></field>
                    </form-single>
                </container-dialog></row-col>
            </container-row>
        </widgets></section>
        <container-box><box-header title="Change history"/><box-body>
            <section name="NoChanges" condition="auditEvents.isEmpty()"><widgets><label text="No changes recorded." type="p"/></widgets></section>
            <form-list name="ActivityAudit" list="auditEvents" skip-form="true">
                <field name="eventDate"><default-field title="When"><display format="dd MMM yyyy HH:mm"/></default-field></field>
                <field name="action"><default-field title="Change"><display/></default-field></field>
                <field name="actorUserId"><default-field title="Changed by"><display/></default-field></field>
                <field name="previousValue"><default-field title="Previous value"><display/></default-field></field>
                <field name="newValue"><default-field title="New value"><display/></default-field></field>
                <field name="note"><default-field><display/></default-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
