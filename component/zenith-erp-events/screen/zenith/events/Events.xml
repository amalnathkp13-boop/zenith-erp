<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Events" default-menu-index="24">

    <always-actions>
        <set field="html_title" value="Events"/>
    </always-actions>

    <subscreens default-item="AllEvents"/>

    <transition name="goMarketing"><default-response url="../marketing/Campaigns"/></transition>
    <transition name="goCrm"><default-response url="../Crm/Leads"/></transition>
    <transition name="goContacts"><default-response url="../Contacts/FindContact"/></transition>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
