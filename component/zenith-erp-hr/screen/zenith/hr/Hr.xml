<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="HR" default-menu-index="7">

    <always-actions>
        <set field="html_title" value="Human Resources"/>
    </always-actions>

    <subscreens default-item="HrDashboard">
        <subscreens-item name="HrDashboard" location="component://zenith-erp-hr/screen/zenith/hr/Hr/HrDashboard.xml" menu-title="Dashboard"/>
        <subscreens-item name="MyProfile" location="component://zenith-erp-hr/screen/zenith/hr/Hr/MyProfile.xml" menu-title="My Profile"/>
        <subscreens-item name="MyPayslips" location="component://zenith-erp-hr/screen/zenith/hr/Hr/MyPayslips.xml" menu-title="My Payslips"/>
        <subscreens-item name="MyLeaves" location="component://zenith-erp-hr/screen/zenith/hr/Hr/MyLeaves.xml" menu-title="My Leaves"/>
        <subscreens-item name="MyAttendance" location="component://zenith-erp-hr/screen/zenith/hr/Hr/MyAttendance.xml" menu-title="My Attendance"/>
    </subscreens>

    <transition name="goPayroll"><default-response url="../payroll/PayrollRuns"/></transition>
    <transition name="goAttendance"><default-response url="../attendance/AllAttendance"/></transition>
    <transition name="goTimeOff"><default-response url="../timeoff/AllLeaves"/></transition>
    <transition name="goRecruitment"><default-response url="../recruitment/Applications"/></transition>
    <transition name="goExpenses"><default-response url="../expenses/AllReports"/></transition>
    <transition name="goContacts"><default-response url="../Contacts/FindContact"/></transition>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
