<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <!-- Work contact details and salary agreements belong to this employment, not to every role its person holds. -->
    <extend-entity entity-name="Employee" package="zenith.erp.hr">
        <field name="hrDisplayName" type="text-medium"/>
        <field name="workEmail" type="text-medium"/>
        <field name="workPhone" type="text-short"/>
        <field name="agreedSalaryType" type="text-short"/>
        <field name="agreedSalary" type="currency-amount"/>
    </extend-entity>
    <extend-entity entity-name="Designation" package="zenith.erp.hr">
        <field name="organizationPartyId" type="id"/>
    </extend-entity>
    <extend-entity entity-name="LeaveApplication" package="zenith.erp.hr">
        <field name="appliedDate" type="date"/>
        <field name="halfDay" type="text-indicator"/>
    </extend-entity>
    <extend-entity entity-name="EmployeeDocument" package="zenith.erp.hr">
        <field name="fileSize" type="number-integer"/>
    </extend-entity>
    <extend-entity entity-name="AttendanceRecord" package="zenith.erp.attendance">
        <field name="hrEmployeeId" type="id"/>
    </extend-entity>
    <entity entity-name="WorkspaceSettings" table-name="ZENITH_HR_WORKSPACE" package="zenith.erp.hr">
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="settingsJson" type="text-very-long"/>
        <field name="recordedAtJson" type="text-long"/>
        <field name="auditJson" type="text-very-long"/>
        <relationship type="one" related="mantle.party.Organization"><key-map field-name="organizationPartyId" related="partyId"/></relationship>
    </entity>
    <!-- A manually reviewed salary register. Payroll-run payslips remain owned by the Payroll module. -->
    <entity entity-name="SalaryRegister" table-name="ZENITH_HR_SALARY_REGISTER" package="zenith.erp.hr">
        <field name="employeeId" type="id" is-pk="true"/>
        <field name="salaryMonth" type="text-short" is-pk="true"/>
        <field name="salaryType" type="text-short"/>
        <field name="dailyRate" type="currency-amount"/>
        <field name="paidDays" type="number-decimal"/>
        <field name="basic" type="currency-amount"/>
        <field name="allowance" type="currency-amount"/>
        <field name="deduction" type="currency-amount"/>
        <field name="recordStatus" type="text-short"/>
        <field name="paid" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.hr.Employee"/>
    </entity>
</entities>
