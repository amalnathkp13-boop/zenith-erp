<?xml version="1.0" encoding="UTF-8"?>
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <!-- ZE-INV-001 f/u (parallel to the Product.mrpAmount guard): a negative per-mode POS price
         (Wholesale / Custom / Employee) would make a POS line total negative — same failure mode as a
         negative MRP. Central pre-service guard on EVERY entity-auto write of PosProductModePrice so no
         path (bulk wholesale import, REST/API, direct service) can persist one. when="pre-service" aborts
         BEFORE the write (a post-service <return error> does NOT roll back when the caller runs
         begin-transaction="false"). All three of create#/update#/store# are covered because store# does
         NOT delegate to create#/update#. Fires only when price is actually being written (null -> no-op,
         e.g. a thresholdQty-only update). NOTE: the grid's set#PosModePrice routes price<=0 to "clear the
         mode" (never reaches store# with a negative), so this backstops DIRECT entity writes; the grid
         itself rejects a negative up front (ProductPricing.savePrices) for a clear message. -->
    <seca id="ZenithPosModePriceNonNegCreate" service="create#zenith.erp.pos.PosProductModePrice" when="pre-service" run-on-error="false" priority="1">
        <condition><expression>price != null &amp;&amp; (price as java.math.BigDecimal) &lt; 0G</expression></condition>
        <actions><return error="true" message="A product's Wholesale / Custom price can't be negative — enter a positive amount (or clear it to use MRP)."/></actions>
    </seca>
    <seca id="ZenithPosModePriceNonNegUpdate" service="update#zenith.erp.pos.PosProductModePrice" when="pre-service" run-on-error="false" priority="1">
        <condition><expression>price != null &amp;&amp; (price as java.math.BigDecimal) &lt; 0G</expression></condition>
        <actions><return error="true" message="A product's Wholesale / Custom price can't be negative — enter a positive amount (or clear it to use MRP)."/></actions>
    </seca>
    <seca id="ZenithPosModePriceNonNegStore" service="store#zenith.erp.pos.PosProductModePrice" when="pre-service" run-on-error="false" priority="1">
        <condition><expression>price != null &amp;&amp; (price as java.math.BigDecimal) &lt; 0G</expression></condition>
        <actions><return error="true" message="A product's Wholesale / Custom price can't be negative — enter a positive amount (or clear it to use MRP)."/></actions>
    </seca>
</secas>
