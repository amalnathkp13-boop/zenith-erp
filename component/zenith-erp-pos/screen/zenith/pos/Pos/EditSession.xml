<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Session Detail" default-menu-index="3" default-menu-include="false">

    <parameter name="sessionId" required="true"/>

    <transition name="createTransaction" begin-transaction="true">
        <actions>
            <!-- Cross-tenant write-IDOR guard: only the owning org (ADMIN exempt) may mutate this session. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.pos.PosSession', idField:'sessionId', idValue:sessionId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="zenith.pos.PosServices.create#PosTransaction" in-map="context"/>
        </actions>
        <default-response url="../EditTransaction"/>
    </transition>
    <transition name="closeSession" begin-transaction="true">
        <actions>
            <!-- Cross-tenant write-IDOR guard: only the owning org (ADMIN exempt) may mutate this session. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.pos.PosSession', idField:'sessionId', idValue:sessionId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="zenith.pos.PosServices.close#PosSession"
                          in-map="[sessionId:sessionId, closingCash:closingCash]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="saveDenomination" begin-transaction="true">
        <actions>
            <!-- Cross-tenant write-IDOR guard: only the owning org (ADMIN exempt) may mutate this session. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.pos.PosSession', idField:'sessionId', idValue:sessionId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="zenith.pos.PosServices.save#CashDenomination"
                          in-map="[sessionId:sessionId, denomination:denomination, denominationCount:denominationCount]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="editTransaction"><default-response url="../EditTransaction"/></transition>
    <transition name="goSessions"><default-response url="../PosSessions"/></transition>
    <transition name="goTerminal"><default-response url="../Terminal"/></transition>
    <transition name="goTransactions"><default-response url="../PosTransactions"/></transition>
    <transition name="goDashboard"><default-response url="../Dashboard"/></transition>

    <actions>
        <!-- Cross-tenant IDOR render guard: only the owning org (ADMIN exempt) may open a session.
             Load NOTHING when blocked; widgets show a plain no-access panel instead of another tenant's data. -->
        <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_acc"
                      in-map="[entityName:'zenith.erp.pos.PosSession', idField:'sessionId', idValue:sessionId, orgField:'organizationPartyId']"/>
        <set field="noAccess" from="!_acc.allowed"/>
        <if condition="_acc.allowed">
        <entity-find-one entity-name="zenith.erp.pos.PosSession" value-field="session"/>
        <entity-find-one entity-name="zenith.erp.pos.PosTerminal" value-field="terminal">
            <field-map field-name="terminalId" from="session.terminalId"/></entity-find-one>
        <entity-find entity-name="zenith.erp.pos.PosTransaction" list="txnList">
            <econdition field-name="sessionId"/>
            <order-by field-name="-entryDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.pos.CashDenomination" list="denomList">
            <econdition field-name="sessionId"/>
            <order-by field-name="-denomination"/>
        </entity-find>
        <set field="currSymbol" from="'₹'"/>
        <script>try { def cs = ec.entity.find("zenith.erp.base.CompanySettings").condition("organizationPartyId", session?.organizationPartyId).condition("settingKey","CURRENCY_UOM_ID").one(); def cur = cs?.settingValue; if (cur=='INR') currSymbol='₹'; else if (cur=='USD') currSymbol='$'; else if (cur=='EUR') currSymbol='€'; else if (cur=='GBP') currSymbol='£'; else if (cur) currSymbol=cur+' ' } catch (Exception e) {}</script>
        <set field="txnRows" from="txnList"/>
        <script><![CDATA[
            def rmode = java.math.RoundingMode.HALF_UP
            txnRows = txnList.collect { t ->
                def m = new LinkedHashMap(t)
                boolean inter = ((t.igstTotal ?: 0) as BigDecimal) > 0 ||
                    (t.originRegionGeoId && t.destinationRegionGeoId && t.originRegionGeoId != t.destinationRegionGeoId)
                def tax = (t.totalTaxAmount ?: 0) as BigDecimal
                if (inter) { m.igstTotal = tax; m.cgstTotal = 0G; m.sgstTotal = 0G }
                else { def h = (tax / 2).setScale(2, rmode); m.cgstTotal = h; m.sgstTotal = tax - h; m.igstTotal = 0G }
                m.isB2b = (t.customerGstin) ? 'Yes' : 'No'
                m
            }
        ]]></script>
        </if>
    </actions>

    <widgets>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
            <link url="goTransactions" text="Transactions" icon="fa fa-list" btn-type="primary" style="q-btn--dense"/>
            <link url="goSessions" text="All Sessions" icon="fa fa-clock-o" btn-type="info" style="q-btn--dense"/>
            <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
        </container>

        <!-- Cross-tenant / missing session — plain notice, never another org's session data -->
        <section name="NoAccess">
            <condition><expression>noAccess</expression></condition>
            <widgets>
                <container style="zenith-card q-pa-lg bg-white shadow-1 border-radius-md q-mt-md text-center">
                    <label text="That session isn't part of your account." type="h5" style="text-grey-8 q-mb-xs"/>
                    <label text="It may belong to another organization, or it may not exist. Use the links above to return to your list." type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <section name="TheRecord">
        <condition><expression>!noAccess</expression></condition>
        <widgets>
        <!-- Session Summary -->
        <container-row>
            <row-col lg="3" md="6">
                <container-box><box-header title="Session Info"/>
                <box-body>
                    <form-single name="SessionInfo" map="session">
                        <field name="sessionId"><default-field title="Session"><display/></default-field></field>
                        <field name="terminalName"><default-field title="Terminal"><display text="${terminal?.terminalName}"/></default-field></field>
                        <field name="openDate"><default-field title="Opened"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>
            <row-col lg="3" md="6">
                <container-box><box-header title="Cash Summary"/>
                <box-body>
                    <form-single name="CashInfo" map="session">
                        <field name="openingCash"><default-field title="Opening"><display format="₹#,##,##0.00"/></default-field></field>
                        <field name="totalSales"><default-field title="Sales"><display format="₹#,##,##0.00"/></default-field></field>
                        <field name="totalReturns"><default-field title="Returns"><display format="₹#,##,##0.00"/></default-field></field>
                        <field name="totalTransactions"><default-field title="Transactions"><display/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>
            <row-col lg="3" md="6">
                <container-box><box-header title="Closing"/>
                <box-body>
                    <form-single name="ClosingInfo" map="session">
                        <field name="closingCash"><default-field title="Closing Cash"><display format="₹#,##,##0.00"/></default-field></field>
                        <field name="expectedCash"><default-field title="Expected"><display format="₹#,##,##0.00"/></default-field></field>
                        <field name="cashDifference"><default-field title="Difference"><display format="₹#,##,##0.00"/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>
            <row-col lg="3" md="6">
                <container-box><box-header title="Actions"/>
                <box-body>
                    <section name="OpenSessionActions" condition="session.statusId == 'PsOpen' &amp;&amp; modCanWrite">
                        <widgets>
                            <container-dialog id="NewTxnDialog" button-text="New Transaction">
                                <form-single name="NewTxnForm" transition="createTransaction">
                                    <field name="sessionId"><default-field><hidden/></default-field></field>
                                    <field name="transactionType"><default-field title="Type">
                                        <drop-down><option key="Sale"/><option key="Return"/></drop-down></default-field></field>
                                    <field name="customerName"><default-field title="Customer Name"><text-line size="25"/></default-field></field>
                                    <field name="customerGstin"><default-field title="Customer GSTIN (B2B)"><text-line size="18"/></default-field></field>
                                    <field name="placeOfSupplyStateCode"><default-field title="Place of Supply State Code"><text-line size="4"/></default-field></field>
                                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                            <container-dialog id="CloseSessionDialog" button-text="Close Session">
                                <form-single name="CloseSessionForm" transition="closeSession">
                                    <field name="sessionId"><default-field><hidden/></default-field></field>
                                    <field name="closingCash"><default-field title="Closing Cash (${currSymbol})"><text-line size="12"/></default-field></field>
                                    <field name="submitButton"><default-field title="Close Session"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                        </widgets>
                    </section>
                </box-body></container-box>
            </row-col>
        </container-row>

        <!-- Transactions -->
        <container-box>
            <box-header title="Transactions"/>
            <box-body>
                <form-list name="TxnList" list="txnRows" skip-form="true">
                    <field name="transactionId"><default-field title="ID">
                        <link url="editTransaction" text="${transactionId}" link-type="anchor"
                              parameter-map="[transactionId:transactionId]"/></default-field></field>
                    <field name="transactionNumber"><default-field title="Number"><display/></default-field></field>
                    <field name="transactionType"><default-field title="Type"><display/></default-field></field>
                    <field name="entryDate"><default-field title="Time"><display format="HH:mm:ss"/></default-field></field>
                    <field name="customerName"><default-field title="Customer"><display/></default-field></field>
                    <field name="isB2b"><default-field title="B2B"><display/></default-field></field>
                    <field name="subtotal"><default-field title="Subtotal"><display format="#,##,##0.00"/></default-field></field>
                    <field name="cgstTotal"><default-field title="CGST"><display format="#,##0.00"/></default-field></field>
                    <field name="sgstTotal"><default-field title="SGST"><display format="#,##0.00"/></default-field></field>
                    <field name="igstTotal"><default-field title="IGST"><display format="#,##0.00"/></default-field></field>
                    <field name="grandTotal"><default-field title="Total"><display format="#,##,##0.00"/></default-field></field>
                    <field name="payableAmount"><default-field title="Payable"><display format="#,##,##0.00"/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <!-- Cash Denomination (for session close) -->
        <container-box>
            <box-header title="Cash Denomination Count"/>
            <box-toolbar>
                <section name="AddDenom_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="AddDenomDialog" button-text="Add Denomination">
                    <form-single name="AddDenomForm" transition="saveDenomination">
                        <field name="sessionId"><default-field><hidden/></default-field></field>
                        <field name="denomination"><default-field title="Denomination (${currSymbol})">
                            <drop-down>
                                <option key="2000" text="₹2000"/>
                                <option key="500" text="₹500"/>
                                <option key="200" text="₹200"/>
                                <option key="100" text="₹100"/>
                                <option key="50" text="₹50"/>
                                <option key="20" text="₹20"/>
                                <option key="10" text="₹10"/>
                                <option key="5" text="₹5"/>
                                <option key="2" text="₹2"/>
                                <option key="1" text="₹1"/>
                            </drop-down></default-field></field>
                        <field name="denominationCount"><default-field title="Count"><text-line size="5"/></default-field></field>
                        <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="DenomList" list="denomList" skip-form="true">
                    <field name="denomination"><default-field title="Denomination (${currSymbol})"><display format="₹#,##0"/></default-field></field>
                    <field name="denominationCount"><default-field title="Count"><display/></default-field></field>
                    <field name="amount"><default-field title="Amount (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
        </widgets>
        </section>
    </widgets>
</screen>
