<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Expenses" default-menu-index="8">

    <subscreens default-item="ExpenseEntry"/>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_expenses" class="pos-reference-help" style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#129534; Expenses &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Record money <b>spent running the shop</b> &mdash; supplies, transport, repairs and so on.<br><b>1</b>&nbsp;On <b>Expense Entry</b>, pick a <b>category</b>, enter the amount, a note and the payment mode, then <b>Save Expense</b>.<br><b>2</b>&nbsp;Use the date / category filter to find past expenses; the boxes show your totals.<br><b>3</b>&nbsp;Open the <b>Expense Report</b> tab for a breakdown by category and date.</div></details>]]></text></render-mode>
        <subscreens-panel id="expense-tabs" type="tab"/>
    </widgets>
</screen>
