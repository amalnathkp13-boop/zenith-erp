<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Cash Entry" default-menu-index="9">

    <!-- ZE-POS-008: the auto create#PosCashEntry accepted an empty/zero/negative Amount (entity field is
         not required) -> invalid cash-movement rows corrupting reconciliation. Validate before saving. -->
    <transition name="addCashIn">
        <actions>
            <script><![CDATA[amtVal = null; try { amtVal = amount ? new BigDecimal(amount.toString().trim()) : null } catch (Exception e) { amtVal = null }]]></script>
            <if condition="amtVal == null || amtVal &lt;= 0">
                <return error="true" message="Enter a valid Amount greater than 0 — the cash entry was not saved."/></if>
            <service-call name="zenith.pos.PosServices.record#PosCashEntry" in-map="[entryType:'CashIn', amount:amtVal, sessionId:sessionId, entryDate:entryDate, reason:reason, description:description, referenceNumber:referenceNumber]"/>
        </actions>
        <default-response url="."/></transition>
    <transition name="addCashOut">
        <actions>
            <script><![CDATA[amtVal = null; try { amtVal = amount ? new BigDecimal(amount.toString().trim()) : null } catch (Exception e) { amtVal = null }]]></script>
            <if condition="amtVal == null || amtVal &lt;= 0">
                <return error="true" message="Enter a valid Amount greater than 0 — the cash entry was not saved."/></if>
            <service-call name="zenith.pos.PosServices.record#PosCashEntry" in-map="[entryType:'CashOut', amount:amtVal, sessionId:sessionId, entryDate:entryDate, reason:reason, description:description, referenceNumber:referenceNumber]"/>
        </actions>
        <default-response url="."/></transition>
    <transition name="deleteCashEntry"><service-call name="delete#zenith.erp.pos.PosCashEntry"/>
        <default-response url="."/></transition>
    <transition name="goExpenses"><default-response url="../Expenses"/></transition>
    <transition name="goSessions"><default-response url="../PosSessions"/></transition>
    <transition name="goDashboard"><default-response url="../Dashboard"/></transition>
    <transition name="goTerminal"><default-response url="../Terminal"/></transition>
    <transition name="goDailySummary"><default-response url="../DailySummary"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.pos.PosSession" list="cashSessionList">
            <econdition field-name="organizationPartyId" from="posOrganizationPartyId"/>
            <econdition field-name="statusId" value="PsOpen"/>
            <order-by field-name="-openDate"/>
        </entity-find>
        <script>cashDefaultSession = cashSessionList.size() == 1 ? cashSessionList[0].sessionId : ''</script>
        <set field="sessionId" from="sessionId ?: cashDefaultSession"/>
        <set field="filterDate" from="filterDate ?: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')"/>
        <set field="filterThruDate" from="filterThruDate ?: filterDate"/>
        <set field="filterType" from="filterType ?: ''"/>
        <set field="searchText" from="searchText ?: ''"/>
        <!-- Match the displayed user-local dates, including fractional seconds and DST day lengths. -->
        <set field="dayStart" from="ec.l10n.parseTimestamp(filterDate + ' 00:00:00', 'yyyy-MM-dd HH:mm:ss')"/>
        <set field="dayEnd" from="ec.l10n.parseTimestamp(java.time.LocalDate.parse(filterThruDate).plusDays(1).toString() + ' 00:00:00', 'yyyy-MM-dd HH:mm:ss')"/>

        <entity-find entity-name="moqui.basic.Enumeration" list="reasonList">
            <econdition field-name="enumTypeId" value="PosCashReason"/>
            <order-by field-name="description"/>
        </entity-find>

        <!-- ZE-SHOP: scope cash entries to the selected shop's sessions (null = All Shops) -->
        <script>_shopSessions = null; try { def _sc = ec.service.sync().name("zenith.base.ShopServices.get#ActiveShopScope").parameter("includePosScope", true).call(); _shopSessions = _sc?.sessionIds } catch (Exception _e) {}</script>
        <entity-find entity-name="zenith.erp.pos.PosCashEntryView" list="cashEntryList">
            <econdition field-name="entryDate" operator="greater-equals" from="dayStart"/>
            <econdition field-name="entryDate" operator="less" from="dayEnd"/>
            <econdition field-name="entryType" from="filterType" ignore-if-empty="true"/>
            <order-by field-name="-entryDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="(ec.user.getPreference('ACTIVE_ORGANIZATION')) ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="sessionId" operator="in" from="_shopSessions" ignore-if-empty="true"/><!-- ZE-SHOP -->
        </entity-find>

        <script><![CDATA[
            def _fmt = com.zenith.Fmt.INSTANCE
            reasonDescMap = [:]; reasonList.each { reasonDescMap[it.enumId] = it.description }
            // client-side text search over reason label / notes / ref no. (re-filters the loaded day, no re-fetch)
            def stx = (searchText ?: '').trim().toLowerCase()
            if (stx) cashEntryList = cashEntryList.findAll { def rd = (reasonDescMap[it.reason] ?: it.reason ?: '').toString().toLowerCase();
                rd.contains(stx) || (it.description ?: '').toString().toLowerCase().contains(stx) || (it.referenceNumber ?: '').toString().toLowerCase().contains(stx) }
            def _in = cashEntryList.findAll { it.entryType == 'CashIn' }
            def _out = cashEntryList.findAll { it.entryType == 'CashOut' }
            totalCashIn = _in.sum { (it.amount ?: 0) as BigDecimal } ?: BigDecimal.ZERO
            totalCashOut = _out.sum { (it.amount ?: 0) as BigDecimal } ?: BigDecimal.ZERO
            netCash = totalCashIn - totalCashOut
            cashInCount = _in.size(); cashOutCount = _out.size()
            entryCount = cashEntryList.size()
            // display strings precomputed in Groovy (render-mode templates are FreeMarker/qvt, not Groovy)
            totalCashInStr = _fmt.inr(ec.l10n.format(totalCashIn, '#,##0.00'))
            totalCashOutStr = _fmt.inr(ec.l10n.format(totalCashOut, '#,##0.00'))
            netCashStr = _fmt.inr(ec.l10n.format(netCash, '#,##0.00'))
            netColor = (netCash < 0) ? '#DC2626' : '#111827'
        ]]></script>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_cashentry" class="pos-reference-help" style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128181; Cash Entry &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Record cash moving in or out of the drawer that is <b>not a sale</b>.<br><b>1</b>&nbsp;<b>Cash In</b> (left) &mdash; money added, e.g. a change fund or owner deposit.<br><b>2</b>&nbsp;<b>Cash Out</b> (right) &mdash; money taken out, e.g. a bank deposit or petty cash.<br><b>3</b>&nbsp;Pick a reason, enter the amount and press <b>Add</b>. Totals and <b>Net Cash</b> update below.</div></details>]]></text></render-mode>
        <container style="q-pa-md">
            <!-- Header: title + subtitle + actions -->
            <render-mode><text type="html,qvt"><![CDATA[<a id="ce-forms-top"></a>]]></text></render-mode>
            <container style="pos-reference-cash-header zsec-hdr q-mb-md">
                <container>
                    <label text="Cash Entry" type="h5" style="text-weight-bold q-my-none"/>
                    <label text="Record and manage all your cash transactions in one place" type="span" style="z-statdesc"/>
                </container>
                <container style="z-btnrow">
                    <link url="goDailySummary" text="View Cash Book" icon="fa fa-book" link-type="anchor" style="z-obtn"/>
                    <render-mode><text type="html,qvt"><![CDATA[<a href="#ce-forms" style="display:inline-flex;align-items:center;gap:6px;height:38px;padding:0 16px;background:#7C3AED;color:#fff;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none">&#43; New Cash Entry</a>]]></text></render-mode>
                </container>
            </container>

            <!-- 3 tinted stat cards -->
            <render-mode><text type="html,qvt" template="true"><![CDATA[
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;margin-bottom:22px;font-family:Inter,Segoe UI,Arial,sans-serif">
  <div style="background:#ECFDF5;border:1px solid #E5E7EB;border-radius:12px;padding:18px 20px;display:flex;gap:16px;align-items:center">
    <div style="width:44px;height:44px;border-radius:50%;background:#D1FAE5;color:#059669;display:flex;align-items:center;justify-content:center;flex:0 0 auto"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg></div>
    <div><div style="font-size:13px;font-weight:600;color:#059669">Total Cash In</div><div style="font-size:22px;font-weight:800;color:#059669;margin:1px 0">&#8377;${totalCashInStr}</div><div style="font-size:12px;color:#6B7280">${cashInCount} entries</div></div>
  </div>
  <div style="background:#FEF2F2;border:1px solid #E5E7EB;border-radius:12px;padding:18px 20px;display:flex;gap:16px;align-items:center">
    <div style="width:44px;height:44px;border-radius:50%;background:#FEE2E2;color:#DC2626;display:flex;align-items:center;justify-content:center;flex:0 0 auto"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg></div>
    <div><div style="font-size:13px;font-weight:600;color:#DC2626">Total Cash Out</div><div style="font-size:22px;font-weight:800;color:#DC2626;margin:1px 0">&#8377;${totalCashOutStr}</div><div style="font-size:12px;color:#6B7280">${cashOutCount} entries</div></div>
  </div>
  <div style="background:#F5F3FF;border:1px solid #E5E7EB;border-radius:12px;padding:18px 20px;display:flex;gap:16px;align-items:center">
    <div style="width:44px;height:44px;border-radius:50%;background:#EDE9FE;color:#7C3AED;display:flex;align-items:center;justify-content:center;flex:0 0 auto"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg></div>
    <div><div style="font-size:13px;font-weight:600;color:#4B5563">Net Cash</div><div style="font-size:22px;font-weight:800;color:${netColor};margin:1px 0">&#8377;${netCashStr}</div><div style="font-size:12px;color:#6B7280">Balance</div></div>
  </div>
</div>
            ]]></text></render-mode>

            <!-- Filter toolbar -->
            <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md q-mb-md">
                <form-single name="CashFilter" transition=".">
                    <field name="filterDate"><default-field title="From"><date-time type="date" default-value="${filterDate}"/></default-field></field>
                    <field name="filterThruDate"><default-field title="To"><date-time type="date" default-value="${filterThruDate}"/></default-field></field>
                    <field name="filterType"><default-field title="Type">
                        <drop-down allow-empty="true"><option key="CashIn" text="Cash In"/><option key="CashOut" text="Cash Out"/></drop-down></default-field></field>
                    <field name="searchText"><default-field title="Search"><text-line size="22" default-value="${searchText ?: ''}"/></default-field></field>
                    <field name="resetBtn"><default-field title=" "><link url="." text="Reset" icon="fa fa-refresh" btn-type="default"/></default-field></field>
                    <field name="submitButton"><default-field title=" "><submit text="Apply" icon="fa fa-check"/></default-field></field>
                    <field-layout>
                        <field-row><field-ref name="filterDate"/><field-ref name="filterThruDate"/><field-ref name="filterType"/><field-ref name="searchText"/><field-ref name="resetBtn"/><field-ref name="submitButton"/></field-row>
                    </field-layout>
                </form-single>
            </container>

            <!-- Cash In / Cash Out entry panels -->
            <render-mode><text type="html,qvt"><![CDATA[<a id="ce-forms"></a>]]></text></render-mode>
            <container-row>
                <row-col lg="6" md="6" sm="12">
                    <container style="zenith-card bg-white shadow-2 border-radius-lg q-mb-md">
                        <render-mode><text type="html,qvt"><![CDATA[<div style="display:flex;align-items:center;gap:12px;background:#ECFDF5;padding:15px 20px;border-radius:12px 12px 0 0"><div style="width:36px;height:36px;border-radius:50%;background:#fff;color:#059669;display:flex;align-items:center;justify-content:center;flex:0 0 auto"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg></div><div><div style="font-size:15px;font-weight:700;color:#111827">Cash In</div><div style="font-size:12px;color:#6B7280">Record money received</div></div></div>]]></text></render-mode>
                        <container style="q-pa-md">
                        <form-single name="CashInForm" transition="addCashIn">
                            <field name="sessionId"><default-field title="POS Session (drawer)"><drop-down allow-empty="true"><list-options list="cashSessionList" key="${sessionId}" text="${terminalId} / ${sessionId}"/></drop-down></default-field></field>
                            <field name="entryDate"><default-field title="Date &amp; Time"><date-time type="date-time" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd HH:mm')}"/></default-field></field>
                            <field name="amount"><default-field title="Amount (₹)"><text-line size="15"/></default-field></field>
                            <field name="reason"><default-field title="Reason">
                                <drop-down>
                                    <option key="CeDeposit" text="Owner/Partner Deposit"/>
                                    <option key="CeAdvance" text="Customer Advance"/>
                                    <option key="CeChange" text="Change Fund"/>
                                    <option key="CeOther" text="Other"/>
                                </drop-down></default-field></field>
                            <field name="description"><default-field title="Notes"><text-line size="30"/></default-field></field>
                            <field name="referenceNumber"><default-field title="Ref No."><text-line size="20"/></default-field></field>
                            <field name="enteredByPartyId"><default-field><hidden default-value="${ec.user.userAccount?.partyId}"/></default-field></field>
                            <field name="submitBtn">
                                <conditional-field name="cashin_save_write" condition="modCanWrite" title="">
                                    <submit text="Add Cash In" icon="fa fa-plus" type="success"/>
                                </conditional-field>
                                <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field></field>
                            <field-layout>
                                <field-ref name="sessionId"/>
                                <field-row><field-ref name="entryDate"/><field-ref name="amount"/><field-ref name="reason"/></field-row>
                                <field-row><field-ref name="description"/><field-ref name="referenceNumber"/></field-row>
                                <field-ref name="enteredByPartyId"/>
                                <field-row><field-ref name="submitBtn"/></field-row>
                            </field-layout>
                        </form-single>
                        </container>
                    </container>
                </row-col>
                <row-col lg="6" md="6" sm="12">
                    <container style="zenith-card bg-white shadow-2 border-radius-lg q-mb-md">
                        <render-mode><text type="html,qvt"><![CDATA[<div style="display:flex;align-items:center;gap:12px;background:#FEF2F2;padding:15px 20px;border-radius:12px 12px 0 0"><div style="width:36px;height:36px;border-radius:50%;background:#fff;color:#DC2626;display:flex;align-items:center;justify-content:center;flex:0 0 auto"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg></div><div><div style="font-size:15px;font-weight:700;color:#111827">Cash Out</div><div style="font-size:12px;color:#6B7280">Record money paid out</div></div></div>]]></text></render-mode>
                        <container style="q-pa-md">
                        <form-single name="CashOutForm" transition="addCashOut">
                            <field name="sessionId"><default-field title="POS Session (drawer)"><drop-down allow-empty="true"><list-options list="cashSessionList" key="${sessionId}" text="${terminalId} / ${sessionId}"/></drop-down></default-field></field>
                            <field name="entryDate"><default-field title="Date &amp; Time"><date-time type="date-time" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd HH:mm')}"/></default-field></field>
                            <field name="amount"><default-field title="Amount (₹)"><text-line size="15"/></default-field></field>
                            <field name="reason"><default-field title="Reason">
                                <drop-down>
                                    <option key="CeBankDeposit" text="Bank Deposit"/>
                                    <option key="CeWithdrawal" text="Owner/Partner Withdrawal"/>
                                    <option key="CePettyCash" text="Petty Cash"/>
                                    <option key="CeRefund" text="Customer Refund"/>
                                    <option key="CeOther" text="Other"/>
                                </drop-down></default-field></field>
                            <field name="description"><default-field title="Notes"><text-line size="30"/></default-field></field>
                            <field name="referenceNumber"><default-field title="Ref No."><text-line size="20"/></default-field></field>
                            <field name="enteredByPartyId"><default-field><hidden default-value="${ec.user.userAccount?.partyId}"/></default-field></field>
                            <field name="submitBtn">
                                <conditional-field name="cashout_save_write" condition="modCanWrite" title="">
                                    <submit text="Add Cash Out" icon="fa fa-minus" type="danger"/>
                                </conditional-field>
                                <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field></field>
                            <field-layout>
                                <field-ref name="sessionId"/>
                                <field-row><field-ref name="entryDate"/><field-ref name="amount"/><field-ref name="reason"/></field-row>
                                <field-row><field-ref name="description"/><field-ref name="referenceNumber"/></field-row>
                                <field-ref name="enteredByPartyId"/>
                                <field-row><field-ref name="submitBtn"/></field-row>
                            </field-layout>
                        </form-single>
                        </container>
                    </container>
                </row-col>
            </container-row>

            <!-- Recent transactions -->
            <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
                <container style="row items-center q-mb-md q-gutter-sm">
                    <label text="Recent Transactions" type="h6" style="text-weight-bold q-my-none"/>
                    <label text="${entryCount} entries" type="span" style="zenith-badge nd primary"/>
                </container>
                <form-list name="CashEntryList" list="cashEntryList" list-entry="ce" skip-form="true"
                           show-csv-button="true" show-xlsx-button="true">
                    <row-actions><script><![CDATA[
                        def isIn = (ce.entryType == 'CashIn')
                        typeLabel = isIn ? 'Cash In' : 'Cash Out'
                        typeColor = isIn ? 'success' : 'danger'
                        amtColor = isIn ? 'z-amt-green' : 'z-txt-red'
                        amtStr = '₹' + com.zenith.Fmt.INSTANCE.inr(ec.l10n.format((ce.amount ?: 0) as BigDecimal, '#,##0.00'))
                        reasonLabel = reasonDescMap[ce.reason] ?: (ce.reason ?: '—')
                        byStr = ("${ce.firstName ?: ''} ${ce.lastName ?: ''}").toString().trim() ?: '—'
                    ]]></script></row-actions>
                    <field name="entryDate"><header-field title="Date &amp; Time"/>
                        <default-field><display format="dd MMM yyyy HH:mm"/></default-field></field>
                    <field name="entryType"><header-field title="Type"/>
                        <default-field><label text="${typeLabel}" type="span" style="zenith-badge nd ${typeColor}"/></default-field></field>
                    <field name="amount"><header-field title="Amount"/>
                        <default-field><label text="${amtStr}" type="span" style="${amtColor} text-weight-medium"/></default-field></field>
                    <field name="reason"><header-field title="Reason"/>
                        <default-field><label text="${reasonLabel}" type="span" style="text-dark"/></default-field></field>
                    <field name="description"><header-field title="Notes"/>
                        <default-field><label text="${ce.description ?: '—'}" type="span" style="text-grey-8"/></default-field></field>
                    <field name="referenceNumber"><header-field title="Ref No."/>
                        <default-field><label text="${ce.referenceNumber ?: '—'}" type="span" style="text-grey-7"/></default-field></field>
                    <field name="enteredBy"><header-field title="Created By"/>
                        <default-field><label text="${byStr}" type="span" style="text-dark"/></default-field></field>
                    <field name="deleteBtn">
                        <conditional-field name="cashdel_write" condition="modCanWrite" title="">
                            <link url="deleteCashEntry" text="Delete" icon="fa fa-trash" btn-type="danger"
                                  parameter-map="[cashEntryId:ce.cashEntryId]" confirmation="Delete this cash entry?"/>
                        </conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                </form-list>
            </container>
        </container>
    </widgets>
</screen>
