    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_wastage" class="pos-reference-help" style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128465; Wastage &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Log stock that was spoiled, damaged or thrown away so your inventory stays correct.<br><b>1</b>&nbsp;<b>Record Wastage</b> tab &mdash; pick the item, quantity and reason, then save.<br><b>2</b>&nbsp;<b>Summary</b> tab shows totals by item and reason.</div></details>]]></text></render-mode>
