<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Sessions" default-menu-index="6">

    <transition name="openSession" begin-transaction="true">
        <service-call name="zenith.pos.PosServices.open#PosSession"/>
        <default-response url="../EditSession"/>
    </transition>
    <transition name="editSession"><default-response url="../EditSession"/></transition>

    <transition name="exportCsv" read-only="true">
        <actions>
            <script><![CDATA[
                import org.moqui.context.ExecutionContext
                ExecutionContext ec = context.ec
                // ZE-SHOP: scope to the selected shop's facility (null = All Shops)
                def _activeShop = null; try { def _sc = ec.service.sync().name("zenith.base.ShopServices.get#ActiveShopScope").call(); _activeShop = _sc?.activeShopId } catch (Exception _e) {}
                def ef = ec.entity.find("zenith.erp.pos.PosSessionView").orderBy("-openDate")
                // org-isolate (standalone CSV render bypasses the MANTLE_ACTIVE_ORG authz filter)
                def _org = ec.user.getPreference('ACTIVE_ORGANIZATION')
                if (_org) ef.condition("organizationPartyId", _org)
                if (_activeShop) ef.condition("facilityId", _activeShop)
                def rows = ef.list()
                def esc = { v -> if (v == null) return ""; String s = v.toString().trim(); (s.contains(",")||s.contains("\"")||s.contains("\n")) ? "\"" + s.replace("\"","\"\"") + "\"" : s }
                def num = { v -> String.format("%.2f", (v ?: 0.0) as double) }
                def dt = { v -> v == null ? "" : ec.l10n.format(v, 'dd-MM-yyyy HH:mm') }
                def slMap = [PsClosed:'Closed', PsOpen:'Open']
                StringBuilder csv = new StringBuilder()
                csv.append("ZetaERP - POS Sessions\n")
                csv.append("Generated on: ${ec.l10n.format(ec.user.nowTimestamp, 'dd MMM yyyy HH:mm')}\n\n")
                csv.append("Session,Terminal,Operator,Opened,Closed,Status,Opening,Sales,Returns,Trans,Closing,Diff\n")
                rows.each { r ->
                    csv.append("${esc(r.sessionId)},${esc(r.terminalName)},${esc(r.operatorPartyId)},${dt(r.openDate)},${dt(r.closeDate)},${slMap[r.statusId] ?: esc(r.statusId)},${num(r.openingCash)},${num(r.totalSales)},${num(r.totalReturns)},${(long)((r.totalTransactions ?: 0) as double)},${num(r.closingCash)},${num(r.cashDifference)}\n")
                }
                ec.web.sendTextResponse(csv.toString(), "text/csv", "POS_Sessions_${ec.l10n.format(ec.user.nowTimestamp, 'yyyyMMdd_HHmm')}.csv")
            ]]></script>
        </actions>
        <default-response type="none"/>
    </transition>

    <transition name="downloadPdf" read-only="true">
        <default-response url="${ec.web.getWebappRootUrl(false, null)}/fop/apps/zenith/pos/PosSessionsPdf" url-type="plain"/>
    </transition>

    <actions>
        <set field="currSymbol" value="₹"/>
        <script>context.zinr = com.zenith.Fmt.INSTANCE</script>
        <!-- ZE-SHOP: scope sessions to the selected shop's facility (null = All Shops) -->
        <script>_activeShop = null; try { def _sc = ec.service.sync().name("zenith.base.ShopServices.get#ActiveShopScope").call(); _activeShop = _sc?.activeShopId } catch (Exception _e) {}</script>
        <entity-find entity-name="zenith.erp.pos.PosSessionView" list="sessionList">
            <search-form-inputs skip-fields="organizationPartyId,ownerPartyId" default-order-by="-openDate"/>
            <!-- org-isolate (standalone CSV/PDF render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="(ec.user.getPreference('ACTIVE_ORGANIZATION')) ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="facilityId" from="_activeShop" ignore-if-empty="true"/><!-- ZE-SHOP -->
        </entity-find>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_sessions" class="pos-reference-help" style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128342; Sessions &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">A <b>session</b> is one cashier&#39;s shift on a terminal &mdash; it holds that shift&#39;s sales and cash count.<br><b>1</b>&nbsp;Click <b>Open New Session</b>, pick the terminal and enter the <b>opening cash</b> to start billing.<br><b>2</b>&nbsp;Each row shows that shift&#39;s sales, returns and cash <b>difference</b>.<br><b>3</b>&nbsp;Click a <b>Session</b> ID to open it, then <b>close</b> it at the end of the shift to count the drawer.</div></details>]]></text></render-mode>
        <container style="q-pa-md">
            <!-- Page header: title + subtitle | Open New Session CTA -->
            <container style="zsec-hdr row items-center justify-between q-mb-md">
                <container style="column">
                    <label text="POS Sessions" type="h5" style="text-weight-bold q-mt-none q-mb-xs"/>
                    <label text="View and manage all POS sessions" type="span" style="z-statdesc"/>
                </container>
                <container style="z-newbtn-wrap">
                    <section name="OpenSession_write"><condition><expression>modCanWrite</expression></condition><widgets>
                        <container-dialog id="OpenSessionDialog" button-text="Open New Session">
                            <form-single name="OpenSessionForm" transition="openSession">
                                <field name="terminalId"><default-field title="Terminal">
                                    <drop-down><entity-options key="${terminalId}" text="${terminalName}">
                                        <entity-find entity-name="zenith.erp.pos.PosTerminal">
                                            <econdition field-name="isActive" value="Y"/>
                                        </entity-find></entity-options></drop-down></default-field></field>
                                <field name="openingCash"><default-field title="Opening Cash (${currSymbol})">
                                    <text-line size="12" default-value="0"/></default-field></field>
                                <field name="submitButton"><default-field title="Open Session"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </widgets></section>
                </container>
            </container>

            <!-- Toolbar: CSV / PDF (left), Refresh (right) -->
            <container style="zsec-hdr row items-center justify-between q-mb-md">
                <container style="z-btnrow">
                    <link url="exportCsv" text="CSV" icon="download" link-type="anchor" style="z-obtn"/>
                    <link url="downloadPdf" text="PDF" icon="picture_as_pdf" link-type="anchor" style="z-obtn"/>
                </container>
                <container style="z-btnrow">
                    <link url="." text="Refresh" icon="refresh" link-type="anchor" style="z-obtn"/>
                </container>
            </container>

            <!-- Sessions table -->
            <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md z-listchrome">
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Sessions..." style="display:none"></span>]]></text></render-mode>
            <form-list name="SessionList" list="sessionList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true">
                    <row-actions>
                        <script><![CDATA[
                            def scMap = [PsClosed:'success', PsOpen:'warning']
                            def slMap = [PsClosed:'Closed', PsOpen:'Open']
                            statusColor = scMap[statusId] ?: 'grey'
                            statusText  = slMap[statusId] ?: (statusId ?: '—')
                            def z = zinr ?: com.zenith.Fmt.INSTANCE
                            def money = { v -> z.inr(ec.l10n.format((v ?: 0) as BigDecimal, '#,##0.00')) }
                            openingDisp = money(openingCash)
                            salesDisp   = money(totalSales)
                            returnsDisp = money(totalReturns)
                            closingDisp = money(closingCash)
                            def diffVal = (cashDifference ?: 0) as BigDecimal
                            diffDisp = money(cashDifference)
                            salesStyle   = ((totalSales ?: 0) as BigDecimal) > 0 ? 'z-amt-green text-weight-medium' : 'text-dark'
                            closingStyle = ((closingCash ?: 0) as BigDecimal) > 0 ? 'z-amt-green text-weight-medium' : 'text-dark'
                            diffStyle    = diffVal > 0 ? 'z-amt-green' : (diffVal < 0 ? 'z-txt-red' : 'text-dark')
                            operatorDisp = operatorPartyId ?: '—'
                        ]]></script>
                    </row-actions>
                    <field name="sessionId"><header-field title="Session" show-order-by="true"><text-find/></header-field>
                        <default-field><link url="editSession" text="${sessionId}" link-type="anchor"
                              parameter-map="[sessionId:sessionId]" style="z-bluelink"/></default-field></field>
                    <field name="terminalName"><header-field title="Terminal" show-order-by="true"/>
                        <conditional-field condition="terminalName"><label text="${terminalName}" type="span" style="zenith-badge nd success"/></conditional-field>
                        <default-field><label text="—" type="span" style="text-grey-6"/></default-field></field>
                    <field name="operatorPartyId"><header-field title="Operator"/>
                        <default-field><label text="${operatorDisp}" type="span" style="text-dark"/></default-field></field>
                    <field name="openDate"><header-field title="Opened" show-order-by="true"><date-period/></header-field>
                        <default-field><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="closeDate"><header-field title="Closed"/>
                        <default-field><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="statusId"><header-field title="Status" show-order-by="true">
                            <drop-down allow-empty="true"><entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="PosSession"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field><label text="${statusText}" type="span" style="zenith-badge nd ${statusColor}"/></default-field></field>
                    <field name="openingCash"><header-field title="Opening (${currSymbol})"/>
                        <default-field><label text="${openingDisp}" type="span" style="text-dark"/></default-field></field>
                    <field name="totalSales"><header-field title="Sales (${currSymbol})"/>
                        <default-field><label text="${salesDisp}" type="span" style="${salesStyle}"/></default-field></field>
                    <field name="totalReturns"><header-field title="Return (${currSymbol})"/>
                        <default-field><label text="${returnsDisp}" type="span" style="z-txt-red"/></default-field></field>
                    <field name="totalTransactions"><header-field title="Trans"/>
                        <default-field><display/></default-field></field>
                    <field name="closingCash"><header-field title="Closing (${currSymbol})"/>
                        <default-field><label text="${closingDisp}" type="span" style="${closingStyle}"/></default-field></field>
                    <field name="cashDifference"><header-field title="Diff (${currSymbol})"/>
                        <default-field><label text="${diffDisp}" type="span" style="${diffStyle}"/></default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </container>
        </container>
    </widgets>
</screen>
