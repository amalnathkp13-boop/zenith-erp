<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Kitchen Display" default-menu-index="1">

    <transition name="updateStatus">
        <actions>
            <service-call name="update#zenith.erp.pos.KitchenOrderTicket"
                          in-map="[kotId:kotId, statusId:statusId]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="goTerminal"><default-response url="../../Terminal"/></transition>
    <transition name="goTransactions"><default-response url="../../PosTransactions"/></transition>
    <transition name="goDashboard"><default-response url="../../Dashboard"/></transition>

    <actions>
        <set field="filterStatus" from="filterStatus ?: ''"/>

        <script><![CDATA[
            def kotQuery = ec.entity.find("zenith.erp.pos.KotView")
            if (filterStatus) {
                kotQuery.condition("statusId", filterStatus)
            } else {
                kotQuery.condition("statusId", "in", ["KotNew", "KotPreparing", "KotReady"])
            }
            activeKots = kotQuery.orderBy("-kotDate").list()

            kotItemsMap = [:]
            activeKots.each { kot ->
                def items = ec.entity.find("zenith.erp.pos.KotItem")
                    .condition("kotId", kot.kotId).orderBy("kotItemSeqId").list()
                kotItemsMap[kot.kotId] = items
            }

            newCount = activeKots.count { it.statusId == 'KotNew' }
            preparingCount = activeKots.count { it.statusId == 'KotPreparing' }
            readyCount = activeKots.count { it.statusId == 'KotReady' }
        ]]></script>
    </actions>

    <widgets>
        <container style="q-pa-md">
            <container style="row items-center justify-end q-mb-md q-gutter-sm">
                <link url="goTerminal" text="Billing Terminal" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
                <link url="goTransactions" text="Transactions" icon="fa fa-list" btn-type="primary" style="q-btn--dense"/>
                <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
            </container>
            <container-row>
                <row-col lg="3" md="3" sm="4">
                    <container style="zenith-card bg-blue-1 shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="New Orders" style="text-grey-7 text-caption"/>
                        <label text="${newCount}" type="h4" style="text-weight-bold text-blue-8 q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="4">
                    <container style="zenith-card bg-orange-1 shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Preparing" style="text-grey-7 text-caption"/>
                        <label text="${preparingCount}" type="h4" style="text-weight-bold text-orange-8 q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="4">
                    <container style="zenith-card bg-green-1 shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Ready" style="text-grey-7 text-caption"/>
                        <label text="${readyCount}" type="h4" style="text-weight-bold text-green-8 q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="12">
                    <container style="q-pa-sm q-mb-md">
                        <form-single name="StatusFilter" transition="." body-parameters="">
                            <field name="filterStatus"><default-field title="Filter">
                                <drop-down allow-empty="true">
                                    <option key="" text="Active (All)"/>
                                    <option key="KotNew" text="New Only"/>
                                    <option key="KotPreparing" text="Preparing Only"/>
                                    <option key="KotReady" text="Ready Only"/>
                                </drop-down>
                            </default-field></field>
                            <field name="searchBtn"><default-field title="">
                                <submit text="Filter" icon="fa fa-filter"/>
                            </default-field></field>
                        </form-single>
                    </container>
                </row-col>
            </container-row>

            <render-mode><text type="html,qvt" template="true"><![CDATA[
<div style="display:flex; flex-wrap:wrap; gap:14px;">
    <#if activeKots?? && (activeKots?size > 0)>
    <#list activeKots as kot>
        <#assign borderColor = "#1976D2"/>
        <#assign bgColor = "#E3F2FD"/>
        <#assign statusLabel = "NEW"/>
        <#if kot.statusId == "KotPreparing">
            <#assign borderColor = "#F57C00"/>
            <#assign bgColor = "#FFF3E0"/>
            <#assign statusLabel = "PREPARING"/>
        <#elseif kot.statusId == "KotReady">
            <#assign borderColor = "#388E3C"/>
            <#assign bgColor = "#E8F5E9"/>
            <#assign statusLabel = "READY"/>
        </#if>
        <#assign elapsed = ""/>
        <#if kot.kotDate??>
            <#assign diffMs = .now?long - kot.kotDate?long/>
            <#assign diffMin = (diffMs / 60000)?int/>
            <#if diffMin < 60>
                <#assign elapsed = diffMin + " min"/>
            <#else>
                <#assign elapsed = (diffMin / 60)?int + "h " + (diffMin % 60) + "m"/>
            </#if>
        </#if>

        <div style="width:280px; border-top:4px solid ${borderColor}; background:${bgColor}; border-radius:10px; box-shadow:0 2px 6px rgba(0,0,0,0.1); overflow:hidden;">
            <div style="padding:12px 14px 8px; display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <span style="font-weight:bold; font-size:18px;">KOT #${kot.kotNumber!kot.kotId!''}</span>
                    <#if kot.tableNumber?has_content>
                        <span style="margin-left:8px; background:#fff; padding:2px 8px; border-radius:4px; font-size:12px; border:1px solid #ddd;">Table ${kot.tableNumber}</span>
                    </#if>
                </div>
                <span style="background:${borderColor}; color:#fff; padding:3px 10px; border-radius:12px; font-size:11px; font-weight:bold;">${statusLabel}</span>
            </div>

            <div style="padding:0 14px 6px; font-size:12px; color:#666;">
                <#if kot.waiterName?has_content>Waiter: ${kot.waiterName} &nbsp;|&nbsp;</#if>
                <#if elapsed?has_content>${elapsed} ago</#if>
                <#if kot.terminalName?has_content> &nbsp;|&nbsp; ${kot.terminalName}</#if>
            </div>

            <div style="padding:4px 14px; border-top:1px solid rgba(0,0,0,0.08);">
                <#assign items = kotItemsMap[kot.kotId]![]/>
                <#if items?size == 0>
                    <div style="padding:8px 0; color:#999; font-size:13px;">No items</div>
                <#else>
                    <table style="width:100%; font-size:13px; border-collapse:collapse;">
                        <#list items as item>
                        <tr style="border-bottom:1px dotted #ddd;">
                            <td style="padding:5px 0; font-weight:500;">${(item.productName!item.productId!'')?html}</td>
                            <td style="padding:5px 0; text-align:right; font-weight:bold; width:40px;">x${item.quantity!1}</td>
                        </tr>
                        <#if item.specialInstructions?has_content>
                        <tr><td colspan="2" style="padding:0 0 4px 10px; font-size:11px; color:#E65100; font-style:italic;">&#9888; ${item.specialInstructions}</td></tr>
                        </#if>
                        </#list>
                    </table>
                </#if>
            </div>

            <#if kot.notes?has_content>
                <div style="padding:4px 14px 6px; font-size:11px; color:#555; background:rgba(0,0,0,0.03);">
                    &#128221; ${kot.notes}
                </div>
            </#if>

            <#if modCanWrite>
            <div style="padding:8px 14px 10px; display:flex; gap:6px; justify-content:flex-end; background:rgba(0,0,0,0.03);">
                <#if kot.statusId == "KotNew">
                    <a href="updateStatus?kotId=${kot.kotId}&statusId=KotPreparing" style="background:#F57C00; color:#fff; padding:5px 14px; border-radius:6px; text-decoration:none; font-size:12px; font-weight:bold;">&#9997; Start Preparing</a>
                    <a href="updateStatus?kotId=${kot.kotId}&statusId=KotCancelled" style="background:#D32F2F; color:#fff; padding:5px 14px; border-radius:6px; text-decoration:none; font-size:12px; font-weight:bold;">&#10005; Cancel</a>
                <#elseif kot.statusId == "KotPreparing">
                    <a href="updateStatus?kotId=${kot.kotId}&statusId=KotReady" style="background:#388E3C; color:#fff; padding:5px 14px; border-radius:6px; text-decoration:none; font-size:12px; font-weight:bold;">&#10003; Ready</a>
                <#elseif kot.statusId == "KotReady">
                    <a href="updateStatus?kotId=${kot.kotId}&statusId=KotServed" style="background:#1565C0; color:#fff; padding:5px 14px; border-radius:6px; text-decoration:none; font-size:12px; font-weight:bold;">&#127869; Served</a>
                </#if>
            </div>
            </#if>
        </div>
    </#list>
    <#else>
        <div style="width:100%; text-align:center; padding:40px; color:#999;">
            <div style="font-size:48px; margin-bottom:10px;">&#127859;</div>
            <div style="font-size:16px;">No active kitchen orders</div>
            <div style="font-size:13px; margin-top:4px;">Orders will appear here when created from the billing terminal</div>
        </div>
    </#if>
</div>
            ]]></text></render-mode>
        </container>
    </widgets>
</screen>
