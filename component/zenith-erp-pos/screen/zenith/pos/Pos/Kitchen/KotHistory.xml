<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="KOT History" default-menu-index="3">

    <transition name="goTerminal"><default-response url="../../Terminal"/></transition>
    <transition name="goTransactions"><default-response url="../../PosTransactions"/></transition>
    <transition name="goDashboard"><default-response url="../../Dashboard"/></transition>

    <transition name="createKot">
        <actions>
            <service-call name="create#zenith.erp.pos.KitchenOrderTicket" in-map="context"
                          out-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="cancelKot">
        <actions>
            <service-call name="update#zenith.erp.pos.KitchenOrderTicket"
                          in-map="[kotId:kotId, statusId:'KotCancelled']"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="filterDate" from="filterDate ?: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')"/>
        <set field="filterThruDate" from="filterThruDate ?: filterDate"/>
        <set field="dayStart" from="java.sql.Timestamp.valueOf(filterDate + ' 00:00:00')"/>
        <set field="dayEnd" from="java.sql.Timestamp.valueOf(filterThruDate + ' 23:59:59')"/>

        <entity-find entity-name="zenith.erp.pos.KotView" list="kotList">
            <econdition field-name="kotDate" operator="greater-equals" from="dayStart"/>
            <econdition field-name="kotDate" operator="less-equals" from="dayEnd"/>
            <econdition field-name="statusId" from="filterStatus" ignore-if-empty="true"/>
            <econdition field-name="tableNumber" from="filterTable" ignore-if-empty="true"/>
            <order-by field-name="-kotDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="(ec.user.getPreference('ACTIVE_ORGANIZATION')) ?: '__NO_ORGANIZATION__'"/>
        </entity-find>

        <script><![CDATA[
            totalKots = kotList.size()
            servedCount = kotList.count { it.statusId == 'KotServed' }
            cancelledCount = kotList.count { it.statusId == 'KotCancelled' }
            pendingCount = kotList.count { it.statusId in ['KotNew', 'KotPreparing', 'KotReady'] }
        ]]></script>
    </actions>

    <widgets>
        <container style="q-pa-md">
            <container style="row items-center justify-end q-mb-sm q-gutter-sm">
                <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
                <link url="goTransactions" text="Transactions" icon="fa fa-list" btn-type="primary" style="q-btn--dense"/>
                <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
            </container>
            <container-row>
                <row-col lg="8" md="8" sm="12">
                    <label text="KOT History" type="h6" style="text-weight-bold q-mb-md"/>
                </row-col>
                <row-col lg="4" md="4" sm="12">
                    <container style="text-right q-mb-md">
                        <section name="CreateKot_write"><condition><expression>modCanWrite</expression></condition><widgets>
                        <container-dialog id="CreateKotDialog" button-text="Create KOT" type="success">
                            <form-single name="CreateKotForm" transition="createKot">
                                <field name="kotNumber"><default-field title="KOT Number">
                                    <text-line size="10"/>
                                </default-field></field>
                                <field name="tableNumber"><default-field title="Table Number">
                                    <text-line size="6"/>
                                </default-field></field>
                                <field name="waiterName"><default-field title="Waiter Name">
                                    <text-line size="20"/>
                                </default-field></field>
                                <field name="notes"><default-field title="Notes">
                                    <text-line size="30"/>
                                </default-field></field>
                                <field name="kotDate" from="ec.user.nowTimestamp"><default-field><hidden/></default-field></field>
                                <field name="statusId" from="'KotNew'"><default-field><hidden/></default-field></field>
                                <field name="submitBtn"><default-field title="">
                                    <submit text="Create KOT" icon="fa fa-plus"/>
                                </default-field></field>
                            </form-single>
                        </container-dialog>
                        </widgets></section>
                    </container>
                </row-col>
            </container-row>

            <container style="q-mb-md">
                <form-single name="KotFilter" transition=".">
                    <field name="filterDate"><default-field title="From">
                        <date-time type="date" default-value="${filterDate}"/>
                    </default-field></field>
                    <field name="filterThruDate"><default-field title="To">
                        <date-time type="date" default-value="${filterThruDate}"/>
                    </default-field></field>
                    <field name="filterStatus"><default-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="KotNew" text="New"/>
                            <option key="KotPreparing" text="Preparing"/>
                            <option key="KotReady" text="Ready"/>
                            <option key="KotServed" text="Served"/>
                            <option key="KotCancelled" text="Cancelled"/>
                        </drop-down>
                    </default-field></field>
                    <field name="filterTable"><default-field title="Table">
                        <text-line size="6"/>
                    </default-field></field>
                    <field name="searchBtn"><default-field title="">
                        <submit text="Search" icon="fa fa-search"/>
                    </default-field></field>
                </form-single>
            </container>

            <container-row>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-white shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Total KOTs" style="text-grey-7 text-caption"/>
                        <label text="${totalKots}" type="h5" style="text-weight-bold text-primary q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-white shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Served" style="text-grey-7 text-caption"/>
                        <label text="${servedCount}" type="h5" style="text-weight-bold text-green-8 q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-white shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Pending" style="text-grey-7 text-caption"/>
                        <label text="${pendingCount}" type="h5" style="text-weight-bold text-orange-8 q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-white shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Cancelled" style="text-grey-7 text-caption"/>
                        <label text="${cancelledCount}" type="h5" style="text-weight-bold text-red-8 q-my-xs"/>
                    </container>
                </row-col>
            </container-row>

            <form-list name="KotHistoryList" list="kotList" list-entry="k" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="kotNumber"><default-field title="KOT #">
                    <display default-text="${k.kotId}"/>
                </default-field></field>
                <field name="kotDate"><default-field title="Date/Time">
                    <display format="dd-MM-yyyy HH:mm"/>
                </default-field></field>
                <field name="tableNumber"><default-field title="Table">
                    <display default-text="-"/>
                </default-field></field>
                <field name="waiterName"><default-field title="Waiter">
                    <display default-text="-"/>
                </default-field></field>
                <field name="terminalName"><default-field title="Terminal">
                    <display default-text="-"/>
                </default-field></field>
                <field name="statusId"><default-field title="Status">
                    <display-entity entity-name="moqui.basic.StatusItem" key-field-name="statusId" text="${description}"/>
                </default-field></field>
                <field name="printCount"><default-field title="Prints">
                    <display/>
                </default-field></field>
                <field name="cancelBtn"><default-field title="">
                    <link url="cancelKot" text="Cancel" icon="fa fa-ban" btn-type="danger"
                          parameter-map="[kotId:k.kotId]"
                          condition="modCanWrite &amp;&amp; k.statusId in ['KotNew','KotPreparing']"
                          confirmation="Cancel this KOT?"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
