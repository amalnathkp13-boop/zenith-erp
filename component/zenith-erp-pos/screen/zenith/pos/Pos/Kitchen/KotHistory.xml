<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="KOT History" default-menu-index="3">

    <transition name="printRecord" method="post">
        <actions><script><![CDATA[
            def result=ec.service.sync().name('zenith.pos.KitchenPrintServices.get#HistoryPrintRecord').parameters([kotId:ec.context.kotId,kind:ec.context.kind]).call()
            ec.web.sendJsonResponse([success:!ec.message.hasError(),record:result?.record,error:ec.message.errorsString])
        ]]></script></actions><default-response type="none"/>
    </transition>
    <transition name="ackKotPrint" method="post" begin-transaction="true">
        <actions><script><![CDATA[
            def result=ec.service.sync().name('zenith.pos.KotServices.reprint#KitchenOrderTicket').parameter('kotId',ec.context.kotId).call()
            ec.web.sendJsonResponse([success:!ec.message.hasError(),printCount:result?.printCount,error:ec.message.errorsString])
        ]]></script></actions><default-response type="none"/>
    </transition>

    <transition name="goTerminal"><default-response url="${kitchenModuleId == 'kot' ? '../../pos/Terminal' : '../../Terminal'}"/></transition>
    <transition name="goTransactions"><default-response url="${kitchenModuleId == 'kot' ? '../../pos/PosTransactions' : '../../PosTransactions'}"/></transition>
    <transition name="goDashboard"><default-response url="${kitchenModuleId == 'kot' ? '../../pos/Dashboard' : '../../Dashboard'}"/></transition>

    <transition name="cancelKot" method="post" begin-transaction="true">
        <actions>
            <service-call name="zenith.pos.KotServices.update#KotStatus"
                          in-map="[kotId:kotId, statusId:'KotCancelled']"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="filterDate" from="filterDate ?: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')"/>
        <set field="filterThruDate" from="filterThruDate ?: filterDate"/>
        <set field="dayStart" from="ec.l10n.parseTimestamp(filterDate + ' 00:00:00', 'yyyy-MM-dd HH:mm:ss')"/>
        <set field="dayEnd" from="ec.l10n.parseTimestamp(filterThruDate + ' 23:59:59.999', 'yyyy-MM-dd HH:mm:ss.SSS')"/>

        <entity-find entity-name="zenith.erp.pos.KotView" list="kotList">
            <econdition field-name="kotDate" operator="greater-equals" from="dayStart"/>
            <econdition field-name="kotDate" operator="less-equals" from="dayEnd"/>
            <econdition field-name="statusId" from="filterStatus" ignore-if-empty="true"/>
            <econdition field-name="tableNumber" from="filterTable" ignore-if-empty="true"/>
            <order-by field-name="-kotDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="(ec.user.getPreference('ACTIVE_ORGANIZATION')) ?: '__NO_ORGANIZATION__'"/>
        </entity-find>

        <script><![CDATA[
            def uri = ec.web?.request?.requestURI ?: ''
            def zenithIndex = uri.indexOf('/zenith/')
            cancelAction = (zenithIndex > 0 ? uri.substring(0, zenithIndex) : '') +
                '/zenith' + kitchenModulePath + '/KotHistory/cancelKot'
            def kotIds=kotList.collect { it.kotId }
            def itemRows=kotIds ? ec.entity.find('zenith.erp.pos.KotItem').condition('kotId','in',kotIds).list() : []
            def itemsByKot=itemRows.groupBy { it.kotId }
            historyItemSummary=[:]
            historyItemCount=[:]
            historyOrderType=[:]
            kotList.each { k ->
                def items=(itemsByKot[k.kotId] ?: []).sort { it.kotItemSeqId }
                historyItemCount[k.kotId]=items.size()
                historyItemSummary[k.kotId]=items.take(2).collect { it.productName ?: it.productId }.join(', ') +
                    (items.size()>2 ? ' +'+(items.size()-2)+' more' : '')
                def savedType=null
                if(k.orderReceiptJson) {
                    try { savedType=new groovy.json.JsonSlurper().parseText(k.orderReceiptJson)?.bill?.orderType }
                    catch(Exception ignored) { }
                }
                historyOrderType[k.kotId]=k.notes?.startsWith('[Take Away]') ? 'Take Away' :
                    (k.notes?.startsWith('[Dine In]') ? 'Dine In' :
                    (savedType in ['Dine In','Take Away'] ? savedType : (k.tableNumber ? 'Dine In' : 'Unspecified')))
            }
            def query=filterQuery?.toString()?.trim()?.toLowerCase()
            if(filterOrderType) kotList=kotList.findAll { historyOrderType[it.kotId]==filterOrderType }
            if(query) kotList=kotList.findAll { k ->
                (k.kotNumber ?: k.kotId ?: '').toString().toLowerCase().contains(query) ||
                    (itemsByKot[k.kotId] ?: []).any { (it.productName ?: it.productId ?: '').toLowerCase().contains(query) }
            }
            tableOptions=ec.entity.find('zenith.erp.pos.KitchenOrderTicket')
                .condition('organizationPartyId',ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__')
                .selectField('tableNumber').list().collect { it.tableNumber }.findAll { it }.unique().sort()
            def txIds=kotList.collect { it.transactionId }.findAll { it }
            linkedBillIds=txIds ? ec.entity.find('zenith.erp.pos.PosTransaction').condition('transactionId','in',txIds)
                .condition('organizationPartyId',ec.user.getPreference('ACTIVE_ORGANIZATION')).condition('statusId','PtCompleted')
                .list().findAll { !!it.transactionNumber }.collect { it.transactionId } : []
            kitchenToken = ec.web?.sessionToken ?: ''
            totalKots = kotList.size()
            servedCount = kotList.count { it.statusId == 'KotServed' }
            cancelledCount = kotList.count { it.statusId == 'KotCancelled' }
            pendingCount = kotList.count { it.statusId in ['KotNew', 'KotPreparing', 'KotReady'] }
        ]]></script>
    </actions>

    <widgets>
        <container style="q-pa-md zk-history">
            <render-mode><text type="html,qvt" template="true"><![CDATA[
            <header class="zk-history-heading">
              <div><h1>KOT History</h1><p>Review kitchen orders, then print the kitchen ticket or its finalized customer bill.</p></div>
              <div class="zk-history-heading-actions"><#if modCanWrite><a class="zk-history-primary" href="${cancelAction?keep_before('/cancelKot')?replace('/KotHistory','/KotBilling')?html}">+ New Order</a></#if></div>
            </header>
            ]]></text></render-mode>

            <container-row>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-white shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Total KOTs" style="text-grey-7 text-caption"/>
                        <render-mode><text type="html,qvt" template="true"><![CDATA[<strong data-kitchen-history-count="total">${totalKots}</strong>]]></text></render-mode>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-white shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Served" style="text-grey-7 text-caption"/>
                        <render-mode><text type="html,qvt" template="true"><![CDATA[<strong data-kitchen-history-count="served">${servedCount}</strong>]]></text></render-mode>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-white shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Pending" style="text-grey-7 text-caption"/>
                        <render-mode><text type="html,qvt" template="true"><![CDATA[<strong data-kitchen-history-count="pending">${pendingCount}</strong>]]></text></render-mode>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-white shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Cancelled" style="text-grey-7 text-caption"/>
                        <render-mode><text type="html,qvt" template="true"><![CDATA[<strong data-kitchen-history-count="cancelled">${cancelledCount}</strong>]]></text></render-mode>
                    </container>
                </row-col>
            </container-row>

            <render-mode><text type="html,qvt" template="true"><![CDATA[
            <form class="zk-history-filters" method="get" action="${cancelAction?keep_before('/cancelKot')?html}">
              <label>From<input type="date" name="filterDate" value="${filterDate?html}" required></label>
              <label>To<input type="date" name="filterThruDate" value="${filterThruDate?html}" required></label>
              <label>Status<select name="filterStatus"><option value="">All statuses</option>
                <#list {'KotNew':'New','KotPreparing':'Preparing','KotReady':'Ready','KotServed':'Served','KotCancelled':'Cancelled'} as id,title><option value="${id}" <#if (filterStatus!'') == id>selected</#if>>${title}</option></#list>
              </select></label>
              <label>Table<select name="filterTable"><option value="">All tables</option><#list tableOptions as t><option value="${t?html}" <#if (filterTable!'') == t>selected</#if>>${t?html}</option></#list></select></label>
              <label>Order type<select name="filterOrderType"><option value="">All types</option><option value="Dine In" <#if (filterOrderType!'') == 'Dine In'>selected</#if>>Dine In</option><option value="Take Away" <#if (filterOrderType!'') == 'Take Away'>selected</#if>>Take Away</option></select></label>
              <label class="zk-history-search">KOT number or item<input name="filterQuery" type="search" value="${(filterQuery!'')?html}" placeholder="Search KOT or item"></label>
              <button type="submit">Search</button><a href="${cancelAction?keep_before('/cancelKot')?html}">Reset</a>
            </form>
            ]]></text></render-mode>

            <render-mode><text type="html,qvt" template="true"><![CDATA[
            <div class="zk-history-actions" id="zk-history-toolbar">
              <label><input type="checkbox" data-kitchen-select-all="true" aria-label="Select KOTs on this page"/> Select this page</label>
              <span data-kitchen-selected-count="true" aria-live="polite">0 selected</span>
              <#if modCanWrite>
              <button type="button" data-kitchen-bulk="kot" disabled="disabled">Print KOT (Selected)</button>
              <button type="button" data-kitchen-bulk="bill" disabled="disabled">Print Bill (Selected)</button>
              </#if>
            </div>
            <p id="zk-print-status" role="status" aria-live="polite"></p>
            ]]></text></render-mode>

            <form-list name="KotHistoryList" list="kotList" list-entry="k" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="selected"><default-field title="Select">
                    <render-mode><text type="html,qvt" template="true"><![CDATA[
                    <input type="checkbox" data-kitchen-select="${k.kotId?html}" data-kitchen-bill-eligible="${(linkedBillIds?seq_contains(k.transactionId!''))?string('true','false')}" aria-label="Select KOT ${(k.kotNumber!k.kotId)?html}"/>
                    ]]></text></render-mode>
                </default-field></field>
                <field name="kotNumber"><default-field title="KOT #">
                    <render-mode><text type="html,qvt" template="true"><![CDATA[<#if k.kotNumber?has_content>${k.kotNumber?html}<#else>${k.kotId?html}</#if>]]></text></render-mode>
                </default-field></field>
                <field name="tableNumber"><default-field title="Table">
                    <display default-text="-"/>
                </default-field></field>
                <field name="orderType"><default-field title="Order Type">
                    <render-mode><text type="html,qvt" template="true"><![CDATA[<span data-kitchen-history-type="${k.kotId?html}">${(historyOrderType[k.kotId]!'')?html}</span>]]></text></render-mode>
                </default-field></field>
                <field name="items"><default-field title="Items">
                    <render-mode><text type="html,qvt" template="true"><![CDATA[<span data-kitchen-history-items="${k.kotId?html}">${(historyItemSummary[k.kotId]!'')?html}</span><small>${historyItemCount[k.kotId]!0} items</small>]]></text></render-mode>
                </default-field></field>
                <field name="statusId"><default-field title="Status">
                    <render-mode><text type="html,qvt" template="true"><![CDATA[<span class="zk-history-status zk-history-status-${k.statusId?html}">${({'KotNew':'New','KotPreparing':'Preparing','KotReady':'Ready','KotServed':'Served','KotCancelled':'Cancelled'}[k.statusId]!k.statusId)?html}</span>]]></text></render-mode>
                </default-field></field>
                <field name="kotDate"><default-field title="Created">
                    <display format="dd-MM-yyyy HH:mm"/>
                </default-field></field>
                <field name="printCount"><default-field title="Prints">
                    <render-mode><text type="html,qvt" template="true"><![CDATA[<span data-kitchen-print-count="${k.kotId?html}">${k.printCount!0}</span>]]></text></render-mode>
                </default-field></field>
                <field name="printOptions"><default-field title="Actions">
                    <render-mode><text type="html,qvt" template="true"><![CDATA[
                    <div class="zk-history-actions">
                    <button type="button" data-kitchen-print="view" data-kot-id="${k.kotId?html}">View</button>
                    <#if modCanWrite>
                    <button type="button" data-kitchen-print="kot" data-kot-id="${k.kotId?html}">KOT Print</button>
                    <button type="button" data-kitchen-print="bill" data-kot-id="${k.kotId?html}" <#if !(linkedBillIds?seq_contains(k.transactionId!''))>disabled="disabled" title="No finalized customer bill is linked to this KOT."</#if>>Bill Print</button>
                    </#if>
                    </div>
                    ]]></text></render-mode>
                </default-field></field>
                <field name="cancelBtn"><default-field title="">
                    <render-mode><text type="html,qvt" template="true"><![CDATA[
                    <#if modCanWrite && (k.statusId == 'KotNew' || k.statusId == 'KotPreparing')>
                    <form method="post" action="${cancelAction?html}" onsubmit="return confirm('Cancel this KOT?')" style="margin:0">
                        <input type="hidden" name="moquiSessionToken" value="${kitchenToken?html}"/>
                        <input type="hidden" name="kotId" value="${k.kotId?html}"/>
                        <button type="submit" style="background:#D32F2F;color:#fff;border:0;border-radius:6px;padding:5px 12px;cursor:pointer">Cancel</button>
                    </form>
                    </#if>
                    ]]></text></render-mode>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
