<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Waiters" default-menu-index="9">

    <transition name="createWaiter">
        <actions>
            <set field="org" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="org == '_NA_'"><set field="org" from="null"/></if>
            <service-call name="create#zenith.erp.pos.Waiter" in-map="context + [organizationPartyId:org]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateWaiter">
        <actions>
            <entity-find-one entity-name="zenith.erp.pos.Waiter" value-field="_w"/>
            <if condition="_w == null"><return error="true" message="Waiter not found."/></if>
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
            <!-- org guard: only edit a waiter your org owns (super-admin exempt) -->
            <if condition="!ec.user.isInGroup('ADMIN') &amp;&amp; (_w.organizationPartyId == null || !_ao || _w.organizationPartyId != _ao)">
                <return error="true" message="You do not have access to this waiter."/></if>
            <service-call name="update#zenith.erp.pos.Waiter" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="deleteWaiter">
        <actions>
            <entity-find-one entity-name="zenith.erp.pos.Waiter" value-field="_w"/>
            <if condition="_w == null"><return error="true" message="Waiter not found."/></if>
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
            <if condition="!ec.user.isInGroup('ADMIN') &amp;&amp; (_w.organizationPartyId == null || !_ao || _w.organizationPartyId != _ao)">
                <return error="true" message="You do not have access to this waiter."/></if>
            <!-- unassign this waiter from any tables first -->
            <entity-find entity-name="zenith.erp.pos.RestaurantTable" list="_wt"><econdition field-name="assignedWaiterId" from="waiterId"/></entity-find>
            <iterate list="_wt" entry="_t"><set field="_t.assignedWaiterId" from="null"/><entity-update value-field="_t"/></iterate>
            <entity-delete value-field="_w"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="curOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <if condition="curOrg == '_NA_'"><set field="curOrg" from="null"/></if>
        <entity-find entity-name="zenith.erp.pos.Waiter" list="waiters">
            <econdition field-name="organizationPartyId" from="(curOrg) ?: '__NO_ORGANIZATION__'"/>
            <order-by field-name="waiterName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.pos.RestaurantTable" list="_tables"/>

        <script><![CDATA[
            def _uri = (ec.web?.request?.requestURI ?: ''); def _zi = _uri.indexOf('/zenith/')
            appBase = (_zi > 0) ? _uri.substring(0, _zi) : ''
            moquiToken = (ec.web != null) ? (ec.web.sessionToken ?: '') : ''
            def _init = { nm ->
                def n = ((nm ?: '') as String).trim(); def p = n.split(/\s+/).findAll { it }
                ((p.size() >= 2) ? ('' + p[0].charAt(0) + p[1].charAt(0)) : (n.length() >= 2 ? n.substring(0,2) : (n ?: 'W'))).toUpperCase()
            }
            def _wtmap = [:]
            (_tables ?: []).each { t -> if (t.assignedWaiterId) { if (_wtmap[t.assignedWaiterId] == null) _wtmap[t.assignedWaiterId] = []; _wtmap[t.assignedWaiterId] << (t.tableNumber ?: t.tableName ?: t.tableId) } }
            waiterRows = (waiters ?: []).collect { w ->
                def tbls = _wtmap[w.waiterId]
                [id: w.waiterId, name: (w.waiterName ?: ''), phone: (w.phone ?: ''), email: (w.email ?: ''),
                 active: (w.isActive != 'N'), notes: (w.notes ?: ''), init: _init(w.waiterName),
                 tables: (tbls ? ('Table ' + tbls.join(', ')) : '—')]
            }
            waiterCount = waiterRows.size()
        ]]></script>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <#assign fLbl="display:block;font-size:12.5px;font-weight:600;color:#374151;margin-bottom:6px">
        <#assign fInp="width:100%;box-sizing:border-box;height:42px;padding:0 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;color:#111827;background:#fff;outline:none">
        <#assign avColors=['#7C3AED','#2563EB','#0E9F6E','#B45309','#DC2626','#DB2777','#0891B2']>
        <input id="wf-token" type="hidden" value="${(moquiToken)!''}"/>

        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:22px">
            <div><div style="font-size:24px;font-weight:700;color:var(--z-text-main,#111827);line-height:1.2">Waiter Management</div><div style="font-size:13.5px;margin-top:4px;color:var(--z-text-muted,#6B7280)">Add, edit and remove waiter details for KOT operations</div></div>
            <button type="button" onclick="window.wfReset()" style="display:inline-flex;align-items:center;gap:7px;height:42px;padding:0 18px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:19px">add</span>Add New Waiter</button>
        </div>

        <div style="display:flex;gap:20px;flex-wrap:wrap;align-items:flex-start">
            <!-- LIST -->
            <div style="flex:1 1 560px;min-width:340px">
                <div style="background:var(--z-bg-card,#fff);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;box-shadow:0 1px 2px rgba(0,0,0,.04)">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:18px 20px;border-bottom:1px solid #EEF0F4">
                        <div style="font-size:16px;font-weight:700;color:#111827">Waiters (${waiterCount})</div>
                        <div style="display:flex;align-items:center;gap:10px">
                            <div style="position:relative"><span class="material-icons" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:18px;color:#9CA3AF">search</span><input id="wf-search" type="text" placeholder="Search waiters..." oninput="window.wfSearch()" style="height:38px;width:200px;box-sizing:border-box;padding:0 12px 0 36px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#111827;background:#fff;outline:none"/></div>
                            <button type="button" style="display:inline-flex;align-items:center;gap:6px;height:38px;padding:0 14px;border:1px solid #E5E7EB;border-radius:8px;background:#fff;color:#6B7280;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:17px">filter_list</span>Filters</button>
                        </div>
                    </div>
                    <div style="overflow-x:auto">
                    <table style="width:100%;border-collapse:collapse;font-size:13px">
                        <thead><tr style="text-align:left;color:#9CA3AF;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid #EEF0F4">
                            <th style="padding:12px 20px">Waiter Name</th><th style="padding:12px">Phone Number</th><th style="padding:12px">Status</th><th style="padding:12px">Assigned Tables</th><th style="padding:12px;text-align:right">Actions</th>
                        </tr></thead>
                        <tbody id="wf-tbody">
                        <#list waiterRows as w>
                            <#assign ci = w_index % (avColors?size)>
                            <tr class="wf-row" data-search="${((w.name + ' ' + w.phone)?lower_case)?html}" data-id="${(w.id)?html}" data-name="${(w.name)?html}" data-phone="${(w.phone)?html}" data-email="${(w.email)?html}" data-active="${w.active?string('Y','N')}" data-notes="${(w.notes)?html}" style="border-bottom:1px solid #F3F4F6">
                                <td style="padding:12px 20px"><div style="display:flex;align-items:center;gap:10px"><span style="width:30px;height:30px;flex:0 0 auto;border-radius:50%;background:${avColors[ci]}1f;color:${avColors[ci]};display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700">${(w.init)?html}</span><span style="font-weight:600;color:#111827">${(w.name)?html}</span></div></td>
                                <td style="padding:12px;color:#374151">${(w.phone)?html}</td>
                                <td style="padding:12px"><#if w.active><span style="display:inline-flex;align-items:center;padding:2px 10px;border-radius:99px;font-size:11.5px;font-weight:600;background:#ECFDF5;color:#059669">Active</span><#else><span style="display:inline-flex;align-items:center;padding:2px 10px;border-radius:99px;font-size:11.5px;font-weight:600;background:#F3F4F6;color:#6B7280">Inactive</span></#if></td>
                                <td style="padding:12px;color:#6B7280">${(w.tables)?html}</td>
                                <td style="padding:12px;text-align:right;white-space:nowrap">
                                    <button type="button" class="wf-edit" title="Edit" style="border:none;background:transparent;color:#7C3AED;cursor:pointer;padding:4px"><span class="material-icons" style="font-size:18px">edit</span></button>
                                    <button type="button" onclick="window.wfDel('${(w.id)?js_string}')" title="Delete" style="border:none;background:transparent;color:#DC2626;cursor:pointer;padding:4px"><span class="material-icons" style="font-size:18px">delete</span></button>
                                </td>
                            </tr>
                        </#list>
                        <#if !(waiterRows?has_content)><tr id="wf-empty"><td colspan="5" style="padding:32px;text-align:center;color:#9CA3AF">No waiters yet. Click &ldquo;Add New Waiter&rdquo; to add one.</td></tr></#if>
                        </tbody>
                    </table>
                    </div>
                    <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-top:1px solid #EEF0F4">
                        <span style="font-size:12.5px;color:#6B7280">Showing 1 to ${waiterCount} of ${waiterCount} waiters</span>
                        <div style="display:flex;gap:6px">
                            <button type="button" style="width:30px;height:30px;border:1px solid #E5E7EB;border-radius:8px;background:#fff;color:#C4C9D4;cursor:not-allowed">&#8249;</button>
                            <button type="button" style="width:30px;height:30px;border:1px solid #7C3AED;border-radius:8px;background:#7C3AED;color:#fff;font-weight:600">1</button>
                            <button type="button" style="width:30px;height:30px;border:1px solid #E5E7EB;border-radius:8px;background:#fff;color:#C4C9D4;cursor:not-allowed">&#8250;</button>
                        </div>
                    </div>
                </div>
                <div style="display:flex;align-items:flex-start;gap:12px;background:#F5F3FF;border:1px solid #E5E7EB;border-radius:12px;padding:14px 18px;margin-top:16px">
                    <span class="material-icons" style="font-size:20px;color:#7C3AED;flex:0 0 auto">lightbulb</span>
                    <div><div style="font-size:13px;font-weight:700;color:#111827">Tips</div><div style="font-size:12.5px;color:#6B7280;margin-top:2px">You can assign waiters to tables from the KOT screen while creating orders.</div></div>
                </div>
            </div>

            <!-- FORM -->
            <div style="flex:1 1 320px;min-width:300px;max-width:380px;background:var(--z-bg-card,#fff);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;box-shadow:0 1px 2px rgba(0,0,0,.04);padding:22px">
                <div id="wf-title" style="font-size:16px;font-weight:700;color:#111827;margin-bottom:18px">Add / Edit Waiter</div>
                <input id="wf-id" type="hidden" value=""/>
                <div style="margin-bottom:16px"><label style="${fLbl}">Waiter Name <span style="color:#EF4444">*</span></label><input id="wf-name" class="st-inp" type="text" placeholder="Enter waiter name" style="${fInp}"/></div>
                <div style="margin-bottom:16px"><label style="${fLbl}">Phone Number <span style="color:#EF4444">*</span></label>
                    <div style="display:flex;gap:8px">
                        <select id="wf-code" class="st-sel" style="${fInp};width:88px;flex:0 0 auto;padding:0 8px"><option value="+91">+91</option><option value="+1">+1</option><option value="+44">+44</option><option value="+971">+971</option></select>
                        <input id="wf-phone" class="st-inp" type="tel" placeholder="Enter phone number" style="${fInp}"/>
                    </div>
                </div>
                <div style="margin-bottom:16px"><label style="${fLbl}">Email Address</label><input id="wf-email" class="st-inp" type="email" placeholder="Enter email address (optional)" style="${fInp}"/></div>
                <div style="margin-bottom:16px"><label style="${fLbl}">Status <span style="color:#EF4444">*</span></label><select id="wf-status" class="st-sel" style="${fInp}"><option value="Y">Active</option><option value="N">Inactive</option></select></div>
                <div style="margin-bottom:18px"><label style="${fLbl}">Notes</label><textarea id="wf-notes" class="st-ta" placeholder="Enter any additional notes (optional)" style="${fInp};height:auto;min-height:84px;padding:10px 12px;resize:vertical"></textarea></div>
                <div style="display:flex;gap:10px">
                    <button type="button" onclick="window.wfReset()" style="flex:1;height:44px;border:1px solid #E5E7EB;border-radius:8px;background:#fff;color:#111827;font-size:14px;font-weight:600;cursor:pointer">Cancel</button>
                    <button type="button" id="wf-save" onclick="window.wfSave()" style="flex:1;height:44px;border:none;border-radius:8px;background:#7C3AED;color:#fff;font-size:14px;font-weight:600;cursor:pointer">Save Waiter</button>
                </div>
            </div>
        </div>

        <script>
        (function(){
            var tok=function(){ var t=''; try{ t=window.moqui.webrootVue.moquiSessionToken; }catch(e){} if(!t){ var h=document.getElementById('wf-token'); t=h?h.value:''; } return t; };
            var txUrl=function(n){ return location.pathname.replace(/\/$/,'') + '/' + n; };
            var g=function(id){ var e=document.getElementById(id); return e?(e.value||'').trim():''; };
            window.wfReset=function(){
                document.getElementById('wf-id').value=''; document.getElementById('wf-name').value='';
                document.getElementById('wf-code').value='+91'; document.getElementById('wf-phone').value='';
                document.getElementById('wf-email').value=''; document.getElementById('wf-status').value='Y';
                document.getElementById('wf-notes').value=''; document.getElementById('wf-title').textContent='Add / Edit Waiter';
                Array.prototype.forEach.call(document.querySelectorAll('.wf-row'), function(r){ r.style.background=''; });
                var n=document.getElementById('wf-name'); if(n) n.focus();
            };
            window.wfSearch=function(){
                var q=(document.getElementById('wf-search').value||'').toLowerCase();
                Array.prototype.forEach.call(document.querySelectorAll('.wf-row'), function(r){ r.style.display = (r.getAttribute('data-search')||'').indexOf(q) !== -1 ? '' : 'none'; });
            };
            Array.prototype.forEach.call(document.querySelectorAll('.wf-edit'), function(b){
                b.addEventListener('click', function(){
                    var r=b.closest('.wf-row'); if(!r) return;
                    document.getElementById('wf-id').value=r.getAttribute('data-id');
                    document.getElementById('wf-name').value=r.getAttribute('data-name')||'';
                    var ph=r.getAttribute('data-phone')||''; var m=ph.match(/^(\+\d+)\s+(.*)$/);
                    if(m){ document.getElementById('wf-code').value=m[1]; document.getElementById('wf-phone').value=m[2]; }
                    else { document.getElementById('wf-code').value='+91'; document.getElementById('wf-phone').value=ph; }
                    document.getElementById('wf-email').value=r.getAttribute('data-email')||'';
                    document.getElementById('wf-status').value=(r.getAttribute('data-active')==='N')?'N':'Y';
                    document.getElementById('wf-notes').value=r.getAttribute('data-notes')||'';
                    document.getElementById('wf-title').textContent='Edit Waiter';
                    Array.prototype.forEach.call(document.querySelectorAll('.wf-row'), function(x){ x.style.background=''; });
                    r.style.background='#F5F3FF';
                    try{ document.getElementById('wf-name').scrollIntoView({block:'center'}); }catch(e){}
                });
            });
            window.wfSave=function(){
                var name=g('wf-name'); if(!name){ alert('Waiter Name is required.'); return; }
                var num=g('wf-phone'); if(!num){ alert('Phone Number is required.'); return; }
                var phone=(g('wf-code')+' '+num).trim();
                var id=g('wf-id'); var upd=!!id;
                var body=new URLSearchParams();
                if(upd) body.append('waiterId', id);
                body.append('waiterName', name); body.append('phone', phone); body.append('email', g('wf-email'));
                body.append('isActive', document.getElementById('wf-status').value); body.append('notes', g('wf-notes'));
                body.append('moquiSessionToken', tok());
                var btn=document.getElementById('wf-save'); btn.disabled=true; btn.textContent='Saving...';
                fetch(txUrl(upd?'updateWaiter':'createWaiter'),{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body,credentials:'same-origin'})
                    .then(function(r){ location.href=r.url||location.href; }).catch(function(){ btn.disabled=false; btn.textContent='Save Waiter'; alert('Save failed - please try again.'); });
            };
            window.wfDel=function(id){
                if(!confirm('Delete this waiter? This cannot be undone.')) return;
                var body=new URLSearchParams(); body.append('waiterId', id); body.append('moquiSessionToken', tok());
                fetch(txUrl('deleteWaiter'),{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body,credentials:'same-origin'})
                    .then(function(r){ location.href=r.url||location.href; }).catch(function(){ alert('Delete failed.'); });
            };
        })();
        </script>
        ]]></text></render-mode>
    </widgets>
</screen>
