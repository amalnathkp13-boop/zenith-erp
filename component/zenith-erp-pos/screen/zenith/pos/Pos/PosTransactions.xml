<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Transactions" default-menu-index="3">

    <transition name="editTransaction"><default-response url="../EditTransaction"/></transition>

    <actions>
        <!-- ZE-SHOP: scope to the globally-selected shop's sessions (null = All Shops) -->
        <script>_shopSessions = null; try { def _sc = ec.service.sync().name("zenith.base.ShopServices.get#ActiveShopScope").parameter("includePosScope", true).call(); _shopSessions = _sc?.sessionIds } catch (Exception _e) {}</script>
        <entity-find entity-name="zenith.erp.pos.PosTransactionView" list="txnList">
            <search-form-inputs skip-fields="organizationPartyId,ownerPartyId" default-order-by="-entryDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="(ec.user.getPreference('ACTIVE_ORGANIZATION')) ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="sessionId" operator="in" from="_shopSessions" ignore-if-empty="true"/><!-- ZE-SHOP -->
        </entity-find>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_transactions" class="pos-reference-help" style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128203; Transactions &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">This is the record of <b>every bill</b> you have made &mdash; sales and returns.<br><b>1</b>&nbsp;Use the column filters (Date, Txn Number, Customer, Status) and press <b>Find</b> to locate a bill.<br><b>2</b>&nbsp;Click a bill&#39;s blue <b>ID</b> to open it and view or correct it.<br><b>3</b>&nbsp;Buttons at the top jump to Billing, Daily Summary or Reports. Use the <b>CSV</b> button to export the list.</div></details>]]></text></render-mode>
        <container style="q-pa-md">
            <label text="All POS Transactions" type="h5" style="text-weight-bold q-mb-md q-mt-none"/>
            <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md z-txntable z-listchrome">
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Transactions..." style="display:none"></span>]]></text></render-mode>
            <form-list name="AllTxnList" list="txnList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true" show-csv-button="true" show-all-button="true">
                    <row-actions>
                        <script><![CDATA[
                            def scMap = [PtCompleted:'success', PtVoided:'danger', PtCancelled:'grey', PtDraft:'warning', PtInProgress:'warning', PtReturned:'info', PtReversed:'grey']
                            def slMap = [PtCompleted:'Completed', PtVoided:'Voided', PtCancelled:'Cancelled', PtDraft:'Draft', PtInProgress:'In Progress', PtReturned:'Returned', PtReversed:'Reversed']
                            isCreditDue = (statusId == 'PtCompleted' && isCredit == 'Y' && ((payableAmount ?: 0) as BigDecimal) > ((paidAmount ?: 0) as BigDecimal))
                            if (isCreditDue) {
                                statusColor = 'info'
                                statusText = 'Credit — Due ' + zinr.inr(ec.l10n.format(((payableAmount ?: 0) as BigDecimal) - ((paidAmount ?: 0) as BigDecimal), '#,##0.00'))
                            } else {
                                statusColor = scMap[statusId] ?: 'grey'
                                statusText = slMap[statusId] ?: (statusId ? statusId.replace('Pt','') : '—')
                            }
                            payableDisp = zinr.inr(ec.l10n.format((payableAmount ?: 0) as BigDecimal, '#,##0.00'))
                            customerDisp = customerName ?: '—'
                        ]]></script>
                    </row-actions>
                    <field name="transactionId"><header-field title="ID"/>
                        <default-field><link url="editTransaction" text="${transactionId}" link-type="anchor"
                              parameter-map="[transactionId:transactionId]" style="z-bluelink"/></default-field></field>
                    <field name="transactionNumber"><header-field title="Txn Number" show-order-by="true"><text-find/></header-field>
                        <default-field><label text="${transactionNumber ?: ''}" type="span" style="text-dark"/></default-field></field>
                    <field name="transactionType"><header-field title="Type">
                            <drop-down allow-empty="true"><option key="Sale"/><option key="Return"/></drop-down></header-field>
                        <default-field><label text="${transactionType ?: ''}" type="span" style="text-dark"/></default-field></field>
                    <field name="entryDate"><header-field title="Date" show-order-by="true"><date-period/></header-field>
                        <default-field><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="terminalName"><header-field title="Terminal" show-order-by="true"/>
                        <conditional-field condition="terminalName"><label text="${terminalName}" type="span" style="zenith-badge nd success"/></conditional-field>
                        <default-field><label text="—" type="span" style="text-grey-6"/></default-field></field>
                    <field name="customerName"><header-field title="Customer"><text-find/></header-field>
                        <default-field><label text="${customerDisp}" type="span" style="${customerName ? 'text-dark' : 'text-grey-6'}"/></default-field></field>
                    <field name="totalTaxAmount"><header-field title="Tax"/>
                        <default-field><display format="#,##0.00"/></default-field></field>
                    <field name="payableAmount"><header-field title="Payable" show-order-by="true"/>
                        <default-field><link url="editTransaction" text="${payableDisp}" link-type="anchor"
                              parameter-map="[transactionId:transactionId]" style="z-bluelink"/></default-field></field>
                    <field name="statusId"><header-field title="Status">
                            <drop-down allow-empty="true"><entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="PosTransaction"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field><label text="${statusText}" type="span" style="zenith-badge nd ${statusColor}"/></default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </container>
        </container>
    </widgets>
</screen>
