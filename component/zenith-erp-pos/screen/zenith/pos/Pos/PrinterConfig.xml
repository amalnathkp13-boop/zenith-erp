<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Printers" default-menu-index="22">

    <parameter name="searchTerm"/>
    <parameter name="typeFilter"/>
    <parameter name="connFilter"/>
    <parameter name="statusFilter"/>
    <parameter name="termFilter"/>

    <transition name="createPrinter" method="post" begin-transaction="true">
        <actions>
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" in-map="[moduleId:(kitchenModuleId ?: 'pos')]" out-map="permission"/>
            <if condition="permission.canWrite != true"><return error="true" message="Printer settings are view-only."/></if>
            <if condition="!printerId?.trim() || !printerName?.trim()"><return error="true" message="Printer ID and name are required."/></if>
            <service-call name="zenith.pos.PosAccessServices.assert#PosAccess" in-map="[terminalId:terminalId, templateId:posReceiptTemplateId]" out-map="scope"/>
            <if condition="!scope.allowed"><return/></if>
            <if condition="posReceiptTemplateId">
                <entity-find-one entity-name="zenith.erp.pos.PosReceiptTemplate" value-field="linkedTemplate"><field-map field-name="templateId" from="posReceiptTemplateId"/></entity-find-one>
                <if condition="linkedTemplate.printUse"><return error="true" message="Set KOT print designs in KOT Receipts."/></if>
                <if condition="terminalId">
                    <entity-find-one entity-name="zenith.erp.pos.PosTerminal" value-field="linkedTerminal"><field-map field-name="terminalId"/></entity-find-one>
                    <if condition="linkedTemplate.facilityId &amp;&amp; linkedTemplate.facilityId != linkedTerminal.facilityId">
                        <return error="true" message="Choose a receipt template for this terminal’s shop."/>
                    </if>
                </if>
            </if>
            <service-call name="create#zenith.erp.pos.PrinterConfiguration" in-map="[printerId:printerId, organizationPartyId:scope.organizationPartyId, printerName:printerName,
                         printerTypeEnumId:printerTypeEnumId, connectionType:connectionType, ipAddress:ipAddress, port:port,
                         terminalId:terminalId ?: null, posReceiptTemplateId:posReceiptTemplateId ?: null, isActive:isActive]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updatePrinter" method="post" begin-transaction="true">
        <actions>
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" in-map="[moduleId:(kitchenModuleId ?: 'pos')]" out-map="permission"/>
            <if condition="permission.canWrite != true"><return error="true" message="Printer settings are view-only."/></if>
            <if condition="!printerId?.trim() || !printerName?.trim()"><return error="true" message="Printer ID and name are required."/></if>
            <service-call name="zenith.pos.PosAccessServices.assert#PosAccess" in-map="[printerId:printerId, terminalId:terminalId, templateId:posReceiptTemplateId]" out-map="scope"/>
            <if condition="!scope.allowed"><return/></if>
            <if condition="posReceiptTemplateId">
                <entity-find-one entity-name="zenith.erp.pos.PosReceiptTemplate" value-field="linkedTemplate"><field-map field-name="templateId" from="posReceiptTemplateId"/></entity-find-one>
                <if condition="linkedTemplate.printUse"><return error="true" message="Set KOT print designs in KOT Receipts."/></if>
                <if condition="terminalId">
                    <entity-find-one entity-name="zenith.erp.pos.PosTerminal" value-field="linkedTerminal"><field-map field-name="terminalId"/></entity-find-one>
                    <if condition="linkedTemplate.facilityId &amp;&amp; linkedTemplate.facilityId != linkedTerminal.facilityId">
                        <return error="true" message="Choose a receipt template for this terminal’s shop."/>
                    </if>
                </if>
            </if>
            <service-call name="update#zenith.erp.pos.PrinterConfiguration" in-map="[printerId:printerId, organizationPartyId:scope.organizationPartyId, printerName:printerName,
                         printerTypeEnumId:printerTypeEnumId, connectionType:connectionType, ipAddress:ipAddress, port:port,
                         terminalId:terminalId ?: null, isActive:isActive] +
                         (ec.web.parameters.containsKey('posReceiptTemplateId') ?
                            [posReceiptTemplateId:posReceiptTemplateId ?: null, receiptTemplateId:null] : [:])"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="deletePrinter" method="post" begin-transaction="true">
        <actions>
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" in-map="[moduleId:(kitchenModuleId ?: 'pos')]" out-map="permission"/>
            <if condition="permission.canWrite != true"><return error="true" message="Printer settings are view-only."/></if>
            <if condition="!printerId"><return error="true" message="Choose a printer."/></if>
            <service-call name="zenith.pos.PosAccessServices.assert#PosAccess" in-map="[printerId:printerId]" out-map="scope"/>
            <if condition="!scope.allowed"><return/></if>
            <service-call name="delete#zenith.erp.pos.PrinterConfiguration" in-map="[printerId:printerId]"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.pos.PrinterConfiguration" list="allPrinters">
            <econdition field-name="organizationPartyId" from="posOrganizationPartyId ?: '__NO_ORGANIZATION__'"/>
            <order-by field-name="printerName"/>
        </entity-find>
        <entity-find entity-name="moqui.basic.Enumeration" list="printerTypeEnums">
            <econdition field-name="enumTypeId" value="PrinterType"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.pos.PosTerminal" list="allTerminals">
            <econdition field-name="organizationPartyId" from="posOrganizationPartyId ?: '__NO_ORGANIZATION__'"/>
            <order-by field-name="terminalName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.pos.PosReceiptTemplate" list="receiptTemplates">
            <econdition field-name="isActive" value="Y"/>
            <econdition field-name="printUse" from="null"/>
            <econdition field-name="organizationPartyId" from="posOrganizationPartyId ?: '__NO_ORGANIZATION__'"/>
            <order-by field-name="templateName"/>
        </entity-find>
        <script><![CDATA[
            // KPI stats from the full (unfiltered) set.
            totalPrinters = allPrinters.size()
            activePrinters = allPrinters.count { it.isActive == 'Y' }
            inactivePrinters = totalPrinters - activePrinters
            def templateIds = receiptTemplates*.templateId as Set
            def currentTemplate = { printer -> printer.posReceiptTemplateId ?:
                (templateIds.contains(printer.receiptTemplateId) ? printer.receiptTemplateId : null) }
            templatesCount = allPrinters.collect(currentTemplate).findAll { it }.unique().size()
            hasPrinters = totalPrinters > 0
            // lookups for search + display
            def typeDesc = [:]; printerTypeEnums.each { typeDesc[it.enumId] = it.description }
            def termName = [:]; allTerminals.each { termName[it.terminalId] = it.terminalName }
            // apply the toolbar filters in-memory (the printer list is small).
            def st = (searchTerm ?: '').toLowerCase().trim()
            printerList = allPrinters.findAll { pr ->
                (st == '' || [pr.printerName, pr.ipAddress, pr.connectionType, (typeDesc[pr.printerTypeEnumId] ?: ''), (termName[pr.terminalId] ?: '')].collect { (it ?: '').toString().toLowerCase() }.any { it.contains(st) }) &&
                (!typeFilter || pr.printerTypeEnumId == typeFilter) &&
                (!connFilter || pr.connectionType == connFilter) &&
                (!statusFilter || pr.isActive == statusFilter) &&
                (!termFilter || pr.terminalId == termFilter)
            }.collect { pr -> new LinkedHashMap(pr) + [posReceiptTemplateId:currentTemplate(pr)] }
        ]]></script>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_printers" style="background:#EEF2FF;border:1px solid #C7D2FE;border-left:5px solid #6366F1;border-radius:10px;padding:9px 16px;margin:8px 16px 0 16px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:700;font-size:14px;color:#3730A3;outline:none">&#128424; Printers &mdash; quick help <span style="font-weight:500;color:#6B7280;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px"><#if (kitchenModuleId!'pos') == 'kot'>Set your kitchen ticket and customer bill designs in KOT Receipts. Until a KOT bill design is set, the terminal can use its existing thermal receipt template. Choose the physical printer in the browser print dialog.<#else>Set up your receipt and kitchen printers.<br><b>1</b>&nbsp;<b>Add Printer</b> with its type and connection.<br><b>2</b>&nbsp;Assign each printer to the terminal that should use it.</#if></div></details>]]></text></render-mode>

        <container style="q-px-md q-pt-md">
            <!-- Page header: printer icon + title + subtitle; Add Printer top-right when printers exist -->
            <container style="zsec-hdr row items-center q-mb-lg">
                <container style="row items-center no-wrap">
                    <container style="z-icobadge lg primary q-mr-md"><label text="print" type="span" style="material-icons"/></container>
                    <container style="column">
                        <label text="Printer Configuration" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="Add, manage and configure printers for billing." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
                    </container>
                </container>
                <section name="AddBtnHdr"><condition><expression>hasPrinters</expression></condition><widgets>
                <render-mode><text type="html,qvt" template="true"><![CDATA[
                    <#if (modCanWrite!false)><button type="button" onclick="var o=document.getElementById('pm-overlay');if(o)o.style.display='flex'" style="display:inline-flex;align-items:center;gap:6px;padding:9px 16px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap"><span class="material-icons" style="font-size:18px">add</span>Add Printer</button></#if>
                ]]></text></render-mode>
                </widgets></section>
            </container>

            <!-- KPI stat cards: Total(violet) / Active(green) / Inactive(grey) / Templates(blue) -->
            <container style="z-statrow">
                <container style="z-statcell z-statcard-violet q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg primary"><label text="print" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Total Printers" type="span" style="z-statlabel"/>
                            <label text="${totalPrinters ?: 0}" type="span" style="z-statnum z-txt-primary"/>
                            <label text="All configured printers" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
                <container style="z-statcell z-statcard-green q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg green"><label text="check_circle" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Active Printers" type="span" style="z-statlabel"/>
                            <label text="${activePrinters ?: 0}" type="span" style="z-statnum z-amt-green"/>
                            <label text="Ready for use" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
                <container style="z-statcell z-statcard-grey q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg grey"><label text="power_settings_new" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Inactive Printers" type="span" style="z-statlabel"/>
                            <label text="${inactivePrinters ?: 0}" type="span" style="z-statnum"/>
                            <label text="Not in use" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
                <container style="z-statcell z-statcard-blue q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg blue"><label text="settings" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Templates" type="span" style="z-statlabel"/>
                            <label text="${templatesCount ?: 0}" type="span" style="z-statnum z-amt-blue"/>
                            <label text="Assigned to printers" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
            </container>
        </container>

        <!-- Toolbar: search + type / connection / status filters + More Filters (reveals terminal filter) -->
        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <div style="margin:2px 16px 0;font-family:'Segoe UI',Arial,sans-serif">
          <form method="get" action="${sri.buildUrl('.').url?html}" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
            <div style="position:relative;flex:1;min-width:240px">
              <span class="material-icons" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:18px;color:#9CA3AF;pointer-events:none">search</span>
              <input type="text" name="searchTerm" value="${(searchTerm!'')?html}" placeholder="Search by printer name, type, IP address or terminal..." style="width:100%;padding:9px 12px 9px 36px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;box-sizing:border-box;background:#fff"/>
            </div>
            <select name="typeFilter" onchange="this.form.submit()" style="padding:9px 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#374151;background:#fff">
              <option value="">All Types</option>
              <#list (printerTypeEnums![]) as e>
                <option value="${e.enumId}" <#if (typeFilter!'')==e.enumId>selected</#if>>${(e.description!e.enumId)?html}</option>
              </#list>
            </select>
            <select name="connFilter" onchange="this.form.submit()" style="padding:9px 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#374151;background:#fff">
              <option value="">All Connections</option>
              <option value="USB" <#if (connFilter!'')=='USB'>selected</#if>>USB</option>
              <option value="Network" <#if (connFilter!'')=='Network'>selected</#if>>Network</option>
              <option value="Bluetooth" <#if (connFilter!'')=='Bluetooth'>selected</#if>>Bluetooth</option>
            </select>
            <select name="statusFilter" onchange="this.form.submit()" style="padding:9px 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#374151;background:#fff">
              <option value="">All Status</option>
              <option value="Y" <#if (statusFilter!'')=='Y'>selected</#if>>Active</option>
              <option value="N" <#if (statusFilter!'')=='N'>selected</#if>>Inactive</option>
            </select>
            <button type="button" onclick="var r=document.getElementById('prnMoreRow');if(r)r.style.display=(r.style.display==='none'?'flex':'none');" style="display:inline-flex;align-items:center;gap:6px;padding:9px 14px;border:1px solid #E5E7EB;border-radius:8px;background:#fff;color:#374151;font-size:13px;font-weight:500;cursor:pointer"><span class="material-icons" style="font-size:16px">filter_list</span>More Filters</button>
            <button type="submit" style="display:inline-flex;align-items:center;gap:6px;padding:9px 18px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:16px">search</span>Search</button>
            <div id="prnMoreRow" style="<#if (termFilter!'')?has_content>display:flex<#else>display:none</#if>;flex-basis:100%;align-items:center;gap:8px;font-size:13px;color:#374151;padding-top:2px">
              <span style="color:#6B7280">Terminal:</span>
              <select name="termFilter" onchange="this.form.submit()" style="padding:8px 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#374151;background:#fff">
                <option value="">All terminals</option>
                <#list (allTerminals![]) as t>
                  <option value="${t.terminalId}" <#if (termFilter!'')==t.terminalId>selected</#if>>${(t.terminalName!t.terminalId)?html}</option>
                </#list>
              </select>
            </div>
          </form>
        </div>
        ]]></text></render-mode>

        <container style="q-pa-md">
            <!-- Empty state (no printers configured at all) -->
            <section name="EmptyState"><condition><expression>!hasPrinters</expression></condition><widgets>
            <container style="zenith-card bg-white shadow-2 border-radius-lg">
                <container style="prn-empty">
                    <container style="prn-empty-ico"><label text="print" type="span" style="material-icons"/></container>
                    <label text="No printers configured yet" type="span" style="prn-empty-h"/>
                    <label text="Add a printer to start printing bills, receipts and kitchen orders." type="span" style="prn-empty-p"/>
                    <render-mode><text type="html,qvt" template="true"><![CDATA[
                        <#if (modCanWrite!false)><button type="button" onclick="var o=document.getElementById('pm-overlay');if(o)o.style.display='flex'" style="display:inline-flex;align-items:center;gap:6px;padding:10px 18px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:18px">add</span>Add Printer</button></#if>
                    ]]></text></render-mode>
                </container>
            </container>
            </widgets></section>

            <!-- Printer table (inline-editable rows) -->
            <section name="TableState"><condition><expression>hasPrinters</expression></condition><widgets>
            <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md z-txntable">
                <form-list name="PrinterListForm" list="printerList" transition="updatePrinter">
                    <field name="printerId"><header-field title="ID"/><default-field><display/></default-field></field>
                    <field name="printerName"><header-field title="Name"/><default-field title="Name"><text-line size="18"/></default-field></field>
                    <field name="printerTypeEnumId"><header-field title="Type"/><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}"><entity-find entity-name="moqui.basic.Enumeration"><econdition field-name="enumTypeId" value="PrinterType"/><order-by field-name="sequenceNum"/></entity-find></entity-options></drop-down></default-field></field>
                    <field name="connectionType"><header-field title="Connection"/><default-field title="Connection">
                        <drop-down><option key="USB" text="USB"/><option key="Network" text="Network"/><option key="Bluetooth" text="Bluetooth"/></drop-down></default-field></field>
                    <field name="ipAddress"><header-field title="IP Address"/><default-field title="IP Address"><text-line size="14"/></default-field></field>
                    <field name="port"><header-field title="Port"/><default-field title="Port"><text-line size="6"/></default-field></field>
                    <field name="terminalId"><header-field title="Terminal"/><default-field title="Terminal">
                        <drop-down allow-empty="true"><entity-options key="${terminalId}" text="${terminalName}"><entity-find entity-name="zenith.erp.pos.PosTerminal"><econdition field-name="organizationPartyId" from="posOrganizationPartyId ?: '__NO_ORGANIZATION__'"/><order-by field-name="terminalName"/></entity-find></entity-options></drop-down></default-field></field>
                    <field name="posReceiptTemplateId"><header-field title="Template"/><default-field title="Template">
                        <drop-down allow-empty="true"><entity-options key="${templateId}" text="${templateName}"><entity-find entity-name="zenith.erp.pos.PosReceiptTemplate"><econdition field-name="printUse" from="null"/><econdition field-name="organizationPartyId" from="posOrganizationPartyId ?: '__NO_ORGANIZATION__'"/><order-by field-name="templateName"/></entity-find></entity-options></drop-down></default-field></field>
                    <field name="isActive"><header-field title="Status"/><default-field title="Status">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitBtn"><header-field title="Actions"/><conditional-field name="printer_update_write" condition="modCanWrite" title="Actions"><submit text="Update"/></conditional-field>
                        <default-field><label text="" type="span"/></default-field></field>
                    <field name="deleteBtn"><header-field title=""/><conditional-field name="printer_delete_write" condition="modCanWrite" title="">
                        <link url="deletePrinter" text="Delete" btn-type="danger" style="q-btn--dense"
                              parameter-map="[printerId:printerId]" link-type="hidden-form" confirmation="Delete this printer?"/>
                    </conditional-field><default-field><label text="" type="span"/></default-field></field>
                </form-list>
            </container>
            </widgets></section>
        </container>

        <!-- Add Printer modal -->
        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <#if (modCanWrite!false)>
        <div id="pm-overlay" style="display:none;position:fixed;inset:0;background:rgba(17,24,39,.45);z-index:12000;align-items:flex-start;justify-content:center;padding:36px 16px;overflow-y:auto;font-family:'Segoe UI',Arial,sans-serif">
            <form method="post" action="${sri.buildUrl('createPrinter').url?html}" style="background:#fff;border-radius:12px;box-shadow:0 20px 40px rgba(17,24,39,.25);width:100%;max-width:700px;max-height:92vh;overflow-y:auto">
                <input type="hidden" name="moquiSessionToken" value="${(ec.web.sessionToken!'')?html}"/>
                <div style="display:flex;align-items:center;gap:14px;padding:20px 24px;border-bottom:1px solid #E5E7EB">
                    <span class="z-icobadge lg primary"><span class="material-icons">print</span></span>
                    <div style="flex:1;min-width:0">
                        <div style="font-size:18px;font-weight:700;color:#111827">Add Printer</div>
                        <div style="font-size:12.5px;color:#6B7280">Configure the printer settings to use it at the billing counter.</div>
                    </div>
                    <button type="button" onclick="document.getElementById('pm-overlay').style.display='none'" title="Close" style="width:32px;height:32px;border:none;background:transparent;color:#6B7280;cursor:pointer;border-radius:8px;display:flex;align-items:center;justify-content:center"><span class="material-icons">close</span></button>
                </div>
                <#assign pmRow="display:flex;align-items:center;gap:14px;margin-bottom:16px">
                <#assign pmLbl="width:150px;flex:0 0 auto;font-size:13px;font-weight:500;color:#374151">
                <#assign pmCtl="flex:1;min-width:0;height:40px;box-sizing:border-box;padding:0 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#111827;background:#fff;outline:none">
                <div style="padding:24px">
                    <div style="${pmRow}"><span class="z-icobadge primary" style="flex:0 0 auto"><span class="material-icons">tag</span></span><label for="pm-printerId" style="${pmLbl}">Printer ID <span style="color:#DC2626">*</span></label><input id="pm-printerId" name="printerId" required type="text" placeholder="Enter printer ID" style="${pmCtl}"/></div>
                    <div style="${pmRow}"><span class="z-icobadge primary" style="flex:0 0 auto"><span class="material-icons">print</span></span><label for="pm-printerName" style="${pmLbl}">Printer Name <span style="color:#DC2626">*</span></label><input id="pm-printerName" name="printerName" required type="text" placeholder="Enter printer name" style="${pmCtl}"/></div>
                    <div style="${pmRow}"><span class="z-icobadge primary" style="flex:0 0 auto"><span class="material-icons">description</span></span><label for="pm-printerType" style="${pmLbl}">Printer Type</label><select id="pm-printerType" name="printerTypeEnumId" style="${pmCtl}"><#list (printerTypeEnums![]) as e><option value="${(e.enumId)?html}">${(e.description!e.enumId)?html}</option></#list></select></div>
                    <div style="${pmRow}"><span class="z-icobadge primary" style="flex:0 0 auto"><span class="material-icons">link</span></span><label for="pm-connType" style="${pmLbl}">Connection Type</label><select id="pm-connType" name="connectionType" style="${pmCtl}"><option value="USB">USB</option><option value="Network">Network (TCP/IP)</option><option value="Bluetooth">Bluetooth</option></select></div>
                    <div style="${pmRow}"><span class="z-icobadge primary" style="flex:0 0 auto"><span class="material-icons">wifi</span></span><label for="pm-ip" style="${pmLbl}">IP Address</label><input id="pm-ip" name="ipAddress" type="text" placeholder="Enter IP address" style="${pmCtl}"/></div>
                    <div style="${pmRow}"><span class="z-icobadge primary" style="flex:0 0 auto"><span class="material-icons">dns</span></span><label for="pm-port" style="${pmLbl}">Port</label><input id="pm-port" name="port" type="text" placeholder="Enter port number" style="${pmCtl}"/></div>
                    <div style="${pmRow}"><span class="z-icobadge primary" style="flex:0 0 auto"><span class="material-icons">desktop_windows</span></span><label for="pm-terminal" style="${pmLbl}">Linked Terminal</label><select id="pm-terminal" name="terminalId" style="${pmCtl}"><option value="">Select terminal</option><#list (allTerminals![]) as t><option value="${(t.terminalId)?html}">${(t.terminalName!t.terminalId)?html}</option></#list></select></div>
                    <div style="${pmRow}"><span class="z-icobadge primary" style="flex:0 0 auto"><span class="material-icons">description</span></span><label for="pm-template" style="${pmLbl}">Receipt Template</label><select id="pm-template" name="posReceiptTemplateId" style="${pmCtl}"><option value="">Select receipt template</option><#list (receiptTemplates![]) as rt><option value="${(rt.templateId)?html}">${(rt.templateName!rt.templateId)?html}</option></#list></select></div>
                    <div style="display:flex;align-items:center;gap:14px;margin-bottom:0"><span class="z-icobadge primary" style="flex:0 0 auto"><span class="material-icons">visibility</span></span><label style="${pmLbl}">Active</label><div style="flex:1;display:flex;align-items:center;gap:10px"><label class="pp-switch"><input type="hidden" name="isActive" value="Y"/><input type="checkbox" id="pm-active" checked onchange="this.form.elements.isActive.value=this.checked?'Y':'N';var l=document.getElementById('pm-active-lbl');if(l)l.textContent=this.checked?'Yes':'No';"/><span class="pp-switch-sl"></span></label><span id="pm-active-lbl" style="font-size:13px;color:#374151">Yes</span></div></div>
                </div>
                <div style="display:flex;justify-content:flex-end;gap:12px;padding:16px 24px;border-top:1px solid #E5E7EB">
                    <button type="button" onclick="document.getElementById('pm-overlay').style.display='none'" style="height:40px;padding:0 20px;background:#fff;color:#111827;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer">Cancel</button>
                    <button type="submit" id="pm-save" style="display:inline-flex;align-items:center;gap:7px;height:40px;padding:0 20px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:18px">save</span>Save</button>
                </div>
            </form>
        </div>
        </#if>
        ]]></text></render-mode>
    </widgets>
</screen>
