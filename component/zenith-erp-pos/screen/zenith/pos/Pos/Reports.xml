    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_reports" class="pos-reference-help" style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128202; Reports &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">See your sales broken down different ways.<br><b>1</b>&nbsp;Pick a tab &mdash; <b>Bill Wise</b>, <b>Item Wise</b>, <b>Payment Wise</b>, <b>User Wise</b> or <b>Cancelled Bills</b>.<br><b>2</b>&nbsp;Set the <b>date range</b> and press <b>View</b>.<br><b>3</b>&nbsp;Export any list with the <b>CSV / Excel</b> button.</div></details>]]></text></render-mode>
