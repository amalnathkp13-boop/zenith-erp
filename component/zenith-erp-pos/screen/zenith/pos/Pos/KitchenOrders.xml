<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Kitchen Orders (KOT)" default-menu-include="false">

    <transition name="updateKotStatus">
        <service-call name="zenith.pos.KotServices.update#KotStatus"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.pos.KitchenOrderTicket" list="kots">
            <search-form-inputs skip-fields="organizationPartyId,ownerPartyId" default-order-by="-createdDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="(ec.user.getPreference('ACTIVE_ORGANIZATION')) ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_kitchenorders" open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#127869; Kitchen Orders (KOT) &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Live kitchen order tickets sent from billing.<br>Mark items as <b>prepared / served</b> as the kitchen works through them.</div></details>]]></text></render-mode>
        <container style="q-mb-lg">
            <label text="Kitchen Order Tickets" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Kitchen Orders (KOT)..." style="display:none"></span>]]></text></render-mode>
            <form-list name="KotForm" list="kots" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="kotId"><default-field title="KOT #"><display/></default-field></field>
                <field name="posTransactionId"><default-field title="Transaction"><display/></default-field></field>
                <field name="tableNumber"><default-field title="Table"><display/></default-field></field>
                <field name="waiterName"><default-field title="Waiter"><display/></default-field></field>
                <field name="createdDate"><default-field title="Created"><display format="dd-MMM HH:mm"/></default-field></field>
                <field name="printCount"><default-field title="Prints"><display/></default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="KotNew" text="New"/><option key="KotPreparing" text="Preparing"/>
                        <option key="KotReady" text="Ready"/><option key="KotServed" text="Served"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field></field>
                <field name="actions"><default-field title="">
                    <link url="updateKotStatus" text="Preparing"
                          parameter-map="[kotId:kotId, statusId:'KotPreparing']"
                          condition="modCanWrite &amp;&amp; statusId == 'KotNew'" btn-type="info" style="q-btn--dense"/>
                    <link url="updateKotStatus" text="Ready"
                          parameter-map="[kotId:kotId, statusId:'KotReady']"
                          condition="modCanWrite &amp;&amp; statusId == 'KotPreparing'" btn-type="warning" style="q-btn--dense"/>
                    <link url="updateKotStatus" text="Served"
                          parameter-map="[kotId:kotId, statusId:'KotServed']"
                          condition="modCanWrite &amp;&amp; statusId == 'KotReady'" btn-type="success" style="q-btn--dense"/>
                </default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
