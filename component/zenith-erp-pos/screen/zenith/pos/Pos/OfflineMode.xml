<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Offline Mode" default-menu-index="20">

    <transition name="saveOfflineConfig">
        <actions>
            <entity-find-one entity-name="zenith.erp.pos.PosOfflineConfig" value-field="existing">
                <field-map field-name="terminalId"/></entity-find-one>
            <if condition="existing">
                <service-call name="update#zenith.erp.pos.PosOfflineConfig"
                    in-map="context"/>
                <else>
                    <service-call name="create#zenith.erp.pos.PosOfflineConfig"
                        in-map="context"/>
                </else>
            </if>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="syncOfflineTransaction">
        <actions>
            <entity-find-one entity-name="zenith.erp.pos.PosOfflineTransaction" value-field="offlineTxn"/>
            <if condition="offlineTxn">
                <set field="offlineTxn.statusId" value="OtSynced"/>
                <set field="offlineTxn.syncedTimestamp" from="ec.user.nowTimestamp"/>
                <entity-update value-field="offlineTxn"/>
                <message>Transaction synced successfully.</message>
            </if>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="retrySync">
        <actions>
            <entity-find-one entity-name="zenith.erp.pos.PosOfflineTransaction" value-field="offlineTxn"/>
            <if condition="offlineTxn">
                <set field="offlineTxn.statusId" value="OtPending"/>
                <set field="offlineTxn.syncAttempts" from="(offlineTxn.syncAttempts ?: 0) + 1"/>
                <entity-update value-field="offlineTxn"/>
                <message>Transaction queued for retry.</message>
            </if>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owning PosTerminal -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="zenith.erp.pos.PosTerminal" list="_expOwnerRows"><econdition field-name="organizationPartyId" from="_expOrg"/><select-field field-name="terminalId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.terminalId} : ['__none__']"/>
        </if>

        <!-- Get all terminals -->
        <entity-find entity-name="zenith.erp.pos.PosTerminal" list="terminals">
            <econdition field-name="isActive" value="Y"/>
            <!-- ZE-SALES-014 f/u: isolate the terminal/config list too — this is a MULTI-LIST screen and the
                 CSV export renders every form-list, so terminalConfigList (built from these terminals) leaked. -->
            <econdition field-name="organizationPartyId" from="(ec.user.getPreference('ACTIVE_ORGANIZATION')) ?: '__NO_ORGANIZATION__'"/>
        </entity-find>

        <!-- Get offline configs -->
        <entity-find entity-name="zenith.erp.pos.PosOfflineConfig" list="offlineConfigs"/>

        <!-- Get pending offline transactions -->
        <entity-find entity-name="zenith.erp.pos.PosOfflineTransaction" list="pendingList">
            <econdition field-name="statusId" operator="in" value="OtPending,OtFailed"/>
            <econdition field-name="terminalId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
            <order-by field-name="-offlineTimestamp"/>
        </entity-find>

        <!-- Get recently synced -->
        <entity-find entity-name="zenith.erp.pos.PosOfflineTransaction" list="syncedList">
            <econdition field-name="statusId" value="OtSynced"/>
            <econdition field-name="terminalId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
            <order-by field-name="-syncedTimestamp"/>
            <limit count="20"/>
        </entity-find>

        <!-- Summary counts -->
        <entity-find-count entity-name="zenith.erp.pos.PosOfflineTransaction" count-field="pendingCount">
            <econdition field-name="statusId" value="OtPending"/>
            <econdition field-name="terminalId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.pos.PosOfflineTransaction" count-field="failedCount">
            <econdition field-name="statusId" value="OtFailed"/>
            <econdition field-name="terminalId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find-count>
        <set field="enabledTerminals" from="offlineConfigs?.findAll { it.offlineEnabled == 'Y' }?.size() ?: 0"/>

        <script><![CDATA[
            def _uri = (ec.web?.request?.requestURI ?: '')
            def _zi = _uri.indexOf('/zenith/')
            appBase = _zi > 0 ? _uri.substring(0, _zi) : ''

            // "Synced Today" count (org-scoped) — synced since local midnight.
            def _todayStart = java.sql.Timestamp.valueOf(ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd') + ' 00:00:00')
            def _sc = ec.entity.find("zenith.erp.pos.PosOfflineTransaction").condition("statusId", "OtSynced").condition("syncedTimestamp", "greater-equals", _todayStart)
            if (_expOwnerIds) _sc.condition("terminalId", "in", _expOwnerIds)
            syncedTodayCount = _sc.count()

            terminalConfigList = []
            for (term in terminals) {
                def conf = offlineConfigs.find { it.terminalId == term.terminalId }
                terminalConfigList.add([
                    terminalId: term.terminalId,
                    terminalName: term.terminalName,
                    offlineEnabled: conf?.offlineEnabled ?: 'N',
                    maxOfflineTransactions: (conf?.maxOfflineTransactions ?: 100) as Integer,
                    maxOfflineHours: (conf?.maxOfflineHours ?: 24) as Integer,
                    autoSyncIntervalMinutes: (conf?.autoSyncIntervalMinutes ?: 5) as Integer,
                    syncProductCatalog: conf?.syncProductCatalog ?: 'Y'
                ])
            }
        ]]></script>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_offline" style="background:#EEF2FF;border:1px solid #C7D2FE;border-left:5px solid #6366F1;border-radius:10px;padding:9px 16px;margin:8px 16px 0 16px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:700;font-size:14px;color:#3730A3;outline:none">&#128244; Offline Mode &mdash; quick help <span style="font-weight:500;color:#6B7280;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Lets terminals keep billing when the internet drops &mdash; sales sync once it is back.<br><b>1</b>&nbsp;<b>Enable</b> it for the terminals that need it, then <b>Save Changes</b>.<br><b>2</b>&nbsp;Watch the <b>Pending</b> / <b>Failed</b> counts and re-sync if anything is stuck.</div></details>]]></text></render-mode>

        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <div style="padding:16px 16px 0;font-family:'Segoe UI',Arial,sans-serif">
            <!-- Page header -->
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px">
                <span class="z-icobadge lg primary"><span class="material-icons">wifi</span></span>
                <div>
                    <div style="font-size:20px;font-weight:800;color:#111827;line-height:1.3">POS Offline Mode</div>
                    <div style="font-size:13px;color:#6B7280;line-height:1.5">Configure offline capabilities and manage transaction sync queue.</div>
                </div>
            </div>

            <!-- KPI stat cards -->
            <div class="z-statrow">
                <div class="z-statcell z-statcard-blue" style="padding:16px"><div class="z-statinner"><span class="z-icobadge lg blue"><span class="material-icons">desktop_windows</span></span><div class="z-statmeta"><span class="z-statnum z-amt-blue">${enabledTerminals!0}</span><span class="z-statlabel">Enabled Terminals</span></div></div></div>
                <div class="z-statcell z-statcard-orange" style="padding:16px"><div class="z-statinner"><span class="z-icobadge lg orange"><span class="material-icons">sync</span></span><div class="z-statmeta"><span class="z-statnum z-txt-orange">${pendingCount!0}</span><span class="z-statlabel">Pending Sync</span></div></div></div>
                <div class="z-statcell z-statcard-red" style="padding:16px"><div class="z-statinner"><span class="z-icobadge lg red"><span class="material-icons">error</span></span><div class="z-statmeta"><span class="z-statnum" style="color:#DC2626">${failedCount!0}</span><span class="z-statlabel">Failed</span></div></div></div>
                <div class="z-statcell z-statcard-green" style="padding:16px"><div class="z-statinner"><span class="z-icobadge lg green"><span class="material-icons">check_circle</span></span><div class="z-statmeta"><span class="z-statnum z-amt-green">${syncedTodayCount!0}</span><span class="z-statlabel">Synced Today</span></div></div></div>
            </div>

            <!-- Terminal Offline Configuration -->
            <div style="background:#fff;border:1px solid #E5E7EB;border-radius:12px;margin-top:18px;overflow:hidden">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:16px 20px">
                    <div style="display:flex;align-items:center;gap:10px">
                        <span class="z-icobadge primary"><span class="material-icons">settings</span></span>
                        <span style="font-size:15px;font-weight:700;color:#111827">Terminal Offline Configuration</span>
                    </div>
                    <#if (modCanWrite!false)>
                    <button type="button" id="omSaveBtn" style="display:inline-flex;align-items:center;gap:6px;padding:9px 16px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:16px">save</span>Save Changes</button>
                    </#if>
                </div>
                <div style="overflow-x:auto">
                <table style="width:100%;border-collapse:collapse;font-size:13px;min-width:860px">
                    <thead>
                        <tr style="text-align:left;color:#6B7280;border-top:1px solid #F1F1F4;border-bottom:1px solid #E5E7EB">
                            <th style="padding:11px 20px;font-weight:600">Terminal</th>
                            <th style="padding:11px 16px;font-weight:600">Offline Enabled</th>
                            <th style="padding:11px 16px;font-weight:600">Max Txns</th>
                            <th style="padding:11px 16px;font-weight:600">Max Hours</th>
                            <th style="padding:11px 16px;font-weight:600">Sync Interval (min)</th>
                            <th style="padding:11px 16px;font-weight:600">Cache Catalog</th>
                        </tr>
                    </thead>
                    <tbody>
                        <#list (terminalConfigList![]) as t>
                        <tr class="om-row" data-tid="${(t.terminalId)?html}" style="border-bottom:1px solid #F1F1F4">
                            <td style="padding:12px 20px;color:#111827;font-weight:500">${(t.terminalName)?html}</td>
                            <td style="padding:12px 16px"><label class="pp-switch" title="Enable offline billing for this terminal"><input type="checkbox" class="om-toggle" <#if (t.offlineEnabled) == 'Y'>checked</#if> <#if !(modCanWrite!false)>disabled</#if>/><span class="pp-switch-sl"></span></label></td>
                            <td style="padding:12px 16px"><input class="om-maxtxn" type="number" min="0" step="1" value="${(t.maxOfflineTransactions)?c}" <#if !(modCanWrite!false)>disabled</#if> style="width:90px;padding:6px 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:12.5px;box-sizing:border-box"/></td>
                            <td style="padding:12px 16px"><input class="om-maxhr" type="number" min="0" step="1" value="${(t.maxOfflineHours)?c}" <#if !(modCanWrite!false)>disabled</#if> style="width:90px;padding:6px 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:12.5px;box-sizing:border-box"/></td>
                            <td style="padding:12px 16px"><input class="om-syncint" type="number" min="0" step="1" value="${(t.autoSyncIntervalMinutes)?c}" <#if !(modCanWrite!false)>disabled</#if> style="width:90px;padding:6px 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:12.5px;box-sizing:border-box"/></td>
                            <td style="padding:12px 16px"><select class="om-cache" <#if !(modCanWrite!false)>disabled</#if> style="width:120px;padding:6px 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:12.5px;color:#374151;background:#fff"><option value="Y" <#if (t.syncProductCatalog) == 'Y'>selected</#if>>Yes</option><option value="N" <#if (t.syncProductCatalog) == 'N'>selected</#if>>No</option></select></td>
                        </tr>
                        </#list>
                        <#if !(terminalConfigList?has_content)>
                        <tr><td colspan="6" style="padding:28px;text-align:center;color:#9CA3AF">No active terminals. Add a terminal first (POS &rarr; Terminals).</td></tr>
                        </#if>
                    </tbody>
                </table>
                </div>
            </div>
        </div>

        <#if (modCanWrite!false)>
        <script>
        (function(){
            function tok(){ try{ if(window.moqui&&window.moqui.webrootVue&&window.moqui.webrootVue.moquiSessionToken) return window.moqui.webrootVue.moquiSessionToken; }catch(e){} return ''; }
            function cur(tr){ var g=function(s){ var e=tr.querySelector(s); return e?e.value:''; };
                return (tr.querySelector('.om-toggle').checked?'Y':'N')+'|'+g('.om-maxtxn')+'|'+g('.om-maxhr')+'|'+g('.om-syncint')+'|'+g('.om-cache'); }
            var snap={};
            Array.prototype.forEach.call(document.querySelectorAll('tr.om-row'), function(tr){ snap[tr.getAttribute('data-tid')]=cur(tr); });
            var btn=document.getElementById('omSaveBtn'); if(!btn) return;
            var base='${appBase!''}/zenith/pos/OfflineMode/saveOfflineConfig';
            btn.addEventListener('click', function(){
                var rows=Array.prototype.slice.call(document.querySelectorAll('tr.om-row'));
                var dirty=rows.filter(function(tr){ return cur(tr)!==snap[tr.getAttribute('data-tid')]; });
                if(dirty.length===0){ var o=btn.innerHTML; btn.textContent='No changes'; setTimeout(function(){btn.innerHTML=o;},1500); return; }
                btn.disabled=true; var o=btn.innerHTML; btn.textContent='Saving...'; var done=0,errs=0;
                dirty.forEach(function(tr){
                    var body=new URLSearchParams({ terminalId:tr.getAttribute('data-tid'),
                        offlineEnabled:(tr.querySelector('.om-toggle').checked?'Y':'N'),
                        maxOfflineTransactions:(tr.querySelector('.om-maxtxn')||{}).value||'',
                        maxOfflineHours:(tr.querySelector('.om-maxhr')||{}).value||'',
                        autoSyncIntervalMinutes:(tr.querySelector('.om-syncint')||{}).value||'',
                        syncProductCatalog:(tr.querySelector('.om-cache')||{}).value||'Y',
                        moquiSessionToken:tok() });
                    fetch(base,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body,credentials:'same-origin'})
                        .then(function(){ done++; if(done+errs===dirty.length){ btn.textContent='✓ Saved'; setTimeout(function(){location.reload();},700); } })
                        .catch(function(){ errs++; if(done+errs===dirty.length){ btn.textContent='✗ Error'; btn.disabled=false; } });
                });
            });
        })();
        </script>
        </#if>
        ]]></text></render-mode>

        <container style="q-px-md">
            <!-- Pending / Failed queue (only when there are any) -->
            <section name="PendingSection" condition="pendingList">
                <widgets>
                    <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md q-mt-md z-txntable">
                        <label text="Pending / Failed Transactions" type="h6" style="text-weight-bold text-warning q-mb-md q-mt-none"/>
                        <form-list name="PendingSyncList" list="pendingList" skip-form="true">
                            <field name="offlineTransactionId"><header-field title="Offline ID"/><default-field><display/></default-field></field>
                            <field name="terminalId"><header-field title="Terminal"/><default-field>
                                <display-entity entity-name="zenith.erp.pos.PosTerminal" text="${terminalName}"/></default-field></field>
                            <field name="offlineTimestamp"><header-field title="Offline Time"/><default-field><display format="dd-MMM HH:mm"/></default-field></field>
                            <field name="itemCount"><header-field title="Items"/><default-field><display/></default-field></field>
                            <field name="grandTotal"><header-field title="Amount"/><default-field><display format="#,##0.00"/></default-field></field>
                            <field name="paymentMethod"><header-field title="Payment"/><default-field><display/></default-field></field>
                            <field name="syncAttempts"><header-field title="Attempts"/><default-field><display/></default-field></field>
                            <field name="statusId"><header-field title="Status"/><default-field>
                                <display-entity entity-name="moqui.basic.StatusItem" key-field-name="statusId" text="${description}"/></default-field></field>
                            <field name="actions"><header-field title=""/><default-field>
                                <link url="syncOfflineTransaction" text="Sync Now" btn-type="success" style="q-btn--dense q-mr-xs"
                                      parameter-map="[offlineTransactionId: offlineTransactionId]"
                                      condition="statusId == 'OtPending' &amp;&amp; modCanWrite"/>
                                <link url="retrySync" text="Retry" btn-type="warning" style="q-btn--dense"
                                      parameter-map="[offlineTransactionId: offlineTransactionId]"
                                      condition="statusId == 'OtFailed' &amp;&amp; modCanWrite"/>
                            </default-field></field>
                        </form-list>
                    </container>
                </widgets>
            </section>

            <!-- Recently Synced -->
            <section name="SyncedSection" condition="syncedList">
                <widgets>
                    <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md q-mt-md z-txntable">
                        <label text="Recently Synced Transactions" type="h6" style="text-weight-bold q-mb-md q-mt-none"/>
                        <form-list name="SyncedList" list="syncedList" skip-form="true" show-csv-button="true">
                            <field name="offlineTransactionId"><header-field title="ID"/><default-field><display/></default-field></field>
                            <field name="terminalId"><header-field title="Terminal"/><default-field>
                                <display-entity entity-name="zenith.erp.pos.PosTerminal" text="${terminalName}"/></default-field></field>
                            <field name="offlineTimestamp"><header-field title="Offline At"/><default-field><display format="dd-MMM HH:mm"/></default-field></field>
                            <field name="syncedTimestamp"><header-field title="Synced At"/><default-field><display format="dd-MMM HH:mm"/></default-field></field>
                            <field name="grandTotal"><header-field title="Amount"/><default-field><display format="#,##0.00"/></default-field></field>
                            <field name="createdTransactionId"><header-field title="Transaction ID"/><default-field><display/></default-field></field>
                        </form-list>
                    </container>
                </widgets>
            </section>
        </container>
    </widgets>
</screen>
