<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Stock" default-menu-index="10">

    <subscreens default-item="StockAlerts"/>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_stock" class="pos-reference-help" style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128230; Stock &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Keep track of what you have on hand.<br><b>1</b>&nbsp;<b>Alerts</b> tab flags items running low or out of stock &mdash; check it daily.<br><b>2</b>&nbsp;<b>All Stock</b> shows every item with its current quantity.</div></details>]]></text></render-mode>
        <subscreens-panel id="stock-tabs" type="tab"/>
    </widgets>
</screen>
