<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Bill Register" default-menu-index="17">

    <!-- Read-only print view: clean, self-contained HTML report that auto-opens the print dialog. -->
    <transition name="printDoc" read-only="true">
        <actions>
            <script><![CDATA[
                def vm = ec.web.parameters.viewMode ?: 'all'
                def pd = ec.web.parameters.period ?: 'all'
                def fd = ec.web.parameters.fromDate
                def td = ec.web.parameters.thruDate
                def opParty = ec.user.userAccount?.partyId
                def rs = ec.entity.find("zenith.erp.pos.PosSession").condition("operatorPartyId", opParty).orderBy("-openDate").limit(1).list()
                // ZE-SALES-014 f/u: use the active org (reliable in the CSV/standalone render) so a tenant
                // without a POS session can't dump every store's register; terminal org is a fallback for admins.
                def myOrg = ec.user.getPreference("ACTIVE_ORGANIZATION")
                if (rs && !myOrg) { def tm = ec.entity.find("zenith.erp.pos.PosTerminal").condition("terminalId", rs[0].terminalId).one(); myOrg = tm?.organizationPartyId }
                def res = ec.service.sync().name("zenith.pos.PosReportServices.get#BillNumberRegister")
                    .parameters([organizationPartyId: myOrg, kotOnly: kitchenModuleId == 'kot', viewMode: vm, period: pd, fromDate: fd, thruDate: td]).call()
                def seqList = res.seqList ?: []
                def regList = res.registerList ?: []
                def grand = (res.grandSalesValue ?: 0) as BigDecimal
                def periodLabel = res.periodLabel ?: 'All dates'
                def esc = { o -> (o == null ? '' : o.toString().replace('&','&amp;').replace('<','&lt;').replace('>','&gt;')) }
                def money = { v -> (v == null) ? '' : ec.l10n.format(v as BigDecimal, "#,##,##0.00") }
                def now = ec.l10n.format(ec.user.nowTimestamp, "dd-MM-yyyy HH:mm")
                def sb = new StringBuilder()
                sb.append("<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Bill Number Register</title><style>")
                sb.append("body{font-family:Arial,Helvetica,sans-serif;margin:24px;color:#222}h1{font-size:20px;margin:0 0 2px}")
                sb.append(".sub{color:#666;font-size:12px;margin-bottom:14px}h2{font-size:14px;margin:14px 0 4px}")
                sb.append("table{border-collapse:collapse;width:100%;font-size:12px;margin:8px 0 20px}")
                sb.append("th,td{border:1px solid #ccc;padding:5px 8px;text-align:left}th{background:#f0f0f0}")
                sb.append(".gap{background:#ffebee;color:#b71c1c;font-weight:bold}.r{text-align:right}")
                sb.append(".tot{background:#e8f5e9;font-weight:bold}.btn{margin-bottom:10px;padding:8px 16px;font-size:13px;cursor:pointer}")
                sb.append("@media print{.noprint{display:none}body{margin:6px}}</style></head><body>")
                sb.append("<button class=\"noprint btn\" onclick=\"window.print()\">Print</button>")
                sb.append("<h1>Bill Number Register").append(vm == 'gaps' ? " &ndash; Gaps Only" : "").append("</h1>")
                sb.append("<div class=\"sub\">Period: <b>").append(esc(periodLabel)).append("</b> &middot; Generated ").append(esc(now))
                sb.append(" &middot; Every number from the first to the last issued is accounted for. No issued bill has been altered or renumbered.</div>")
                sb.append("<h2>Summary</h2><table><tr><th>Store</th><th>Sequence</th><th>Range</th><th>Total</th><th>Sales</th><th>Held</th><th>Incomplete</th><th>Voided</th><th>Unused (Gaps)</th><th>Sales Value</th></tr>")
                for (s in seqList) {
                    sb.append("<tr><td>").append(esc(s.orgName)).append("</td><td>").append(esc(s.prefix)).append("</td><td>").append(esc(s.rangeText))
                      .append("</td><td class=\"r\">").append(s.total).append("</td><td class=\"r\">").append(s.sale).append("</td><td class=\"r\">").append(s.held)
                      .append("</td><td class=\"r\">").append(s.inc).append("</td><td class=\"r\">").append(s.voided).append("</td><td class=\"r\">").append(s.gap)
                      .append("</td><td class=\"r\">").append(money(s.salesValue)).append("</td></tr>")
                }
                sb.append("<tr class=\"tot\"><td colspan=\"9\">Total sales value (Sale issued)</td><td class=\"r\">&#8377; ").append(money(grand)).append("</td></tr>")
                sb.append("</table>")
                sb.append("<h2>").append(vm == 'gaps' ? "Unused (Gap) Numbers" : "Number-by-Number Register").append("</h2>")
                sb.append("<table><tr><th>Store</th><th>Bill Number</th><th>Status</th><th>Date / Time</th><th>Amount</th></tr>")
                for (r in regList) {
                    def isGap = (r.statusLabel != null && r.statusLabel.toString().startsWith('UNUSED'))
                    def dt = r.entryDate ? ec.l10n.format(r.entryDate, "dd-MM-yyyy HH:mm") : ''
                    sb.append("<tr").append(isGap ? " class=\"gap\"" : "").append("><td>").append(esc(r.orgName)).append("</td><td>").append(esc(r.fullNumber))
                      .append("</td><td>").append(esc(r.statusLabel)).append("</td><td>").append(esc(dt)).append("</td><td class=\"r\">").append(esc(money(r.amount))).append("</td></tr>")
                }
                sb.append("</table>")
                sb.append("<script>window.onload=function(){setTimeout(function(){try{window.print()}catch(e){}},350)}</script></body></html>")
                ec.web.sendTextResponse(sb.toString(), "text/html", null)
            ]]></script>
        </actions>
        <default-response type="none"/>
    </transition>

    <!-- Read-only CSV export of the number-by-number register (org-scoped, same filters). -->
    <transition name="exportCsv" read-only="true">
        <actions>
            <script><![CDATA[
                def vm = ec.web.parameters.viewMode ?: 'all'
                def pd = ec.web.parameters.period ?: 'all'
                def fd = ec.web.parameters.fromDate
                def td = ec.web.parameters.thruDate
                def opParty = ec.user.userAccount?.partyId
                def rs = ec.entity.find("zenith.erp.pos.PosSession").condition("operatorPartyId", opParty).orderBy("-openDate").limit(1).list()
                def myOrg = ec.user.getPreference("ACTIVE_ORGANIZATION")
                if (rs && !myOrg) { def tm = ec.entity.find("zenith.erp.pos.PosTerminal").condition("terminalId", rs[0].terminalId).one(); myOrg = tm?.organizationPartyId }
                def res = ec.service.sync().name("zenith.pos.PosReportServices.get#BillNumberRegister")
                    .parameters([organizationPartyId: myOrg, kotOnly: kitchenModuleId == 'kot', viewMode: vm, period: pd, fromDate: fd, thruDate: td]).call()
                def regList = res.registerList ?: []
                def q = { v -> '"' + (v == null ? '' : v.toString().replace('"','""')) + '"' }
                def money = { v -> (v == null) ? '' : ec.l10n.format(v as BigDecimal, "#,##0.00") }
                def sb = new StringBuilder()
                sb.append("Store,Sequence,Bill Number,Status,Sales Value,Date & Time\r\n")
                for (r in regList) {
                    def fn = (r.fullNumber ?: '').toString()
                    def seqPart = fn.contains('/') ? fn.substring(0, fn.lastIndexOf('/')) : fn
                    def numPart = fn.contains('/') ? fn.substring(fn.lastIndexOf('/') + 1) : fn
                    def isSale = (r.statusLabel != null && r.statusLabel.toString().startsWith('Sale issued'))
                    def dt = r.entryDate ? ec.l10n.format(r.entryDate, "dd-MM-yyyy hh:mm a") : ''
                    sb.append(q(r.orgName)).append(',').append(q(seqPart)).append(',').append(q(numPart)).append(',')
                      .append(q(r.statusLabel)).append(',').append(q(isSale && r.amount != null ? money(r.amount) : '')).append(',')
                      .append(q(dt)).append("\r\n")
                }
                ec.web.sendTextResponse(sb.toString(), "text/csv", "bill-register.csv")
            ]]></script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <set field="viewMode" from="ec.web.parameters.viewMode ?: 'all'"/>
        <set field="period" from="ec.web.parameters.period ?: 'all'"/>
        <set field="fromDate" from="ec.web.parameters.fromDate"/>
        <set field="thruDate" from="ec.web.parameters.thruDate"/>
        <script><![CDATA[
            def _uri = (ec.web?.request?.requestURI ?: '')
            def _zi = _uri.indexOf('/zenith/')
            appBase = _zi > 0 ? _uri.substring(0, _zi) : ''
        ]]></script>
        <!-- Scope to the operator's organization (whole store) -->
        <set field="opParty" from="ec.user.userAccount?.partyId"/>
        <entity-find entity-name="zenith.erp.pos.PosSession" list="recentSess" limit="1">
            <econdition field-name="operatorPartyId" from="opParty"/>
            <order-by field-name="-openDate"/>
        </entity-find>
        <!-- ZE-SALES-014 f/u: active org first (reliable in the CSV/standalone render), terminal org only as an admin fallback -->
        <set field="myOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <if condition="recentSess">
            <entity-find-one entity-name="zenith.erp.pos.PosTerminal" value-field="myTerm">
                <field-map field-name="terminalId" from="recentSess[0].terminalId"/>
            </entity-find-one>
            <set field="myOrg" from="myOrg ?: myTerm?.organizationPartyId"/>
        </if>
        <service-call name="zenith.pos.PosReportServices.get#BillNumberRegister" out-map="regOut"
            in-map="[organizationPartyId:myOrg, kotOnly:kitchenModuleId == 'kot', viewMode:viewMode, period:period, fromDate:fromDate, thruDate:thruDate]"/>
        <set field="periodLabel" from="regOut.periodLabel"/>
        <set field="grandSalesFmt" from="zinr.inr(ec.l10n.format(regOut.grandSalesValue ?: 0, '#,##,##0.00'))"/>
        <script><![CDATA[
            // ---- KPI roll-ups from the per-sequence summary ----
            def sums = [total:0, sale:0, held:0, inc:0, voided:0, gap:0]
            (regOut.seqList ?: []).each { s ->
                sums.total += (s.total ?: 0); sums.sale += (s.sale ?: 0); sums.held += (s.held ?: 0)
                sums.inc += (s.inc ?: 0); sums.voided += (s.voided ?: 0); sums.gap += (s.gap ?: 0)
            }
            kpiTotal = sums.total; kpiSale = sums.sale; kpiHeld = sums.held; kpiVoided = sums.voided; kpiGap = sums.gap

            // ---- Pre-build the number-by-number rows (split sequence/number, badge, formatted amount/date) ----
            def badgeOf = { lb ->
                if (lb == null) return ['grey','—']
                def s = lb.toString()
                if (s.startsWith('Sale issued')) return ['success','Sale issued']
                if (s.startsWith('Voided')) return ['danger','Voided']
                if (s.startsWith('Held')) return ['warning','Held']
                if (s.startsWith('Incomplete')) return ['grey','Incomplete']
                if (s.startsWith('UNUSED')) return ['info','Unused']
                return ['grey', s]
            }
            rows = (regOut.registerList ?: []).collect { r ->
                def fn = (r.fullNumber ?: '').toString()
                def seqPart = fn.contains('/') ? fn.substring(0, fn.lastIndexOf('/')) : fn
                def numPart = fn.contains('/') ? fn.substring(fn.lastIndexOf('/') + 1) : fn
                def isSale = (r.statusLabel != null && r.statusLabel.toString().startsWith('Sale issued'))
                def b = badgeOf(r.statusLabel)
                [store:(r.orgName ?: ''), seq:seqPart, num:numPart, badgeClass:b[0], badgeText:b[1],
                 salesVal:(isSale && r.amount != null ? zinr.inr(ec.l10n.format(r.amount as BigDecimal, '#,##,##0.00')) : null),
                 dt:(r.entryDate ? ec.l10n.format(r.entryDate, 'dd-MM-yyyy hh:mm a') : '')]
            }
            rowCount = rows.size()
        ]]></script>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_billregister" style="background:#EEF2FF;border:1px solid #C7D2FE;border-left:5px solid #6366F1;border-radius:10px;padding:9px 16px;margin:8px 16px 0 16px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:700;font-size:14px;color:#3730A3;outline:none">&#128290; Bill Register &mdash; quick help <span style="font-weight:500;color:#6B7280;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Confirms <b>every bill number is accounted for</b>, with no gaps. An <b>UNUSED</b> number was never printed on a customer bill.<br><b>1</b>&nbsp;Pick a <b>period</b>.<br><b>2</b>&nbsp;Choose <b>All Numbers</b> or <b>Gaps Only</b> to spot any missing or skipped bills.</div></details>]]></text></render-mode>

        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <#assign bu = (appBase!'') + '/zenith' + (kitchenModulePath!'/pos') + '/BillNumberRegister'>
        <#assign fd = (fromDate!'')?string>
        <#assign td = (thruDate!'')?string>
        <#assign qp = '&period=' + (period!'all') + '&viewMode=' + (viewMode!'all') + '&fromDate=' + fd?url('UTF-8') + '&thruDate=' + td?url('UTF-8')>
        <#macro vtab label mode><#assign on = (viewMode!'all') == mode>
            <a href="${bu}?viewMode=${mode}&period=${(period!'all')}&fromDate=${fd?url('UTF-8')}&thruDate=${td?url('UTF-8')}" style="display:inline-flex;align-items:center;height:34px;padding:0 14px;border-radius:8px;font-size:12.5px;font-weight:600;text-decoration:none;<#if on>background:#7C3AED;color:#fff;border:1px solid #7C3AED;<#else>background:#fff;color:#6B7280;border:1px solid #E5E7EB;</#if>">${label}</a>
        </#macro>
        <#macro ptab label pd icon=''><#assign on = (period!'all') == pd>
            <a href="${bu}?period=${pd}&viewMode=${(viewMode!'all')}" style="display:inline-flex;align-items:center;gap:5px;height:34px;padding:0 14px;border-radius:8px;font-size:12.5px;font-weight:600;text-decoration:none;<#if on>background:#F5F3FF;color:#7C3AED;border:1px solid #7C3AED;<#else>background:#fff;color:#6B7280;border:1px solid #E5E7EB;</#if>"><#if icon?has_content><span class="material-icons" style="font-size:15px">${icon}</span></#if>${label}</a>
        </#macro>
        <div style="padding:16px 16px 24px;font-family:'Segoe UI',Arial,sans-serif">
            <!-- Page header -->
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px">
                <span class="z-icobadge lg primary"><span class="material-icons">description</span></span>
                <div>
                    <div style="font-size:20px;font-weight:800;color:#111827;line-height:1.3"><#if (kitchenModuleId!'pos') == 'kot'>KOT </#if>Bill Register</div>
                    <div style="font-size:13px;color:#6B7280;line-height:1.5"><#if (kitchenModuleId!'pos') == 'kot'>View KOT bills and unused numbers in the shared bill sequence.<#else>Track and verify every bill number in each sequence. View issued, voided, unused and missing numbers.</#if></div>
                </div>
            </div>

            <!-- KPI stat cards -->
            <div class="z-statrow">
                <div class="z-statcell z-statcard-violet" style="padding:16px"><div class="z-statinner"><span class="z-icobadge lg primary"><span class="material-icons">description</span></span><div class="z-statmeta"><span class="z-statnum" style="color:#7C3AED">${kpiTotal!0}</span><span class="z-statlabel">Total Numbers</span><span class="z-statdesc">In selected period</span></div></div></div>
                <div class="z-statcell z-statcard-green" style="padding:16px"><div class="z-statinner"><span class="z-icobadge lg green"><span class="material-icons">check_circle</span></span><div class="z-statmeta"><span class="z-statnum" style="color:#0E9F6E">${kpiSale!0}</span><span class="z-statlabel">Sales Issued</span><span class="z-statdesc">Printed to customers</span></div></div></div>
                <div class="z-statcell z-statcard-orange" style="padding:16px"><div class="z-statinner"><span class="z-icobadge lg orange"><span class="material-icons">pause_circle</span></span><div class="z-statmeta"><span class="z-statnum" style="color:#B45309">${kpiHeld!0}</span><span class="z-statlabel">Held</span><span class="z-statdesc">Reserved numbers</span></div></div></div>
                <div class="z-statcell z-statcard-red" style="padding:16px"><div class="z-statinner"><span class="z-icobadge lg red"><span class="material-icons">cancel</span></span><div class="z-statmeta"><span class="z-statnum" style="color:#DC2626">${kpiVoided!0}</span><span class="z-statlabel">Voided</span><span class="z-statdesc">Cancelled bills</span></div></div></div>
                <div class="z-statcell z-statcard-blue" style="padding:16px"><div class="z-statinner"><span class="z-icobadge lg blue"><span class="material-icons">more_horiz</span></span><div class="z-statmeta"><span class="z-statnum" style="color:#2563EB">${kpiGap!0}</span><span class="z-statlabel">Unused (Gaps)</span><span class="z-statdesc">Numbers not issued</span></div></div></div>
                <div class="z-statcell z-statcard-violet" style="padding:16px"><div class="z-statinner"><span class="z-icobadge lg primary"><span class="material-icons">currency_rupee</span></span><div class="z-statmeta"><span class="z-statnum" style="color:#7C3AED;font-size:21px">&#8377;${grandSalesFmt!'0.00'}</span><span class="z-statlabel">Sales Value</span><span class="z-statdesc">In selected period</span></div></div></div>
            </div>

            <!-- Filter toolbar -->
            <div style="background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:16px;margin-bottom:18px">
                <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
                    <span style="font-size:12.5px;color:#6B7280;font-weight:600">View:</span>
                    <div style="display:flex;gap:8px"><@vtab label="All Numbers" mode="all"/><@vtab label="Gaps Only" mode="gaps"/></div>
                    <span style="font-size:12.5px;color:#6B7280;font-weight:600;margin-left:8px">Period:</span>
                    <div style="display:flex;gap:8px;flex-wrap:wrap"><@ptab label="All Dates" pd="all"/><@ptab label="This Month" pd="thisMonth"/><@ptab label="Last Month" pd="lastMonth"/>
                        <button type="button" id="br-customBtn" style="display:inline-flex;align-items:center;gap:5px;height:34px;padding:0 14px;border-radius:8px;font-size:12.5px;font-weight:600;cursor:pointer;<#if (period!'all')=='custom'>background:#F5F3FF;color:#7C3AED;border:1px solid #7C3AED;<#else>background:#fff;color:#6B7280;border:1px solid #E5E7EB;</#if>"><span class="material-icons" style="font-size:15px">event</span>Custom Range</button>
                    </div>
                    <a href="${sri.buildUrl('printDoc').url}?viewMode=${(viewMode!'all')}&amp;period=${(period!'all')}&amp;fromDate=${fd?url('UTF-8')}&amp;thruDate=${td?url('UTF-8')}" target="_blank" style="margin-left:auto;display:inline-flex;align-items:center;gap:6px;height:38px;padding:0 16px;border-radius:8px;background:#7C3AED;color:#fff;text-decoration:none;font-weight:600;font-size:12.5px"><span class="material-icons" style="font-size:16px">print</span>Print Report</a>
                </div>
                <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:14px">
                    <span style="font-size:12.5px;color:#374151;font-weight:600">From</span>
                    <input type="date" id="br-from" value="${fd?html}" style="height:36px;padding:0 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#374151"/>
                    <span style="font-size:12.5px;color:#374151;font-weight:600">To</span>
                    <input type="date" id="br-thru" value="${td?html}" style="height:36px;padding:0 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#374151"/>
                    <button type="button" id="br-apply" style="height:36px;padding:0 16px;border-radius:8px;background:#fff;color:#7C3AED;border:1px solid #7C3AED;font-size:12.5px;font-weight:600;cursor:pointer">Apply</button>
                    <div style="margin-left:auto;display:flex;align-items:center;gap:8px">
                        <span style="font-size:12.5px;color:#6B7280;font-weight:600">Total sales value (in view):</span>
                        <span style="background:#D1FAE5;color:#0E9F6E;padding:4px 10px;border-radius:8px;font-weight:700;font-size:12.5px">&#8377;${grandSalesFmt!'0.00'}</span>
                    </div>
                </div>
            </div>

            <!-- Register panel -->
            <div style="background:#fff;border:1px solid #E5E7EB;border-radius:12px;overflow:hidden">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 20px">
                    <div style="display:flex;align-items:flex-start;gap:12px">
                        <span class="z-icobadge primary"><span class="material-icons">description</span></span>
                        <div>
                            <div style="font-size:15px;font-weight:700;color:#111827"><#if (kitchenModuleId!'pos') == 'kot'>KOT Bill Number Register<#else>Bill Number Register &ndash; every number accounted for</#if></div>
                            <div style="font-size:12px;color:#6B7280;line-height:1.5;max-width:860px"><#if (kitchenModuleId!'pos') == 'kot'>Unused numbers are gaps between KOT bills that no bill in the shared sequence used.<#else>This shows every bill number in each sequence, from the first to the last issued. An 'UNUSED' number was never printed on a customer bill - older system behaviour reserved a number when a cart was opened, so a cancelled or abandoned cart left a gap.</#if></div>
                        </div>
                    </div>
                    <div style="display:flex;gap:8px;flex-shrink:0;position:relative">
                        <button type="button" id="br-colsBtn" style="display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 14px;border-radius:8px;background:#fff;color:#6B7280;border:1px solid #E5E7EB;font-size:12.5px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:16px">view_column</span>Columns</button>
                        <div id="br-colsMenu" style="display:none;position:absolute;top:40px;right:60px;background:#fff;border:1px solid #E5E7EB;border-radius:10px;box-shadow:0 8px 24px rgba(17,24,39,.12);padding:8px;z-index:30;min-width:170px">
                            <label style="display:flex;align-items:center;gap:8px;padding:6px 8px;font-size:13px;color:#374151;cursor:pointer"><input type="checkbox" class="br-colchk" data-col="store" checked/> Store</label>
                            <label style="display:flex;align-items:center;gap:8px;padding:6px 8px;font-size:13px;color:#374151;cursor:pointer"><input type="checkbox" class="br-colchk" data-col="seq" checked/> Sequence</label>
                            <label style="display:flex;align-items:center;gap:8px;padding:6px 8px;font-size:13px;color:#374151;cursor:pointer"><input type="checkbox" class="br-colchk" data-col="billno" checked/> Bill Number</label>
                            <label style="display:flex;align-items:center;gap:8px;padding:6px 8px;font-size:13px;color:#374151;cursor:pointer"><input type="checkbox" class="br-colchk" data-col="status" checked/> Status</label>
                            <label style="display:flex;align-items:center;gap:8px;padding:6px 8px;font-size:13px;color:#374151;cursor:pointer"><input type="checkbox" class="br-colchk" data-col="salesval" checked/> Sales Value</label>
                            <label style="display:flex;align-items:center;gap:8px;padding:6px 8px;font-size:13px;color:#374151;cursor:pointer"><input type="checkbox" class="br-colchk" data-col="datetime" checked/> Date &amp; Time</label>
                            <label style="display:flex;align-items:center;gap:8px;padding:6px 8px;font-size:13px;color:#374151;cursor:pointer"><input type="checkbox" class="br-colchk" data-col="action" checked/> Action</label>
                        </div>
                        <a href="${sri.buildUrl('exportCsv').url}?viewMode=${(viewMode!'all')}&amp;period=${(period!'all')}&amp;fromDate=${fd?url('UTF-8')}&amp;thruDate=${td?url('UTF-8')}" target="_blank" style="display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 14px;border-radius:8px;background:#fff;color:#6B7280;border:1px solid #E5E7EB;font-size:12.5px;font-weight:600;text-decoration:none"><span class="material-icons" style="font-size:16px">download</span>CSV</a>
                    </div>
                </div>
                <div style="overflow-x:auto">
                <table id="br-table" style="width:100%;border-collapse:collapse;font-size:12.5px;min-width:900px">
                    <thead>
                        <tr style="background:#F5F3FF;color:#6B7280;text-align:left">
                            <th style="padding:11px 16px;font-weight:600;font-size:11.5px">#</th>
                            <th data-col="store" style="padding:11px 16px;font-weight:600;font-size:11.5px">Store</th>
                            <th data-col="seq" style="padding:11px 16px;font-weight:600;font-size:11.5px">Sequence</th>
                            <th data-col="billno" style="padding:11px 16px;font-weight:600;font-size:11.5px">Bill Number</th>
                            <th data-col="status" style="padding:11px 16px;font-weight:600;font-size:11.5px">Status</th>
                            <th data-col="salesval" style="padding:11px 16px;font-weight:600;font-size:11.5px;text-align:right">Sales Value</th>
                            <th data-col="datetime" style="padding:11px 16px;font-weight:600;font-size:11.5px">Date &amp; Time</th>
                            <th data-col="action" style="padding:11px 16px;font-weight:600;font-size:11.5px">Action</th>
                        </tr>
                    </thead>
                    <tbody id="br-tbody">
                        <#list (rows![]) as r>
                        <tr class="br-row" style="border-top:1px solid #F1F1F4">
                            <td style="padding:11px 16px;color:#9CA3AF">${r_index + 1}</td>
                            <td data-col="store" style="padding:11px 16px;color:#111827">${(r.store)?html}</td>
                            <td data-col="seq" style="padding:11px 16px;color:#6B7280">${(r.seq)?html}</td>
                            <td data-col="billno" style="padding:11px 16px;color:#111827;font-weight:600">${(r.num)?html}</td>
                            <td data-col="status" style="padding:11px 16px"><span class="zenith-badge ${r.badgeClass} nd">${(r.badgeText)?html}</span></td>
                            <td data-col="salesval" style="padding:11px 16px;text-align:right;<#if (r.salesVal)??>color:#111827;font-weight:600<#else>color:#9CA3AF</#if>"><#if (r.salesVal)??>&#8377;${r.salesVal}<#else>&mdash;</#if></td>
                            <td data-col="datetime" style="padding:11px 16px;color:#6B7280">${(r.dt)?html}</td>
                            <td data-col="action" style="padding:11px 16px;color:#9CA3AF">&mdash;</td>
                        </tr>
                        </#list>
                    </tbody>
                </table>
                </div>
                <#if (rowCount!0) == 0>
                <div style="padding:40px 20px;text-align:center;color:#9CA3AF;font-size:13px">No bill numbers found for this period.</div>
                </#if>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px 20px;border-top:1px solid #F1F1F4">
                    <span id="br-showing" style="font-size:12.5px;color:#6B7280"></span>
                    <div style="display:flex;align-items:center;gap:12px">
                        <nav id="br-pager" style="display:flex;align-items:center;gap:6px"></nav>
                        <select id="br-perpage" style="height:32px;padding:0 8px;border:1px solid #E5E7EB;border-radius:8px;font-size:12.5px;color:#374151;background:#fff">
                            <option value="10">10 per page</option>
                            <option value="25">25 per page</option>
                            <option value="50">50 per page</option>
                            <option value="100">100 per page</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

