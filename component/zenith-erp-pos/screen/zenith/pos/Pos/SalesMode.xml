<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Sales Mode" default-menu-index="14">

    <transition name="createMode">
        <actions>
            <!-- ZE-CONTACTS-022 f/u: a sales-mode discount is a percentage — reject out-of-range (0-100).
                 The POS engine also clamps at apply time, but this gives a clear error at entry. -->
            <script><![CDATA[
                if (discountPercent != null && discountPercent.toString().trim() && ((discountPercent as BigDecimal) < 0 || (discountPercent as BigDecimal) > 100))
                    ec.message.addError("Discount % must be between 0 and 100.")
            ]]></script>
            <if condition="ec.message.hasError()"><return/></if>
            <service-call name="create#zenith.erp.pos.PosSalesMode" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateMode">
        <actions>
            <script><![CDATA[
                if (discountPercent != null && discountPercent.toString().trim() && ((discountPercent as BigDecimal) < 0 || (discountPercent as BigDecimal) > 100))
                    ec.message.addError("Discount % must be between 0 and 100.")
            ]]></script>
            <if condition="ec.message.hasError()"><return/></if>
            <service-call name="update#zenith.erp.pos.PosSalesMode" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="deleteMode">
        <service-call name="delete#zenith.erp.pos.PosSalesMode"/>
        <default-response url="."/>
    </transition>
    <transition name="assignTerminal">
        <service-call name="store#zenith.erp.pos.PosTerminalSalesMode"/>
        <default-response url="."/>
    </transition>
    <transition name="removeTerminal">
        <service-call name="delete#zenith.erp.pos.PosTerminalSalesMode"/>
        <default-response url="."/>
    </transition>
    <!-- ZE-POS-MODERULES: opt-in per-shop order rules. organizationPartyId is ALWAYS taken from the
         caller's active org server-side (never from the post) so one tenant can't write another's rules. -->
    <transition name="saveOrgRule">
        <actions>
            <set field="_org" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="!_org || _org == '_NA_'">
                <return error="true" message="No active shop is selected, so a shop-specific rule cannot be saved."/></if>
            <if condition="!salesModeId">
                <return error="true" message="Pick a sales mode for the rule."/></if>
            <if condition="minOrderAmount != null &amp;&amp; minOrderAmount.toString().trim() &amp;&amp; (minOrderAmount as BigDecimal) &lt; 0">
                <return error="true" message="Minimum order amount cannot be negative."/></if>
            <service-call name="store#zenith.erp.pos.PosSalesModeOrgConfig"
                in-map="[organizationPartyId:_org, salesModeId:salesModeId,
                         requireCustomer:(requireCustomer ?: 'N'), minOrderAmount:minOrderAmount]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="deleteOrgRule">
        <actions>
            <set field="_org" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="!_org || _org == '_NA_'">
                <return error="true" message="No active shop is selected."/></if>
            <service-call name="delete#zenith.erp.pos.PosSalesModeOrgConfig"
                in-map="[organizationPartyId:_org, salesModeId:salesModeId]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="goProductPrices"><default-response url="../ProductPricing"/></transition>
    <transition name="goTerminals"><default-response url="../PosTerminals"/></transition>
    <transition name="goTerminal"><default-response url="../Terminal"/></transition>
    <transition name="goDashboard"><default-response url="../Dashboard"/></transition>
    <transition name="goSessions"><default-response url="../PosSessions"/></transition>
    <transition name="goReceipts"><default-response url="../ReceiptConfig"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.pos.PosSalesMode" list="modeList">
            <order-by field-name="isDefault,modeName"/>
        </entity-find>

        <entity-find entity-name="moqui.basic.Enumeration" list="priceSourceList">
            <econdition field-name="enumTypeId" value="PosPriceSource"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>

        <entity-find entity-name="zenith.erp.pos.PosTerminal" list="terminalList">
            <order-by field-name="terminalName"/>
        </entity-find>

        <entity-find entity-name="zenith.erp.pos.PosTerminalSalesMode" list="terminalModeList"/>

        <!-- ZE-POS-MODERULES: the active shop's opt-in order rules (scoped to the active org; never list all). -->
        <set field="_activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="orgRuleList" from="[]"/>
        <set field="hasActiveOrg" from="(_activeOrg &amp;&amp; _activeOrg != '_NA_') ? true : false"/>
        <if condition="hasActiveOrg">
            <entity-find entity-name="zenith.erp.pos.PosSalesModeOrgConfig" list="orgRuleList">
                <econdition field-name="organizationPartyId" from="_activeOrg"/>
                <order-by field-name="salesModeId"/>
            </entity-find>
        </if>

        <!-- Sales Mode redesign (Sales_mode.jpeg): build the Active-mode tiles as a cross-surface HTML
             string (the old FreeMarker <#list> renders on /apps but NOT /qapps). Display-only. -->
        <script><![CDATA[
            def _psById = [:]; (priceSourceList ?: []).each { _psById[it.enumId] = it.description }
            def _short = { s -> s == null ? '' : s.toString().replaceAll(/\s*\(.*?\)/, '').trim() }
            def _esc = { s -> s == null ? '' : s.toString().replace('&','&amp;').replace('<','&lt;').replace('>','&gt;') }
            def C = 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"'
            def svgBag = '<svg viewBox="0 0 24 24" ' + C + '><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>'
            def svgUsers = '<svg viewBox="0 0 24 24" ' + C + '><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>'
            def svgSliders = '<svg viewBox="0 0 24 24" ' + C + '><line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/></svg>'
            // order + theme keyed by mode identity so it reads like the mockup (Retail/violet, Wholesale/blue, Custom/green)
            def _prio = { mm -> def n = (mm.modeName ?: '').toLowerCase(); (n.contains('retail') || mm.isDefault == 'Y') ? 0 : (n.contains('wholesale') || n.contains('bulk')) ? 1 : (n.contains('custom') || n.contains('special') || n.contains('project')) ? 2 : 3 }
            def _ordered = (modeList ?: []).sort(false) { _prio(it) }
            def _cycleT = ['b','g','v']; def _cycleI = [svgUsers, svgSliders, svgBag]; int _i = 0
            def _tiles = new StringBuilder()
            _ordered.each { m ->
                def isDef = (m.isDefault == 'Y')
                def _n = (m.modeName ?: '').toLowerCase()
                def theme, iconSvg
                if (isDef || _n.contains('retail')) { theme = 'v'; iconSvg = svgBag }
                else if (_n.contains('wholesale') || _n.contains('bulk')) { theme = 'b'; iconSvg = svgUsers }
                else if (_n.contains('custom') || _n.contains('special') || _n.contains('project')) { theme = 'g'; iconSvg = svgSliders }
                else { theme = _cycleT[_i % 3]; iconSvg = _cycleI[_i % 3]; _i++ }
                def psLabel = _short(_psById[m.priceSource] ?: m.priceSource)
                def taxLabel = (m.isTaxInclusive == 'Y') ? 'Yes' : 'No'
                def reqLabel = (m.requireCustomer == 'Y') ? 'Yes' : 'No'
                def disc = (m.discountPercent ?: 0); def markup = (m.markupPercent ?: 0)
                _tiles.append('<div class="smode-tile ').append(theme).append('"><div class="smode-tile-hd"><span class="smode-tile-ico">').append(iconSvg).append('</span><span class="smode-tile-name">').append(_esc(m.modeName)).append('</span>')
                if (isDef) _tiles.append('<span class="smode-badge-default">Default</span>')
                _tiles.append('</div><dl style="margin:0">')
                _tiles.append('<div class="smode-fact"><dt>Price Source</dt><dd>').append(psLabel ?: '&#8212;').append('</dd></div>')
                _tiles.append('<div class="smode-fact"><dt>Discount</dt><dd>').append(disc).append('%</dd></div>')
                _tiles.append('<div class="smode-fact"><dt>Markup</dt><dd>').append(markup).append('%</dd></div>')
                _tiles.append('<div class="smode-fact"><dt>Tax Inclusive</dt><dd>').append(taxLabel).append('</dd></div>')
                _tiles.append('<div class="smode-fact"><dt>Require Customer</dt><dd>').append(reqLabel).append('</dd></div></dl>')
                if (m.description) _tiles.append('<div class="smode-tile-foot">').append(_esc(m.description)).append('</div>')
                _tiles.append('</div>')
            }
            context.tilesHtml = _tiles.length() ? ('<div class="smode-tiles">' + _tiles.toString() + '</div>') : '<div class="smode-info">No sales modes yet — create one on the left.</div>'
        ]]></script>
    </actions>

    <widgets>
        <container style="smode-wrap q-pa-md">
            <render-mode><text type="html,qvt"><![CDATA[
<div class="smode-hdr">
  <div class="smode-hdr-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 21v-5a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v5"/><path d="M17.774 10.31a1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.451 0 1.12 1.12 0 0 0-1.548 0 2.5 2.5 0 0 1-3.452 0 1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.77-3.248l2.889-4.184A2 2 0 0 1 7 2h10a2 2 0 0 1 1.653.873l2.895 4.192a2.5 2.5 0 0 1-3.774 3.244"/><path d="M4 10.95V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8.05"/></svg></div>
  <div class="smode-hdr-tx"><h1 class="smode-h1">Sales Mode</h1><p class="smode-sub">Set up different sales modes and assign them to terminals.</p></div>
  <details class="smode-helpd"><summary class="smode-help"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg> Need help? View guide <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></summary><div class="smode-helpbody"><b>Sales modes</b> are the price tiers a cashier picks while billing. Your shop already has Retail, Wholesale and Custom &mdash; most shops never change anything here. <b>Retail</b> charges MRP; <b>Wholesale</b> / <b>Custom</b> charge a fixed price you set per product in <b>Product Prices</b>. This screen is for advanced setup &mdash; creating a mode, or choosing which modes appear on each terminal.</div></details>
</div>
            ]]></text></render-mode>
            <container style="row items-center justify-end q-mb-lg q-gutter-sm">
                <link url="goProductPrices" text="Product Prices" icon="fa fa-tags" btn-type="warning" style="q-btn--dense"/>
                <link url="goTerminals" text="Terminals" icon="fa fa-desktop" btn-type="primary" style="q-btn--dense"/>
                <link url="goSessions" text="Sessions" icon="fa fa-clock-o" style="q-btn--dense"/>
                <link url="goReceipts" text="Receipts" icon="fa fa-file-text-o" style="q-btn--dense"/>
                <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
                <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
            </container>
            <container style="smode-grid">
                <section name="CreateMode_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container style="smode-card smode-createform">
                        <render-mode><text type="html,qvt"><![CDATA[<div class="smode-card-hd"><span class="smode-card-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg></span><h2 class="smode-card-title">Create Sales Mode</h2></div>]]></text></render-mode>
                        <form-single name="CreateMode" transition="createMode">
                            <field name="modeName"><default-field title="Mode Name">
                                <text-line size="20"/>
                            </default-field></field>
                            <field name="modeCode"><default-field title="Code">
                                <text-line size="6"/>
                            </default-field></field>
                            <field name="priceSource"><default-field title="Price Source">
                                <drop-down>
                                    <list-options list="priceSourceList" key="${enumId}" text="${description}"/>
                                </drop-down>
                            </default-field></field>
                            <field name="discountPercent"><default-field title="Discount %">
                                <text-line size="6" input-type="number" default-value="0"/>
                            </default-field></field>
                            <field name="markupPercent"><default-field title="Markup %">
                                <text-line size="6" input-type="number" default-value="0"/>
                            </default-field></field>
                            <field name="isTaxInclusive"><default-field title="Tax Inclusive">
                                <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>
                            <field name="requireCustomer"><default-field title="Require Customer">
                                <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                            </default-field></field>
                            <field name="minOrderAmount"><default-field title="Min Order Amount">
                                <text-line size="10" input-type="number" default-value="0"/>
                            </default-field></field>
                            <field name="invoicePrefix"><default-field title="Invoice Prefix">
                                <text-line size="6"/>
                            </default-field></field>
                            <field name="colorCode"><default-field title="Color Code">
                                <text-line size="8" default-value="#1976D2"/>
                            </default-field></field>
                            <field name="isDefault"><default-field title="Default Mode">
                                <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                            </default-field></field>
                            <field name="description"><default-field title="Description">
                                <text-line size="40"/>
                            </default-field></field>
                            <field name="submitBtn"><default-field title="">
                                <submit text="Save Sales Mode" icon="fa fa-save"/>
                            </default-field></field>
                        </form-single>
                    </container>
                    </widgets></section>

                <container style="smode-card">
                    <render-mode><text type="html,qvt"><![CDATA[<div class="smode-card-hd"><span class="smode-card-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg></span><h2 class="smode-card-title">Active Sales Modes</h2></div>]]></text></render-mode>
                    <render-mode><text type="html,qvt"><![CDATA[${tilesHtml}]]></text></render-mode>
                    <render-mode><text type="html,qvt"><![CDATA[<div class="smode-info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg><span>Each sales mode can have different pricing rules and can be assigned to specific terminals.</span></div>]]></text></render-mode>
                </container>
            </container>

            <container style="smode-card smode-tbl">
            <render-mode><text type="html,qvt"><![CDATA[<div class="smode-card-hd"><span class="smode-card-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg></span><h2 class="smode-card-title">Sales Mode Pricing Rules</h2></div>]]></text></render-mode>
            <form-list name="ModeListForm" list="modeList" transition="updateMode" skip-form="false">
                <field name="salesModeId"><default-field><hidden/></default-field></field>
                <field name="modeName"><default-field title="Name">
                    <text-line size="15"/>
                </default-field></field>
                <field name="modeCode"><default-field title="Code">
                    <text-line size="5"/>
                </default-field></field>
                <field name="priceSource"><default-field title="Price Source">
                    <drop-down>
                        <list-options list="priceSourceList" key="${enumId}" text="${description}"/>
                    </drop-down>
                </default-field></field>
                <field name="discountPercent"><default-field title="Disc %">
                    <text-line size="5" input-type="number"/>
                </default-field></field>
                <field name="isTaxInclusive"><default-field title="Tax Incl.">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="requireCustomer"><default-field title="Req. Cust.">
                    <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                </default-field></field>
                <field name="isDefault"><default-field title="Default">
                    <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                </default-field></field>
                <field name="isActive"><default-field title="Active">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="submitBtn">
                    <conditional-field name="mode_save_write" condition="modCanWrite" title="">
                    <submit text="Save" icon="fa fa-save"/>
                    </conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field></field>
                <field name="deleteBtn">
                    <conditional-field name="mode_delete_write" condition="modCanWrite" title="">
                    <link url="deleteMode" text="Delete" icon="fa fa-trash" btn-type="danger"
                          parameter-map="[salesModeId:salesModeId]"
                          confirmation="Delete this sales mode?"/>
                    </conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field></field>
            </form-list>
            </container>

            <label text="Order Rules for This Shop" type="h6" style="text-weight-bold q-mt-lg q-mb-sm"/>
            <container style="q-mb-md">
                <label text="Optional and OFF by default. Add a rule to require a customer on the bill and/or a minimum order value for a mode. Applies to THIS shop only — leaving a mode unlisted means no restriction (the default)." style="text-grey-7"/>
            </container>
            <section name="NoActiveOrgNote"><condition><expression>!hasActiveOrg</expression></condition><widgets>
                <label text="Select an active shop (organization) to manage its order rules." style="text-orange-9 text-weight-medium"/>
            </widgets></section>
            <section name="OrgRules_write"><condition><expression>hasActiveOrg &amp;&amp; modCanWrite</expression></condition><widgets>
            <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md border-radius-lg">
                <form-single name="CreateOrgRule" transition="saveOrgRule">
                    <field name="salesModeId"><default-field title="Sales Mode">
                        <drop-down><list-options list="modeList" key="${salesModeId}" text="${modeName}"/></drop-down>
                    </default-field></field>
                    <field name="requireCustomer"><default-field title="Require Customer">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>
                    <field name="minOrderAmount"><default-field title="Min Order Amount">
                        <text-line size="10" input-type="number" default-value="0"/>
                    </default-field></field>
                    <field name="submitBtn"><default-field title="">
                        <submit text="Save Rule" icon="fa fa-shield"/>
                    </default-field></field>
                </form-single>
            </container>
            </widgets></section>
            <section name="OrgRules_list"><condition><expression>hasActiveOrg</expression></condition><widgets>
            <form-list name="OrgRuleListForm" list="orgRuleList" transition="saveOrgRule" skip-form="false">
                <field name="salesModeId"><default-field><hidden/></default-field></field>
                <field name="modeDisplay"><default-field title="Sales Mode">
                    <display-entity entity-name="zenith.erp.pos.PosSalesMode" key-field-name="salesModeId" text="${modeName}"/>
                </default-field></field>
                <field name="requireCustomer"><default-field title="Require Customer">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="minOrderAmount"><default-field title="Min Order">
                    <text-line size="10" input-type="number"/>
                </default-field></field>
                <field name="saveBtn">
                    <conditional-field name="orgrule_save_write" condition="modCanWrite" title="">
                    <submit text="Save" icon="fa fa-save"/>
                    </conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field></field>
                <field name="deleteBtn">
                    <conditional-field name="orgrule_delete_write" condition="modCanWrite" title="">
                    <link url="deleteOrgRule" text="Delete" icon="fa fa-trash" btn-type="danger"
                          parameter-map="[salesModeId:salesModeId]" confirmation="Remove this rule?"/>
                    </conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field></field>
            </form-list>
            </widgets></section>

            <container style="smode-card smode-assign smode-tbl">
            <render-mode><text type="html,qvt"><![CDATA[<div class="smode-card-hd"><span class="smode-card-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg></span><div><h2 class="smode-card-title">Terminal Mode Assignment</h2><p class="smode-card-sub">Assign which sales mode is available on each terminal.</p></div></div>]]></text></render-mode>
            <section name="AssignTerminalMode_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container style="q-mb-md">
                <form-single name="AssignTerminalMode" transition="assignTerminal">
                    <field name="terminalId"><default-field title="Terminal">
                        <drop-down>
                            <list-options list="terminalList" key="${terminalId}" text="${terminalName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="salesModeId"><default-field title="Sales Mode">
                        <drop-down>
                            <list-options list="modeList" key="${salesModeId}" text="${modeName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="submitBtn"><default-field title="">
                        <submit text="Assign" icon="fa fa-link"/>
                    </default-field></field>
                </form-single>
            </container>
            </widgets></section>

            <form-list name="TerminalModeListForm" list="terminalModeList" list-entry="tm" skip-form="true">
                <field name="terminalId"><default-field title="Terminal">
                    <display-entity entity-name="zenith.erp.pos.PosTerminal" key-field-name="terminalId" text="${terminalName}"/>
                </default-field></field>
                <field name="salesModeId"><default-field title="Sales Mode">
                    <display-entity entity-name="zenith.erp.pos.PosSalesMode" key-field-name="salesModeId" text="${modeName}"/>
                </default-field></field>
                <field name="removeBtn">
                    <conditional-field name="tm_remove_write" condition="modCanWrite" title="">
                    <link url="removeTerminal" text="Remove" icon="fa fa-unlink" btn-type="danger"
                          parameter-map="[terminalId:tm.terminalId, salesModeId:tm.salesModeId]"
                          confirmation="Remove this assignment?"/>
                    </conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field></field>
            </form-list>
            </container>
        </container>
    </widgets>
</screen>
