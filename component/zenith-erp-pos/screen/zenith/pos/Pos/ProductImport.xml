                    </section>

                    <section style="background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:20px">
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
                            <span class="z-icobadge primary"><span class="material-icons">description</span></span>
                            <div style="font-size:15px;font-weight:700;color:#111827">CSV Column Format</div>
                        </div>
                        <table style="width:100%;border-collapse:collapse;font-size:12.5px">
                            <thead><tr style="background:#F8F9FC;text-align:left;color:#6B7280">
                                <th style="padding:9px 14px;font-weight:600;border-bottom:1px solid #E5E7EB">Column</th>
                                <th style="padding:9px 14px;font-weight:600;border-bottom:1px solid #E5E7EB">Required</th>
                                <th style="padding:9px 14px;font-weight:600;border-bottom:1px solid #E5E7EB">Description</th>
                            </tr></thead>
                            <tbody>
                                <tr style="border-bottom:1px solid #F1F1F4"><td style="padding:9px 14px;color:#111827;font-weight:500">SKU</td><td style="padding:9px 14px"><span class="zenith-badge danger nd" style="font-size:11px">Yes</span></td><td style="padding:9px 14px;color:#6B7280">Unique product code</td></tr>
                                <tr style="border-bottom:1px solid #F1F1F4"><td style="padding:9px 14px;color:#111827;font-weight:500">ProductName</td><td style="padding:9px 14px"><span class="zenith-badge danger nd" style="font-size:11px">Yes</span></td><td style="padding:9px 14px;color:#6B7280">Product display name</td></tr>
                                <tr style="border-bottom:1px solid #F1F1F4"><td style="padding:9px 14px;color:#111827;font-weight:500">Description</td><td style="padding:9px 14px"><span class="zenith-badge grey nd" style="font-size:11px">No</span></td><td style="padding:9px 14px;color:#6B7280">Product description</td></tr>
                                <tr style="border-bottom:1px solid #F1F1F4"><td style="padding:9px 14px;color:#111827;font-weight:500">ListPrice</td><td style="padding:9px 14px"><span class="zenith-badge grey nd" style="font-size:11px">No</span></td><td style="padding:9px 14px;color:#6B7280">Selling price charged at POS</td></tr>
                                <tr style="border-bottom:1px solid #F1F1F4"><td style="padding:9px 14px;color:#111827;font-weight:500">MRP</td><td style="padding:9px 14px"><span class="zenith-badge grey nd" style="font-size:11px">No</span></td><td style="padding:9px 14px;color:#6B7280">Maximum retail price</td></tr>
                                <tr style="border-bottom:1px solid #F1F1F4"><td style="padding:9px 14px;color:#111827;font-weight:500">ProductTaxCode</td><td style="padding:9px 14px"><span class="zenith-badge grey nd" style="font-size:11px">No</span></td><td style="padding:9px 14px;color:#6B7280">Tax code (HSN/SAC)</td></tr>
                                <tr style="border-bottom:1px solid #F1F1F4"><td style="padding:9px 14px;color:#111827;font-weight:500">ReorderPoint</td><td style="padding:9px 14px"><span class="zenith-badge grey nd" style="font-size:11px">No</span></td><td style="padding:9px 14px;color:#6B7280">Low stock alert level</td></tr>
                                <tr style="border-bottom:1px solid #F1F1F4"><td style="padding:9px 14px;color:#111827;font-weight:500">ReorderQuantity</td><td style="padding:9px 14px"><span class="zenith-badge grey nd" style="font-size:11px">No</span></td><td style="padding:9px 14px;color:#6B7280">Quantity to reorder</td></tr>
                                <tr style="border-bottom:1px solid #F1F1F4"><td style="padding:9px 14px;color:#111827;font-weight:500">ExpiryDate</td><td style="padding:9px 14px"><span class="zenith-badge grey nd" style="font-size:11px">No</span></td><td style="padding:9px 14px;color:#6B7280">Perishable goods expiry, YYYY-MM-DD (shows in Wastage)</td></tr>
                                <tr><td style="padding:9px 14px;color:#111827;font-weight:500">Unit</td><td style="padding:9px 14px"><span class="zenith-badge grey nd" style="font-size:11px">No</span></td><td style="padding:9px 14px;color:#6B7280">kg, g, l, ml or pcs (loose/weighed). Blank = piece.</td></tr>
                            </tbody>
                        </table>
                    </section>
                    <section style="background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:20px">
                        <div style="font-size:15px;font-weight:700;color:#111827;margin-bottom:6px">Arrange Existing Products by Category</div>
                        <div style="font-size:12.5px;color:#6B7280;line-height:1.5;margin-bottom:12px">Upload a CSV with <b>SourceProductId,SourceCode,ProductName,Category</b> from the old ERP, or <b>SKU,ProductName,Category</b>. Preview checks every product in this organization. Applying changes category memberships only; product names, prices and stock stay as they are. Current category memberships for matched products are replaced.</div>
                        <input id="pi-category-file" type="file" accept=".csv,text/csv,text/plain" style="font-size:13px;max-width:100%"/>
                        <div style="display:flex;gap:8px;margin-top:12px">
                            <button id="pi-category-preview" type="button" style="padding:9px 15px;border:1px solid #7C3AED;border-radius:8px;background:#fff;color:#7C3AED;font-weight:600;cursor:pointer">Preview Categories</button>
                            <button id="pi-category-apply" type="button" disabled="disabled" style="padding:9px 15px;border:0;border-radius:8px;background:#7C3AED;color:#fff;font-weight:600;cursor:pointer">Apply Categories</button>
                        </div>
                        <div id="pi-category-result" role="status" style="font-size:12.5px;margin-top:10px;white-space:pre-wrap"></div>
                    </section>
                </div>
            </div>
        </div>
        <script src="/zenithstatic/js/pos-terminal.js?v=${ec.resource.getLocationReference('component://zenith-erp-app/screen/zenithstatic/js/pos-terminal.js').getLastModified()?c}"></script>
        <script>
        (function(){
            var tu=document.getElementById('imp-tab-upload'), tp=document.getElementById('imp-tab-paste');
            var up=document.getElementById('imp-upload-pane'), pp=document.getElementById('imp-paste-pane');
            function show(which){ var u=(which==='upload');
                if(tu){ tu.style.color=u?'#7C3AED':'#6B7280'; tu.style.borderBottomColor=u?'#7C3AED':'transparent'; tu.style.fontWeight=u?'600':'500'; }
                if(tp){ tp.style.color=!u?'#7C3AED':'#6B7280'; tp.style.borderBottomColor=!u?'#7C3AED':'transparent'; tp.style.fontWeight=!u?'600':'500'; }
                if(up) up.style.display=u?'block':'none'; if(pp) pp.style.display=u?'none':'block'; }
            if(tu) tu.addEventListener('click',function(){show('upload');});
            if(tp) tp.addEventListener('click',function(){show('paste');});
            var dz=document.getElementById('imp-dropzone'), ta=document.getElementById('pos-csv-text'), fn=document.getElementById('imp-filename');
            if(dz){
                ['dragover','dragenter'].forEach(function(ev){ dz.addEventListener(ev,function(e){ e.preventDefault(); dz.style.borderColor='#7C3AED'; dz.style.background='#F5F3FF'; }); });
                ['dragleave','dragend'].forEach(function(ev){ dz.addEventListener(ev,function(e){ e.preventDefault(); dz.style.borderColor='#DDD6FE'; dz.style.background='#FBFAFF'; }); });
                dz.addEventListener('drop',function(e){ e.preventDefault(); dz.style.borderColor='#DDD6FE'; dz.style.background='#FBFAFF';
                    var f=e.dataTransfer&&e.dataTransfer.files&&e.dataTransfer.files[0]; if(!f) return;
                    var r=new FileReader(); r.onload=function(ev){ if(ta) ta.value=ev.target.result; if(fn) fn.textContent='Selected: '+f.name; }; r.readAsText(f); });
            }
            var cf=document.getElementById('pos-csv-file');
            if(cf) cf.addEventListener('change',function(){ if(cf.files&&cf.files[0]&&fn) fn.textContent='Selected: '+cf.files[0].name; });
        })();
        </script>
        ]]></text></render-mode>

