<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Import" default-menu-index="13">

    <transition name="downloadTemplate">
        <actions><script><![CDATA[
            def csvContent = new StringBuilder()
            csvContent.append("SKU,ProductName,Description,ListPrice,MRP,ProductTaxCode,ReorderPoint,ReorderQuantity,ExpiryDate,Unit\n")
            csvContent.append("RICE-5KG,Rice Bag 5kg,Premium Basmati Rice 5kg,240.00,250.00,1006,10,50,\n")
            csvContent.append("MILK-1L,Milk 1 Litre,Full Cream Milk 1L,52.00,55.00,0401,10,40,2026-07-15\n")
            csvContent.append("OIL-1L,Cooking Oil 1L,Refined Sunflower Oil 1 Litre,170.00,180.00,1508,5,20,\n")
            ec.web.response.setContentType("text/csv")
            ec.web.response.setHeader("Content-Disposition", "attachment; filename=product_import_template.csv")
            ec.web.response.writer.write(csvContent.toString())
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <transition name="exportProducts">
        <actions><script><![CDATA[
            def prods = ec.entity.find("mantle.product.Product").condition("productTypeEnumId", "PtAsset").condition("ownerPartyId", posOrganizationPartyId ?: "__NO_ORGANIZATION__").orderBy("productName").list()
            def esc = { v -> if (v == null) return ""; def s = v.toString(); (s.contains(",") || s.contains("\"") || s.contains("\n")) ? ("\"" + s.replace("\"", "\"\"") + "\"") : s }
            def num = { v -> v != null ? v.toString() : "" }
            def sb = new StringBuilder()
            sb.append("SKU,ProductName,Description,ListPrice,MRP,ProductTaxCode,ReorderPoint,ReorderQuantity,ExpiryDate,Unit\n")
            prods.each { p ->
                def price = num(p.mrpAmount)
                def unitLbl = ([WT_kg:'kg', WT_g:'g', VLIQ_L:'l', VLIQ_ml:'ml'].get(p.amountUomId) ?: '')
                sb.append([esc(p.pseudoId), esc(p.productName), esc(p.description), price, price,
                           esc(p.productTaxCode), num(p.reorderPoint), num(p.reorderQuantity), num(p.expiryDate), unitLbl].join(",")).append("\n")
            }
            ec.web.response.setContentType("text/csv")
            ec.web.response.setHeader("Content-Disposition", "attachment; filename=products_export.csv")
            ec.web.response.writer.write(sb.toString())
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <transition name="searchProductsForImport">
        <actions><script><![CDATA[
            def rawTerm = (ec.web.parameters.term ?: '').toString().trim()
            def _ao = posOrganizationPartyId ?: '__NO_ORGANIZATION__'
            def results = []
            if (rawTerm) {
                // Filter before limiting so every product remains searchable after a bulk import.
                def cf = ec.entity.conditionFactory
                def nameOrSku = cf.makeCondition(['productName', 'pseudoId'].collect {
                    cf.makeCondition(it, org.moqui.entity.EntityCondition.LIKE, '%' + rawTerm + '%').ignoreCase()
                }, org.moqui.entity.EntityCondition.OR)
                def matched = ec.entity.find("mantle.product.Product").condition("productTypeEnumId", "PtAsset")
                    .condition("ownerPartyId", _ao).condition(nameOrSku).orderBy("productName").limit(12).list()
                // exact barcode match — fetch the product directly so it's found even past the name-search limit
                def bcQ = ec.entity.find("zenith.erp.barcode.ProductBarcode").condition("barcodeValue", rawTerm).condition("isActive", "Y")
                bcQ.condition("organizationPartyId", _ao)
                bcQ.list().collect { it.productId }.unique().each { pid ->
                    if (!matched.any { it.productId == pid }) {
                        def bp = ec.entity.find("mantle.product.Product").condition("productId", pid).one()
                        if (bp != null && bp.ownerPartyId == _ao) matched.add(bp)
                    }
                }
                if (matched.size() > 12) matched = matched.subList(0, 12)
                matched.each { p ->
                    results.add([sku:(p.pseudoId ?: ''), name:(p.productName ?: ''), description:(p.description ?: ''),
                                 price:(p.mrpAmount != null ? p.mrpAmount.toString() : ''),
                                 taxCode:(p.productTaxCode ?: ''),
                                 reorderPoint:(p.reorderPoint != null ? p.reorderPoint.toString() : ''),
                                 reorderQuantity:(p.reorderQuantity != null ? p.reorderQuantity.toString() : ''),
                                 expiryDate:(p.expiryDate != null ? p.expiryDate.toString() : ''),
                                 unit:([WT_kg:'kg', WT_g:'g', VLIQ_L:'l', VLIQ_ml:'ml'].get(p.amountUomId) ?: '')])
                }
            }
            ec.web.sendJsonResponse([success:true, products:results])
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <transition name="importProducts">
        <actions><script><![CDATA[
            def csvText = ec.web.parameters.csvText
            if (!csvText || !csvText.trim()) { ec.web.sendJsonResponse([success:false, error:'Choose a CSV file or paste rows first']); return }
            def lines = csvText.split("\\r?\\n")
            if (lines.length < 2) { ec.web.sendJsonResponse([success:false, error:'Need a header row and at least one data row']); return }

            def parseLine = { String ln ->
                def out = []
                def sb = new StringBuilder()
                boolean inQ = false
                int n = ln.length()
                for (int i = 0; i < n; i++) {
                    def ch = ln.charAt(i)
                    if (ch == ('"' as char)) {
                        if (inQ && (i + 1) < n && ln.charAt(i + 1) == ('"' as char)) { sb.append('"' as char); i++ }
                        else { inQ = !inQ }
                    } else if (ch == (',' as char) && !inQ) { out.add(sb.toString()); sb = new StringBuilder() }
                    else { sb.append(ch) }
                }
                out.add(sb.toString())
                return out
            }

            def headers = parseLine(lines[0]).collect { it.trim() }
            def col = [:]
            headers.eachWithIndex { h, i -> col[h.toLowerCase()] = i }
            def missing = ["sku", "productname"].findAll { !col.containsKey(it) }
            if (missing) { ec.web.sendJsonResponse([success:false, error:'CSV must include SKU and ProductName columns']); return }

            def cellAt = { cols, key -> (col.containsKey(key) && cols.size() > col[key]) ? (cols[col[key]] != null ? cols[col[key]].trim() : null) : null }
            def toBD = { s -> (s != null && s.trim()) ? new BigDecimal(s.trim()) : null }

            int imported = 0
            int skipped = 0
            def errors = []
            for (int li = 1; li < lines.length; li++) {
                def line = lines[li]
                if (!line || !line.trim()) continue
                try {
                    def cols = parseLine(line)
                    def name = cellAt(cols, "productname")
                    if (!name) { skipped++; continue }
                    ec.service.sync().name("zenith.pos.PosServices.upsert#PosProduct")
                        .parameters([sku:cellAt(cols, "sku"), productName:name, description:cellAt(cols, "description"),
                                     listPrice:toBD(cellAt(cols, "listprice")), mrp:toBD(cellAt(cols, "mrp")),
                                     productTaxCode:cellAt(cols, "producttaxcode"),
                                     reorderPoint:toBD(cellAt(cols, "reorderpoint")),
                                     reorderQuantity:toBD(cellAt(cols, "reorderquantity")),
                                     expiryDate:cellAt(cols, "expirydate"), unit:cellAt(cols, "unit")]).call()
                    if (ec.message.hasError()) { errors.add("Row " + (li + 1) + ": " + ec.message.errorsString); ec.message.clearErrors(); skipped++ }
                    else { imported++ }
                } catch (Exception e) { skipped++; errors.add("Row " + (li + 1) + ": " + e.message) }
            }
            ec.web.sendJsonResponse([success:true, imported:imported, skipped:skipped, errors:errors.take(10)])
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <transition name="importCategoryAssignments">
        <actions><script><![CDATA[
            def result = ec.service.sync().name('zenith.inventory.CatalogueServices.import#ProductCategories')
                .parameters([csvText:ec.web.parameters.csvText, apply:ec.web.parameters.apply == 'true']).call()
            if (ec.message.hasError()) {
                def error = ec.message.errorsString
                ec.message.clearErrors()
                ec.web.sendJsonResponse([success:false,error:error]); return
            }
            ec.web.sendJsonResponse([success:true,matched:result.matched,categories:result.categories,
                changed:result.changed,issueCount:result.issueCount,matchMethods:result.matchMethods,
                issues:result.issues,applied:ec.web.parameters.apply == 'true' && !result.issueCount])
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <transition name="addSingleProduct">
        <actions><script><![CDATA[
            def name = ec.web.parameters.productName
            if (!name || !name.trim()) { ec.web.sendJsonResponse([success:false, error:'Product Name is required']); return }
            def toBD = { s -> (s != null && s.toString().trim()) ? new BigDecimal(s.toString().trim()) : null }
            def result = ec.service.sync().name("zenith.pos.PosServices.upsert#PosProduct")
                .parameters([sku:ec.web.parameters.sku, productName:name, description:ec.web.parameters.description,
                             listPrice:toBD(ec.web.parameters.listPrice), mrp:toBD(ec.web.parameters.mrp),
                             productTaxCode:ec.web.parameters.productTaxCode,
                             reorderPoint:toBD(ec.web.parameters.reorderPoint),
                             reorderQuantity:toBD(ec.web.parameters.reorderQuantity),
                             expiryDate:ec.web.parameters.expiryDate, unit:ec.web.parameters.unit]).call()
            if (ec.message.hasError()) { def em = ec.message.errorsString; ec.message.clearErrors(); ec.web.sendJsonResponse([success:false, error:em]); return }
            ec.web.sendJsonResponse([success:true, created:result.created, name:name])
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <set field="appBase" from="(ec.web?.request?.requestURI ?: '').with { it.indexOf('/zenith/') > 0 ? it.substring(0, it.indexOf('/zenith/')) : '' }"/>
        <entity-find entity-name="mantle.product.Product" list="recentProducts" limit="20">
            <econdition field-name="productTypeEnumId" value="PtAsset"/>
            <!-- Org isolation: only this org's products (admin with no active org sees all). -->
            <econdition field-name="ownerPartyId" from="(ec.user.getPreference('ACTIVE_ORGANIZATION')) ?: '__NO_ORGANIZATION__'"/>
            <order-by field-name="-lastUpdatedStamp"/>
        </entity-find>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_import" style="background:#EEF2FF;border:1px solid #C7D2FE;border-left:5px solid #6366F1;border-radius:10px;padding:9px 16px;margin:8px 16px 0 16px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:700;font-size:14px;color:#3730A3;outline:none">&#128229; Import &mdash; quick help <span style="font-weight:500;color:#6B7280;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Add the products you sell.<br><b>1</b>&nbsp;<b>Add Single Product</b> for one item (search first to edit an existing one &mdash; it auto-fills the SKU).<br><b>2</b>&nbsp;<b>Bulk Import</b> to paste rows or upload a CSV &mdash; follow the column format shown.<br><b>3</b>&nbsp;Recently added / updated items appear at the bottom.</div></details>]]></text></render-mode>

        <render-mode><text type="html,qvt" template="true"><![CDATA[
