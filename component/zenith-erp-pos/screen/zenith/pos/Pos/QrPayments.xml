<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="QR Payments" default-menu-include="false">

    <transition name="confirmPayment">
        <service-call name="zenith.pos.KotServices.confirm#QrPayment"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.pos.PosQrPayment" list="qrPayments">
            <search-form-inputs skip-fields="organizationPartyId,ownerPartyId" default-order-by="-generatedDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="(ec.user.getPreference('ACTIVE_ORGANIZATION')) ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_qrpayments" open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128241; QR Payments &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Set up <b>QR / UPI</b> code payments offered to customers at checkout.</div></details>]]></text></render-mode>
        <container style="q-mb-lg">
            <label text="QR Code Payments" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search QR Payments..." style="display:none"></span>]]></text></render-mode>
            <form-list name="QrForm" list="qrPayments" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="qrPaymentId"><default-field title="ID"><display/></default-field></field>
                <field name="posTransactionId"><default-field title="Transaction"><display/></default-field></field>
                <field name="qrTypeEnumId"><default-field title="QR Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="amount"><default-field><display format="#,##0.00"/></default-field></field>
                <field name="merchantName"><default-field title="Merchant"><display/></default-field></field>
                <field name="generatedDate"><default-field title="Generated"><display format="dd-MMM HH:mm"/></default-field></field>
                <field name="paymentReference"><default-field title="Reference"><display/></default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="QpGenerated" text="Generated"/>
                        <option key="QpPending" text="Pending"/>
                        <option key="QpConfirmed" text="Confirmed"/>
                        <option key="QpFailed" text="Failed"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field></field>
                <field name="actions"><default-field title="">
                    <link url="confirmPayment" text="Confirm"
                          parameter-map="[qrPaymentId:qrPaymentId]"
                          condition="modCanWrite &amp;&amp; (statusId in ['QpGenerated', 'QpPending'])" btn-type="success" style="q-btn--dense"/>
                </default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
