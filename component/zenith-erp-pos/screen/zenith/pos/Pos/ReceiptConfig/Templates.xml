<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Templates" default-menu-index="1">

    <transition name="createTemplate" method="post" begin-transaction="true">
        <actions>
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" in-map="[moduleId:(kitchenModuleId ?: 'pos')]" out-map="_receiptWrite"/>
            <if condition="!_receiptWrite.canWrite"><return error="true" message="Receipt settings are view-only."/></if>
            <set field="organizationPartyId" from="posOrganizationPartyId"/>
            <if condition="!organizationPartyId || organizationPartyId == '_NA_'"><return error="true" message="Choose your organization before creating a template."/></if>
            <if condition="receiptWidth &amp;&amp; !['58mm','80mm'].contains(receiptWidth)"><return error="true" message="Choose a supported receipt width."/></if>
            <if condition="!templateName?.trim() || !companyName?.trim()"><return error="true" message="Template name and company name are required."/></if>
            <if condition="facilityId &amp;&amp; !ec.entity.find('mantle.facility.Facility').condition('facilityId',facilityId).condition('ownerPartyId',organizationPartyId).one()"><return error="true" message="Choose a shop in your organization."/></if>
            <set field="printUse" from="kitchenModuleId == 'kot' ? ec.web.parameters.printUse : null"/>
            <if condition="kitchenModuleId == 'kot' &amp;&amp; !(printUse in ['kotBill','kotTicket'])"><return error="true" message="Choose a KOT print output."/></if>
            <entity-find-one entity-name="mantle.party.Party" value-field="_receiptOrgLock" for-update="true"><field-map field-name="partyId" from="organizationPartyId"/></entity-find-one>
            <set field="defaultKotTemplate" from="printUse &amp;&amp; !ec.entity.find('zenith.erp.pos.PosReceiptTemplate')
                .condition('organizationPartyId',organizationPartyId).condition('facilityId',facilityId ?: null)
                .condition('printUse',printUse).condition('isActive','Y').count()"/>
            <service-call name="create#zenith.erp.pos.PosReceiptTemplate" in-map="[organizationPartyId:organizationPartyId,templateName:templateName,companyName:companyName,
                phone:phone,facilityId:facilityId ?: null,receiptWidth:receiptWidth ?: '80mm',printUse:printUse,isDefault:defaultKotTemplate ? 'Y' : 'N']" out-map="context"/>
            <service-call name="zenith.pos.PosServices.enforce#SingleDefaultReceiptTemplate" in-map="[templateId:templateId]"/>
        </actions>
        <default-response url="."/></transition>
    <transition name="editTemplate">
        <default-response url="../EditTemplate"><parameter name="templateId"/><parameter name="receiptDesign"/></default-response>
    </transition>

    <actions>
        <entity-find entity-name="mantle.facility.Facility" list="receiptFacilities"><econdition field-name="ownerPartyId" from="posOrganizationPartyId ?: '__NONE__'"/><order-by field-name="facilityName"/></entity-find>
        <script><![CDATA[
            def templates = ec.entity.find('zenith.erp.pos.PosReceiptTemplate')
                .condition('organizationPartyId',posOrganizationPartyId ?: '__NO_ORGANIZATION__')
            if (kitchenModuleId == 'kot') templates.condition('printUse','in',['kotBill','kotTicket'])
            else templates.condition('printUse',null)
            templateList = templates.orderBy('templateName').list()
            totalTemplates = templateList.size()
            activeTemplates = templateList.count { it.isActive == 'Y' }
            defaultTemplates = templateList.count { it.isDefault == 'Y' }
            def defTpl = templateList.find { it.isDefault == 'Y' }
            stdWidth = (defTpl?.receiptWidth ?: '80mm')
            // 1-based row counter for the '#' column badge (shared mutable holder; a row's own
            // context write doesn't persist across rows, mutating a shared object does).
            context.tplCounter = [0]
        ]]></script>
    </actions>

    <widgets>
        <container style="q-pa-md">

            <!-- Page header: document icon + title + subtitle -->
            <container style="zsec-hdr row items-center q-mb-lg">
                <container style="row items-center no-wrap">
                    <container style="z-icobadge lg primary q-mr-md"><label text="description" type="span" style="material-icons"/></container>
                    <container style="column">
                        <label text="${kitchenModuleId == 'kot' ? 'KOT Print Templates' : 'Create Receipt Template'}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="${kitchenModuleId == 'kot' ? 'Customize the kitchen order ticket and customer bill separately for KOT Billing.' : 'Set up and customize your receipt template for printing at the billing counter.'}" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
                    </container>
                </container>
            </container>

            <!-- KPI stat cards: Total(violet) / Active(blue) / Default(green) / Width(orange) -->
            <container style="z-statrow">
                <container style="z-statcell z-statcard-violet q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg primary"><label text="description" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Total Templates" type="span" style="z-statlabel"/>
                            <label text="${totalTemplates ?: 0}" type="span" style="z-statnum z-txt-primary"/>
                            <label text="In your organization" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
                <container style="z-statcell z-statcard-blue q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg blue"><label text="layers" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Active Templates" type="span" style="z-statlabel"/>
                            <label text="${activeTemplates ?: 0}" type="span" style="z-statnum z-amt-blue"/>
                            <label text="Currently enabled" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
                <container style="z-statcell z-statcard-green q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg green"><label text="check_circle" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Default Template" type="span" style="z-statlabel"/>
                            <label text="${defaultTemplates ?: 0}" type="span" style="z-statnum z-amt-green"/>
                            <label text="Used for new receipts" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
                <container style="z-statcell z-statcard-orange q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg orange"><label text="print" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Standard Width" type="span" style="z-statlabel z-txt-orange"/>
                            <label text="${stdWidth}" type="span" style="z-statnum z-txt-orange"/>
                            <label text="Default receipt size" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
            </container>

            <!-- Template Details panel: the Create form (write-gated) -->
            <section name="CreateTemplate_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md q-mb-lg rcpt-panel">
                <container style="row items-center q-mb-md no-wrap">
                    <container style="z-icobadge primary q-mr-sm"><label text="description" type="span" style="material-icons"/></container>
                    <container style="column">
                        <label text="Template Details" type="span" style="rcpt-ptitle"/>
                        <label text="Enter the basic details for your receipt template." type="span" style="rcpt-psub"/>
                    </container>
                </container>
                <!-- Native POST keeps qvt from treating the POST-only transition as a navigation link. -->
                <render-mode><text type="html,qvt" template="true"><![CDATA[
<#assign createUrl=sri.buildUrl('createTemplate').url>
<#if sri.getRenderMode() == 'qvt'><#assign createUrl=createUrl?replace('/apps/','/qapps/')></#if>
<link rel="stylesheet" href="/zenithstatic/css/pos-receipt-editor.css?v=${ec.resource.getLocationReference('component://zenith-erp-app/screen/zenithstatic/css/pos-receipt-editor.css').getLastModified()?c}"/>
<form id="CreateTemplate" class="receipt-create-form" method="post" action="${createUrl?html}">
<input type="hidden" name="moquiSessionToken" value="${(ec.web.sessionToken!'')?html}"/>
<#if (kitchenModuleId!'pos') == 'kot'>
<div class="form-group q-ma-sm"><label for="receipt-create-output">Print output</label><select class="form-control" id="receipt-create-output" name="printUse" required><option value="">Choose a print output</option><option value="kotTicket">Kitchen order ticket</option><option value="kotBill">Customer bill</option></select></div>
</#if>
<div class="form-group q-ma-sm"><label for="receipt-create-name">Template Name</label><input class="form-control" id="receipt-create-name" name="templateName" maxlength="255" placeholder="Enter template name" required/></div>
<div class="form-group q-ma-sm"><label for="receipt-create-company">Company Name</label><input class="form-control" id="receipt-create-company" name="companyName" maxlength="255" placeholder="Enter company name" required/></div>
<div class="form-group q-ma-sm"><label for="receipt-create-shop">Shop</label><select class="form-control" id="receipt-create-shop" name="facilityId"><option value="">All shops (organization default)</option><#list receiptFacilities as facility><option value="${facility.facilityId?html}">${(facility.facilityName!facility.facilityId)?html}</option></#list></select></div>
<#if (kitchenModuleId!'pos') != 'kot'><div class="form-group q-ma-sm"><label for="receipt-create-phone">Phone</label><input class="form-control" id="receipt-create-phone" name="phone" maxlength="60" placeholder="Enter phone number"/></div></#if>
<div class="form-group q-ma-sm"><label for="receipt-create-width">Receipt Width</label><select class="form-control" id="receipt-create-width" name="receiptWidth"><option value="80mm">80mm (Standard)</option><option value="58mm">58mm (Compact)</option></select></div>
<div class="q-ma-sm"><button type="submit" class="btn btn-primary">Create Template</button></div>
</form>
                ]]></text></render-mode>
            </container>
            </widgets></section>

            <!-- Receipt Templates panel: the templates table -->
            <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md rcpt-panel">
                <container style="row items-center q-mb-md no-wrap">
                    <container style="z-icobadge primary q-mr-sm"><label text="description" type="span" style="material-icons"/></container>
                    <container style="column">
                        <label text="Receipt Templates" type="span" style="rcpt-ptitle"/>
                        <label text="Manage your existing receipt templates." type="span" style="rcpt-psub"/>
                    </container>
                </container>
                <container style="z-txntable">
                <form-list name="TemplateList" list="templateList" list-entry="tpl" skip-form="true">
                    <row-actions>
                        <set field="shopName" from="receiptFacilities.find { it.facilityId==tpl.facilityId }?.facilityName ?: (tpl.facilityId ?: 'All shops')"/>
                        <set field="rowNum" from="(tplCounter[0] = tplCounter[0] + 1)"/>
                        <set field="defTxt" from="tpl.isDefault == 'Y' ? 'Yes' : 'No'"/>
                        <set field="defCls" from="tpl.isDefault == 'Y' ? 'zenith-badge success nd' : 'zenith-badge grey nd'"/>
                        <set field="actTxt" from="tpl.isActive == 'Y' ? 'Yes' : 'No'"/>
                        <set field="actCls" from="tpl.isActive == 'Y' ? 'zenith-badge success nd' : 'zenith-badge grey nd'"/>
                    </row-actions>
                    <field name="rowNum"><header-field title="#"/>
                        <default-field><label text="${rowNum}" type="span" style="z-rownum"/></default-field></field>
                    <field name="templateName"><header-field title="Template"/>
                        <conditional-field condition="kitchenModuleId == 'kot'">
                            <link url="editTemplate" text="${tpl.templateName} · ${tpl.printUse == 'kotTicket' ? 'Kitchen order ticket' : 'Customer bill'}" parameter-map="[templateId:tpl.templateId]" link-type="anchor" style="z-vlink"/>
                        </conditional-field>
                        <default-field>
                            <link url="editTemplate" text="${tpl.templateName}" parameter-map="[templateId:tpl.templateId]" link-type="anchor" style="z-vlink"/>
                        </default-field></field>
                    <field name="companyName"><header-field title="Company"/>
                        <default-field><display default-text="-"/></default-field></field>
                    <field name="facilityId"><header-field title="Shop"/><default-field><label text="${shopName}" type="span"/></default-field></field>
                    <field name="receiptWidth"><header-field title="Width"/>
                        <default-field><display/></default-field></field>
                    <field name="isDefault"><header-field title="Default"/>
                        <default-field><label text="${defTxt}" type="span" style="${defCls}"/></default-field></field>
                    <field name="isActive"><header-field title="Active"/>
                        <default-field><label text="${actTxt}" type="span" style="${actCls}"/></default-field></field>
                    <field name="editBtn">
                        <conditional-field name="tpl_edit_write" condition="modCanWrite" title="Action">
                        <link url="editTemplate" text="${tpl.printUse == 'kotTicket' ? 'Edit ticket' : 'Edit Normal'}" icon="fa fa-pencil"
                              parameter-map="[templateId:tpl.templateId,receiptDesign:'normal']" link-type="anchor" style="z-obtn"/>
                        </conditional-field>
                        <default-field title="Action"><label text="" type="span"/></default-field></field>
                    <field name="editCreditBtn">
                        <conditional-field name="tpl_credit_write" condition="modCanWrite &amp;&amp; tpl.printUse != 'kotTicket'" title="Credit / Pay Later">
                        <link url="editTemplate" text="Edit Credit" icon="fa fa-pencil" parameter-map="[templateId:tpl.templateId,receiptDesign:'credit']" link-type="anchor" style="z-obtn"/>
                        </conditional-field>
                        <default-field title="Credit / Pay Later"><label text="" type="span"/></default-field></field>
                    <field name="editRevisedBtn">
                        <conditional-field name="tpl_revised_write" condition="modCanWrite &amp;&amp; tpl.printUse != 'kotTicket'" title="Revised Bill">
                        <link url="editTemplate" text="Edit Revised" icon="fa fa-pencil" parameter-map="[templateId:tpl.templateId,receiptDesign:'revised']" link-type="anchor" style="z-obtn"/>
                        </conditional-field>
                        <default-field title="Revised Bill"><label text="" type="span"/></default-field></field>
                </form-list>
                </container>
            </container>
        </container>
    </widgets>
</screen>
