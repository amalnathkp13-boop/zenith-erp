<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Terminals" default-menu-index="5">

    <always-actions><script><![CDATA[
        if (!ec.user.isInGroup('ADMIN') && !ec.user.isInGroup('ZENITH_ADMIN'))
            throw new org.moqui.context.ArtifactAuthorizationException('Only an administrator can manage POS terminals and assignments.')
    ]]></script></always-actions>
    <transition name="saveAssignment" begin-transaction="true">
        <actions>
            <!-- Quasar needs a resolvable form target. Only POST with the current session token can write. -->
            <if condition="ec.web.request.method != 'POST' || !ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken"><return error="true" message="Submit the assignment form with a valid session token."/></if>
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" in-map="[moduleId:kitchenModuleId ?: 'pos']" out-map="_writeAccess"/>
            <if condition="_writeAccess.canWrite != true"><return error="true" message="Module write access is required to assign a terminal."/></if>
            <service-call name="zenith.pos.PosAccessServices.save#TerminalAssignment" in-map="[userId:userId,terminalId:terminalId]"/>
        </actions><default-response url="."/>
    </transition>

    <transition name="createTerminal" begin-transaction="true">
        <actions>
            <!-- Let Quasar resolve the form target; enforce POST and CSRF before every write. -->
            <if condition="ec.web.request.method != 'POST' || !ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken"><return error="true" message="Submit the terminal form with a valid session token."/></if>
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" in-map="[moduleId:kitchenModuleId ?: 'pos']" out-map="_writeAccess"/>
            <if condition="_writeAccess.canWrite != true"><return error="true" message="Module write access is required to create a terminal."/></if>
            <!-- Pos.xml has already verified active-org membership and the submitted facility.
                 Reject a forged organization field, including for an admin with an active org. -->
            <if condition="organizationPartyId &amp;&amp; organizationPartyId != posOrganizationPartyId"><return error="true" message="The selected organization does not match your active organization."/></if>
            <set field="organizationPartyId" from="posOrganizationPartyId"/>
            <if condition="!organizationPartyId"><return error="true" message="Select an organization before creating a terminal."/></if>
            <if condition="ec.entity.isEntityDefined('zenith.erp.saas.SaasTenant')">
                <service-call name="zenith.saas.SaasUsageServices.check#KotCapacity" in-map="[resource:'terminal']" disable-authz="true"/>
            </if>
            <if condition="ec.message.hasError()"><return/></if>
            <service-call name="create#zenith.erp.pos.PosTerminal" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateTerminal" begin-transaction="true">
        <actions>
            <!-- Let Quasar resolve the form target; enforce POST and CSRF before every write. -->
            <if condition="ec.web.request.method != 'POST' || !ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken"><return error="true" message="Submit the terminal form with a valid session token."/></if>
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" in-map="[moduleId:kitchenModuleId ?: 'pos']" out-map="_writeAccess"/>
            <if condition="_writeAccess.canWrite != true"><return error="true" message="Module write access is required to edit a terminal."/></if>
            <entity-find-one entity-name="zenith.erp.pos.PosTerminal" value-field="_existingTerminal">
                <field-map field-name="terminalId" from="terminalId"/>
            </entity-find-one>
            <if condition="!_existingTerminal || _existingTerminal.organizationPartyId != posOrganizationPartyId">
                <return error="true" message="This terminal does not belong to your active organization."/>
            </if>
            <!-- A terminal's legal seller cannot be changed by editing its facility, even for an admin. -->
            <if condition="organizationPartyId &amp;&amp; organizationPartyId != posOrganizationPartyId">
                <return error="true" message="Switch to the correct organization before editing a terminal."/>
            </if>
            <if condition="_existingTerminal.facilityId != facilityId">
                <entity-find entity-name="zenith.erp.pos.PosSession" list="_openTerminalSessions" limit="1">
                    <econdition field-name="terminalId" from="terminalId"/>
                    <econdition field-name="statusId" value="PsOpen"/>
                </entity-find>
                <if condition="_openTerminalSessions"><return error="true" message="Close the POS session before changing this terminal's facility."/></if>
            </if>
            <set field="organizationPartyId" from="posOrganizationPartyId"/>
            <if condition="isActive == 'Y' &amp;&amp; _existingTerminal.isActive != 'Y' &amp;&amp; ec.entity.isEntityDefined('zenith.erp.saas.SaasTenant')">
                <service-call name="zenith.saas.SaasUsageServices.check#KotCapacity"
                              in-map="[resource:'terminal',terminalId:terminalId]" disable-authz="true"/>
                <if condition="ec.message.hasError()"><return/></if>
            </if>
            <service-call name="update#zenith.erp.pos.PosTerminal" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <actions>
        <set field="activeOrgId" from="posOrganizationPartyId ?: ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="hasActiveOrg" from="activeOrgId != null &amp;&amp; activeOrgId != '_NA_'"/>
        <entity-find entity-name="zenith.erp.pos.PosTerminal" list="terminalList">
            <!-- ZE-POS-TERM-VIS: explicit org scope (belt-and-suspenders with ZTF_POSTERMINAL). -->
            <econdition field-name="organizationPartyId" from="(activeOrgId) ?: '__NO_ORGANIZATION__'"/>
            <order-by field-name="terminalName"/>
        </entity-find>
        <!-- ZE-SHOP: facilities a terminal may bind to — this org's stores/warehouses (a no-org super-admin sees all). -->
        <entity-find entity-name="mantle.facility.Facility" list="orgFacilities">
            <econdition field-name="facilityTypeEnumId" operator="in" value="FcTpWarehouse,FcTpStore,FcTpRetailStore"/>
            <econdition field-name="ownerPartyId" from="(hasActiveOrg ? activeOrgId : null) ?: '__NO_ORGANIZATION__'"/>
            <order-by field-name="facilityName"/>
        </entity-find>
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="invoiceSeller">
            <field-map field-name="partyId" from="activeOrgId"/>
        </entity-find-one>
        <script><![CDATA[
            totalTerminals = terminalList.size()
            activeTerminals = terminalList.count { it.isActive == 'Y' }
            inactiveTerminals = totalTerminals - activeTerminals
            facilityCount = terminalList.collect { it.facilityId }.findAll { it }.unique().size()
            // 1-based row counter for the ID-column badge. A form-list has no row index and converting the
            // list to maps breaks its column layout, so keep the entity values and use a shared mutable holder
            // (a 1-element list) that row-actions can increment across rows (writes to a row's own context
            // don't persist, but mutating a shared object does).
            context.termCounter = [0]
            def parties=ec.entity.find('mantle.party.PartyRelationship').condition('toPartyId',activeOrgId)
                .condition('toRoleTypeId','OrgInternal').conditionDate('fromDate','thruDate',ec.user.nowTimestamp).disableAuthz().list()*.fromPartyId
            assignmentUsers=ec.entity.find('moqui.security.UserAccount').condition('partyId','in',parties ?: ['__NONE__'])
                .orderBy('username').disableAuthz().list().findAll { it.disabled!='Y' }
            def assignments=ec.entity.find('zenith.erp.pos.PosTerminalAssignment').condition('organizationPartyId',activeOrgId).list()
            def names=terminalList.collectEntries { [(it.terminalId):it.terminalName ?: it.terminalId] }
            assignmentRows=assignmentUsers.collect { u ->
                def assigned=assignments.find { it.userId==u.userId }
                [username:u.username,terminalName:assigned ? names[assigned.terminalId] ?: 'Unavailable terminal' : 'Not assigned']
            }
        ]]></script>
    </actions>

    <widgets>
        <container style="pos-terminals-reference q-pa-md">
            <!-- Page header: title + subtitle (left), Add Terminal solid CTA (right) -->
            <container style="zsec-hdr row items-center justify-between q-mb-lg">
                <container style="column">
                    <label text="${kitchenModuleId == 'kot' ? 'KOT Terminals' : 'POS Terminals'}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                    <label text="Manage and configure all POS terminals in your outlet" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
                    <label text="Invoice seller: ${invoiceSeller?.organizationName ?: activeOrgId ?: 'No organization selected'}. A facility selection does not change the legal seller or GSTIN." type="p" style="text-grey-7 q-mt-xs q-mb-none"/>
                </container>
                <section name="CreateTerminal_write"><condition><expression>modCanWrite &amp;&amp; hasActiveOrg</expression></condition><widgets>
                <container style="pos-terminals-reference__actions">
                <container style="z-newbtn-wrap">
                    <container-dialog id="CreateTerminalDialog" button-text="+ Add Terminal"
                        button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md z-newbtn">
                        <form-single name="CreateTerminalForm" transition="createTerminal">
                            <field name="terminalId"><default-field title="Terminal ID"><text-line size="15"/></default-field></field>
                            <field name="terminalName"><default-field title="Name"><text-line size="30"/></default-field></field>
                            <field name="facilityId"><default-field title="Store/Facility">
                                <drop-down allow-empty="true"><list-options list="orgFacilities" key="${facilityId}" text="${facilityName}"/></drop-down></default-field></field>
                            <field name="organizationPartyId"><default-field><hidden default-value="${activeOrgId}"/></default-field></field>
                            <field name="stateCode"><default-field title="State Code"><text-line size="5"/></default-field></field>
                            <field name="upiVpa"><default-field title="UPI VPA"><text-line size="30"/></default-field></field>
                            <field name="isActive"><default-field title="Active">
                                <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </container>
                <render-mode><text type="html,qvt" template="true"><![CDATA[
                    <details class="pos-terminals-reference__menu">
                      <summary aria-label="More terminal options"><span class="material-icons">expand_more</span></summary>
                      <div><a href="#pos-terminals-table">View terminals</a><a href="${sri.buildUrl('.').url?html}">Refresh list</a></div>
                    </details>
                ]]></text></render-mode>
                </container>
                </widgets></section>
            </container>

            <!-- KPI stat cards: Total(violet) / Active(green) / Inactive(orange) / Facilities(blue) -->
            <container style="z-statrow">
                <container style="z-statcell z-statcard-violet q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg primary"><label text="point_of_sale" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Total Terminals" type="span" style="z-statlabel"/>
                            <label text="${totalTerminals ?: 0}" type="span" style="z-statnum"/>
                            <label text="All registered terminals" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
                <container style="z-statcell z-statcard-green q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg green"><label text="check_circle" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Active Terminals" type="span" style="z-statlabel"/>
                            <label text="${activeTerminals ?: 0}" type="span" style="z-statnum z-amt-green"/>
                            <label text="Currently active" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
                <container style="z-statcell z-statcard-orange q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg orange"><label text="pause_circle" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Inactive Terminals" type="span" style="z-statlabel z-txt-orange"/>
                            <label text="${inactiveTerminals ?: 0}" type="span" style="z-statnum"/>
                            <label text="Currently inactive" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
                <container style="z-statcell z-statcard-blue q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg blue"><label text="storefront" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Facilities" type="span" style="z-statlabel"/>
                            <label text="${facilityCount ?: 0}" type="span" style="z-statnum z-amt-blue"/>
                            <label text="Across all terminals" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
            </container>

            <!-- Terminals table (inline-editable rows) -->
            <container style="zenith-card bg-white q-pa-md q-mb-lg">
                <label text="Billing login assignments" type="h4"/>
                <label text="Only administrators assign terminals. Billing logins are locked to the assigned terminal and its shop. Close the user's sessions before reassigning." type="p"/>
                <section name="AssignTerminalWrite" condition="modCanWrite">
                    <widgets>
                        <form-single name="AssignTerminalForm" transition="saveAssignment">
                            <field name="userId"><default-field title="Billing login"><drop-down><list-options list="assignmentUsers" key="${userId}" text="${username}"/></drop-down></default-field></field>
                            <field name="terminalId"><default-field title="Assigned terminal"><drop-down allow-empty="true"><list-options list="terminalList" key="${terminalId}" text="${terminalName ?: terminalId}"/></drop-down></default-field></field>
                            <field name="submitButton"><default-field><submit text="Save terminal assignment"/></default-field></field>
                        </form-single>
                    </widgets>
                </section>
                <form-list name="TerminalAssignmentList" list="assignmentRows" skip-form="true">
                    <field name="username"><default-field title="Billing login"><display/></default-field></field>
                    <field name="terminalName"><default-field title="Assigned terminal"><display/></default-field></field>
                </form-list>
            </container>
            <container id="pos-terminals-table" style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md z-termtable">
                <form-list name="TerminalList" list="terminalList" transition="updateTerminal">
                    <row-actions>
                        <set field="rowNum" from="(termCounter[0] = termCounter[0] + 1)"/>
                    </row-actions>
                    <field name="terminalId"><header-field title="ID"/>
                        <default-field>
                            <label text="${rowNum}" type="span" style="z-rownum"/>
                            <display/>
                            <label text="Terminal ID" type="div" style="text-caption text-grey-6 z-termsub"/>
                        </default-field></field>
                    <field name="terminalName"><header-field title="Name"/>
                        <default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="facilityId"><header-field title="Facility"/>
                        <default-field title="Facility"><drop-down allow-empty="true"><list-options list="orgFacilities" key="${facilityId}" text="${facilityName}"/></drop-down></default-field></field>
                    <field name="stateCode"><header-field title="State"/>
                        <default-field title="State"><text-line size="4"/></default-field></field>
                    <field name="upiVpa"><header-field title="UPI VPA"/>
                        <default-field title="UPI VPA"><text-line size="20"/></default-field></field>
                    <field name="isActive"><header-field title="Active"/>
                        <default-field title="Active"><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton"><header-field title=""/>
                        <conditional-field name="term_save_write" condition="modCanWrite"><submit text="Update"/></conditional-field>
                        <default-field><label text="view-only" type="span" style="text-grey-6 text-caption"/></default-field></field>
                </form-list>
            </container>
        </container>
    </widgets>
</screen>
