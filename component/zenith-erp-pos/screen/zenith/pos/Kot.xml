<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="KOT" default-menu-index="12">
    <always-actions>
        <set field="html_title" value="KOT"/>
        <set field="kitchenModuleId" value="kot"/>
        <set field="kitchenModulePath" value="/kot"/>
        <script><![CDATA[
            def nav = ec.service.sync().name('zenith.base.SecurityServices.get#ModuleNavigation').disableAuthz().call()
            if (nav.roleRestricted && !nav.moduleIds?.contains('kot'))
                throw new org.moqui.context.ArtifactAuthorizationException('Your role does not include KOT.')
            def p = ec.web.parameters
            def postPath = ec.web.request.method == 'POST' ? ec.web.request.pathInfo : null
            def creatingTerminal = postPath?.endsWith('/PosTerminals/createTerminal')
            def creatingPrinter = postPath?.endsWith('/PrinterConfig/createPrinter')
            def access = ec.service.sync().name('zenith.pos.PosAccessServices.assert#PosAccess')
                .parameters([transactionId:p.transactionId, sessionId:p.sessionId,
                    terminalId:creatingTerminal ? null : p.terminalId,
                    productId:p.productId, customerPartyId:p.customerPartyId, facilityId:p.facilityId,
                    kotId:p.kotId, waiterId:p.waiterId, wastageId:p.wastageId, templateId:p.templateId,
                    printerId:creatingPrinter ? null : p.printerId]).call()
            if (!access?.allowed)
                throw new org.moqui.context.ArtifactAuthorizationException('You do not have access to this KOT organization or record.')
            context.posOrganizationPartyId = access.organizationPartyId
            context.posTerminalRestricted = access.terminalRestricted
            context.posAllowedTerminalIds = access.allowedTerminalIds
        ]]></script>
    </always-actions>
    <subscreens default-item="KotDashboard">
        <subscreens-item name="KotDashboard" location="component://zenith-erp-pos/screen/zenith/pos/Pos/Kitchen/KotDashboard.xml" menu-title="KOT Dashboard" menu-index="1"/>
        <subscreens-item name="KitchenDisplay" location="component://zenith-erp-pos/screen/zenith/pos/Pos/Kitchen/KitchenDisplay.xml" menu-title="Kitchen Display" menu-index="2"/>
        <subscreens-item name="KotBilling" location="component://zenith-erp-pos/screen/zenith/pos/Pos/Kitchen/KotBilling.xml" menu-title="KOT Billing" menu-index="3"/>
        <subscreens-item name="Tables" location="component://zenith-erp-pos/screen/zenith/pos/Pos/Kitchen/Tables.xml" menu-title="Tables" menu-index="4"/>
        <subscreens-item name="KotHistory" location="component://zenith-erp-pos/screen/zenith/pos/Pos/Kitchen/KotHistory.xml" menu-title="KOT History" menu-index="5"/>
        <subscreens-item name="WaiterManagement" location="component://zenith-erp-pos/screen/zenith/pos/Pos/Kitchen/WaiterManagement.xml" menu-title="Waiters" menu-index="6"/>
        <subscreens-item name="PosTransactions" location="component://zenith-erp-pos/screen/zenith/pos/Pos/PosTransactions.xml" menu-title="Transactions" menu-index="7"/>
        <subscreens-item name="PosSessions" location="component://zenith-erp-pos/screen/zenith/pos/Pos/PosSessions.xml" menu-title="Sessions" menu-index="8"/>
        <subscreens-item name="PosTerminals" location="component://zenith-erp-pos/screen/zenith/pos/Pos/PosTerminals.xml" menu-title="Terminals" menu-index="9"/>
        <subscreens-item name="CreditBills" location="component://zenith-erp-pos/screen/zenith/pos/Pos/CreditBills.xml" menu-title="Credit Bills" menu-index="10"/>
        <subscreens-item name="Wastage" location="component://zenith-erp-pos/screen/zenith/pos/Pos/Wastage.xml" menu-title="Wastage" menu-index="11"/>
        <subscreens-item name="ProductPricing" location="component://zenith-erp-pos/screen/zenith/pos/Pos/ProductPricing.xml" menu-title="Product Prices" menu-index="12"/>
        <subscreens-item name="DiscountSettings" location="component://zenith-erp-pos/screen/zenith/pos/Pos/DiscountSettings.xml" menu-title="Discount" menu-index="13"/>
        <subscreens-item name="SalesMode" location="component://zenith-erp-pos/screen/zenith/pos/Pos/SalesMode.xml" menu-title="Sales Mode" menu-index="14"/>
        <subscreens-item name="ProductImport" location="component://zenith-erp-pos/screen/zenith/pos/Pos/ProductImport.xml" menu-title="Import" menu-index="15"/>
        <subscreens-item name="ReceiptConfig" location="component://zenith-erp-pos/screen/zenith/pos/Pos/ReceiptConfig.xml" menu-title="Receipts" menu-index="16"/>
        <subscreens-item name="PrinterConfig" location="component://zenith-erp-pos/screen/zenith/pos/Pos/PrinterConfig.xml" menu-title="Printers" menu-index="17"/>
        <subscreens-item name="BillNumberRegister" location="component://zenith-erp-pos/screen/zenith/pos/Pos/BillNumberRegister.xml" menu-title="Bill Register" menu-index="18"/>
        <subscreens-item name="OfflineMode" location="component://zenith-erp-pos/screen/zenith/pos/Pos/Kitchen/KotOfflineMode.xml" menu-title="Offline Mode" menu-index="19"/>
        <subscreens-item name="EditSession" location="component://zenith-erp-pos/screen/zenith/pos/Pos/EditSession.xml" menu-include="false"/>
        <subscreens-item name="PosSessionsPdf" location="component://zenith-erp-pos/screen/zenith/pos/Pos/PosSessionsPdf.xml" menu-include="false"/>
        <subscreens-item name="EditTransaction" location="component://zenith-erp-pos/screen/zenith/pos/Pos/EditTransaction.xml" menu-include="false"/>
        <subscreens-item name="ReceiptPdf" location="component://zenith-erp-pos/screen/zenith/pos/Pos/ReceiptPdf.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <container style="z-pos-page z-kot-page">
            <render-mode><text type="html,qvt" template="true"><![CDATA[
<section id="kitchen-page-frame" data-kitchen-route="${(ec.web.request.requestURI!'')?html}">
            ]]></text></render-mode>
            <subscreens-active/>
            <render-mode><text type="html,qvt"><![CDATA[</section>]]></text></render-mode>
        </container>
    </widgets>
</screen>
