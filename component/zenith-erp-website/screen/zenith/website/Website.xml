<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Website" default-menu-index="12">

    <always-actions>
        <set field="html_title" value="Website Builder"/>
    </always-actions>

    <subscreens default-item="Sites"/>

    <transition name="goEcommerce"><default-response url="../ecommerce/EcomOrders"/></transition>
    <transition name="goMarketing"><default-response url="../marketing/Campaigns"/></transition>
    <transition name="goCrm"><default-response url="../Crm/Leads"/></transition>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
