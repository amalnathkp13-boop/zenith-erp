<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="eCommerce" default-menu-index="10">

    <always-actions>
        <set field="html_title" value="eCommerce"/>
    </always-actions>

    <subscreens default-item="EcomOrders"/>

    <transition name="goSales"><default-response url="../sales/SalesDashboard"/></transition>
    <transition name="goInventory"><default-response url="../Inventory/FindProduct"/></transition>
    <transition name="goContacts"><default-response url="../Contacts/Customers"/></transition>
    <transition name="goMarketing"><default-response url="../marketing/Campaigns"/></transition>
    <transition name="goWebsite"><default-response url="../website/Sites"/></transition>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
