<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Project" default-menu-index="50">

    <always-actions>
        <set field="html_title" value="Project"/>
    </always-actions>

    <subscreens default-item="Projects">
        <subscreens-item name="EditProject" location="component://zenith-erp-project/screen/zenith/project/Project/EditProject.xml"
                         menu-include="false"/>
    </subscreens>

    <transition name="goTimesheets"><default-response url="../timesheets/MyTimesheets"/></transition>
    <transition name="goHr"><default-response url="../Hr/Employees"/></transition>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
