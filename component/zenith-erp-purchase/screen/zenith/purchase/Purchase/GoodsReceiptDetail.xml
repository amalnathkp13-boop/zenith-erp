<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Goods Receipt" default-menu-include="false">
    <parameter name="grnId" required="true"/>
    <transition name="saveDetails"><actions>
        <if condition="ec.web.request.method != 'POST'"><return error="true" message="Save GRN details using the form."/></if>
        <if condition="!ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken"><return error="true" message="Your session expired. Reload this GRN."/></if>
        <service-call name="zenith.purchase.GoodsReceiptServices.save#GoodsReceiptDetails" in-map="[grnId:grnId,facilityId:facilityId,invoiceId:invoiceId,vendorInvoiceNumber:vendorInvoiceNumber]"/>
    </actions><default-response url="." parameter-map="[grnId:grnId]"/></transition>
    <transition name="saveLine"><actions>
        <if condition="ec.web.request.method != 'POST'"><return error="true" message="Save delivery lines using the form."/></if>
        <if condition="!ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken"><return error="true" message="Your session expired. Reload this GRN."/></if>
        <service-call name="zenith.purchase.GoodsReceiptServices.save#GoodsReceiptLine" in-map="[grnId:grnId,orderItemSeqId:orderItemSeqId,plannedQuantity:plannedQuantity,unitAmount:unitAmount]"/>
    </actions><default-response url="." parameter-map="[grnId:grnId]"/></transition>
    <transition name="submitGrn"><actions>
        <if condition="ec.web.request.method != 'POST'"><return error="true" message="Submit this GRN using the form."/></if>
        <if condition="!ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken"><return error="true" message="Your session expired. Reload this GRN."/></if>
        <service-call name="zenith.purchase.GoodsReceiptServices.submit#GoodsReceipt" in-map="[grnId:grnId]"/>
    </actions><default-response url="." parameter-map="[grnId:grnId]"/></transition>
    <transition name="cancelGrn"><actions>
        <if condition="ec.web.request.method != 'POST'"><return error="true" message="Cancel this GRN using the form."/></if>
        <if condition="!ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken"><return error="true" message="Your session expired. Reload this GRN."/></if>
        <service-call name="zenith.purchase.GoodsReceiptServices.cancel#GoodsReceipt" in-map="[grnId:grnId]"/>
    </actions><default-response url="." parameter-map="[grnId:grnId]"/></transition>
    <actions>
        <service-call name="zenith.purchase.GoodsReceiptServices.get#GoodsReceipt" in-map="[grnId:grnId]" out-map="access"/>
        <if condition="access.allowed">
            <set field="grn" from="access.grn"/>
            <set field="draft" from="!grn.statusId || grn.statusId == 'GrnDraft'"/>
            <set field="canEdit" from="modCanWrite &amp;&amp; draft"/>
            <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <set field="grnStatus" from="[GrnDraft:'Draft',GrnPending:'Awaiting receipt',GrnPartial:'Partially received',GrnReceived:'Received',GrnCancelled:'Cancelled'][grn.statusId] ?: 'Draft'"/>
            <entity-find-one entity-name="mantle.party.PartyDetail" value-field="supplier"><field-map field-name="partyId" from="grn.vendorPartyId"/></entity-find-one>
            <entity-find-one entity-name="mantle.facility.Facility" value-field="receivingLocation"><field-map field-name="facilityId" from="grn.facilityId"/></entity-find-one>
            <entity-find entity-name="mantle.facility.Facility" list="locations"><econdition field-name="ownerPartyId" from="organizationPartyId"/><order-by field-name="facilityName"/></entity-find>
            <entity-find entity-name="mantle.account.invoice.Invoice" list="vendorBills">
                <econdition field-name="invoiceTypeEnumId" value="InvoicePurchase"/><econdition field-name="fromPartyId" from="grn.vendorPartyId"/>
                <econdition field-name="toPartyId" from="organizationPartyId"/><econdition field-name="currencyUomId" from="access.order.currencyUomId"/>
                <econdition field-name="statusId" operator="not-equals" value="InvoiceCancelled"/><order-by field-name="-invoiceDate,-invoiceId"/>
            </entity-find>
            <entity-find entity-name="mantle.order.OrderItem" list="poItems"><econdition field-name="orderId" from="grn.purchaseOrderId"/><econdition field-name="orderPartSeqId" value="01"/><econdition field-name="productId" operator="is-not-null"/><order-by field-name="orderItemSeqId"/></entity-find>
            <entity-find entity-name="zenith.erp.purchase.GoodsReceiptNoteItem" list="deliveryItems"><econdition field-name="grnId"/><order-by field-name="itemSeqId"/></entity-find>
            <set field="deliveryByItem" from="deliveryItems.findAll { it.orderItemSeqId != null }.collectEntries { [(it.orderItemSeqId):it] }"/>
        </if>
    </actions>
    <widgets><container style="zpur-page">
        <link url="../GoodsReceipt" text="← Goods Receipt Notes" link-type="anchor"/>
        <section name="GrnUnavailable"><condition><expression>!access.allowed</expression></condition><widgets>
            <label text="This goods receipt is not available in your active organization." type="h3"/>
        </widgets></section>
        <section name="GrnContent"><condition><expression>access.allowed</expression></condition><widgets>
            <container style="zenith-card q-pa-lg bg-white q-mt-md q-mb-lg">
                <label text="Goods Receipt #${grnId}" type="h3" style="text-primary text-weight-bold"/>
                <label text="${supplier.organizationName ?: supplier.firstName ?: grn.vendorPartyId} · PO ${grn.purchaseOrderId} · ${grnStatus}" type="p"/>
                <label text="Prepare the delivery here, then confirm the quantities in Inventory → Receiving." type="p" style="text-grey-7"/>
                <link url="../EditPurchaseOrder" parameter-map="[orderId:grn.purchaseOrderId]" text="View purchase order" link-type="anchor"/>
                <label condition="draft &amp;&amp; !(access.order.statusId in ['OrderApproved','OrderCompleted'])" text="This PO needs approval before the GRN can be submitted to Inventory." type="p" style="text-warning text-weight-bold q-mt-md"/>
            </container>
            <container style="zenith-card q-pa-lg bg-white q-mb-lg">
                <label text="Supplier delivery details" type="h5" style="text-weight-bold"/>
                <section name="GrnDetailsEdit"><condition><expression>modCanWrite &amp;&amp; grn.statusId != 'GrnCancelled'</expression></condition><widgets>
                    <form-single name="GrnDetailsForm" transition="saveDetails" map="grn">
                        <field name="grnId"><default-field><hidden/></default-field></field>
                        <field name="facilityId"><default-field title="Receiving location"><drop-down allow-empty="false"><list-options list="locations.findAll { draft || it.facilityId == grn.facilityId }" key="${facilityId}" text="${facilityName}"/></drop-down></default-field></field>
                        <field name="invoiceId"><default-field title="Existing vendor bill (optional)"><drop-down allow-empty="true"><list-options list="vendorBills" key="${invoiceId}" text="${vendorInvoiceNumber ?: invoiceId}"/></drop-down></default-field></field>
                        <field name="vendorInvoiceNumber"><default-field title="Supplier invoice number (when available)"><text-line maxlength="50"/></default-field></field>
                        <field name="submitButton"><default-field title="Save delivery details"><submit/></default-field></field>
                    </form-single>
                </widgets></section>
                <section name="GrnDetailsRead"><condition><expression>!modCanWrite || grn.statusId == 'GrnCancelled'</expression></condition><widgets>
                    <label text="Receiving location: ${receivingLocation?.facilityName ?: 'Not set'}" type="p"/>
                    <label text="Supplier invoice: ${grn.vendorInvoiceNumber ?: 'Awaiting invoice'}" type="p"/>
                    <label condition="grn.invoiceId" text="Linked vendor bill: ${grn.invoiceId}" type="p"/>
                </widgets></section>
            </container>
            <container style="zenith-card q-pa-lg bg-white q-mb-lg">
                <label text="Delivery products" type="h5" style="text-weight-bold"/>
                <label text="Enter the supplied quantity and unit cost before tax for each PO product. Save each line before submitting." type="p" condition="canEdit" style="text-grey-7"/>
                <form-list name="GrnDeliveryLines" list="poItems" skip-form="true">
                    <row-actions>
                        <set field="deliveryLine" from="deliveryByItem[orderItemSeqId]"/>
                        <entity-find-one entity-name="mantle.product.Product" value-field="product"><field-map field-name="productId"/></entity-find-one>
                        <set field="plannedQuantity" from="deliveryLine?.plannedQuantity ?: ''"/>
                        <set field="unitAmount" from="deliveryLine?.unitAmount != null ? deliveryLine.unitAmount : unitAmount"/>
                    </row-actions>
                    <field name="productName"><default-field title="Product"><label text="${product?.productName ?: productId}"/></default-field></field>
                    <field name="ordered"><default-field title="PO quantity"><label text="${(quantity ?: 0G) - (quantityCancelled ?: 0G)}"/></default-field></field>
                    <field name="delivery"><default-field title="Delivery quantity"><label text="${deliveryLine?.plannedQuantity ?: 0}"/></default-field></field>
                    <field name="received"><default-field title="Received into stock"><label text="${deliveryLine?.inventoryReceivedQuantity ?: 0}"/></default-field></field>
                    <field name="price"><default-field title="Unit cost (${access.order.currencyUomId})"><label text="${deliveryLine?.unitAmount != null ? deliveryLine.unitAmount : unitAmount}"/></default-field></field>
                    <field name="lineAction"><default-field title="Action">
                        <container-dialog id="GrnLine_${orderItemSeqId}" button-text="Edit delivery" condition="canEdit">
                            <form-single name="GrnLineForm" transition="saveLine">
                                <field name="grnId"><default-field><hidden/></default-field></field>
                                <field name="orderItemSeqId"><default-field><hidden/></default-field></field>
                                <field name="plannedQuantity"><default-field title="Delivery quantity (zero removes line)"><text-line/></default-field></field>
                                <field name="unitAmount"><default-field title="Supplier unit cost before tax"><text-line/></default-field></field>
                                <field name="submitButton"><default-field title="Save line"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </default-field></field>
                </form-list>
                <label condition="!poItems" text="Add product lines to the purchase order before preparing this delivery." type="p"/>
            </container>
            <container style="zenith-card q-pa-lg bg-white">
                <section name="SubmitGrn"><condition><expression>canEdit</expression></condition><widgets><form-single name="SubmitGrnForm" transition="submitGrn">
                    <field name="grnId"><default-field><hidden/></default-field></field>
                    <field name="submitButton"><default-field title="Submit to Inventory Receiving"><submit/></default-field></field>
                </form-single></widgets></section>
                <link url="../../Inventory/ReceiveInventory" parameter-map="[orderId:grn.purchaseOrderId,grnId:grnId]" text="Open Inventory Receiving" link-type="anchor" condition="grn.statusId in ['GrnPending','GrnPartial','GrnReceived']"/>
                <section name="CancelGrn"><condition><expression>modCanWrite &amp;&amp; (draft || grn.statusId in ['GrnPending','GrnPartial'])</expression></condition><widgets><form-single name="CancelGrnForm" transition="cancelGrn">
                    <field name="grnId"><default-field><hidden/></default-field></field>
                    <field name="submitButton"><default-field title="Cancel outstanding delivery"><submit confirmation="Cancel the outstanding delivery? Quantities already received stay in stock."/></default-field></field>
                </form-single></widgets></section>
            </container>
        </widgets></section>
    </container></widgets>
</screen>
