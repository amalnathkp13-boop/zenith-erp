<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Purchase Order" default-menu-include="false">

    <parameter name="orderId" required="true"/>

    <transition name="findOrder"><default-response url="../FindPurchaseOrder"/></transition>
    
    <transition name="updateOrder"><actions><service-call name="zenith.purchase.OperationsServices.update#PurchaseOrder" in-map="[orderId:orderId,updates:[orderName:ec.web.requestParameters.orderName,statusId:ec.web.requestParameters.statusId]]"/></actions><default-response url="."/><error-response url="."/></transition>

    <transition name="addItem"><actions><service-call name="zenith.purchase.OperationsServices.add#PurchaseOrderLine" in-map="[orderId:orderId,productId:productId,itemDescription:itemDescription,quantity:quantity,unitAmount:unitAmount,requiredByDate:requiredByDate]"/></actions><default-response url="."/><error-response url="."/></transition>

    <transition name="deleteItem"><actions><service-call name="zenith.purchase.OperationsServices.delete#PurchaseOrderLine" in-map="[orderId:orderId,orderItemSeqId:orderItemSeqId]"/></actions><default-response url="."/><error-response url="."/></transition>
    
    <transition name="createVendorBill">
        <!-- Transition to explicitly convert this PO to a Purchase Invoice -->
        <default-response url="../CreatePurchaseInvoice">
            <parameter name="purchaseOrderId" value="${orderId}"/>
            <parameter name="vendorPartyId" value="${vendorPartyId}"/>
        </default-response>
    </transition>

    <actions>
        <service-call name="zenith.purchase.OperationsServices.get#PurchaseOrganization" out-map="scope"/>
        <set field="_org" from="scope.organizationPartyId ?: '__NO_ORGANIZATION__'"/>
        <!-- ZE-INV-IV-06A: org-isolation guard — only open a PO owned (bought) by the caller's active org
             (super-admins exempt). A PO's owner is OrderPart.customerPartyId. Load NOTHING when blocked. -->
        <service-call name="zenith.purchase.PurchaseServices.assert#PurchaseOrderAccess" in-map="[orderId:orderId]" out-map="_acc"/>
        <set field="noAccess" from="!_acc.allowed"/>
        <if condition="_acc.allowed">
        <entity-find-one entity-name="mantle.order.OrderHeader" value-field="order"/>
        <script><![CDATA[
            // Use the same configured transitions and permission gate as update#PurchaseOrder.
            def nextStatuses = ec.entity.find('moqui.basic.StatusFlowTransition')
                .condition('statusFlowId','Default').condition('statusId',order.statusId).list()
                .findAll { !it.userPermissionId || ec.user.hasPermission(it.userPermissionId) }*.toStatusId
            context.orderStatusOptions = ec.entity.find('moqui.basic.StatusItem')
                .condition('statusTypeId','OrderHeader').condition('statusId','in',([order.statusId] + nextStatuses).unique())
                .orderBy('sequenceNum').list()
        ]]></script>
        <entity-find-one entity-name="mantle.order.OrderPart" value-field="orderPart">
            <field-map field-name="orderId"/>
            <field-map field-name="orderPartSeqId" value="01"/>
        </entity-find-one>

        <entity-find entity-name="mantle.order.OrderItem" list="orderItems">
            <econdition field-name="orderId"/><econdition field-name="orderPartSeqId" value="01"/>
            <order-by field-name="orderItemSeqId"/>
        </entity-find>

        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendor">
            <field-map field-name="partyId" from="orderPart?.vendorPartyId"/>
        </entity-find-one>

        <set field="statusColorMap" from="[
            'OrderOpen': 'info',
            'OrderProposed': 'warning',
            'OrderPlaced': 'primary',
            'OrderApproved': 'success',
            'OrderCompleted': 'dark',
            'OrderCancelled': 'danger'
        ]"/>
        <set field="statusColor" from="statusColorMap[order?.statusId] ?: 'dark'"/>
        <script><![CDATA[
            def currency = order.currencyUomId
            context.poCurrencyLabel = currency == 'INR' ? '₹' : currency
            context.poAmount = { value ->
                def number = ec.l10n.format(value ?: 0G, '#,##0.00')
                if (currency == 'INR') return '₹' + zinr.inr(number)
                return currency ? currency + ' ' + number : number
            }
        ]]></script>
        </if>
    </actions>

    <widgets><container style="zpur-page">
        <link url="findOrder" text="Back to Purchase Orders" link-type="anchor"/>

        <!-- ZE-INV-IV-06A: cross-tenant / missing record — plain notice, never another org's PO -->
        <section name="NoAccess">
            <condition><expression>noAccess</expression></condition>
            <widgets>
                <container style="zenith-card q-pa-lg bg-white shadow-1 border-radius-md q-mt-md text-center">
                    <label text="That purchase order isn't part of your account." type="h5" style="text-grey-8 q-mb-xs"/>
                    <label text="It may belong to another organization, or it may not exist. Use “Back to Purchase Orders” above to return to your list." type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <section name="ThePo">
        <condition><expression>!noAccess</expression></condition>
        <widgets>
        <!-- Profile Banner -->
        <container style="zenith-profile-banner q-pa-lg bg-white shadow-1 border-radius-lg q-mb-lg">
            <container style="row items-center justify-between no-wrap">
                <container style="row items-center">
                    <container style="zenith-avatar q-mr-lg zpur-po-avatar">
                        <label text="PO" type="span" style="zpur-avatar-label"/>
                    </container>
                    <container style="column">
                        <label text="Purchase Order #${orderId}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="Date: ${ec.l10n.format(order?.placedDate ?: order?.entryDate, 'dd MMM yyyy')}" type="p" style="text-grey-7 text-subtitle2 q-mt-xs q-mb-none"/>
                    </container>
                </container>
                
                <container style="row items-center">
                    <form-single name="StatusForm" transition="updateOrder" map="order">
                        <field name="orderId"><default-field><hidden/></default-field></field>
                        <field name="statusId"><default-field title="">
                            <drop-down current="selected">
                                <list-options list="orderStatusOptions" key="${statusId}" text="${description}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton"><conditional-field name="save_write" condition="modCanWrite" title="Update Status"><submit/></conditional-field><default-field title="Update Status"><label text="Changes are unavailable for your account or this record." type="span" style="text-grey-7"/></default-field></field>
                        <field-layout><field-row><field-ref name="statusId"/><field-ref name="submitButton"/></field-row></field-layout>
                    </form-single>
                </container>
            </container>
            
            <container style="row items-center q-mt-md justify-between">
                <container style="bg-grey-2 q-pa-sm border-radius-md">
                    <label text="Supplier: ${vendor?.organizationName ?: vendor?.firstName + ' ' + vendor?.lastName} [${orderPart?.vendorPartyId}]" type="span" style="text-dark text-weight-bold"/>
                </container>
                
                <container>
                    <label text="${order?.statusId ? order.statusId.replace('Order', '') : 'Open'}" type="span" style="zenith-badge ${statusColor} q-mr-sm"/>
                    
                    <!-- Print PO Button -->
                    <link url="${ec.web.getWebappRootUrl(false, null)}/fop/apps/zenith/Purchase/OrderPrint" url-type="plain" 
                          text="Print PO" parameter-map="[orderId:orderId]" icon="print" 
                          class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo text-white q-btn--actionable q-focusable q-hoverable q-mr-sm"
                          link-type="anchor" target-window="_blank"/>

                    <!-- Convert to Bill button is enabled if PO is Approved or Completed -->
                    <section name="POConvertBill_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <link url="createVendorBill" text="Log Vendor Bill (ITC)" parameter-map="[orderId:orderId, vendorPartyId:orderPart?.vendorPartyId]" condition="order?.statusId in ['OrderApproved', 'OrderCompleted']"
                          icon="receipt" class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-teal-8 text-white q-btn--actionable q-focusable q-hoverable"/>
                    </widgets></section>
                </container>
            </container>
        </container>

        <!-- Main Sections -->
        <container-row>
            <row-col lg="8">
                <!-- PO Items -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-lg">
                    <section name="POAddItem_write"><condition><expression>modCanWrite &amp;&amp; order?.statusId == 'OrderOpen'</expression></condition><widgets>
                        <container style="po-entry-panel">
                            <label text="Add a product" type="h4" style="po-entry-title"/>
                            <form-single name="AddItemForm" transition="addItem">
                                <field name="orderId"><default-field><hidden/></default-field></field>
                                <field name="productId"><default-field title="Product">
                                    <drop-down allow-empty="true">
                                        <entity-options key="${productId}" text="${productName ?: productId}${pseudoId ? ' · ' + pseudoId : ''}">
                                            <entity-find entity-name="mantle.product.Product"><econdition field-name="ownerPartyId" from="orderPart?.customerPartyId ?: '__NO_ORGANIZATION__'"/><order-by field-name="productName"/></entity-find>
                                        </entity-options>
                                    </drop-down>
                                </default-field></field>
                                <field name="quantity"><default-field title="Quantity"><text-line default-value="1" size="8"/></default-field></field>
                                <field name="unitAmount"><default-field title="Unit price${poCurrencyLabel ? ' (' + poCurrencyLabel + ')' : ''}"><text-line size="15"/></default-field></field>
                                <field name="itemDescription"><default-field title="Custom description"><text-line size="45"/></default-field></field>
                                <field name="requiredByDate"><default-field title="Expected date"><date-time type="date"/></default-field></field>
                                <field name="submitButton"><default-field title="Add to order"><submit/></default-field></field>
                                <field-layout>
                                    <field-ref name="orderId"/>
                                    <field-group title="" style="po-entry-fields">
                                        <field-ref name="productId"/><field-ref name="quantity"/><field-ref name="unitAmount"/>
                                    </field-group>
                                    <field-accordion active="false">
                                        <field-group title="Custom description or expected date" style="po-entry-extra">
                                            <field-ref name="itemDescription"/><field-ref name="requiredByDate"/>
                                        </field-group>
                                    </field-accordion>
                                    <field-ref name="submitButton"/>
                                </field-layout>
                            </form-single>
                        </container>
                    </widgets></section>
                    <container style="row justify-between items-center q-mb-md border-bottom q-pb-sm">
                        <label text="Order items" type="h5" style="text-primary text-weight-bold q-my-none"/>
                    </container>

                    <form-list name="OrderItemsForm" list="orderItems" skip-form="true">
                        <field name="orderItemSeqId"><default-field title="#"><label text="${orderItemSeqId}" type="span" style="text-grey-7"/></default-field></field>
                        <field name="itemDescription"><default-field title="Description"><label text="${itemDescription ?: productId ?: '—'}" type="strong" style="text-dark"/></default-field></field>
                        <field name="requiredByDate"><default-field title="Expected"><label text="${ec.l10n.format(requiredByDate, 'dd MMM') ?: '-'}" type="span" style="zenith-badge grey"/></default-field></field>
                        <field name="quantity"><default-field><label text="${quantity}" type="span" style="text-dark"/></default-field></field>
                        <field name="unitAmount"><default-field title="Unit Price"><label text="${poAmount(unitAmount)}" type="span"/></default-field></field>
                        <field name="total"><default-field title="Est. Total">
                            <label text="${poAmount((quantity ?: 0) * (unitAmount ?: 0))}" type="span" style="text-weight-bold text-dark"/>
                        </default-field></field>
                        
                        <field name="deleteItem">
                            <conditional-field name="del_write" condition="modCanWrite" title=" ">
                                <link url="deleteItem" parameter-map="[orderId:orderId, orderItemSeqId:orderItemSeqId]" condition="order?.statusId == 'OrderOpen'" icon="delete" style="text-danger" confirmation="Remove item?"/>
                            </conditional-field>
                            <default-field title=" "><label text="" type="span"/></default-field>
                        </field>
                    </form-list>
                </container>
            </row-col>
            
            <row-col lg="4">
                <!-- Totals Dashboard -->
                <container style="zenith-card q-pa-md bg-indigo-9 text-white shadow-1 border-radius-md q-mb-md">
                    <label text="PO Summary" type="h5" style="text-white text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row justify-between q-mb-sm">
                        <label text="Est. Total" type="span" style="text-indigo-2"/>
                        <label text="${poAmount(order.grandTotal)}" type="strong" style="font-size:1.2rem;"/>
                    </container>
                    <container style="q-mt-md border-top q-pt-sm">
                        <label text="Note: Taxes and final amounts will be reconciled when the Vendor Bill is logged." type="p" style="text-indigo-2 text-caption"/>
                    </container>
                </container>
                
                <!-- Terms -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md">
                    <label text="Purchase Details" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-single name="OrderDetailsForm" transition="updateOrder" map="order">
                        <field name="orderId"><default-field><hidden/></default-field></field>
                        <field name="orderName"><default-field title="Reference / Title"><text-line/></default-field></field>
                        <field name="submitButton"><conditional-field name="save_write" condition="modCanWrite &amp;&amp; order?.statusId=='OrderOpen'" title="Save Details"><submit/></conditional-field><default-field title="Save Details"><label text="Changes are unavailable for your account or this record." type="span" style="text-grey-7"/></default-field></field>
                    </form-single>
                </container>
            </row-col>
        </container-row>
        </widgets>
        </section>

</container>    </widgets>
</screen>
