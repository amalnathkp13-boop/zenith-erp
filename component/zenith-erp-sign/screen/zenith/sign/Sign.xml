<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Sign" default-menu-index="9">

    <always-actions>
        <set field="html_title" value="Sign"/>
    </always-actions>

    <subscreens default-item="SignatureRequests"/>

    <transition name="goDocuments"><default-response url="../documents/DocumentList"/></transition>
    <transition name="goApprovals"><default-response url="../approvals/MyApprovals"/></transition>
    <transition name="goSales"><default-response url="../sales/FindInvoice"/></transition>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
