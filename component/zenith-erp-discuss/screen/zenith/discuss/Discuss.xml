        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Discuss" default-menu-index="10">

    <always-actions>
        <set field="html_title" value="Discuss"/>
    </always-actions>

    <subscreens default-item="Channels"/>

    <transition name="goHr"><default-response url="../Hr/Employees"/></transition>
