<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tenants" require-authentication="true">
    <transition name="suspendTenant"><service-call name="zenith.saas.SaasServices.suspend#Tenant"/>
        <default-response url="."/></transition>
    <transition name="reactivateTenant"><service-call name="zenith.saas.SaasServices.reactivate#Tenant"/>
        <default-response url="."/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.saas.SaasTenant" list="tenantList">
            <search-form-inputs default-order-by="-registeredDate"/>
        </entity-find>
    </actions>
    <widgets>
        <container style="row justify-between items-center q-mb-md">
            <label text="All Tenants" type="h5" style="text-weight-bold q-my-none"/>
            <link url="../ProvisionTenant" text="+ New Tenant" btn-type="success"/>
        </container>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Tenants..." style="display:none"></span>]]></text></render-mode>
            <form-list name="TenantListForm" list="tenantList" skip-form="true"
                       header-dialog="true" select-columns="true" saved-finds="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="tenantId"><header-field show-order-by="true"/><default-field title="ID"><display/></default-field></field>
                <field name="tenantName"><header-field show-order-by="true"><text-find/></header-field>
                    <default-field title="Business"><display/></default-field></field>
                <field name="subdomain"><header-field show-order-by="true"><text-find/></header-field>
                    <default-field title="Subdomain"><display/></default-field></field>
                <field name="planId"><header-field show-order-by="true"><text-find/></header-field>
                    <default-field title="Plan"><display/></default-field></field>
                <field name="adminEmail"><default-field title="Admin"><display/></default-field></field>
                <field name="countryGeoId"><default-field title="Country"><display/></default-field></field>
                <field name="statusId"><header-field show-order-by="true"><text-find/></header-field>
                    <default-field title="Status"><display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                <field name="registeredDate"><header-field show-order-by="true"/>
                    <default-field title="Registered"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="actions"><default-field title="">
                    <link url="../PlanAssignments" text="Assign Plan" btn-type="primary" parameter-map="[tenantId:tenantId]"/>
                    <link url="../TenantDetail" text="View" btn-type="primary" icon="fa fa-eye"
                          parameter-map="[tenantId:tenantId]"/>
                    <link url="suspendTenant" text="Suspend" btn-type="danger" icon="fa fa-ban"
                          parameter-map="[tenantId:tenantId]"
                          condition="statusId == 'SaasTenantActive'" confirmation="Suspend tenant ${tenantName}?"/>
                    <link url="reactivateTenant" text="Activate" btn-type="success" icon="fa fa-check"
                          parameter-map="[tenantId:tenantId]"
                          condition="statusId == 'SaasTenantSuspended'" confirmation="Reactivate tenant ${tenantName}?"/>
                </default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
