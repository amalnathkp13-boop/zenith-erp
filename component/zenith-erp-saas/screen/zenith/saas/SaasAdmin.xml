<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="SaaS Admin" default-menu-index="99"
        require-authentication="true">

    <pre-actions>
        <script><![CDATA[
            if (!(ec.user.isInGroup("ADMIN"))) {
                ec.message.addError("Access Denied: Only the ZetaERP Parent Super Admin can access the SaaS module.")
                ec.web.sendError(403, "Forbidden", null)
                return
            }
        ]]></script>
    </pre-actions>

    <subscreens default-item="Dashboard">
        <subscreens-item name="Dashboard" location="component://zenith-erp-saas/screen/zenith/saas/Dashboard.xml" menu-title="Dashboard" menu-index="1"/>
        <subscreens-item name="Tenants" location="component://zenith-erp-saas/screen/zenith/saas/Tenants.xml" menu-title="Tenants" menu-index="2"/>
        <subscreens-item name="Plans" location="component://zenith-erp-saas/screen/zenith/saas/Plans.xml" menu-title="Plans" menu-index="3"/>
        <subscreens-item name="PlanAssignments" location="component://zenith-erp-saas/screen/zenith/saas/PlanAssignments.xml" menu-title="Tenant Plans" menu-index="4"/>
        <subscreens-item name="Subscriptions" location="component://zenith-erp-saas/screen/zenith/saas/Subscriptions.xml" menu-title="Subscriptions" menu-index="4"/>
        <subscreens-item name="Invoices" location="component://zenith-erp-saas/screen/zenith/saas/Invoices.xml" menu-title="Invoices" menu-index="5"/>
        <subscreens-item name="Payments" location="component://zenith-erp-saas/screen/zenith/saas/Payments.xml" menu-title="Payments" menu-index="6"/>
        <subscreens-item name="Settings" location="component://zenith-erp-saas/screen/zenith/saas/Settings.xml" menu-title="Settings" menu-index="7"/>
        <subscreens-item name="ProvisionTenant" location="component://zenith-erp-saas/screen/zenith/saas/ProvisionTenant.xml" menu-title="New Tenant" menu-index="8" menu-include="false"/>
        <subscreens-item name="TenantDetail" location="component://zenith-erp-saas/screen/zenith/saas/TenantDetail.xml" menu-title="Tenant Detail" menu-index="9" menu-include="false"/>
        <subscreens-item name="InvoiceDetail" location="component://zenith-erp-saas/screen/zenith/saas/InvoiceDetail.xml" menu-title="Invoice" menu-index="10" menu-include="false"/>
        <subscreens-item name="SubscriptionDetail" location="component://zenith-erp-saas/screen/zenith/saas/SubscriptionDetail.xml" menu-title="Subscription" menu-index="11" menu-include="false"/>
    </subscreens>

    <widgets>
        <subscreens-panel id="saas-admin-panel" type="tab"/>
    </widgets>
</screen>
