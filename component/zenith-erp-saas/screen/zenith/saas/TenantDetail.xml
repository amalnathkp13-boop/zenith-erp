<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tenant Detail" default-menu-include="false" require-authentication="true">

    <parameter name="tenantId" required="true"/>

    <transition name="updateTenant">
        <service-call name="update#zenith.erp.saas.SaasTenant"/>
        <default-response url="."/>
    </transition>
    <transition name="suspendTenant">
        <service-call name="zenith.saas.SaasServices.suspend#Tenant"/>
        <default-response url="."/>
    </transition>
    <transition name="reactivateTenant">
        <service-call name="zenith.saas.SaasServices.reactivate#Tenant"/>
        <default-response url="."/>
    </transition>
    <transition name="extendTrial">
        <service-call name="zenith.saas.SaasServices.extend#Trial"/>
        <default-response url="."/>
    </transition>
    <transition name="changePlan">
        <service-call name="zenith.saas.SaasServices.change#Plan"/>
        <default-response url="."/>
    </transition>
    <transition name="cancelSubscription">
        <service-call name="zenith.saas.SaasServices.cancel#Subscription"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.saas.SaasTenant" value-field="tenant"/>
        <entity-find-one entity-name="zenith.erp.saas.SaasPlan" value-field="plan">
            <field-map field-name="planId" from="tenant.planId"/>
        </entity-find-one>
        <entity-find entity-name="zenith.erp.saas.SaasSubscription" list="subscriptions">
            <econdition field-name="tenantId"/>
            <order-by field-name="-startDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.saas.SaasInvoice" list="invoices">
            <econdition field-name="tenantId"/>
            <order-by field-name="-invoiceDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.saas.SaasPayment" list="payments">
            <econdition field-name="tenantId"/>
            <order-by field-name="-paymentDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.saas.SaasAuditLog" list="auditLogs">
            <econdition field-name="tenantId"/>
            <order-by field-name="-eventDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.saas.SaasPlanModule" list="planModules">
            <econdition field-name="planId" from="tenant.planId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.saas.SaasPlan" list="allPlans">
            <econdition field-name="isActive" value="Y"/>
            <order-by field-name="sortOrder"/>
        </entity-find>
        <!-- Show "Extend Trial" only for trial-stage tenants: no live paid (SubActive) sub and not cancelled.
             Covers a currently-trialing tenant AND an expired/suspended trial; hidden for paying customers. -->
        <script>canExtendTrial = (tenant?.statusId != 'SaasTenantCancelled') &amp;&amp; !(subscriptions?.any { it.statusId == 'SubActive' })</script>
    </actions>

    <widgets>
        <link url="../Tenants" text="← Back to Tenants" link-type="anchor" style="q-mb-md text-grey-7"/>

        <container style="row items-center q-mb-lg">
            <label text="${tenant.tenantName}" type="h4" style="text-weight-bold q-mr-md"/>
            <label text="${tenant.statusId == 'SaasTenantActive' ? 'Active' : tenant.statusId == 'SaasTenantSuspended' ? 'Suspended' : tenant.statusId}" style="text-caption text-white q-pa-xs q-px-sm border-radius-md ${tenant.statusId == 'SaasTenantActive' ? 'bg-positive' : tenant.statusId == 'SaasTenantSuspended' ? 'bg-negative' : 'bg-grey'}"/>
        </container>

        <container style="row q-gutter-lg q-mb-lg">
            <!-- Tenant Info -->
            <container style="col-6">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="Tenant Information" type="h6" style="text-weight-bold q-mb-md"/>
                    <form-single name="TenantEditForm" transition="updateTenant" map="tenant">
                        <field name="tenantId"><default-field><hidden/></default-field></field>
                        <field name="tenantName"><default-field title="Business Name"><text-line size="30"/></default-field></field>
                        <field name="subdomain"><default-field title="Subdomain"><display/></default-field></field>
                        <field name="adminEmail"><default-field title="Admin Email"><display/></default-field></field>
                        <field name="adminPhone"><default-field title="Phone"><text-line size="15"/></default-field></field>
                        <field name="countryGeoId"><default-field title="Country"><display/></default-field></field>
                        <field name="currencyUomId"><default-field title="Currency"><display/></default-field></field>
                        <field name="organizationPartyId"><default-field title="Org Party ID"><display/></default-field></field>
                        <field name="registeredDate"><default-field title="Registered"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                        <field name="submitBtn"><default-field title=""><submit text="Save Changes"/></default-field></field>
                    </form-single>
                </container>
            </container>

            <!-- Plan & Actions -->
            <container style="col-6">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
                    <label text="Current Plan" type="h6" style="text-weight-bold q-mb-md"/>
                    <container style="q-mb-sm">
                        <label text="Plan: " style="text-grey-7"/>
                        <label text="${plan?.planName ?: tenant.planId}" style="text-weight-bold text-primary text-h6"/>
                    </container>
                    <container style="q-mb-sm">
                        <label text="Modules: " style="text-grey-7"/>
                        <label text="${planModules?.collect{it.moduleId}?.join(', ') ?: 'None'}" style="text-weight-medium"/>
                    </container>
                    <container style="q-mb-sm">
                        <label text="Limits: " style="text-grey-7"/>
                        <label text="${plan?.maxUsers ?: 0} users, ${plan?.maxPosTerminals ?: 0} POS, ${plan?.maxProductsSku ?: 0} products, ${plan?.maxStores ?: 0} stores, ${plan?.maxPromotions ?: 0} promos"/>
                    </container>

                    <link url="../PlanAssignments" text="Assign / Extend Manual Plan" btn-type="primary" parameter-map="[tenantId:tenantId]"/>
                    <container-dialog id="ChangePlanDialog" button-text="Change Billed Plan" type="primary">
                        <form-single name="ChangePlanForm" transition="changePlan">
                            <field name="tenantId"><default-field><hidden default-value="${tenantId}"/></default-field></field>
                            <field name="newPlanId"><default-field title="New Plan">
                                <drop-down>
                                    <list-options list="allPlans" key="${planId}" text="${planName} (₹${monthlyPrice}/mo)"/>
                                </drop-down>
                            </default-field></field>
                            <field name="billingCycle"><default-field title="Billing">
                                <drop-down no-current-selected-key="Monthly">
                                    <option key="Monthly" text="Monthly"/>
                                    <option key="Yearly" text="Yearly"/>
                                </drop-down>
                            </default-field></field>
                            <field name="submitBtn"><default-field title=""><submit text="Change Plan"/></default-field></field>
                        </form-single>
                    </container-dialog>
                </container>

                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="Actions" type="h6" style="text-weight-bold q-mb-md"/>
                    <container style="row q-gutter-sm">
                        <link url="suspendTenant" text="Suspend" btn-type="danger" icon="fa fa-ban"
                              parameter-map="[tenantId:tenantId]"
                              condition="tenant.statusId == 'SaasTenantActive'" confirmation="Suspend ${tenant.tenantName}?"/>
                        <link url="reactivateTenant" text="Reactivate" btn-type="success" icon="fa fa-check"
                              parameter-map="[tenantId:tenantId]"
                              condition="tenant.statusId == 'SaasTenantSuspended'" confirmation="Reactivate ${tenant.tenantName}?"/>
                        <link url="cancelSubscription" text="Cancel Subscription" btn-type="warning" icon="fa fa-times-circle"
                              parameter-map="[tenantId:tenantId, immediate:'false']"
                              condition="tenant.statusId != 'SaasTenantCancelled'"
                              confirmation="Cancel subscription for ${tenant.tenantName}? They will retain access until end of billing period."/>
                    </container>
                    <section name="ExtendTrialSec" condition="canExtendTrial"><widgets>
                        <container style="q-mt-md">
                            <container-dialog id="ExtendTrialDialog" button-text="Extend Trial" type="info">
                                <form-single name="ExtendTrialForm" transition="extendTrial">
                                    <field name="tenantId"><default-field><hidden default-value="${tenantId}"/></default-field></field>
                                    <field name="trialDays"><default-field title="Extend trial by (days)"><text-line size="6" default-value="14"/></default-field></field>
                                    <field name="submitBtn"><default-field title=""><submit text="Extend Trial"/></default-field></field>
                                </form-single>
                            </container-dialog>
                        </container>
                    </widgets></section>
                </container>
            </container>
        </container>

        <!-- Subscriptions -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <label text="Subscription History" type="h6" style="text-weight-bold q-mb-md"/>
            <form-list name="SubHistoryForm" list="subscriptions" skip-form="true">
                <field name="subscriptionId"><default-field title="ID"><display/></default-field></field>
                <field name="planId"><default-field title="Plan"><display/></default-field></field>
                <field name="billingCycle"><default-field title="Cycle"><display/></default-field></field>
                <field name="amount"><default-field title="Amount"><display format="#,##0.00"/></default-field></field>
                <field name="statusId"><default-field title="Status"><display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                <field name="startDate"><default-field title="Start"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="renewalDate"><default-field title="Renewal"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="trialEndDate"><default-field title="Trial End"><display format="dd-MMM-yyyy"/></default-field></field>
            </form-list>
        </container>

        <!-- Invoices -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <label text="Invoices" type="h6" style="text-weight-bold q-mb-md"/>
            <form-list name="TenantInvoicesForm" list="invoices" skip-form="true">
                <field name="saasInvoiceId"><default-field title="ID"><display/></default-field></field>
                <field name="invoiceDate"><default-field title="Date"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="dueDate"><default-field title="Due"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="totalAmount"><default-field title="Amount"><display format="#,##0.00"/></default-field></field>
                <field name="statusId"><default-field title="Status"><display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                <field name="paidDate"><default-field title="Paid"><display format="dd-MMM-yyyy"/></default-field></field>
            </form-list>
        </container>

        <!-- Payments -->
        <section name="PaymentsSection" condition="payments">
            <widgets>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
                    <label text="Payments" type="h6" style="text-weight-bold q-mb-md"/>
                    <form-list name="TenantPaymentsForm" list="payments" skip-form="true">
                        <field name="saasPaymentId"><default-field title="ID"><display/></default-field></field>
                        <field name="paymentDate"><default-field title="Date"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                        <field name="amount"><default-field title="Amount"><display format="#,##0.00"/></default-field></field>
                        <field name="paymentGateway"><default-field title="Gateway"><display/></default-field></field>
                        <field name="gatewayPaymentId"><default-field title="Txn ID"><display/></default-field></field>
                        <field name="statusId"><default-field title="Status"><display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    </form-list>
                </container>
            </widgets>
        </section>

        <!-- Audit Log -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <label text="Activity Log" type="h6" style="text-weight-bold q-mb-md"/>
            <form-list name="TenantAuditForm" list="auditLogs" skip-form="true">
                <field name="eventDate"><default-field title="Date"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                <field name="eventType"><default-field title="Event"><display/></default-field></field>
                <field name="description"><default-field title="Details"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
