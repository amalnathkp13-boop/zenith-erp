<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="New Tenant" require-authentication="true">

    <transition name="provisionTenant">
        <service-call name="zenith.saas.SaasServices.provision#Tenant"/>
        <default-response url="../Tenants"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.saas.SaasPlan" list="planList">
            <econdition field-name="isActive" value="Y"/>
            <order-by field-name="sortOrder"/>
        </entity-find>
    </actions>
    <widgets>
        <label text="Provision New Tenant" type="h5" style="text-weight-bold q-mb-md"/>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-xl" style-sm="max-width:700px;">
            <form-single name="ProvisionTenantForm" transition="provisionTenant">
                <field name="header1"><default-field title=""><label text="Business Details" type="h6" style="text-weight-bold text-primary"/></default-field></field>
                <field name="tenantName"><default-field title="Business Name"><text-line size="40"/></default-field></field>
                <field name="subdomain"><default-field title="Subdomain">
                    <text-line size="25" suffix=".zenitherp.com"/>
                </default-field></field>
                <field name="industryEnumId"><default-field title="Industry">
                    <drop-down>
                        <entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="TenantIndustry"/>
                                <order-by field-name="sequenceNum"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field></field>
                <field name="countryGeoId"><default-field title="Country">
                    <drop-down no-current-selected-key="IND">
                        <entity-options key="${countryGeoId}" text="${countryName}">
                            <entity-find entity-name="zenith.erp.base.CountryConfiguration">
                                <order-by field-name="countryName"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field></field>
                <field name="currencyUomId"><default-field title="Currency (auto from country, override if needed)">
                    <drop-down allow-empty="true">
                        <entity-options key="${uomId}" text="${description} (${abbreviation})">
                            <entity-find entity-name="moqui.basic.Uom">
                                <econdition field-name="uomTypeEnumId" value="UT_CURRENCY_MEASURE"/>
                                <order-by field-name="description"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field></field>

                <field name="header2"><default-field title=""><label text="Admin Account" type="h6" style="text-weight-bold text-primary q-mt-md"/></default-field></field>
                <field name="adminFirstName"><default-field title="First Name"><text-line size="20"/></default-field></field>
                <field name="adminLastName"><default-field title="Last Name"><text-line size="20"/></default-field></field>
                <field name="adminEmail"><default-field title="Email (used as login)"><text-line size="30"/></default-field></field>
                <field name="adminPhone"><default-field title="Phone"><text-line size="15"/></default-field></field>
                <field name="adminPassword"><default-field title="Password"><password size="20"/></default-field></field>

                <field name="header3"><default-field title=""><label text="Subscription" type="h6" style="text-weight-bold text-primary q-mt-md"/></default-field></field>
                <field name="planId"><default-field title="Plan">
                    <drop-down>
                        <list-options list="planList" key="${planId}" text="${planName} — ${monthlyPrice}/mo (${maxUsers} users, ${maxPosTerminals} POS)"/>
                    </drop-down>
                </default-field></field>

                <field name="submitBtn"><default-field title="">
                    <submit text="Provision Tenant" type="success" icon="fa fa-rocket"/>
                </default-field></field>
            </form-single>
        </container>
    </widgets>
</screen>
