<?xml version="1.0" encoding="UTF-8"?>
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <screen-facade>
        <!-- Super-admin panel (authenticated, inside ZenithApp) -->
        <screen location="component://zenith-erp-app/screen/zenith/ZenithApp.xml">
            <subscreens-item name="saas-admin" location="component://zenith-erp-saas/screen/zenith/saas/SaasAdmin.xml"
                menu-title="SaaS Admin" menu-index="99"/>
            <subscreens-item name="my-subscription" location="component://zenith-erp-saas/screen/zenith/saas/TenantDashboard.xml"
                menu-title="My Subscription" menu-index="98"/>
        </screen>
        <!-- Public signup page (no auth required, under webroot) -->
        <screen location="component://webroot/screen/webroot.xml">
            <subscreens-item name="signup" location="component://zenith-erp-saas/screen/saas-public/Signup.xml"
                menu-include="false"/>
            <subscreens-item name="signup-success" location="component://zenith-erp-saas/screen/saas-public/SignupSuccess.xml"
                menu-include="false"/>
            <subscreens-item name="razorpay-webhook" location="component://zenith-erp-saas/screen/saas-public/RazorpayWebhook.xml"
                menu-include="false"/>
            <subscreens-item name="signin" location="component://zenith-erp-saas/screen/saas-public/Welcome.xml"
                menu-include="false"/>
            <subscreens-item name="get-started" location="component://zenith-erp-saas/screen/saas-public/Onboarding.xml"
                menu-include="false"/>
        </screen>
    </screen-facade>
    <!-- ERP login stays active while idle. KOT Billing applies its own inactivity timer. -->
    <webapp-list>
        <webapp name="webroot">
            <session-config timeout="0"/>
        </webapp>
    </webapp-list>
</moqui-conf>
