<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Manufacturing" default-menu-index="9">

    <always-actions>
        <set field="html_title" value="Manufacturing"/>
    </always-actions>

    <subscreens default-item="WorkOrders">
        <subscreens-item name="MrpPlanning" location="component://zenith-erp-manufacturing/screen/zenith/manufacturing/Manufacturing/MrpPlanning.xml" menu-title="MRP Planning"/>
        <subscreens-item name="ProductionSchedule" location="component://zenith-erp-manufacturing/screen/zenith/manufacturing/Manufacturing/ProductionSchedule.xml" menu-title="Production Schedule"/>
    </subscreens>

    <transition name="goInventory"><default-response url="../Inventory/FindProduct"/></transition>
    <transition name="goPurchase"><default-response url="../Purchase/RfqList"/></transition>
    <transition name="goQuality"><default-response url="../quality/Inspections"/></transition>
    <transition name="goMaintenance"><default-response url="../maintenance/MaintenanceDashboard"/></transition>
    <transition name="goPlm"><default-response url="../plm/EngineeringChangeOrders"/></transition>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
