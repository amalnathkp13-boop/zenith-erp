<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- Navigation uses the same authenticated role grants on initial render and SPA config requests. -->
    <service verb="get" noun="ModuleNavigation" authenticate="true">
        <in-parameters><parameter name="planModules" type="List"/></in-parameters>
        <out-parameters><parameter name="moduleIds" type="List"/><parameter name="roleRestricted" type="Boolean"/></out-parameters>
        <actions><script><![CDATA[
            roleRestricted = !ec.user.isInGroup('ADMIN') && !ec.user.isInGroup('ZENITH_ADMIN')
            def plan = planModules != null && !planModules.contains('all') ? planModules : null
            if (!roleRestricted) { moduleIds = plan; return }
            def groups = (ec.user.userGroupIdSet ?: []) as List
            def roles = groups.findAll { it?.startsWith('ZENITH_') && it != 'ZENITH_ALL' }
            def modules = [] as Set
            if (roles.size() == 1 && roles.contains('ZENITH_CASHIER')) modules.addAll(['pos','inventory'])
            else if (groups) {
                ec.entity.find('moqui.security.ArtifactAuthz').condition('userGroupId','in',groups)
                    .condition('authzTypeEnumId','in',['AUTHZT_ALLOW','AUTHZT_ALWAYS']).disableAuthz().list().each {
                        if (it.artifactGroupId?.startsWith('Z_')) modules.add(it.artifactGroupId.substring(2).toLowerCase())
                    }
            }
            moduleIds = (plan == null ? modules : modules.findAll { plan.contains(it) }) as List
        ]]></script></actions>
    </service>

    <!-- ZE-INV-010 (IV-110): does the current user have WRITE (full) access to a module? Mirrors the central write
         gate in ZenithApp.xml so screens can HIDE write features and transitions can ENFORCE them (the gate is
         fail-open; these explicit checks are the robust half). canWrite = ADMIN / ZENITH_ADMIN, OR a POS-cashier-only
         user (posOnly is exempt from the gate), OR any of the user's groups holds AUTHZA_ALL on the module's Z_<MOD>
         artifact group. View-only (AUTHZA_VIEW) or no grant => canWrite = false. -->
    <service verb="check" noun="ModuleWriteAccess" authenticate="true">
        <in-parameters><parameter name="moduleId" required="true"/></in-parameters>
        <out-parameters><parameter name="canWrite" type="Boolean"/></out-parameters>
        <actions>
            <script><![CDATA[
                canWrite = false
                if (ec.user.userId == null) { return }
                if (ec.user.isInGroup("ADMIN") || ec.user.isInGroup("ZENITH_ADMIN")) { canWrite = true; return }
                def _zr = (ec.user.userGroupIdSet ?: []).findAll { it?.startsWith("ZENITH_") && it != "ZENITH_ALL" }
                if (_zr.size() == 1 && _zr.contains("ZENITH_CASHIER")) { canWrite = true; return }   // posOnly: gate-exempt
                def _myG = (ec.user.userGroupIdSet ?: []) as List
                if (!_myG) { return }
                boolean _dz = ec.artifactExecution.disableAuthz()
                try {
                    canWrite = ec.entity.find("moqui.security.ArtifactAuthz")
                            .condition("artifactGroupId", "Z_" + moduleId.toString().toUpperCase())
                            .condition("userGroupId", "in", _myG)
                            .condition("authzActionEnumId", "AUTHZA_ALL")
                            .condition("authzTypeEnumId", "in", ["AUTHZT_ALLOW", "AUTHZT_ALWAYS"])
                            .count() > 0
                } finally { if (!_dz) ec.artifactExecution.enableAuthz() }
            ]]></script>
        </actions>
    </service>

    <!-- ZE-GATE-004: the PLAN decision — "does a tenant holding <planModules> get <moduleId>[/<transitionName>]?" —
         as a PURE function of its inputs. Extracted from the transition gate in ZenithApp.xml (which still owns the
         org -> SaasTenant -> SaasPlanModule lookups; only the DECISION lives here) for one reason: while the decision
         was welded to those lookups, the ONLY way to exercise a plan shape was to make the DB produce it, i.e. to
         INSERT into saas_plan/saas_plan_module — platform billing config — just to run a test. Taking planModules as
         a parameter turns that into a call: any shape, including ones no real plan has, with zero writes. Verify a
         hypothesis about the gate with e.g.
             check#ModulePlanAccess {moduleId:'barcode', transitionName:'renderLabels', planModules:['pos','contacts']}
         The gate calls this with disableAuthz and blocks ONLY on inPlan==false, so a fault here fails OPEN exactly as
         the inline code did (see the fail-open note in ZenithApp.xml).

         SHARED-TX registry: a screen in module A may legitimately call a transition in module B, but the gate infers
         the module from the URL and cannot tell that call apart from a direct hit at B. Each entry names such a
         transition and the OTHER modules whose plan also grants it, so the gate never depends on a coincidence of
         plan composition (ZE-GATE-003). This map is the SINGLE source of truth for that registry and is parsed by
         docs/infra/lint-cross-module-transitions.sh, which FAILS if a cross-module transition reference exists in the
         codebase without an entry here — keep the "// SHARED-TX" marker on every entry line. -->
    <service verb="check" noun="ModulePlanAccess" authenticate="true" transaction="ignore">
        <in-parameters>
            <parameter name="moduleId" required="true"/>
            <parameter name="transitionName"/>
            <parameter name="planModules" type="List" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="inPlan" type="Boolean"/></out-parameters>
        <actions>
            <script><![CDATA[
                def _mods = new HashSet()
                planModules.each { if (it != null) _mods.add(it.toString().toLowerCase()) }
                def _m = moduleId.toString().toLowerCase()
                // "<urlModule>:<transitionName>" -> other modules that legitimately reach it.
                // barcode/renderLabels is the shared label renderer: the barcode module's own screens
                // (FindBarcode, PrintJobs) AND the POS bulk printer (pos/BarcodeLabels) both call it.
                def _sharedTx = [
                    'barcode:renderLabels': ['pos'] as Set   // SHARED-TX
                ]
                def _also = transitionName ? _sharedTx[_m + ':' + transitionName.toString()] : null
                inPlan = _mods.contains('all') || _mods.contains(_m) ||
                        (_also != null && _also.any { _mods.contains(it) })
            ]]></script>
        </actions>
    </service>

    <!-- ZE-INV-IV-031: reusable "your own organization(s)" list for the many org pickers across modules.
         Those pickers were EMPTY for every tenant: they query mantle.party.PartyDetailAndRole (which drags in
         mantle.party.Party), and the MANTLE_ACTIVE_ORG entity filter scopes Party by ownerPartyId=activeOrg —
         but a tenant's OWN org party has ownerPartyId='_NA_' (an org isn't owned by itself), so the active org
         is filtered out of its own picker. This bypasses that filter with disableAuthz, staying safe by scoping
         to partyId=activeOrg: a tenant sees ONLY their own org (no cross-tenant leak); an admin with no active
         org (getPreference null/'_NA_') sees all internal orgs, as those pickers intend. Excludes disabled orgs.
         Returns PartyDetailAndRole rows (use .partyId / .organizationName in list-options). -->
    <service verb="get" noun="ActiveOrgList" authenticate="true">
        <out-parameters><parameter name="orgList" type="List"/></out-parameters>
        <actions>
            <script><![CDATA[
                def _ao = ec.user.getPreference('ACTIVE_ORGANIZATION')
                def _q = ec.entity.find('mantle.party.PartyDetailAndRole')
                            .condition('roleTypeId', 'OrgInternal').disableAuthz()
                if (_ao && _ao != '_NA_') _q.condition('partyId', _ao)
                orgList = _q.list().findAll { it.disabled != 'Y' }
            ]]></script>
        </actions>
    </service>

    <!-- ZE-INV-IV-035 f/u (cross-module render IDOR sweep): reusable, deterministic org-ownership predicate for a
         by-id detail screen. Two Inventory screens (EditFacility, EditProduct) plus an audit of Sales/Purchase/
         Project/Expenses/Tax/POS found a common class: a screen renders a tenant-owned record loaded straight from
         a URL id, trusting ONLY the Mantle ZTF entity filter — which has a first-load race (leaks cross-tenant on
         the first /qapps load). This service is an EXPLICIT, timing-independent check: load the record by id with
         disableAuthz and compare its org field to the caller's ACTIVE_ORGANIZATION (platform super-admins exempt).
         Generic so one service guards every shape: primary entity with organizationPartyId (most), Invoice.toPartyId
         (purchase bill = buyer/tenant), or a sales order via its OrderPart.vendorPartyId (idField=orderId on
         mantle.order.OrderPart — a tenant owns the order if it is the vendor on any part). Pure predicate — returns
         allowed=Boolean and adds NO message, so a screen render can call it without a service-error/rollback. -->
    <service verb="assert" noun="RecordOrgAccess" authenticate="true">
        <in-parameters>
            <parameter name="entityName" required="true"/>
            <parameter name="idField" required="true"/>
            <parameter name="idValue" required="true"/>
            <parameter name="orgField" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="allowed" type="Boolean"/></out-parameters>
        <actions>
            <script><![CDATA[
                allowed = true
                if (!ec.user.isInGroup('ADMIN')) {
                    def activeOrg = ec.user.getPreference('ACTIVE_ORGANIZATION')
                    if (!activeOrg || activeOrg == '_NA_') {
                        allowed = false
                    } else {
                        def rows = ec.entity.find(entityName).condition(idField, idValue).disableAuthz().list()
                        allowed = !rows.isEmpty() && rows.any { it.get(orgField) == activeOrg }
                    }
                }
            ]]></script>
        </actions>
    </service>

    <!-- ZE-SB-013 (Tier 5): is a party a MEMBER of the caller's active org? Unlike assert#RecordOrgAccess
         (ownerPartyId==org — for customers/products), an EMPLOYEE relates to its org via an Employee record
         (zenith.erp.hr.Employee: partyId + organizationPartyId), so the many hr/payroll/attendance/timeoff writes
         keyed on an employeePartyId use THIS. allowed=true for: an Employee of the active org, a party owned by
         it (contacts), or the org itself. ADMIN exempt. Pure predicate — adds no message. -->
    <service verb="assert" noun="PartyOrgMembership" authenticate="true">
        <in-parameters><parameter name="partyId" required="true"/></in-parameters>
        <out-parameters><parameter name="allowed" type="Boolean"/></out-parameters>
        <actions>
            <script><![CDATA[
                allowed = true
                if (!ec.user.isInGroup('ADMIN')) {
                    def activeOrg = ec.user.getPreference('ACTIVE_ORGANIZATION')
                    if (!activeOrg || activeOrg == '_NA_') {
                        allowed = false
                    } else if (partyId == activeOrg) {
                        allowed = true
                    } else {
                        def emp = ec.entity.find('zenith.erp.hr.Employee').condition('partyId', partyId)
                                    .condition('organizationPartyId', activeOrg).disableAuthz().count()
                        if (emp > 0) {
                            allowed = true
                        } else {
                            def owned = ec.entity.find('mantle.party.Party').condition('partyId', partyId)
                                         .condition('ownerPartyId', activeOrg).disableAuthz().count()
                            allowed = owned > 0
                        }
                    }
                }
            ]]></script>
        </actions>
    </service>

    <!-- ZE-SB-013 (Tier 5): does an EMPLOYEE record (by its PK employeeId) belong to the caller's active org?
         Most hr/payroll/attendance writes key on the Employee PK (employeeId), not a party id, so they can't use
         assert#PartyOrgMembership (which takes a partyId). This loads zenith.erp.hr.Employee by employeeId and
         compares its organizationPartyId to ACTIVE_ORGANIZATION. ADMIN exempt. Pure predicate — adds no message.
         (Equivalent to assert#RecordOrgAccess on the Employee entity, wrapped for a one-arg call at the many sites.) -->
    <service verb="assert" noun="EmployeeOrgAccess" authenticate="true">
        <in-parameters><parameter name="employeeId" required="true"/></in-parameters>
        <out-parameters><parameter name="allowed" type="Boolean"/></out-parameters>
        <actions>
            <script><![CDATA[
                allowed = true
                if (!ec.user.isInGroup('ADMIN')) {
                    def activeOrg = ec.user.getPreference('ACTIVE_ORGANIZATION')
                    if (!activeOrg || activeOrg == '_NA_') {
                        allowed = false
                    } else {
                        def emp = ec.entity.find('zenith.erp.hr.Employee').condition('employeeId', employeeId)
                                    .disableAuthz().one()
                        allowed = emp != null && emp.organizationPartyId == activeOrg
                    }
                }
            ]]></script>
        </actions>
    </service>

</services>
