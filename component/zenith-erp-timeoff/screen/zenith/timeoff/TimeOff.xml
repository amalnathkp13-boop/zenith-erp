<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Time Off" default-menu-index="22">

    <always-actions>
        <set field="html_title" value="Time Off"/>
    </always-actions>

    <subscreens default-item="MyLeaves"/>

    <transition name="goHr"><default-response url="../Hr/Employees"/></transition>
    <transition name="goPayroll"><default-response url="../payroll/PayrollRuns"/></transition>
    <transition name="goAttendance"><default-response url="../attendance/AllAttendance"/></transition>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
