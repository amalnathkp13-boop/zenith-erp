<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Marketing" default-menu-index="13">

    <always-actions>
        <set field="html_title" value="Marketing"/>
    </always-actions>

    <subscreens default-item="Campaigns"/>

    <transition name="goCrm"><default-response url="../Crm/Leads"/></transition>
    <transition name="goContacts"><default-response url="../Contacts/FindContact"/></transition>
    <transition name="goSales"><default-response url="../sales/SalesDashboard"/></transition>
    <transition name="goEvents"><default-response url="../events/AllEvents"/></transition>
    <transition name="goEcommerce"><default-response url="../ecommerce/EcomOrders"/></transition>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
