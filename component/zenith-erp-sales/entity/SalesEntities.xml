<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Generic Order Header Extensions ========== -->
    <extend-entity entity-name="OrderHeader" package="mantle.order">
        <field name="invoiceSequenceNumber" type="text-short"/>
        <field name="financialYearPrefix" type="text-short"/>
        <field name="totalTaxableAmount" type="currency-precise"/>
        <field name="totalTaxAmount" type="currency-precise"/>
        <field name="documentType" type="text-short"/>
        <field name="zenithDocNumber" type="text-short"><description>Formatted, per-org financial-year document number (e.g. QTN/26-27/00001, SO/26-27/00001) assigned at creation; mirrors Invoice.customInvoiceNumber.</description></field>
        <field name="originatingQuoteNumber" type="text-short"><description>When a quotation is converted to a sales order it is renumbered to the SO series; this preserves the original QTN number for traceability.</description></field>
    </extend-entity>

    <!-- ========== Generic Order Item Extensions ========== -->
    <extend-entity entity-name="OrderItem" package="mantle.order">
        <field name="taxableAmount" type="currency-precise"/>
        <field name="totalTaxAmount" type="currency-precise"/>
        <field name="discountAmount" type="currency-precise"/>
        <field name="discountPercent" type="number-decimal"/>
        <field name="mrpAmount" type="currency-precise"/>
        <field name="isTaxInclusive" type="text-indicator" default="'N'"/>
        <field name="productTaxCode" type="text-short"><description>Tax classification code (HSN/SAC, tax category, etc.)</description></field>
    </extend-entity>

    <!-- ========== Generic Invoice Extensions ========== -->
    <extend-entity entity-name="Invoice" package="mantle.account.invoice">
        <field name="customInvoiceNumber" type="text-short"><description>Custom/formatted invoice number</description></field>
        <field name="financialYearPrefix" type="text-short"/>
        <field name="originalInvoiceId" type="id"><description>For credit/debit notes: links to original invoice</description></field>
        <field name="creditDebitNoteType" type="text-short"/>
        <field name="creditDebitNoteReason" type="text-medium"/>
        <field name="amountInWords" type="text-long"/>
        <field name="totalTaxableAmount" type="currency-precise"/>
        <field name="totalTaxAmount" type="currency-precise"/>
        <field name="roundOffAmount" type="currency-precise"/>
        <field name="documentType" type="text-short"/>
        <field name="facilityId" type="id"><description>ZE-SHOP: the shop (FcTpRetailStore facility) this invoice belongs to, for per-shop sales/AR reporting. Nullable: POS bills stamp it from their session's terminal facility; manual invoices from the active shop; older/unattributed invoices stay null (appear only under "All Shops").</description></field>
    </extend-entity>

    <!-- ========== Generic Invoice Item Extensions ========== -->
    <extend-entity entity-name="InvoiceItem" package="mantle.account.invoice">
        <field name="taxableAmount" type="currency-precise"/>
        <field name="totalTaxAmount" type="currency-precise"/>
        <field name="discountAmount" type="currency-precise"/>
        <field name="discountPercent" type="number-decimal"/>
        <field name="mrpAmount" type="currency-precise"/>
        <field name="isTaxInclusive" type="text-indicator" default="'N'"/>
        <field name="productTaxCode" type="text-short"/>
    </extend-entity>

    <!-- ========== Quotation Template (generic) ========== -->
    <entity entity-name="QuotationTemplate" package="zenith.erp.sales" short-alias="QuotationTemplate">
        <field name="templateId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="templateName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="termsAndConditions" type="text-very-long"/>
        <field name="validityDays" type="number-integer" default="30"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
    </entity>

    <!-- ========== Delivery Schedule ========== -->
    <entity entity-name="DeliverySchedule" package="zenith.erp.sales" short-alias="DeliverySchedules">
        <field name="scheduleId" type="id" is-pk="true"/>
        <field name="orderId" type="id"/>
        <field name="deliveryDate" type="date"/>
        <field name="facilityId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="notes" type="text-medium"/>
        <relationship type="one" related="mantle.order.OrderHeader"/>
        <relationship type="one" related="mantle.facility.Facility"/>
    </entity>

    <!-- ========== Delivery Schedule Item ========== -->
    <entity entity-name="DeliveryScheduleItem" package="zenith.erp.sales" short-alias="DeliveryScheduleItems">
        <field name="scheduleId" type="id" is-pk="true"/>
        <field name="orderItemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="quantity" type="number-decimal"/>
        <field name="deliveredQuantity" type="number-decimal"/>
        <relationship type="one" related="zenith.erp.sales.DeliverySchedule"/>
    </entity>

    <!-- ========== Consignment Stock ========== -->
    <entity entity-name="ConsignmentStock" package="zenith.erp.sales" short-alias="ConsignmentStocks">
        <field name="consignmentId" type="id" is-pk="true"/>
        <field name="vendorPartyId" type="id"/>
        <field name="retailerPartyId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="productId" type="id"/>
        <field name="quantity" type="number-decimal"/>
        <field name="valuationAmount" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="consignmentDate" type="date-time"/>
        <field name="settlementDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <relationship type="one" title="Vendor" related="mantle.party.Party">
            <key-map field-name="vendorPartyId" related="partyId"/></relationship>
        <relationship type="one" title="Retailer" related="mantle.party.Party">
            <key-map field-name="retailerPartyId" related="partyId"/></relationship>
    </entity>

    <!-- ========== Commission Structure ========== -->
    <entity entity-name="CommissionStructure" package="zenith.erp.sales" short-alias="CommissionStructures">
        <field name="commissionId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="partyId" type="id"/>
        <field name="commissionTypeEnumId" type="id"/>
        <field name="rate" type="number-decimal"/>
        <field name="productCategoryId" type="id"/>
        <field name="minAmount" type="currency-amount"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="validFrom" type="date"/>
        <field name="validTo" type="date"/>
        <relationship type="one" related="mantle.party.Party"/>
    </entity>

    <!-- ZE-SALES-024 f/u (SL-084): slab table for a Tiered commission structure. A CmtTiered structure owns its
         slabs here (one row per amount band), so a salesperson's tiers are managed in one place instead of as
         separate CommissionStructure rows. -->
    <entity entity-name="CommissionTier" package="zenith.erp.sales" short-alias="CommissionTiers">
        <field name="commissionTierId" type="id" is-pk="true"/>
        <field name="commissionId" type="id"/>
        <field name="minAmount" type="currency-amount"/>
        <field name="rate" type="number-decimal"/>
        <relationship type="one" related="zenith.erp.sales.CommissionStructure"/>
    </entity>

    <!-- ========== Commission Transaction ========== -->
    <entity entity-name="CommissionTransaction" package="zenith.erp.sales" short-alias="CommissionTransactions">
        <field name="commissionTxnId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="commissionId" type="id"/>
        <field name="orderId" type="id"/>
        <field name="invoiceId" type="id"/>
        <field name="orderAmount" type="currency-amount"/>
        <field name="commissionAmount" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="calculatedDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="zenith.erp.sales.CommissionStructure"/>
    </entity>

    <!-- ========== Delivery Challan (DC) ========== -->
    <entity entity-name="DeliveryChallan" package="zenith.erp.sales" table-name="ZENITH_DELIVERY_CHALLAN" short-alias="DeliveryChallan">
        <field name="challanId" type="id" is-pk="true"/>
        <field name="challanNumber" type="text-short"/>
        <field name="organizationPartyId" type="id"/>
        <field name="customerPartyId" type="id"/>
        <field name="orderId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="challanDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <field name="vehicleNumber" type="text-short"/>
        <field name="transporterName" type="text-medium"/>
        <field name="lrNumber" type="text-short"/>
        <field name="convertedToInvoiceId" type="id"/>
        <field name="notes" type="text-medium"/>
        <!-- Fields already collected by the Sales challan UI; persist them on its owning entity. -->
        <field name="challanType" type="text-short"/>
        <field name="ewayBillId" type="id"/>
        <field name="transporterId" type="id"/>
        <field name="returnDueDate" type="date"/>
        <field name="actualReturnDate" type="date"/>
        <relationship type="one" title="Customer" related="mantle.party.Party" short-alias="customer">
            <key-map field-name="customerPartyId" related="partyId"/></relationship>
    </entity>

    <entity entity-name="DeliveryChallanItem" package="zenith.erp.sales" table-name="ZENITH_DLVRY_CHALLAN_ITEM" short-alias="DeliveryChallanItem">
        <field name="challanId" type="id" is-pk="true"/>
        <field name="challanItemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="quantity" type="number-decimal"/>
        <field name="unitPrice" type="currency-amount"/>
        <field name="batchNumber" type="text-short"/>
        <field name="remarks" type="text-medium"/>
        <field name="description" type="text-medium"/>
        <field name="uomId" type="id"/>
        <field name="hsnSacCode" type="text-short"/>
        <field name="estimatedValue" type="currency-precise"/>
        <relationship type="one" related="zenith.erp.sales.DeliveryChallan" short-alias="challan"/>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
    </entity>

    <!-- ========== Warranty Tracking ========== -->
    <entity entity-name="WarrantyPolicy" package="zenith.erp.sales" short-alias="WarrantyPolicy">
        <field name="warrantyPolicyId" type="id" is-pk="true"/>
        <!-- ZE-SALES-037: owning tenant. WarrantyPolicies.xml filters the policies list by this
             (ec.user.getPreference('ACTIVE_ORGANIZATION')); without the field the find threw
             EntityException for every tenant (non-empty org kept the econdition) while super-admin
             (empty org -> ignore-if-empty dropped it) saw the screen fine. -->
        <field name="organizationPartyId" type="id"/>
        <field name="policyName" type="text-medium"/>
        <field name="warrantyTypeEnumId" type="id"/>
        <field name="durationMonths" type="number-integer"/>
        <field name="coverageDescription" type="text-long"/>
        <field name="isExtendable" type="text-indicator" default="'N'"/>
        <field name="extendedMonths" type="number-integer"/>
        <field name="extendedCost" type="currency-amount"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <entity entity-name="WarrantyRegistration" package="zenith.erp.sales" short-alias="WarrantyRegistration">
        <field name="warrantyRegId" type="id" is-pk="true"/>
        <field name="warrantyPolicyId" type="id"/>
        <field name="productId" type="id"/>
        <field name="serialNumber" type="text-short"/>
        <field name="customerPartyId" type="id"/>
        <field name="invoiceId" type="id"/>
        <field name="purchaseDate" type="date"/>
        <field name="warrantyStartDate" type="date"/>
        <field name="warrantyEndDate" type="date"/>
        <field name="isExtended" type="text-indicator" default="'N'"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="zenith.erp.sales.WarrantyPolicy" short-alias="policy"/>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
        <relationship type="one" title="Customer" related="mantle.party.Party" short-alias="customer">
            <key-map field-name="customerPartyId" related="partyId"/></relationship>
    </entity>

    <entity entity-name="WarrantyClaim" package="zenith.erp.sales" short-alias="WarrantyClaim">
        <field name="claimId" type="id" is-pk="true"/>
        <field name="warrantyRegId" type="id"/>
        <field name="claimDate" type="date-time"/>
        <field name="issueDescription" type="text-long"/>
        <field name="resolutionEnumId" type="id"/>
        <field name="resolutionNotes" type="text-long"/>
        <field name="resolvedDate" type="date-time"/>
        <field name="serviceCost" type="currency-amount" default="0"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="zenith.erp.sales.WarrantyRegistration" short-alias="registration"/>
    </entity>

    <!-- ========== Generic Sales Invoice View ========== -->
    <view-entity entity-name="SalesInvoiceView" package="zenith.erp.sales">
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice"/>
        <member-entity entity-alias="FORG" entity-name="mantle.party.Organization" join-from-alias="INV" join-optional="true">
            <key-map field-name="fromPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="TORG" entity-name="mantle.party.Organization" join-from-alias="INV" join-optional="true">
            <key-map field-name="toPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="TPER" entity-name="mantle.party.Person" join-from-alias="INV" join-optional="true">
            <key-map field-name="toPartyId" related="partyId"/></member-entity>
        <alias entity-alias="INV" name="invoiceId"/>
        <alias entity-alias="INV" name="invoiceTypeEnumId"/>
        <alias entity-alias="INV" name="statusId"/>
        <alias entity-alias="INV" name="invoiceDate"/>
        <alias entity-alias="INV" name="dueDate"/>
        <alias entity-alias="INV" name="fromPartyId"/>
        <alias entity-alias="INV" name="toPartyId"/>
        <alias entity-alias="INV" name="currencyUomId"/>
        <alias entity-alias="INV" name="customInvoiceNumber"/>
        <alias entity-alias="INV" name="financialYearPrefix"/>
        <alias entity-alias="INV" name="totalTaxableAmount"/>
        <alias entity-alias="INV" name="totalTaxAmount"/>
        <alias entity-alias="INV" name="amountInWords"/>
        <alias entity-alias="INV" name="originalInvoiceId"/>
        <alias entity-alias="INV" name="creditDebitNoteType"/>
        <alias entity-alias="INV" name="documentType"/>
        <alias entity-alias="INV" name="roundOffAmount"/>
        <alias entity-alias="FORG" name="sellerName" field="organizationName"/>
        <alias entity-alias="TORG" name="buyerOrgName" field="organizationName"/>
        <alias entity-alias="TPER" name="buyerFirstName" field="firstName"/>
        <alias entity-alias="TPER" name="buyerLastName" field="lastName"/>
    </view-entity>

    <!-- Aggregated sales-invoice totals per org (for the Sales dashboard "Total Sales") -->
    <view-entity entity-name="InvoiceSalesSummaryView" package="zenith.erp.sales">
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice"/>
        <alias entity-alias="INV" name="fromPartyId" group-by="true"/>
        <alias entity-alias="INV" name="invoiceTypeEnumId" group-by="true"/>
        <alias entity-alias="INV" name="statusId" group-by="true"/>
        <alias entity-alias="INV" name="taxableSum" field="totalTaxableAmount" function="sum"/>
        <alias entity-alias="INV" name="taxSum" field="totalTaxAmount" function="sum"/>
        <alias entity-alias="INV" name="roundSum" field="roundOffAmount" function="sum"/>
        <alias entity-alias="INV" name="cnt" field="invoiceId" function="count"/>
    </view-entity>

    <!-- ZE-DASH: product-level sales aggregation for the Home dashboard "Top Selling Products" widget.
         Query-only view (no table). The DB does the group-by (per product + org + type + status) so callers
         filter to finalised sales in-code and never build a huge invoiceId IN-clause. totalValue = SUM(amount*qty). -->
    <view-entity entity-name="InvoiceSalesProductAgg" package="zenith.erp.sales">
        <member-entity entity-alias="ITM" entity-name="mantle.account.invoice.InvoiceItem"/>
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice" join-from-alias="ITM">
            <key-map field-name="invoiceId"/>
        </member-entity>
        <alias entity-alias="ITM" name="productId" group-by="true"/>
        <alias entity-alias="INV" name="fromPartyId" group-by="true"/>
        <alias entity-alias="INV" name="invoiceTypeEnumId" group-by="true"/>
        <alias entity-alias="INV" name="statusId" group-by="true"/>
        <alias entity-alias="ITM" name="totalQuantity" field="quantity" function="sum"/>
        <alias name="totalValue" function="sum">
            <complex-alias operator="*">
                <complex-alias-field entity-alias="ITM" field="amount"/>
                <complex-alias-field entity-alias="ITM" field="quantity"/>
            </complex-alias>
        </alias>
    </view-entity>

    <!-- Range-filterable sales aggregate for the home dashboard. -->
    <view-entity entity-name="InvoiceSalesProductByDateAgg" package="zenith.erp.sales">
        <member-entity entity-alias="ITM" entity-name="mantle.account.invoice.InvoiceItem"/>
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice" join-from-alias="ITM">
            <key-map field-name="invoiceId"/>
        </member-entity>
        <alias entity-alias="ITM" name="productId" group-by="true"/>
        <alias entity-alias="INV" name="fromPartyId" group-by="true"/>
        <alias entity-alias="INV" name="facilityId" group-by="true"/>
        <alias entity-alias="INV" name="invoiceTypeEnumId" group-by="true"/>
        <alias entity-alias="INV" name="statusId" group-by="true"/>
        <alias entity-alias="INV" name="invoiceDate" group-by="true"/>
        <alias entity-alias="ITM" name="totalQuantity" field="quantity" function="sum"/>
        <alias name="totalValue" function="sum">
            <complex-alias operator="*">
                <complex-alias-field entity-alias="ITM" field="amount"/>
                <complex-alias-field entity-alias="ITM" field="quantity"/>
            </complex-alias>
        </alias>
    </view-entity>

</entities>
