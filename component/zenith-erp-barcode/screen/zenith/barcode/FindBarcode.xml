<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Product Barcodes" default-menu-index="2">

    <transition name="addBarcode" method="post">
        <service-call name="zenith.barcode.BarcodeServices.add#ProductBarcode"/>
        <default-response url="."/>
    </transition>
    <transition name="generateBarcode" method="post">
        <service-call name="zenith.barcode.BarcodeServices.generate#InternalBarcode"/>
        <default-response url="."/>
    </transition>
    <!-- ZE-BC-091: remove an obsolete barcode (service is org-guarded). -->
    <transition name="deleteBarcode" method="post">
        <service-call name="zenith.barcode.BarcodeServices.delete#ProductBarcode"/>
        <default-response url="."/>
    </transition>

    <actions>
        <service-call name="zenith.barcode.BarcodeServices.get#AuthorizedActiveOrganization" out-map="_barcodeOrg"/>
        <set field="curOrg" from="_barcodeOrg.activeOrgId ?: '__NO_ORGANIZATION__'"/>

        <entity-find entity-name="zenith.erp.barcode.ProductBarcodeDetail" list="barcodes">
            <!-- BC-primary: group each product's barcodes together with the PRIMARY on top (then secondaries),
                 so the authoritative barcode is never buried below an alternate. -->
            <search-form-inputs skip-fields="organizationPartyId,ownerPartyId" default-order-by="productName,-isPrimary,barcodeValue"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="curOrg"/>
            <!-- A legacy barcode with an inconsistent product owner must not expose another tenant's name. -->
            <econdition field-name="ownerPartyId" from="curOrg"/>
            <date-filter from-field-name="salesIntroductionDate" thru-field-name="salesDiscontinuationDate"/>
        </entity-find>

        <!-- Stat cards: real, org-scoped counts (no active organization yields zero rows). -->
        <entity-find-count entity-name="zenith.erp.barcode.ProductBarcodeDetail" count-field="statTotal">
            <econdition field-name="ownerPartyId" from="curOrg"/>
            <date-filter from-field-name="salesIntroductionDate" thru-field-name="salesDiscontinuationDate"/>
            <econdition field-name="isActive" value="Y"/>
            <econdition field-name="organizationPartyId" from="curOrg"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.barcode.ProductBarcodeDetail" count-field="statInternal">
            <econdition field-name="ownerPartyId" from="curOrg"/>
            <date-filter from-field-name="salesIntroductionDate" thru-field-name="salesDiscontinuationDate"/>
            <econdition field-name="isActive" value="Y"/>
            <econdition field-name="barcodeTypeEnumId" value="BctInternal"/>
            <econdition field-name="organizationPartyId" from="curOrg"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.barcode.ProductBarcodeDetail" count-field="statEanUpc">
            <econdition field-name="ownerPartyId" from="curOrg"/>
            <date-filter from-field-name="salesIntroductionDate" thru-field-name="salesDiscontinuationDate"/>
            <econdition field-name="isActive" value="Y"/>
            <econdition field-name="barcodeTypeEnumId" operator="in" from="['BctUpcA','BctUpcE','BctEan13','BctEan8']"/>
            <econdition field-name="organizationPartyId" from="curOrg"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.barcode.BarcodePrintJob" count-field="statPrintReady">
            <econdition field-name="statusId" value="BpPending"/>
            <econdition field-name="organizationPartyId" from="curOrg"/>
        </entity-find-count>

        <!-- Generate Internal Barcode modal: org-scoped product options + surface-aware post target -->
        <entity-find entity-name="mantle.product.Product" list="_prodOpts">
            <econdition field-name="ownerPartyId" from="curOrg"/>
            <date-filter from-field-name="salesIntroductionDate" thru-field-name="salesDiscontinuationDate"/>
            <order-by field-name="productName"/>
        </entity-find>
        <entity-find entity-name="moqui.basic.Enumeration" list="_typeEnums">
            <econdition field-name="enumTypeId" value="BarcodeType"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
        <script><![CDATA[
            statTotalF = ec.l10n.format(statTotal ?: 0, '#,##0')
            statInternalF = ec.l10n.format(statInternal ?: 0, '#,##0')
            statEanUpcF = ec.l10n.format(statEanUpc ?: 0, '#,##0')
            statPrintReadyF = ec.l10n.format(statPrintReady ?: 0, '#,##0')
            productOptions = []
            for (p in (_prodOpts ?: [])) {
                productOptions.add([id: p.productId, label: ((p.productName ?: p.productId) + ' [' + (p.pseudoId ?: p.productId) + ']')])
            }
            typeOptions = []
            for (e in (_typeEnums ?: [])) { typeOptions.add([id: e.enumId, label: (e.description ?: e.enumId)]) }
            def _uri = (ec.web?.request?.requestURI ?: ''); def _zi = _uri.indexOf('/zenith/')
            appBase = (_zi > 0) ? _uri.substring(0, _zi) : ''
            moquiToken = (ec.web != null) ? (ec.web.sessionToken ?: '') : ''
        ]]></script>
    </actions>

    <widgets>
        <container style="zbc-page">
<render-mode><text type="html,qvt"><![CDATA[<img alt="" aria-hidden="true" style="display:none" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" onload="if(window.ZenithBarcode){window.ZenithBarcode.init()}else{var s=document.createElement('script');s.src='/zenithstatic/js/barcode-module.js?v=1';s.onload=function(){window.ZenithBarcode.init()};document.head.appendChild(s)}"/>]]></text></render-mode>
        <!-- ===== Page header: title + subtitle + Add Barcode (violet) / Generate Internal (outline) ===== -->
        <container style="pb-head">
            <container style="pb-head-text">
                <label text="Product Barcodes" type="h4" style="pb-head-title"/>
                <label text="View and manage all product barcodes." type="p" style="pb-head-sub"/>
            </container>
            <container style="pb-head-actions">
                <section name="bar_AddBarcode_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <render-mode><text type="html,qvt"><![CDATA[
                    <button type="button" onclick="var o=document.getElementById('ab-overlay');if(o)o.style.display='flex'" style="display:inline-flex;align-items:center;gap:7px;height:40px;padding:0 16px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:18px">add</span>Add Barcode</button>
                ]]></text></render-mode>
                </widgets></section>
                <section name="bar_GenerateBarcode_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <render-mode><text type="html,qvt"><![CDATA[
                    <button type="button" onclick="var o=document.getElementById('gb-overlay');if(o)o.style.display='flex'" style="display:inline-flex;align-items:center;gap:7px;height:40px;padding:0 16px;background:var(--z-bg-card,#fff);color:var(--z-text-main,#374151);border:1px solid var(--z-border,#E5E7EB);border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:18px">file_download</span>Generate Internal</button>
                ]]></text></render-mode>
                </widgets></section>
            </container>
        </container>

        <!-- ===== Stat cards (real, org-scoped) ===== -->
        <render-mode><text type="html,qvt"><![CDATA[
            <div style="display:flex;flex-wrap:wrap;gap:16px;margin-bottom:20px">
                <div style="flex:1 1 210px;min-width:200px;background:rgba(124,58,237,.06);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:18px 20px;display:flex;align-items:center;gap:16px">
                    <div style="width:48px;height:48px;flex:0 0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(124,58,237,.12)"><span class="material-icons" style="font-size:24px;color:#7C3AED">qr_code_2</span></div>
                    <div style="min-width:0">
                        <div style="font-size:12.5px;font-weight:600;color:var(--z-text-main,#111827)">Total Barcodes</div>
                        <div style="font-size:26px;font-weight:700;line-height:1.15;color:var(--z-text-main,#111827)">${statTotalF}</div>
                        <div style="font-size:12px;color:var(--z-text-muted,#6B7280)">Active in system</div>
                    </div>
                </div>
                <div style="flex:1 1 210px;min-width:200px;background:rgba(16,185,129,.07);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:18px 20px;display:flex;align-items:center;gap:16px">
                    <div style="width:48px;height:48px;flex:0 0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(16,185,129,.15)"><span class="material-icons" style="font-size:24px;color:#0E9F6E">inventory_2</span></div>
                    <div style="min-width:0">
                        <div style="font-size:12.5px;font-weight:600;color:#0E9F6E">Internal SKUs</div>
                        <div style="font-size:26px;font-weight:700;line-height:1.15;color:var(--z-text-main,#111827)">${statInternalF}</div>
                        <div style="font-size:12px;color:var(--z-text-muted,#6B7280)">Primary items</div>
                    </div>
                </div>
                <div style="flex:1 1 210px;min-width:200px;background:rgba(217,119,6,.07);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:18px 20px;display:flex;align-items:center;gap:16px">
                    <div style="width:48px;height:48px;flex:0 0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(217,119,6,.14)"><span class="material-icons" style="font-size:24px;color:#B45309">qr_code_scanner</span></div>
                    <div style="min-width:0">
                        <div style="font-size:12.5px;font-weight:600;color:#B45309">EAN / UPC</div>
                        <div style="font-size:26px;font-weight:700;line-height:1.15;color:var(--z-text-main,#111827)">${statEanUpcF}</div>
                        <div style="font-size:12px;color:var(--z-text-muted,#6B7280)">Secondary items</div>
                    </div>
                </div>
                <div style="flex:1 1 210px;min-width:200px;background:rgba(37,99,235,.06);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:18px 20px;display:flex;align-items:center;gap:16px">
                    <div style="width:48px;height:48px;flex:0 0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(37,99,235,.12)"><span class="material-icons" style="font-size:24px;color:#2563EB">print</span></div>
                    <div style="min-width:0">
                        <div style="font-size:12.5px;font-weight:600;color:#2563EB">Print Ready</div>
                        <div style="font-size:26px;font-weight:700;line-height:1.15;color:var(--z-text-main,#111827)">${statPrintReadyF}</div>
                        <div style="font-size:12px;color:var(--z-text-muted,#6B7280)">Jobs in queue</div>
                    </div>
                </div>
            </div>
        ]]></text></render-mode>

        <!-- ===== Table (native form-list + z-listchrome toolbar/footer) ===== -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search product, SKU or barcode" style="display:none"></span>]]></text></render-mode>
            <form-list name="BarcodesForm" list="barcodes" list-entry="bc" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <row-actions><script><![CDATA[
                    stCls = 'warning'; stTxt = 'Secondary'
                    if (bc.isActive == 'N') { stCls = 'grey'; stTxt = 'Inactive' }
                    else if (bc.isPrimary == 'Y') { stCls = 'success'; stTxt = 'Primary' }
                ]]></script></row-actions>
                <field name="productName"><header-field title="Product" show-order-by="true"><text-find size="20"/></header-field>
                    <default-field title="Product"><label text="${bc.productName ?: '—'}" type="span" style="text-dark text-weight-medium"/></default-field></field>
                <field name="pseudoId"><header-field title="SKU" show-order-by="true"/>
                    <default-field title="SKU"><label text="${bc.pseudoId ?: '—'}" type="span" style="text-dark"/></default-field></field>
                <field name="barcodeValue"><header-field title="Barcode" show-order-by="true"><text-find size="20"/></header-field>
                    <default-field title="Barcode"><label text="${bc.barcodeValue ?: '—'}" type="span" style="text-dark"/></default-field></field>
                <field name="printLink"><default-field title="Label">
                    <link url="../renderLabels" text="Print" parameter-map="[barcodeId:bc.barcodeId, moquiSessionToken:ec.web.sessionToken]" link-type="anchor" style="z-vlink"/>
                </default-field></field>
                <field name="barcodeTypeEnumId"><header-field title="Type">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="BarcodeType"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                <!-- BC-primary: clear tri-state status so a product's authoritative barcode is unmistakable and
                     non-primary alternates read as "Secondary". Purely presentational — the one-primary-per-product
                     invariant is already enforced by add#ProductBarcode. -->
                <field name="isPrimary"><default-field title="Status">
                    <label text="${stTxt}" type="span" style="zenith-badge ${stCls}"/>
                </default-field></field>
                <field name="productTypeEnumId"><default-field title="Asset Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}" style="text-grey-6"/></default-field></field>
                <!-- ZE-BC-091 / ZE-BC-DELETE-001: delete must POST (default link-type); write-gated + org-guarded in the service. -->
                <field name="deleteBtn"><default-field title="Action">
                    <link url="deleteBarcode" icon="fa fa-trash" text="" parameter-map="[barcodeId:bc.barcodeId]"
                          confirmation="Delete this barcode? To replace it, delete then Add the new value. This can't be undone."
                          style="z-redlink" condition="modCanWrite"/>
                </default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>

        <!-- ===== Generate Internal Barcode modal (custom <div>+fetch; posts to the generateBarcode transition) ===== -->
        <section name="bar_GenerateModal"><condition><expression>modCanWrite</expression></condition><widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <#assign gbInp="width:100%;box-sizing:border-box;height:40px;padding:0 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#111827;background:#fff;outline:none">
        <div id="gb-overlay" style="display:none;position:fixed;inset:0;background:rgba(17,24,39,.4);z-index:12000;align-items:flex-start;justify-content:center;padding:40px 16px;overflow-y:auto;font-family:'Segoe UI',Arial,sans-serif">
            <div id="gb-modal" style="background:#fff;border:1px solid #E5E7EB;border-radius:12px;box-shadow:0 20px 40px rgba(17,24,39,.16);width:100%;max-width:420px;padding:20px 22px">
                <input id="gb-token" type="hidden" value="${(moquiToken)!''}"/>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
                    <div style="font-size:16px;font-weight:600;color:#111827">Generate Internal Barcode</div>
                    <button type="button" onclick="document.getElementById('gb-overlay').style.display='none'" title="Close" style="width:30px;height:30px;border:none;background:transparent;color:#9CA3AF;cursor:pointer;border-radius:8px;display:flex;align-items:center;justify-content:center"><span class="material-icons" style="font-size:19px">close</span></button>
                </div>
                <div style="margin-bottom:16px">
                    <label style="display:block;font-size:12.5px;font-weight:500;color:#6B7280;margin-bottom:6px">Product</label>
                    <div style="position:relative">
                        <span class="material-icons" style="position:absolute;left:11px;top:50%;transform:translateY(-50%);font-size:18px;color:#6B7280;pointer-events:none;z-index:1">inventory_2</span>
                        <select id="gb-product" style="${gbInp};padding-left:38px"><#list (productOptions![]) as p><option value="${(p.id)?html}">${(p.label)?html}</option></#list></select>
                    </div>
                </div>
                <div style="margin-bottom:16px">
                    <label style="display:block;font-size:12.5px;font-weight:500;color:#6B7280;margin-bottom:6px">Prefix</label>
                    <input id="gb-prefix" type="text" value="ZEN" style="${gbInp}"/>
                </div>
                <div style="background:#F5F3FF;border:1px solid #E5E7EB;border-radius:12px;padding:18px 16px;text-align:center;margin:4px 0 22px">
                    <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:#7C3AED;margin-bottom:8px">Barcode Preview</div>
                    <div id="gb-code" style="font-size:20px;font-weight:700;color:#111827;margin-bottom:12px;letter-spacing:.02em">ZEN000001</div>
                    <div style="height:46px;background:repeating-linear-gradient(90deg,#111 0,#111 2px,#fff 2px,#fff 5px)"></div>
                </div>
                <div style="display:flex;justify-content:flex-end;gap:12px">
                    <button type="button" onclick="document.getElementById('gb-overlay').style.display='none'" style="height:40px;padding:0 20px;border:1px solid #E5E7EB;border-radius:8px;background:#fff;color:#6B7280;font-size:13px;font-weight:600;cursor:pointer">Cancel</button>
                    <button type="button" id="gb-create" style="display:inline-flex;align-items:center;gap:7px;height:40px;padding:0 20px;border:none;border-radius:8px;background:#2563EB;color:#fff;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:17px">file_download</span>Generate</button>
                </div>
            </div>
        </div>

        ]]></text></render-mode>
        </widgets></section>

        <!-- ===== Add Barcode modal (custom <div>+fetch; posts to the addBarcode transition) ===== -->
        <section name="bar_AddModal"><condition><expression>modCanWrite</expression></condition><widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <#assign abLbl="display:block;font-size:12.5px;font-weight:500;color:#6B7280;margin-bottom:6px">
        <#assign abInp="width:100%;box-sizing:border-box;height:40px;padding:0 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#111827;background:#fff;outline:none">
        <#assign abPill="flex:1;display:inline-flex;align-items:center;justify-content:center;gap:6px;height:40px;border:1px solid #E5E7EB;border-radius:8px;background:#fff;color:#6B7280;font-size:13px;font-weight:600;cursor:pointer">
        <div id="ab-overlay" style="display:none;position:fixed;inset:0;background:rgba(17,24,39,.4);z-index:12000;align-items:flex-start;justify-content:center;padding:40px 16px;overflow-y:auto;font-family:'Segoe UI',Arial,sans-serif">
            <div id="ab-modal" style="background:#fff;border:1px solid #E5E7EB;border-radius:12px;box-shadow:0 20px 40px rgba(17,24,39,.16);width:100%;max-width:420px;padding:20px 22px">
                <input id="ab-token" type="hidden" value="${(moquiToken)!''}"/>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
                    <div style="font-size:16px;font-weight:600;color:#111827">Add Barcode</div>
                    <button type="button" onclick="document.getElementById('ab-overlay').style.display='none'" title="Close" style="width:30px;height:30px;border:none;background:transparent;color:#9CA3AF;cursor:pointer;border-radius:8px;display:flex;align-items:center;justify-content:center"><span class="material-icons" style="font-size:19px">close</span></button>
                </div>
                <div style="margin-bottom:16px"><label style="${abLbl}">Product <span style="color:#EF4444">*</span></label><select id="ab-product" style="${abInp}"><#list (productOptions![]) as p><option value="${(p.id)?html}">${(p.label)?html}</option></#list></select></div>
                <div style="margin-bottom:16px"><label style="${abLbl}">Type <span style="color:#EF4444">*</span></label><select id="ab-type" style="${abInp}"><#list (typeOptions![]) as t><option value="${(t.id)?html}">${(t.label)?html}</option></#list></select></div>
                <div style="margin-bottom:16px"><label style="${abLbl}">Barcode Value <span style="color:#EF4444">*</span></label><input id="ab-value" type="text" placeholder="Enter barcode value" style="${abInp}"/></div>
                <div style="margin-bottom:4px"><label style="${abLbl}">Primary Barcode</label>
                    <div class="ab-tg" style="display:flex;gap:8px">
                        <button type="button" class="ab-pill" data-v="Y" style="${abPill}"><span class="material-icons ab-pico" style="font-size:16px;display:none">check_circle</span>Yes</button>
                        <button type="button" class="ab-pill" data-v="N" style="${abPill}">No</button>
                    </div>
                    <input id="ab-primary" type="hidden" value="Y"/>
                </div>
                <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:22px">
                    <button type="button" onclick="document.getElementById('ab-overlay').style.display='none'" style="height:40px;padding:0 20px;border:1px solid #E5E7EB;border-radius:8px;background:#fff;color:#6B7280;font-size:13px;font-weight:600;cursor:pointer">Cancel</button>
                    <button type="button" id="ab-create" style="height:40px;padding:0 22px;border:none;border-radius:8px;background:#7C3AED;color:#fff;font-size:13px;font-weight:600;cursor:pointer">Add Barcode</button>
                </div>
            </div>
        </div>

        ]]></text></render-mode>
        </widgets></section>
        </container>
    </widgets>
</screen>
