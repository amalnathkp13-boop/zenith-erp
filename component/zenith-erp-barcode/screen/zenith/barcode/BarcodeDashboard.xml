<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <parameter name="barcodeValue"/>

    <actions>
        <service-call name="zenith.barcode.BarcodeServices.get#AuthorizedActiveOrganization" out-map="_barcodeOrg"/>
        <set field="curOrg" from="_barcodeOrg.activeOrgId ?: '__NO_ORGANIZATION__'"/>
        <if condition="curOrg == '_NA_'"><set field="curOrg" from="null"/></if>

        <!-- org-scoped counts (no active organization yields zero rows; was GLOBAL = cross-tenant leak) -->
        <entity-find-count entity-name="zenith.erp.barcode.ProductBarcodeDetail" count-field="totalBarcodes">
            <econdition field-name="ownerPartyId" from="curOrg"/>
            <date-filter from-field-name="salesIntroductionDate" thru-field-name="salesDiscontinuationDate"/>
            <econdition field-name="isActive" value="Y"/>
            <econdition field-name="organizationPartyId" from="curOrg"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.barcode.BarcodeLabel" count-field="totalTemplates">
            <econdition field-name="organizationPartyId" from="curOrg"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.barcode.BarcodePrintJob" count-field="pendingJobs">
            <econdition field-name="statusId" value="BpPending"/>
            <econdition field-name="organizationPartyId" from="curOrg"/>
        </entity-find-count>

        <if condition="barcodeValue">
            <service-call name="zenith.barcode.BarcodeServices.lookup#ProductByBarcode"
                          in-map="[barcodeValue:barcodeValue]" out-map="lookupResult"/>
        </if>

        <script><![CDATA[
            totalBarcodesF = ec.l10n.format(totalBarcodes ?: 0, '#,##0')
            totalTemplatesF = ec.l10n.format(totalTemplates ?: 0, '#,##0')
            pendingJobsF = ec.l10n.format(pendingJobs ?: 0, '#,##0')
            def _uri = (ec.web?.request?.requestURI ?: ''); def _zi = _uri.indexOf('/zenith/')
            appBase = (_zi > 0) ? _uri.substring(0, _zi) : ''
        ]]></script>
    </actions>

    <widgets>
        <container style="zbc-page">
<render-mode><text type="html,qvt"><![CDATA[<img alt="" aria-hidden="true" style="display:none" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" onload="if(window.ZenithBarcode){window.ZenithBarcode.init()}else{var s=document.createElement('script');s.src='/zenithstatic/js/barcode-module.js?v=1';s.onload=function(){window.ZenithBarcode.init()};document.head.appendChild(s)}"/>]]></text></render-mode>
        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <#assign card="flex:1 1 300px;min-width:260px;border-radius:12px;padding:22px 24px;display:flex;align-items:center;gap:18px">
        <#assign acard="flex:1 1 220px;min-width:200px;background:var(--z-bg-card,#fff);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:26px 20px;text-align:center;text-decoration:none;display:block">
        <#assign aico="width:56px;height:56px;margin:0 auto 14px;border-radius:50%;display:flex;align-items:center;justify-content:center">
        <#assign inp="width:100%;box-sizing:border-box;height:46px;padding:0 42px 0 14px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;color:#111827;background:#fff;outline:none">
        <div style="margin-bottom:22px">
            <div style="font-size:30px;font-weight:700;color:var(--z-text-main,#111827);line-height:1.15">Barcode Management</div>
            <div style="font-size:14px;margin-top:6px;color:var(--z-text-muted,#6B7280)">Manage product barcodes, label templates, and print jobs.</div>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:20px;margin-bottom:24px">
            <div style="${card};background:rgba(124,58,237,.06)">
                <div style="width:56px;height:56px;flex:0 0 auto;border-radius:50%;background:rgba(124,58,237,.12);display:flex;align-items:center;justify-content:center"><span class="material-icons" style="font-size:26px;color:#7C3AED">view_week</span></div>
                <div><div style="font-size:11.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#6B7280">Active Barcodes</div><div style="font-size:28px;font-weight:700;line-height:1.1;color:#111827;margin:2px 0">${totalBarcodesF}</div><div style="font-size:12.5px;color:#6B7280">Total barcodes in system</div></div>
            </div>
            <div style="${card};background:rgba(16,185,129,.07)">
                <div style="width:56px;height:56px;flex:0 0 auto;border-radius:50%;background:rgba(16,185,129,.15);display:flex;align-items:center;justify-content:center"><span class="material-icons" style="font-size:26px;color:#0E9F6E">description</span></div>
                <div><div style="font-size:11.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#6B7280">Label Templates</div><div style="font-size:28px;font-weight:700;line-height:1.1;color:#111827;margin:2px 0">${totalTemplatesF}</div><div style="font-size:12.5px;color:#6B7280">Available templates</div></div>
            </div>
            <div style="${card};background:rgba(217,119,6,.07)">
                <div style="width:56px;height:56px;flex:0 0 auto;border-radius:50%;background:rgba(217,119,6,.14);display:flex;align-items:center;justify-content:center"><span class="material-icons" style="font-size:26px;color:#B45309">print</span></div>
                <div><div style="font-size:11.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#6B7280">Pending Print Jobs</div><div style="font-size:28px;font-weight:700;line-height:1.1;color:#111827;margin:2px 0">${pendingJobsF}</div><div style="font-size:12.5px;color:#6B7280">Jobs in queue</div></div>
            </div>
        </div>

        <div style="background:var(--z-bg-card,#fff);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:24px;margin-bottom:24px">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px"><span class="material-icons" style="color:#7C3AED;font-size:22px">search</span><span style="font-size:18px;font-weight:700;color:#111827">Quick Barcode Lookup</span></div>
            <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
                <div style="position:relative;flex:1 1 320px;min-width:260px">
                    <input id="bm-lookup" type="text" placeholder="Scan or enter barcode" value="${(barcodeValue!'')?html}" onkeydown="if(event.key==='Enter'){window.bmLook()}" style="${inp}"/>
                    <span class="material-icons" style="position:absolute;right:13px;top:50%;transform:translateY(-50%);color:#9CA3AF;font-size:20px;pointer-events:none">view_week</span>
                </div>
                <button type="button" onclick="window.bmLook()" style="height:46px;padding:0 28px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer">Lookup</button>
            </div>
            <#if (barcodeValue!'')?has_content>
                <#if (lookupResult.found)!false>
                <div style="margin-top:16px;padding:14px 16px;border-radius:8px;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3)">
                    <div style="font-size:14px;font-weight:700;color:#0E7A52">${(lookupResult.productName!'')?html} (${(lookupResult.productId!'')?html})</div>
                    <div style="font-size:13px;color:#0E7A52;margin-top:2px">Price: <#if (lookupResult.listPrice)??>&#8377; ${lookupResult.listPrice}<#else>N/A</#if></div>
                </div>
                <#else>
                <div style="margin-top:16px;padding:14px 16px;border-radius:8px;background:rgba(220,38,38,.08);border:1px solid rgba(220,38,38,.25);font-size:13.5px;color:#B91C1C">No product found for barcode: ${(barcodeValue!'')?html}</div>
                </#if>
            </#if>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:20px">
            <a class="bm-acard" href="${appBase}/zenith/barcode/FindBarcode" style="${acard}">
                <div style="${aico};background:rgba(124,58,237,.1)"><span class="material-icons" style="font-size:26px;color:#7C3AED">view_week</span></div>
                <div style="font-size:15px;font-weight:600;color:#111827">Product Barcodes</div>
                <div style="font-size:12.5px;color:#6B7280;margin-top:3px">View &amp; manage barcodes</div>
                <span class="material-icons bm-aarrow" style="font-size:18px;color:#9CA3AF;margin-top:12px;display:inline-block">arrow_forward</span>
            </a>
            <a class="bm-acard" href="${appBase}/zenith/barcode/LabelTemplates" style="${acard}">
                <div style="${aico};background:rgba(16,185,129,.12)"><span class="material-icons" style="font-size:26px;color:#0E9F6E">sell</span></div>
                <div style="font-size:15px;font-weight:600;color:#111827">Label Templates</div>
                <div style="font-size:12.5px;color:#6B7280;margin-top:3px">Create &amp; edit templates</div>
                <span class="material-icons bm-aarrow" style="font-size:18px;color:#9CA3AF;margin-top:12px;display:inline-block">arrow_forward</span>
            </a>
            <a class="bm-acard" href="${appBase}/zenith/barcode/PrintJobs" style="${acard}">
                <div style="${aico};background:rgba(217,119,6,.12)"><span class="material-icons" style="font-size:26px;color:#B45309">print</span></div>
                <div style="font-size:15px;font-weight:600;color:#111827">Print Jobs</div>
                <div style="font-size:12.5px;color:#6B7280;margin-top:3px">View print history</div>
                <span class="material-icons bm-aarrow" style="font-size:18px;color:#9CA3AF;margin-top:12px;display:inline-block">arrow_forward</span>
            </a>
            <a class="bm-acard" href="${appBase}/zenith/barcode/FindBarcode" style="${acard}">
                <div style="${aico};background:rgba(37,99,235,.1)"><span class="material-icons" style="font-size:26px;color:#2563EB">show_chart</span></div>
                <div style="font-size:15px;font-weight:600;color:#111827">Barcode Exports</div>
                <div style="font-size:12.5px;color:#6B7280;margin-top:3px">Open the barcode list to export</div>
                <span class="material-icons bm-aarrow" style="font-size:18px;color:#9CA3AF;margin-top:12px;display:inline-block">arrow_forward</span>
            </a>
        </div>

        ]]></text></render-mode>
        </container>
    </widgets>
</screen>
