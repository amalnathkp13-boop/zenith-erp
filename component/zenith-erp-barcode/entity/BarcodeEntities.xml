<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Product Barcode ========== -->
    <entity entity-name="ProductBarcode" package="zenith.erp.barcode" short-alias="ProductBarcodes">
        <field name="barcodeId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="productId" type="id"/>
        <field name="barcodeTypeEnumId" type="id"/>
        <field name="barcodeValue" type="text-medium"/>
        <field name="isPrimary" type="text-indicator" default="'N'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="mantle.product.Product"/>
        <index name="BC_VALUE">
            <index-field name="organizationPartyId"/>
            <index-field name="barcodeValue"/>
        </index>
        <index name="BC_PRODUCT_VALUE" unique="true">
            <index-field name="productId"/>
            <index-field name="organizationPartyId"/>
            <index-field name="barcodeValue"/>
        </index>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="BarcodeType" description="Barcode Type"/>
            <moqui.basic.Enumeration enumId="BctUpcA" enumTypeId="BarcodeType" description="UPC-A" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="BctUpcE" enumTypeId="BarcodeType" description="UPC-E" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="BctEan13" enumTypeId="BarcodeType" description="EAN-13" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="BctEan8" enumTypeId="BarcodeType" description="EAN-8" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="BctCode128" enumTypeId="BarcodeType" description="Code 128" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="BctCode39" enumTypeId="BarcodeType" description="Code 39" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="BctQrCode" enumTypeId="BarcodeType" description="QR Code" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="BctInternal" enumTypeId="BarcodeType" description="Internal SKU" sequenceNum="8"/>
        </seed-data>
    </entity>

    <!-- ========== Barcode Label Template ========== -->
    <entity entity-name="BarcodeLabel" package="zenith.erp.barcode" short-alias="BarcodeLabels">
        <field name="labelId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="labelName" type="text-medium"/>
        <field name="labelWidth" type="number-decimal"><description>Width in mm</description></field>
        <field name="labelHeight" type="number-decimal"><description>Height in mm</description></field>
        <field name="showProductName" type="text-indicator" default="'Y'"/>
        <field name="showPrice" type="text-indicator" default="'Y'"/>
        <field name="showSku" type="text-indicator" default="'N'"/>
        <field name="showMrp" type="text-indicator" default="'N'"/>
        <field name="barcodeTypeEnumId" type="id" default="'BctEan13'"/>
        <field name="columnsPerRow" type="number-integer" default="3"/>
        <field name="isDefault" type="text-indicator" default="'N'"/>
    </entity>

    <!-- ========== Barcode Print Job ========== -->
    <entity entity-name="BarcodePrintJob" package="zenith.erp.barcode" short-alias="BarcodePrintJobs">
        <field name="printJobId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="labelId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="completedDate" type="date-time"/>
        <field name="totalLabels" type="number-integer"/>
        <field name="createdByUserId" type="id"/>
        <relationship type="one" related="zenith.erp.barcode.BarcodeLabel"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="BarcodePrint" description="Barcode Print Job"/>
            <moqui.basic.StatusItem statusId="BpPending" statusTypeId="BarcodePrint" description="Pending" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="BpPrinting" statusTypeId="BarcodePrint" description="Printing" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="BpCompleted" statusTypeId="BarcodePrint" description="Completed" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="BpFailed" statusTypeId="BarcodePrint" description="Failed" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="BpPending" toStatusId="BpPrinting" transitionName="Start Print"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="BpPrinting" toStatusId="BpCompleted" transitionName="Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="BpPrinting" toStatusId="BpFailed" transitionName="Fail"/>
        </seed-data>
    </entity>

    <!-- ========== Print Job Item ========== -->
    <entity entity-name="BarcodePrintJobItem" package="zenith.erp.barcode" short-alias="BarcodePrintJobItems">
        <field name="printJobId" type="id" is-pk="true"/>
        <field name="productId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="quantity" type="number-integer"/>
        <field name="barcodeValue" type="text-medium"/>
        <relationship type="one" related="zenith.erp.barcode.BarcodePrintJob"/>
        <relationship type="one" related="mantle.product.Product"/>
    </entity>

    <!-- ========== Product Barcode View ========== -->
    <view-entity entity-name="ProductBarcodeDetail" package="zenith.erp.barcode">
        <member-entity entity-alias="PB" entity-name="zenith.erp.barcode.ProductBarcode"/>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="PB">
            <key-map field-name="productId"/></member-entity>
        <alias entity-alias="PB" name="barcodeId"/>
        <alias entity-alias="PB" name="productId"/>
        <alias entity-alias="PB" name="barcodeTypeEnumId"/>
        <alias entity-alias="PB" name="barcodeValue"/>
        <alias entity-alias="PB" name="isPrimary"/>
        <alias entity-alias="PB" name="isActive"/>
        <alias entity-alias="PB" name="organizationPartyId"/>
        <alias entity-alias="PRD" name="ownerPartyId"/>
        <alias entity-alias="PRD" name="productName"/>
        <alias entity-alias="PRD" name="salesIntroductionDate"/>
        <alias entity-alias="PRD" name="salesDiscontinuationDate"/>
        <alias entity-alias="PRD" name="pseudoId"/>
        <alias entity-alias="PRD" name="productTypeEnumId"/>
        <alias entity-alias="PRD" name="listPrice" field="mrpAmount"/>
    </view-entity>

</entities>
