<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Generic Product Extensions ========== -->
    <extend-entity entity-name="Product" package="mantle.product">
        <field name="printName" type="text-medium"><description>Optional bill name; blank follows productName for future bill items.</description></field>
        <field name="mrpAmount" type="currency-amount"><description>Maximum Retail Price</description></field>
        <field name="productTaxCode" type="text-short"><description>Tax classification code (HSN, tax category, etc.)</description></field>
        <field name="taxCategoryId" type="id"><description>Reference to tax category for rate lookup</description></field>
        <field name="isTaxExempt" type="text-indicator"/>
        <field name="enableBatchTracking" type="text-indicator"/>
        <field name="enableSerialTracking" type="text-indicator"/>
        <field name="defaultShelfLifeDays" type="number-integer"/>
        <field name="reorderPoint" type="number-decimal"/>
        <field name="reorderQuantity" type="number-decimal"/>
        <field name="minimumStockLevel" type="number-decimal"/>
        <field name="maximumStockLevel" type="number-decimal"/>
        <field name="expiryDate" type="date"><description>Product-level expiry date for perishable goods</description></field>
        <field name="isPerishable" type="text-indicator"><description>Y = perishable (has an expiry date); surfaced in the Wastage module</description></field>
        <field name="inventoryTracked" type="text-indicator"><description>Y = stock tracked/depleted for this item (set when an opening count is entered)</description></field>
    </extend-entity>

    <!-- Images are separate so catalogue/POS product queries do not load binary data. -->
    <entity entity-name="ProductEditorImage" package="zenith.erp.inventory" cache="never">
        <field name="productId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="imageData" type="text-very-long"/>
        <relationship type="one" related="mantle.product.Product"/>
    </entity>

    <!-- ========== Generic Asset Extensions (Batch/Lot Tracking) ========== -->
    <extend-entity entity-name="Asset" package="mantle.product.asset">
        <field name="batchNumber" type="text-short"/>
        <field name="expiryDate" type="date"/>
        <field name="manufacturingDate" type="date"/>
        <field name="mrpAmount" type="currency-amount"/>
        <field name="valuationRate" type="currency-amount"/>
    </extend-entity>

    <!-- ========== Generic Facility Extensions ========== -->
    <extend-entity entity-name="Facility" package="mantle.facility">
        <field name="taxRegistrationNumber" type="text-short"/>
        <field name="countryGeoId" type="id"/>
        <field name="regionGeoId" type="id"/>
        <field name="postalCode" type="text-short"/>
    </extend-entity>

    <!-- ========== Stock Transfer ========== -->
    <entity entity-name="StockTransfer" package="zenith.erp.inventory">
        <field name="stockTransferId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="fromFacilityId" type="id"/>
        <field name="toFacilityId" type="id"/>
        <field name="transferDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <field name="transferNumber" type="text-short"/>
        <field name="remarks" type="text-medium"/>
        <field name="totalValue" type="currency-amount"/>
        <field name="ewayBillRequired" type="text-indicator"/>
        <field name="lrNumber" type="text-short"/>
        <field name="vehicleNumber" type="text-short"/>
        <field name="igstInvoiceId" type="id"/>
        <field name="transporterGstin" type="text-short"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" title="From" related="mantle.facility.Facility">
            <key-map field-name="fromFacilityId" related="facilityId"/></relationship>
        <relationship type="one" title="To" related="mantle.facility.Facility">
            <key-map field-name="toFacilityId" related="facilityId"/></relationship>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="StockTransfer" description="Stock Transfer"/>
            <moqui.basic.StatusItem statusId="StxDraft" statusTypeId="StockTransfer" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="StxInTransit" statusTypeId="StockTransfer" description="In Transit" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="StxReceived" statusTypeId="StockTransfer" description="Received" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="StxCancelled" statusTypeId="StockTransfer" description="Cancelled" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="StxDraft" toStatusId="StxInTransit" transitionName="Ship"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="StxInTransit" toStatusId="StxReceived" transitionName="Receive"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="StxDraft" toStatusId="StxCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <entity entity-name="StockTransferItem" package="zenith.erp.inventory">
        <field name="stockTransferId" type="id" is-pk="true"/>
        <field name="transferItemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="quantity" type="number-decimal"/>
        <field name="quantityReceived" type="number-decimal"/>
        <field name="unitAmount" type="currency-amount"/>
        <field name="productTaxCode" type="text-short"/>
        <field name="batchNumber" type="text-short"/>
        <field name="fromAssetId" type="id"/>
        <relationship type="one" related="zenith.erp.inventory.StockTransfer"/>
        <relationship type="one" related="mantle.product.Product"/>
        <relationship type="one" title="From" related="mantle.product.asset.Asset">
            <key-map field-name="fromAssetId" related="assetId"/></relationship>
    </entity>

    <!-- The specific serial units a transfer line moves (serial-tracked products). Ship records available units when none were picked.
         Partial receiving marks exactly which recorded serials arrived. -->
    <entity entity-name="StockTransferItemSerial" package="zenith.erp.inventory">
        <field name="stockTransferId" type="id" is-pk="true"/>
        <field name="transferItemSeqId" type="id" is-pk="true"/>
        <field name="serialNumberId" type="id" is-pk="true"/>
        <field name="serialNumber" type="text-short"/>
        <field name="received" type="text-indicator"><description>Y/N after confirming a partial serialized receipt; null means full receipt.</description></field>
        <relationship type="one" related="zenith.erp.inventory.StockTransferItem">
            <key-map field-name="stockTransferId"/><key-map field-name="transferItemSeqId"/></relationship>
        <relationship type="one" related="zenith.erp.inventory.ProductSerialNumber">
            <key-map field-name="serialNumberId"/></relationship>
    </entity>

    <!-- ========== Stock Adjustment ========== -->
    <entity entity-name="StockAdjustment" package="zenith.erp.inventory">
        <field name="organizationPartyId" type="id"/>
        <field name="stockAdjustmentId" type="id" is-pk="true"/>
        <field name="facilityId" type="id"/>
        <field name="adjustmentDate" type="date-time"/>
        <field name="adjustmentType" type="text-short"><description>PhysicalCount, Damage, Expiry, WriteOff, Opening</description></field>
        <field name="statusId" type="id"/>
        <field name="remarks" type="text-medium"/>
        <field name="adjustedBy" type="id"/>
        <relationship type="one" related="mantle.facility.Facility"/>
        <relationship type="one" title="AdjustedBy" related="moqui.security.UserAccount">
            <key-map field-name="adjustedBy" related="userId"/></relationship>
    </entity>

    <entity entity-name="StockAdjustmentItem" package="zenith.erp.inventory">
        <field name="stockAdjustmentId" type="id" is-pk="true"/>
        <field name="adjustmentItemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="assetId" type="id"/>
        <field name="systemQuantity" type="number-decimal"/>
        <field name="actualQuantity" type="number-decimal"/>
        <field name="differenceQuantity" type="number-decimal"/>
        <field name="valuationRate" type="currency-amount"/>
        <field name="stockSnapshot" type="text-very-long"><description>Asset quantities and identities captured at count time; prevents stale counts.</description></field>
        <field name="serialSnapshot" type="text-very-long"><description>Existing serial states and the explicitly counted identities.</description></field>
        <field name="remarks" type="text-medium"/>
        <relationship type="one" related="zenith.erp.inventory.StockAdjustment"/>
        <relationship type="one" related="mantle.product.Product"/>
        <relationship type="one" related="mantle.product.asset.Asset"/>
    </entity>

    <!-- ========== Gate Pass ========== -->
    <entity entity-name="GatePass" package="zenith.erp.inventory">
        <field name="organizationPartyId" type="id"/>
        <field name="gatePassId" type="id" is-pk="true"/>
        <field name="passTypeEnumId" type="id"><description>RGP (Returnable) or NRGP (Non-Returnable)</description></field>
        <field name="facilityId" type="id"/>
        <field name="partyId" type="id"/>
        <field name="issueDate" type="date-time"/>
        <field name="expectedReturnDate" type="date-time"/>
        <field name="actualReturnDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <field name="vehicleNumber" type="text-short"/>
        <field name="transporterName" type="text-medium"/>
        <field name="remarks" type="text-medium"/>
        <field name="issuedBy" type="id"/>
        <relationship type="one" related="mantle.facility.Facility"/>
        <relationship type="one" related="mantle.party.Party"/>
        <relationship type="one" title="IssuedBy" related="moqui.security.UserAccount">
            <key-map field-name="issuedBy" related="userId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType description="Gate Pass Type" enumTypeId="GatePassType"/>
            <moqui.basic.Enumeration description="Returnable Gate Pass (RGP)" enumId="GptRgp" enumTypeId="GatePassType"/>
            <moqui.basic.Enumeration description="Non-Returnable Gate Pass (NRGP)" enumId="GptNrgp" enumTypeId="GatePassType"/>
            <moqui.basic.StatusType statusTypeId="GatePass" description="Gate Pass Status"/>
            <moqui.basic.StatusItem statusId="GpIssued" statusTypeId="GatePass" description="Issued" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="GpReturned" statusTypeId="GatePass" description="Returned" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="GpOverdue" statusTypeId="GatePass" description="Overdue" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="GpClosed" statusTypeId="GatePass" description="Closed" sequenceNum="4"/>
        </seed-data>
    </entity>

    <entity entity-name="GatePassItem" package="zenith.erp.inventory">
        <field name="gatePassId" type="id" is-pk="true"/>
        <field name="gatePassItemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="assetId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="quantity" type="number-decimal"/>
        <field name="returnedQuantity" type="number-decimal"/>
        <field name="uomId" type="id"/>
        <field name="remarks" type="text-medium"/>
        <relationship type="one" related="zenith.erp.inventory.GatePass"/>
        <relationship type="one" related="mantle.product.Product"/>
        <relationship type="one" related="mantle.product.asset.Asset"/>
    </entity>

    <!-- ========== Reorder Rule ========== -->
    <entity entity-name="ReorderRule" package="zenith.erp.inventory">
        <field name="reorderRuleId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="reorderPoint" type="number-decimal"/>
        <field name="reorderQuantity" type="number-decimal"/>
        <field name="minimumStockLevel" type="number-decimal"/>
        <field name="maximumStockLevel" type="number-decimal"/>
        <field name="preferredSupplierId" type="id"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="mantle.product.Product"/>
        <relationship type="one" related="mantle.facility.Facility"/>
        <relationship type="one" title="PreferredSupplier" related="mantle.party.Party">
            <key-map field-name="preferredSupplierId" related="partyId"/></relationship>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="ProductStockView" package="zenith.erp.inventory">
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="PRD" join-optional="true">
            <key-map field-name="productId"/></member-entity>
        <!-- ZE-INV-IV-013 f/u: LEFT-join the GST slab so the catalog can show the friendly GST rate instead of
             the raw slab id. join-optional so products with no slab still list. -->
        <member-entity entity-alias="SLB" entity-name="zenith.erp.india.IndiaGstSlab" join-from-alias="PRD" join-optional="true">
            <key-map field-name="gstSlabId"/></member-entity>
        <alias entity-alias="PRD" name="productId"/>
        <alias entity-alias="PRD" name="ownerPartyId"/>
        <alias entity-alias="PRD" name="pseudoId"/>
        <alias entity-alias="PRD" name="productName"/>
        <alias entity-alias="PRD" name="productTypeEnumId"/>
        <alias entity-alias="PRD" name="productTaxCode"/>
        <alias entity-alias="PRD" name="mrpAmount"/>
        <alias entity-alias="PRD" name="description"/>
        <!-- ZE-INV-IV-013: the Product Catalog "Tax Code" column reads hsnCode/sacCode (India ext fields);
             they were missing from this view so the column always showed "-" even when the product had them. -->
        <alias entity-alias="PRD" name="hsnCode"/>
        <alias entity-alias="PRD" name="sacCode"/>
        <alias entity-alias="PRD" name="isTaxExempt"/>
        <!-- ZE-INV-IV-013 f/u: catalog columns that were silently blank — UQC (uqcEnumId), Tax-free
             (isGstExempt; the catalog reads THIS, not the aliased-but-unused isTaxExempt), and the GST
             rate/name from the joined slab (shown in place of the raw Gst Slab ID). -->
        <alias entity-alias="PRD" name="uqcEnumId"/>
        <alias entity-alias="PRD" name="isGstExempt"/>
        <alias entity-alias="PRD" name="gstSlabId"/>
        <alias entity-alias="SLB" name="gstRate"/>
        <alias entity-alias="SLB" name="slabName"/>
        <alias entity-alias="PRD" name="enableBatchTracking"/>
        <alias entity-alias="PRD" name="reorderPoint"/>
        <alias entity-alias="AST" name="totalQoh" field="quantityOnHandTotal" function="sum"/>
        <alias entity-alias="AST" name="totalAtp" field="availableToPromiseTotal" function="sum"/>
    </view-entity>

    <!-- Catalog stock includes owned and legacy unowned inventory lots, excluding other owners and fixed assets.
         Filter in a nested view so the outer LEFT JOIN still lists products that have no eligible stock. -->
    <view-entity entity-name="ProductCatalogInventoryAsset" package="zenith.erp.inventory">
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset"/>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="AST"><key-map field-name="productId"/></member-entity>
        <alias entity-alias="AST" name="productId"/>
        <alias entity-alias="AST" name="assetOwnerPartyId" field="ownerPartyId"/>
        <alias entity-alias="PRD" name="ownerPartyId"/>
        <alias entity-alias="PRD" name="productOwnerPartyId" field="ownerPartyId"/>
        <alias entity-alias="AST" name="assetTypeEnumId"/>
        <alias entity-alias="AST" name="quantityOnHandTotal" function="sum"/>
        <alias entity-alias="AST" name="availableToPromiseTotal" function="sum"/>
        <entity-condition><econditions>
            <econdition field-name="assetTypeEnumId" value="AstTpInventory"/>
            <econditions combine="or">
                <econdition field-name="assetOwnerPartyId" operator="is-null"/>
                <econdition field-name="assetOwnerPartyId" to-field-name="productOwnerPartyId"/>
            </econditions>
        </econditions></entity-condition>
    </view-entity>
    <view-entity entity-name="ProductCatalogStockView" package="zenith.erp.inventory">
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product"/>
        <member-entity entity-alias="AST" entity-name="zenith.erp.inventory.ProductCatalogInventoryAsset" join-from-alias="PRD" join-optional="true" sub-select="non-lateral"><key-map field-name="productId"/></member-entity>
        <member-entity entity-alias="SLB" entity-name="zenith.erp.india.IndiaGstSlab" join-from-alias="PRD" join-optional="true"><key-map field-name="gstSlabId"/></member-entity>
        <alias entity-alias="PRD" name="productId"/><alias entity-alias="PRD" name="ownerPartyId"/>
        <alias entity-alias="PRD" name="pseudoId"/><alias entity-alias="PRD" name="productName"/>
        <alias entity-alias="PRD" name="productTypeEnumId"/><alias entity-alias="PRD" name="description"/>
        <alias entity-alias="PRD" name="hsnCode"/><alias entity-alias="PRD" name="sacCode"/>
        <alias name="catalogTaxCode" type="text-short"><complex-alias function="COALESCE">
            <complex-alias-field entity-alias="PRD" field="hsnCode"/><complex-alias-field entity-alias="PRD" field="sacCode"/>
        </complex-alias></alias>
        <alias entity-alias="PRD" name="isGstExempt"/><alias entity-alias="PRD" name="uqcEnumId"/>
        <alias entity-alias="PRD" name="gstSlabId"/><alias entity-alias="SLB" name="gstRate"/>
        <alias entity-alias="PRD" name="mrpAmount"/><alias entity-alias="PRD" name="reorderPoint"/>
        <alias entity-alias="PRD" name="enableBatchTracking"/>
        <!-- The sub-select's field comparison needs these aliases in the parent definition. -->
        <alias entity-alias="AST" name="assetOwnerPartyId"/>
        <alias entity-alias="AST" name="productOwnerPartyId"/>
        <alias name="totalQoh" field="quantityOnHandTotal" type="number-decimal"><complex-alias><complex-alias-field entity-alias="AST" field="quantityOnHandTotal" default-value="0"/></complex-alias></alias>
        <alias name="totalAtp" field="availableToPromiseTotal" type="number-decimal"><complex-alias><complex-alias-field entity-alias="AST" field="availableToPromiseTotal" default-value="0"/></complex-alias></alias>
    </view-entity>

    <view-entity entity-name="StockByFacilityView" package="zenith.erp.inventory">
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset"/>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="AST">
            <key-map field-name="productId"/></member-entity>
        <!-- ZE-INV-002 (IV-002): LEFT-join Facility so stock with NO facility yet (an org with no warehouse,
             or opening stock created before any facility existed) STILL shows in Stock Levels / EditProduct
             instead of vanishing. Such stock IS shown in the Product Catalog (ProductStockView is
             join-optional), so the by-facility view must agree or the two modules contradict each other.
             facilityName is null for those rows; the screens render it as "— No store —". EditFacility is
             unaffected (it filters by a specific facilityId, which a null row never matches). -->
        <member-entity entity-alias="FAC" entity-name="mantle.facility.Facility" join-from-alias="AST" join-optional="true">
            <key-map field-name="facilityId"/></member-entity>
        <alias entity-alias="PRD" name="ownerPartyId"/>
        <!-- ZE-INV-IV-033 f/u: member-sourced ownerPartyId alias so the ZTF_ASSET org-isolation entity filter
             (which filters Asset by ownerPartyId) can MAP to this view instead of erroring on every query
             ("field ownerPartyId not included in view-entity"). AST is the INNER/base member (always present),
             and asset owner == product owner, so this is redundant with the PRD.ownerPartyId isolation — no
             result change, no facility-less-stock drop, just kills the ZTF_ASSET error spam. NB: NOT adding a
             FAC alias — FAC is LEFT-joined, so a ZTF_FACILITY condition would exclude facility-less stock
             (ZE-INV-002 regression); that filter stays a harmless logged-and-skipped no-op for this view. -->
        <alias entity-alias="AST" name="assetOwnerPartyId" field="ownerPartyId"/>
        <alias entity-alias="AST" name="assetTypeEnumId"/>
        <alias entity-alias="AST" name="productId"/>
        <alias entity-alias="AST" name="facilityId"/>
        <alias entity-alias="AST" name="lotId"/>
        <alias entity-alias="PRD" name="pseudoId"/>
        <alias entity-alias="PRD" name="productName"/>
        <alias entity-alias="PRD" name="productTaxCode"/>
        <alias entity-alias="PRD" name="hsnCode"/>
        <alias entity-alias="PRD" name="mrpAmount" field="mrpAmount"/>
        <alias entity-alias="FAC" name="facilityName"/>
        <alias entity-alias="AST" name="totalQoh" field="quantityOnHandTotal" function="sum"/>
        <alias entity-alias="AST" name="totalAtp" field="availableToPromiseTotal" function="sum"/>
        <!-- ZE-INV-001 f/u: intentionally NO totalValue alias. Stock value in this app uses the
             valuationRate -> acquireCost -> product-MRP fallback, which a grouped view CANNOT express
             (no per-asset COALESCE across an aggregate). The old sum(acquireCost) was doubly wrong:
             0 for MRP-priced stock (cost unset) AND sum-of-unit-costs, not sum(qty*cost). Compute stock
             value from Assets in the screen instead (see StockLevels / EditProduct / EditFacility). -->
        <!-- acquireCost still available per-row via the base entity if a cost-basis metric is ever needed. -->
        <!-- XF-001: newest change time for this SKU@store, so the Stock Levels screen can flag
             recently-updated stock. Aggregate (max) → does not affect the group-by / row shape. -->
        <alias entity-alias="AST" name="lastUpdated" field="lastUpdatedStamp" function="max"/>
    </view-entity>

    <!-- ========== Inventory Valuation ========== -->
    <entity entity-name="InventoryValuation" package="zenith.erp.inventory" short-alias="InventoryValuation">
        <field name="valuationId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="valuationMethodEnumId" type="id"/>
        <field name="currentCost" type="currency-amount"/>
        <field name="totalQuantity" type="number-decimal"/>
        <field name="totalValue" type="currency-amount"/>
        <field name="lastCalculatedDate" type="date-time"/>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
        <relationship type="one" related="mantle.facility.Facility" short-alias="facility"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="ValuationMethod" description="Inventory Valuation Method"/>
            <moqui.basic.Enumeration enumId="VmFifo" enumTypeId="ValuationMethod" description="FIFO" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="VmLifo" enumTypeId="ValuationMethod" description="LIFO" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="VmWeightedAvg" enumTypeId="ValuationMethod" description="Weighted Average" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="VmSpecificId" enumTypeId="ValuationMethod" description="Specific Identification" sequenceNum="4"/>
        </seed-data>
    </entity>

    <!-- ========== Demand Forecast ========== -->
    <entity entity-name="DemandForecast" package="zenith.erp.inventory" short-alias="DemandForecast">
        <field name="forecastId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="periodStart" type="date"/>
        <field name="periodEnd" type="date"/>
        <field name="forecastQuantity" type="number-decimal"/>
        <field name="actualQuantity" type="number-decimal"/>
        <field name="forecastMethodEnumId" type="id"/>
        <field name="accuracyPercent" type="number-decimal"/>
        <!-- ZE-DF-005 (IV-111): reorder inputs persisted so the lightweight intraday cycle#ReorderCheck can
             re-check stock vs reorder point WITHOUT recomputing the (expensive) forecast. Written by cycle#DemandForecast. -->
        <field name="reorderPoint" type="number-decimal"/>
        <field name="safetyStock" type="number-decimal"/>
        <field name="suggestedOrderQty" type="number-decimal"/>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
        <relationship type="one" related="mantle.facility.Facility" short-alias="facility"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="ForecastMethod" description="Demand Forecast Method"/>
            <moqui.basic.Enumeration enumId="FmMovingAvg" enumTypeId="ForecastMethod" description="Moving Average" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="FmExponential" enumTypeId="ForecastMethod" description="Exponential Smoothing" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="FmManual" enumTypeId="ForecastMethod" description="Manual" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="FmSeasonal" enumTypeId="ForecastMethod" description="Seasonal" sequenceNum="4"/>
        </seed-data>
    </entity>

    <!-- ========== ABC Classification ========== -->
    <entity entity-name="AbcClassification" package="zenith.erp.inventory" short-alias="AbcClassification">
        <field name="classificationId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="classCode" type="text-short"/>
        <field name="annualSalesValue" type="currency-amount"/>
        <field name="annualQuantitySold" type="number-decimal"/>
        <field name="cumulativePercent" type="number-decimal"/>
        <field name="classifiedDate" type="date-time"/>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
        <relationship type="one" related="mantle.facility.Facility" short-alias="facility"/>
    </entity>

    <!-- ========== Product Variant ========== -->
    <entity entity-name="ProductVariant" package="zenith.erp.inventory" short-alias="ProductVariant">
        <field name="variantId" type="id" is-pk="true"/>
        <field name="variantGroupId" type="id"/>
        <field name="productId" type="id"/>
        <field name="attributeName" type="text-medium"/>
        <field name="attributeValue" type="text-medium"/>
