            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SnInStock" toStatusId="SnDefective" transitionName="Mark Defective"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SnDefective" toStatusId="SnScrapped" transitionName="Scrap"/>
