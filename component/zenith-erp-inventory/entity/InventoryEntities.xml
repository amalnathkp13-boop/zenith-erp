    <!-- ZE-INV-008 (IV-107): scheduled job for Expiry Risk notifications -->
    <entity entity-name="InventoryJobSeed" package="zenith.erp.inventory" short-alias="InventoryJobSeed">
        <description>Placeholder entity for inventory scheduled job seed data</description>
        <field name="seedId" type="id" is-pk="true"/>
        <seed-data>
            <!-- Persist and calibrate demand predictions nightly; the dashboard's automatic-update promise
                 must have a registered job as well as the manual Update Now transition. -->
            <moqui.service.job.ServiceJob jobName="zenith_DemandForecast_cycle"
                description="Nightly demand predictions and calibration for active tenants"
                serviceName="zenith.inventory.AdvancedForecastServices.cycle#DemandForecast"
                cronExpression="0 30 1 * * ?" paused="N"/>
            <!-- Daily at 6:30 AM: raise in-app expiry alerts per tenant -->
            <moqui.service.job.ServiceJob jobName="zenith_ExpiryAlerts_daily"
                description="Notify tenants about products nearing expiry (Expiry Risk alerts)"
                serviceName="zenith.inventory.InventoryAlertServices.send#ExpiryAlerts"
                cronExpression="0 30 6 * * ?" paused="N"/>
            <!-- persist + pop the in-app alert (like DemandAlert) -->
            <moqui.security.user.NotificationTopic topic="ExpiryAlert"
                description="Products nearing expiry" persistOnSend="Y" showAlert="Y"/>
            <!-- ZE-DF-005 (IV-111): lightweight reorder re-check so a same-day dip -> stockout escalates automatically
                 between the daily 01:30 forecast runs (no forecast recompute; reads stored reorder point).
                 ZE-DF-007: cron fires hourly 24/7, but cycle#ReorderCheck only checks each tenant when the current
                 hour (IST) is inside ITS OWN business hours (per-tenant REORDER_OPEN_HOUR/CLOSE_HOUR, default 08:00-22:00)
                 -> <=1h catch while each shop is open, no work for a closed tenant. Hours are set per tenant in-app. -->
            <moqui.service.job.ServiceJob jobName="zenith_ReorderCheck_cycle"
                description="Intraday reorder re-check for same-day stock escalation (all tenants), hourly within each tenant's business hours (IST)"
                serviceName="zenith.inventory.AdvancedForecastServices.cycle#ReorderCheck"
                cronExpression="0 0 * * * ?" paused="N"/>
        </seed-data>
    </entity>

</entities>
