<#macro field key title required=false wide=false>
<label class="<#if wide>pe-wide</#if>">${title}<#if required> <b>*</b></#if><input name="${key}" value="${(product[key]!'')?html}" <#if required>required</#if> maxlength="${(key=='pseudoId')?then(100,255)?c}"/></label>
</#macro>
<#macro choice key title values labels>
<label>${title}<select name="${key}"><#if product[key]?has_content && !values?seq_contains(product[key])><option value="${product[key]?html}" selected>Current: ${product[key]?html}</option></#if><#list values as v><option value="${v}" <#if (product[key]!'N')==v>selected</#if>>${labels[v_index]}</option></#list></select></label>
</#macro>
<div id="productEditor">
<img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" hidden onload="if(!document.getElementById('productEditorCss')){var l=document.createElement('link');l.id='productEditorCss';l.rel='stylesheet';l.href='/zenithstatic/css/product-editor.css?v=1';document.head.appendChild(l)}if(!window.initProductEditor){var j=document.createElement('script');j.src='/zenithstatic/js/product-editor.js?v=1';document.head.appendChild(j)}else{window.initProductEditor()}"/>
<div class="pe-header"><div><p>Inventory / Products / Edit Product</p><h1>Edit Product</h1><p>Update product details, pricing, tax and inventory settings.</p></div><div class="pe-actions"><a class="pe-button" data-pe-leave href="${sri.buildUrl('../FindProduct').url?html}">← Back to Products</a><#if invCanWrite><button type="button" class="pe-danger" data-pe-delete>Delete Product</button><button class="pe-primary" form="productEditorForm" type="submit">▣ Save Changes</button></#if></div></div>
<form id="productEditorForm" method="post" action="${sri.buildUrl('updateProduct').url?html}">
<input type="hidden" name="moquiSessionToken" value="${(ec.web.sessionToken!'')?html}"/><input type="hidden" name="productId" value="${productId?html}"/>
<input type="hidden" name="imageData"/><input type="hidden" name="removeImage" value="N"/>
<div class="pe-workspace"><main>
<nav class="pe-tabs" aria-label="Product settings"><a href="#pe-identity" aria-current="true">Basic Info</a><a href="#pe-pricing">Pricing &amp; Tax</a><a href="#pe-inventory">Inventory</a><a href="#pe-barcode">Barcode &amp; Printing</a><a href="#pe-additional">Additional Details</a></nav>
<fieldset <#if !invCanWrite>disabled</#if>>
<section class="pe-card" id="pe-identity"><header><i class="material-icons">layers</i><div><h2>Product Identity</h2><p>Basic details about this product.</p></div></header><div class="pe-fields">
<@field key="productName" title="Product Name" required=true/>
<label>Print Name (on bills)<input name="printName" value="${(product.printName!product.productName!'')?html}" maxlength="255" data-custom="${product.printName?has_content?then('true','false')}"/><small>Defaults to Product Name. Change it for a different name on new POS bills.</small><button type="button" class="pe-text" data-pe-reset-name>Use Product Name</button></label>
<div id="pe-barcode"><@field key="pseudoId" title="Item Code / Barcode"/></div>
<@choice key="productTypeEnumId" title="Product Type" values=['PtAsset','PtService','PtDigitalAsset'] labels=['Physical product (stock & count)','Service (no stock)','Digital product']/>
<label class="pe-wide">Description<textarea name="description" maxlength="500" rows="3" placeholder="Enter product description (optional)...">${(product.description!'')?html}</textarea><small class="pe-count" data-pe-count></small></label>
</div></section>
<section class="pe-card" id="pe-pricing"><header><i class="material-icons pe-orange">sell</i><div><h2>Pricing &amp; Tax</h2><p>Set selling price and applicable tax details.</p></div></header><div class="pe-fields pe-four">
<@choice key="uqcEnumId" title="Unit (how you sell it)" values=['','NOS','KGS','MTR','PCS','LTR'] labels=['Not set','Numbers (Nos)','Kilogram (Kg)','Metre (M)','Pieces (Pcs)','Litre (L)']/>
<label>Selling Price (MRP)<input name="mrpAmount" type="number" min="0" step="any" value="<#if product.mrpAmount?has_content>${product.mrpAmount?c}</#if>"/></label>
<label>GST Tax Rate<select name="gstSlabId"><option value="">Not set</option><#list gstSlabs as slab><option value="${slab.gstSlabId?html}" <#if (product.gstSlabId!'')==slab.gstSlabId>selected</#if>>${slab.slabName?html} (${slab.gstRate?c}%)</option></#list></select></label>
<@choice key="isGstExempt" title="Tax-free item?" values=['N','Y'] labels=['No (Taxable)','Yes (Exempt)']/>
<div class="pe-info pe-wide"><strong>ⓘ Tax Information</strong><p>Choose the applicable GST rate. HSN / SAC classification is entered separately; a tax rate does not determine the classification code.</p></div>
<@field key="hsnCode" title="Tax Code — HSN (for products)"/><@field key="sacCode" title="Tax Code — SAC (for services)"/>
</div></section>
<section class="pe-card" id="pe-inventory"><header><i class="material-icons pe-green">inventory_2</i><div><h2>Inventory Tracking</h2><p>Choose how this product's inventory will be tracked.</p></div></header><div class="pe-fields pe-three">
<@choice key="enableBatchTracking" title="Track by batch / lot?" values=['N','Y'] labels=['No','Yes']/><@choice key="enableSerialTracking" title="Track by serial number?" values=['N','Y'] labels=['No','Yes']/>
<label>Reorder Point (low-stock alert)<input name="reorderPoint" type="number" min="0" step="any" value="<#if product.reorderPoint?has_content>${product.reorderPoint?c}</#if>"/><small>Leave blank for no low-stock alert.</small></label>
</div></section>
<section class="pe-card" id="pe-additional"><header><i class="material-icons">info</i><div><h2>Additional Details</h2><p>Changes apply to future sales. Existing issued bills keep their saved name and price.</p></div></header><label>Internal Notes<textarea name="comments" maxlength="2000" rows="3">${(product.comments!'')?html}</textarea><small>Internal product notes; these are not printed on customer bills.</small></label><p>To set stock quantities, use the Receiving or Stock Adjustments workflow.</p></section>
</fieldset></main><aside>
<section class="pe-card"><header><i class="material-icons pe-blue">image</i><div><h2>Product Image (Optional)</h2><p>Upload a product image for easy identification.</p></div></header><div class="pe-image-layout"><label class="pe-drop" tabindex="0" data-pe-drop><i class="material-icons">add_photo_alternate</i><strong>Drag and drop an image here</strong><span>or click to upload</span><small>Supports JPG, PNG (Max 2 MB)</small><input type="file" accept="image/png,image/jpeg" data-pe-file <#if !invCanWrite>disabled</#if>/></label><div class="pe-image-preview"><img alt="Product image" data-pe-image <#if productImage?has_content>src="${productImage.imageData?html}"<#else>hidden</#if>/><button type="button" class="pe-danger" aria-label="Remove product image" data-pe-remove-image <#if !invCanWrite>disabled</#if>>×</button><span data-pe-no-image <#if productImage?has_content>hidden</#if>>No image</span></div></div><p role="status" data-pe-image-status></p></section>
<section class="pe-card"><header><i class="material-icons">description</i><h2>Product Summary</h2></header><dl class="pe-summary"><#list [['pseudoId','Item Code'],['productName','Product Name'],['printName','Print Name'],['uqcEnumId','Unit'],['mrpAmount','Selling Price (MRP)'],['gstSlabId','GST Tax Rate'],['isGstExempt','Tax-free Item'],['hsnCode','HSN Code'],['sacCode','SAC Code'],['productTypeEnumId','Product Type']] as row><div><dt>${row[1]}</dt><dd data-pe-summary="${row[0]}"><#if row[0]=='printName'>${(product.printName!product.productName!'')?html}<#else>${(product[row[0]]!'—')?html}</#if></dd></div></#list></dl></section>
<section class="pe-card"><header><i class="material-icons">store</i><h2>Stock by Store / Warehouse</h2><a class="pe-button" href="${sri.buildUrl('../StockLevels').url?html}">View All</a></header><div class="pe-table-scroll"><table><thead><tr><th>Store / Warehouse</th><th>Quantity on Hand</th><th>Free to Sell</th><th>Stock Value (₹)</th></tr></thead><tbody><#list stockList as stock><tr><td>${(stock.facilityName!'No store')?html}</td><td>${stock.totalQoh!0}</td><td>${stock.totalAtp!0}</td><td>${ec.l10n.format(stockValueByRow[(stock.facilityId!'')+'|'+(stock.lotId!'')]!0,'#,##0.00')}</td></tr><#else><tr><td colspan="4">No stock records for this product.</td></tr></#list></tbody><tfoot><tr><th>Total</th><th>${totalQoh}</th><th>${totalAtp}</th><th>${ec.l10n.format(totalStockValue,'#,##0.00')}</th></tr></tfoot></table></div></section>
<section class="pe-card" id="pe-history"><header><i class="material-icons">history</i><h2>Price History</h2></header><div class="pe-table-scroll pe-history"><table><thead><tr><th>Old Price (₹)</th><th>New Price (₹)</th><th>Updated On</th><th>Updated By</th></tr></thead><tbody><#list priceHistory as row><tr><td>${ec.l10n.format(row.previousPrice!0,'#,##0.00')}</td><td>${ec.l10n.format(row.newPrice!0,'#,##0.00')}</td><td>${ec.l10n.format(row.changeDate,'dd-MM-yyyy HH:mm')}</td><td>${(row.changedByUserId!'')?html}</td></tr><#else><tr><td colspan="4">No price changes recorded yet.</td></tr></#list></tbody></table></div></section>
</aside></div>
<div class="pe-savebar"><span role="status" data-pe-status><#if !invCanWrite>View-only access — changes are disabled.</#if></span><a class="pe-button" data-pe-leave href="${sri.buildUrl('../FindProduct').url?html}">Cancel</a><#if invCanWrite><button type="submit" class="pe-primary">Save Changes</button></#if></div>
</form>
<#if invCanWrite><form id="productDeleteForm" method="post" action="${sri.buildUrl('deleteProduct').url?html}"><input type="hidden" name="moquiSessionToken" value="${(ec.web.sessionToken!'')?html}"/><input type="hidden" name="productId" value="${productId?html}"/></form></#if>
</div>
