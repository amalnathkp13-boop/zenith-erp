<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Warehouses &amp; Facilities" default-menu-index="2" default-menu-include="true">

    <transition name="editFacility"><default-response url="../EditFacility"/></transition>
    
    <transition name="createFacility">
        <service-call name="create#mantle.facility.Facility" out-map="createOut"
                      in-map="[facilityName:facilityName, facilityTypeEnumId:facilityTypeEnumId, gstStateCode:gstStateCode, facilityGstin:facilityGstin, postalCode:postalCode, ownerPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION')]"/>
        <default-response url="../EditFacility">
            <parameter name="facilityId" value="${createOut.facilityId}"/>
        </default-response>
    </transition>

    <actions>
        <script><![CDATA[
            facilityOrgId = ec.user.getPreference('ACTIVE_ORGANIZATION')
            if (!facilityOrgId || facilityOrgId == '_NA_') facilityOrgId = '__NO_ORGANIZATION__'
            def facilities = ec.entity.find('mantle.facility.Facility').condition('ownerPartyId',facilityOrgId).orderBy('facilityName,facilityId').list()
            def types = ec.entity.find('moqui.basic.Enumeration').condition('enumTypeId','FacilityType').list().collectEntries { [(it.enumId):it.description] }
            def statuses = ec.entity.find('moqui.basic.StatusItem').condition('statusTypeId','Facility').list().collectEntries { [(it.statusId):it.description] }
            def now = ec.user.nowTimestamp
            facilityRows = facilities.collect { f ->
                def operating = (!f.openedDate || f.openedDate <= now) && (!f.closedDate || f.closedDate > now)
                def status = statuses[f.statusId] ?: (operating ? 'Active' : 'Inactive')
                def active = operating && status.equalsIgnoreCase('Active')
                [id:f.facilityId, name:f.facilityName ?: f.facilityId, type:types[f.facilityTypeEnumId] ?: f.facilityTypeEnumId ?: 'Other',
                 typeId:f.facilityTypeEnumId ?: '', state:f.gstStateCode ?: '', gstin:f.facilityGstin ?: '',
                 description:f.description ?: '', pincode:f.postalCode ?: '', status:status, active:active]
            }
            facilityTotal = facilityRows.size()
            facilityActive = facilityRows.count { it.active }
            facilityRetail = facilityRows.count { it.typeId == 'FcTpRetailStore' }
            facilityWarehouses = facilityRows.count { it.typeId == 'FcTpWarehouse' }
            facilityViewKey = 'zenith.facility.views.v1.' + ec.user.userId + '.' + facilityOrgId
            facilityInitialSearch = (ec.web.parameters.facilitySearch ?: ec.web.parameters.facilityName ?: '').toString()
        ]]></script>
    </actions>

    <widgets>
<container id="warehouseFacilities" style="wf-page">
<render-mode><text type="html,qvt" template="true"><![CDATA[
<#assign warehouseSvg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-6 9 6v12h-6v-8H9v8H3Z"/><path d="M7 9h10M9 17h6M11 21h2"/></svg></#assign>
<#assign storeSvg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10v11h16V10M3 4h18l1 6a3 3 0 0 1-5 2 3 3 0 0 1-5 0 3 3 0 0 1-5 0 3 3 0 0 1-5-2Zm0 3h18"/></svg></#assign>
<span class="wf-config" data-view-key="${facilityViewKey?html}" hidden></span>
  <header class="wf-heading">
    <div class="wf-heading-left"><span class="wf-page-icon">${warehouseSvg}</span><div><h1>Warehouses &amp; Facilities</h1><p>Your stores, warehouses and other places where you keep stock.</p></div></div>
    <div class="wf-new-slot"></div>
  </header>
  <section class="wf-kpis" aria-label="Facility summary">
    <article class="wf-kpi"><span class="wf-icon wf-violet">${warehouseSvg}</span><div><span>Total Facilities</span><strong>${facilityTotal}</strong></div></article>
    <article class="wf-kpi"><span class="wf-icon wf-green">${warehouseSvg}</span><div><span>Active Facilities</span><strong>${facilityActive}</strong></div></article>
    <article class="wf-kpi"><span class="wf-icon wf-blue">${storeSvg}</span><div><span>Retail Stores</span><strong>${facilityRetail}</strong></div></article>
    <article class="wf-kpi"><span class="wf-icon wf-orange">${warehouseSvg}</span><div><span>Warehouses</span><strong>${facilityWarehouses}</strong></div></article>
  </section>
  <section class="wf-card" aria-label="Facilities">
    <div class="wf-toolbar">
      <label class="wf-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/></svg><input type="search" aria-label="Search facilities" placeholder="Search facilities..." value="${facilityInitialSearch?html}"/></label>
      <details class="wf-views"><summary class="wf-button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4Z"/></svg>Saved Views</summary><div class="wf-view-pop"><p class="wf-view-empty">No saved views yet.</p><div class="wf-view-list"></div><form class="wf-save-view"><label>Name this view<input name="viewName" maxlength="60" required placeholder="e.g. Regional facilities"/></label><button class="wf-button" type="submit">Save current view</button></form></div></details>
      <button class="wf-button wf-csv" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"/></svg>CSV</button>
      <button class="wf-button wf-reset" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 11a8 8 0 1 1-2-5M20 3v6h-6"/></svg>Reset</button>
    </div>
    <p class="wf-selection" role="status" aria-live="polite"></p>
    <div class="wf-table-scroll">
      <table class="wf-table">
        <thead><tr>
          <th class="wf-select-cell"><input type="checkbox" aria-label="Select all facilities on this page"/></th>
          <#list [['id','Facility ID'],['name','Facility Name'],['type','Type'],['state','State Code'],['gstin','GSTIN'],['description','Description'],['pincode','Pincode']] as col>
          <th scope="col" <#if col[0]!='description'>aria-sort="none"</#if>><#if col[0]!='description'><button type="button" data-sort="${col[0]}">${col[1]}<span class="wf-sort" aria-hidden="true">&#8597;</span></button><#else>${col[1]}</#if></th>
          </#list>
          <th scope="col">Status</th><th scope="col" class="wf-actions-head">Actions</th>
        </tr></thead>
        <tbody>
        <#list facilityRows as f>
          <tr data-id="${f.id?html}">
            <td class="wf-select-cell"><input type="checkbox" aria-label="Select ${f.name?html}"/></td>
            <td data-column="id"><a class="wf-id" href="EditFacility?facilityId=${f.id?url('UTF-8')}">${f.id?html}</a></td>
            <td data-column="name">${f.name?html}</td>
            <td data-column="type"><span class="wf-type <#if f.typeId=='FcTpRetailStore'>wf-retail<#elseif f.typeId=='FcTpWarehouse'>wf-warehouse<#else>wf-other</#if>"><#if f.typeId=='FcTpRetailStore'>${storeSvg}<#else>${warehouseSvg}</#if>${f.type?html}</span></td>
            <td data-column="state" class="wf-state">${f.state?has_content?then(f.state,'-')?html}</td>
            <td data-column="gstin">${f.gstin?has_content?then(f.gstin,'-')?html}</td>
            <td data-column="description" class="wf-description">${f.description?has_content?then(f.description,'-')?html}</td>
            <td data-column="pincode">${f.pincode?has_content?then(f.pincode,'-')?html}</td>
            <td data-column="status"><span class="wf-status <#if f.active>wf-active<#else>wf-inactive</#if>">${f.status?html}</span></td>
            <td class="wf-row-actions"><#if invCanWrite><a class="wf-edit" href="EditFacility?facilityId=${f.id?url('UTF-8')}" aria-label="Edit ${f.name?html}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m15 4 5 5M4 20l4-1L20 7a2 2 0 0 0-3-3L5 16Z"/><path d="M12 4H4v16h16v-8"/></svg></a></#if><details class="wf-more"><summary aria-label="More actions for ${f.name?html}">&#8943;</summary><div class="wf-more-pop"><a href="EditFacility?facilityId=${f.id?url('UTF-8')}">View facility details</a><button type="button" data-copy-id="${f.id?html}">Copy facility ID</button></div></details></td>
          </tr>
        </#list>
        </tbody>
      </table>
      <p class="wf-empty" <#if facilityRows?has_content>hidden</#if>>No facilities found. <#if facilityOrgId=='__NO_ORGANIZATION__'>Select an organization to view its facilities.<#else>Try another search or add a new facility.</#if></p>
    </div>
    <footer class="wf-footer"><span class="wf-entries">Showing <#if facilityTotal gt 0>1 to ${facilityTotal}<#else>0 to 0</#if> of ${facilityTotal} entries</span><div class="wf-pagination"><select aria-label="Facilities per page"><option value="10">10 per page</option><option value="25">25 per page</option><option value="50">50 per page</option><option value="100">100 per page</option></select><button type="button" data-page="first" aria-label="First page">&#124;&lsaquo;</button><button type="button" data-page="previous" aria-label="Previous page">&lsaquo;</button><span class="wf-current-page" aria-label="Current page">1</span><button type="button" data-page="next" aria-label="Next page">&rsaquo;</button><button type="button" data-page="last" aria-label="Last page">&rsaquo;&#124;</button></div></footer>
  </section>

]]></text></render-mode>
<container style="wf-create-anchor">
            <section name="FindFacilityCreate_write">
              <condition><expression>invCanWrite &amp;&amp; facilityOrgId != '__NO_ORGANIZATION__'</expression></condition>
              <widgets>
            <container-dialog id="CreateFacilityDialog" button-text="New Facility" button-style="wf-primary">
                <form-single name="CreateFacilityForm" transition="createFacility">
                    <field name="facilityName"><default-field title="Facility Name"><text-line size="60"/></default-field></field>
                    <field name="facilityTypeEnumId">
                        <default-field title="Type">
                            <drop-down>
                                <option key="FcTpWarehouse" text="Warehouse"/>
                                <option key="FcTpRetailStore" text="Retail Store"/>
                                <option key="FcTpPlant" text="Manufacturing Plant"/>
                                <option key="FcTpOffice" text="Office"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="gstStateCode">
                        <default-field title="GST State Code" tooltip="01-37 (Crucial for E-Way Bills)">
                            <text-line size="2"/>
                        </default-field>
                    </field>
                    <field name="facilityGstin">
                        <default-field title="Facility GSTIN" tooltip="Enter the 15-character GSTIN for this location">
                            <text-line size="15"/>
                        </default-field>
                    </field>
                    <!-- ZE-INV-IV-030: allow entering the pincode at create time (was edit-only). -->
                    <field name="postalCode">
                        <default-field title="Pincode"><text-line size="10"/></default-field>
                    </field>
                    <field name="submitButton"><default-field title="Create Facility"><submit/></default-field></field>
                </form-single>
            </container-dialog>
              </widgets>
            </section>
</container>
<section name="FacilityNativeExport" condition="sri.getRenderMode() in ['csv','xlsx']"><widgets>
            <form-list name="FindFacilityList" list="facilityList" skip-form="true" header-dialog="true" show-csv-button="true">
                <entity-find entity-name="mantle.facility.Facility" list="facilityList">
                    <search-form-inputs default-order-by="facilityName"/>
                    <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
                    <econdition field-name="ownerPartyId" from="facilityOrgId"/>
                </entity-find>

                <field name="facilityId">
                    <header-field title="Facility ID" show-order-by="true"/>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'"><display/></conditional-field>
                    <default-field><hidden/></default-field>
                </field>

                <field name="facilityName">
                    <header-field title="Facility Name" show-order-by="true"><text-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'"><display/></conditional-field>
                    <default-field>
                        <link url="editFacility" text="${facilityName ?: facilityId}" parameter-map="[facilityId:facilityId]" style="text-weight-bold text-indigo-8 text-decoration-none"/>
                    </default-field>
                </field>
                
                <field name="facilityTypeEnumId">
                    <header-field title="Type">
                        <drop-down allow-empty="true">
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="FacilityType"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </conditional-field>
                    <default-field>
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field>
                </field>

                <field name="gstStateCode">
                    <header-field title="State Code" show-order-by="true"><text-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'"><display/></conditional-field>
                    <default-field><label text="${gstStateCode ?: '-'}" type="strong" style="text-dark"/></default-field>
                </field>
                
                <field name="facilityGstin">
                    <header-field title="GSTIN" show-order-by="true"><text-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'"><display/></conditional-field>
                    <default-field><label text="${facilityGstin ?: '-'}" type="span"/></default-field>
                </field>

                <!-- ZE-INV-IV-030 f/u: was <hidden/> on screen (CSV-only) so the saved facility description
                     never showed — same bug as the Pincode column. Display it on screen. -->
                <field name="description">
                    <header-field title="Description"/>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'"><display/></conditional-field>
                    <default-field><label text="${description ?: '-'}" type="span" style="text-grey-8"/></default-field>
                </field>

                <!-- ZE-INV-IV-030: real field is postalCode (was misnamed "pincode" -> always null); and it was
                     <hidden/> on screen (CSV-only) so it never showed. Point at the real field + display it. -->
                <field name="postalCode">
                    <header-field title="Pincode" show-order-by="true"><text-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'"><display/></conditional-field>
                    <default-field><label text="${postalCode ?: '-'}" type="span"/></default-field>
                </field>

                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
</widgets></section>
</container>
    </widgets>
</screen>
