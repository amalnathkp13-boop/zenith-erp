<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Warehouses &amp; Facilities" default-menu-index="2" default-menu-include="true">

    <transition name="editFacility"><default-response url="../EditFacility"/></transition>
    
    <transition name="createFacility">
        <service-call name="create#mantle.facility.Facility" out-map="createOut"
                      in-map="[facilityName:facilityName, facilityTypeEnumId:facilityTypeEnumId, gstStateCode:gstStateCode, facilityGstin:facilityGstin, postalCode:postalCode, ownerPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION')]"/>
        <default-response url="../EditFacility">
            <parameter name="facilityId" value="${createOut.facilityId}"/>
        </default-response>
    </transition>

    <widgets>
        <render-mode><text type="html"><![CDATA[
            <style>
                .zenith-card { border-radius: 12px; border: 1px solid #e2e8f0; }
                /* Fix Quasar text inputs getting squashed */
                .q-field__control { min-height: 40px !important; }
                .q-field__native, .q-field__input { padding-top: 12px !important; }
                .q-field__label { top: 12px !important; }
            </style>
        ]]></text></render-mode>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Warehouses &amp; Facilities" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Your stores, warehouses and other places where you keep stock." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            
            <!-- ZE-INV-010 (IV-110): create control only for users with full Inventory write access -->
            <section name="FindFacilityCreate_write">
              <condition><expression>invCanWrite</expression></condition>
              <widgets>
            <container-dialog id="CreateFacilityDialog" button-text="New Facility" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md">
                <form-single name="CreateFacilityForm" transition="createFacility">
                    <field name="facilityName"><default-field title="Facility Name"><text-line size="60"/></default-field></field>
                    <field name="facilityTypeEnumId">
                        <default-field title="Type">
                            <drop-down>
                                <option key="FcTpWarehouse" text="Warehouse"/>
                                <option key="FcTpRetailStore" text="Retail Store"/>
                                <option key="FcTpPlant" text="Manufacturing Plant"/>
                                <option key="FcTpOffice" text="Office"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="gstStateCode">
                        <default-field title="GST State Code" tooltip="01-37 (Crucial for E-Way Bills)">
                            <text-line size="2"/>
                        </default-field>
                    </field>
                    <field name="facilityGstin">
                        <default-field title="Facility GSTIN" tooltip="Enter the 15-character GSTIN for this location">
                            <text-line size="15"/>
                        </default-field>
                    </field>
                    <!-- ZE-INV-IV-030: allow entering the pincode at create time (was edit-only). -->
                    <field name="postalCode">
                        <default-field title="Pincode"><text-line size="10"/></default-field>
                    </field>
                    <field name="submitButton"><default-field title="Create Facility"><submit/></default-field></field>
                </form-single>
            </container-dialog>
              </widgets>
            </section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search facilities..." style="display:none"></span>]]></text></render-mode>
            <form-list name="FindFacilityList" list="facilityList" skip-form="true" header-dialog="true" show-csv-button="true">
                <entity-find entity-name="mantle.facility.Facility" list="facilityList">
                    <search-form-inputs default-order-by="facilityName"/>
                    <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                </entity-find>

                <field name="facilityId">
                    <header-field title="Facility ID" show-order-by="true"/>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'"><display/></conditional-field>
                    <default-field><hidden/></default-field>
                </field>

                <field name="facilityName">
                    <header-field title="Facility Name" show-order-by="true"><text-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'"><display/></conditional-field>
                    <default-field>
                        <link url="editFacility" text="${facilityName ?: facilityId}" parameter-map="[facilityId:facilityId]" style="text-weight-bold text-indigo-8 text-decoration-none"/>
                    </default-field>
                </field>
                
                <field name="facilityTypeEnumId">
                    <header-field title="Type">
                        <drop-down allow-empty="true">
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="FacilityType"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </conditional-field>
                    <default-field>
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field>
                </field>

                <field name="gstStateCode">
                    <header-field title="State Code" show-order-by="true"><text-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'"><display/></conditional-field>
                    <default-field><label text="${gstStateCode ?: '-'}" type="strong" style="text-dark"/></default-field>
                </field>
                
                <field name="facilityGstin">
                    <header-field title="GSTIN" show-order-by="true"><text-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'"><display/></conditional-field>
                    <default-field><label text="${facilityGstin ?: '-'}" type="span"/></default-field>
                </field>

                <!-- ZE-INV-IV-030 f/u: was <hidden/> on screen (CSV-only) so the saved facility description
                     never showed — same bug as the Pincode column. Display it on screen. -->
                <field name="description">
                    <header-field title="Description"/>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'"><display/></conditional-field>
                    <default-field><label text="${description ?: '-'}" type="span" style="text-grey-8"/></default-field>
                </field>

                <!-- ZE-INV-IV-030: real field is postalCode (was misnamed "pincode" -> always null); and it was
                     <hidden/> on screen (CSV-only) so it never showed. Point at the real field + display it. -->
                <field name="postalCode">
                    <header-field title="Pincode" show-order-by="true"><text-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'"><display/></conditional-field>
                    <default-field><label text="${postalCode ?: '-'}" type="span"/></default-field>
                </field>

                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
