<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Inventory" default-menu-index="5">

    <always-actions>
        <set field="html_title" value="Inventory"/>
    </always-actions>

    <!-- ZE-INV-010 (IV-110): invCanWrite/modCanWrite are computed centrally in ZenithApp.xml pre-actions (per current
         module) and inherited here, so every Inventory subscreen can hide its write UI for view-only users. -->


    <subscreens default-item="InventoryDashboard">
        <subscreens-item name="InventoryDashboard" location="component://zenith-erp-inventory/screen/zenith/inventory/Inventory/InventoryDashboard.xml" menu-title="Dashboard"/>
        <subscreens-item name="DashboardDetails" location="component://zenith-erp-inventory/screen/zenith/inventory/Inventory/DashboardDetails.xml" menu-include="false"/>
        <subscreens-item name="FindProduct" location="component://zenith-erp-inventory/screen/zenith/inventory/FindProduct.xml"/>
        <subscreens-item name="EditProduct" location="component://zenith-erp-inventory/screen/zenith/inventory/EditProduct.xml" menu-include="false"/>
        <subscreens-item name="CreateCatalogue" location="component://zenith-erp-inventory/screen/zenith/inventory/CreateCatalogue.xml" menu-title="Catalogues"/>
        
        <subscreens-item name="FindFacility" location="component://zenith-erp-inventory/screen/zenith/inventory/FindFacility.xml" menu-title="Warehouse"/>
        <subscreens-item name="EditFacility" location="component://zenith-erp-inventory/screen/zenith/inventory/EditFacility.xml" menu-include="false"/>
        
        <subscreens-item name="FindReceipt" location="component://zenith-erp-inventory/screen/zenith/inventory/FindReceipt.xml"/>
        <subscreens-item name="ReceiveInventory" location="component://zenith-erp-inventory/screen/zenith/inventory/ReceiveInventory.xml" menu-include="false"/>
        <subscreens-item name="SerialNumbers" location="component://zenith-erp-inventory/screen/zenith/inventory/Inventory/SerialNumbers.xml" menu-title="Serial Numbers"/>
        <subscreens-item name="DemandForecast" location="component://zenith-erp-inventory/screen/zenith/inventory/Inventory/DemandForecast.xml" menu-title="Demand Forecast"/>
        <subscreens-item name="StockLevels" location="component://zenith-erp-inventory/screen/zenith/inventory/Inventory/StockLevels.xml" menu-title="Stock Levels"/>
        <subscreens-item name="StockTransfers" location="component://zenith-erp-inventory/screen/zenith/inventory/Inventory/StockTransfers.xml" menu-title="Stock Transfers"/>
        <subscreens-item name="NewStockTransfer" location="component://zenith-erp-inventory/screen/zenith/inventory/Inventory/NewStockTransfer.xml" menu-include="false"/>
        <subscreens-item name="EditStockTransfer" location="component://zenith-erp-inventory/screen/zenith/inventory/Inventory/EditStockTransfer.xml" menu-include="false"/>
        <subscreens-item name="StockAdjustments" location="component://zenith-erp-inventory/screen/zenith/inventory/Inventory/StockAdjustments.xml" menu-title="Stock Adjustments"/>
        <subscreens-item name="EditStockAdjustment" location="component://zenith-erp-inventory/screen/zenith/inventory/Inventory/EditStockAdjustment.xml" menu-include="false"/>
        <subscreens-item name="GatePasses" location="component://zenith-erp-inventory/screen/zenith/inventory/Inventory/GatePasses.xml" menu-title="Gate Passes"/>
        <subscreens-item name="PrintGatePass" location="component://zenith-erp-inventory/screen/zenith/inventory/Inventory/PrintGatePass.xml" menu-include="false"/>
        <subscreens-item name="ExpiryDashboard" location="component://zenith-erp-inventory/screen/zenith/inventory/Inventory/ExpiryDashboard.xml" menu-title="Expiry Risk"/>
    </subscreens>
    
    <transition name="goSales"><default-response url="../sales/SalesDashboard"/></transition>
    <transition name="goPurchase"><default-response url="../Purchase/RfqList"/></transition>
    <transition name="goPos"><default-response url="../pos/Terminal"/></transition>
    <transition name="goManufacturing"><default-response url="../manufacturing/WorkOrders"/></transition>
    <transition name="goQuality"><default-response url="../quality/Inspections"/></transition>
    <transition name="goEcommerce"><default-response url="../ecommerce/EcomOrders"/></transition>

    <widgets>
        <container id="inventoryModule" style="inventory-module">
        <subscreens-active/>
        </container>
    </widgets>
</screen>
