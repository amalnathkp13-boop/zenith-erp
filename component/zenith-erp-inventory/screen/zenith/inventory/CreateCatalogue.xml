<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Catalogues" default-menu-index="2">

    <!-- Create & manage product catalogues (categories) = the filter tabs on the POS billing grid.
         Org scoping:
           * A tenant user (real ACTIVE_ORGANIZATION) is locked to their own org — everything they
             create/see/manage is their org's, they can never pick another tenant.
           * A platform admin (ec.user.isInGroup('ADMIN')) with no real active org — getPreference
             returns the literal '_NA_' / null — gets an ORGANIZATION PICKER and creates catalogues
             on behalf of the chosen tenant, so the catalogue actually appears on that tenant's grid. -->

    <parameter name="productCategoryId"/>
    <parameter name="orgPartyId"/>

    <transition name="selectOrg" read-only="true"><default-response url="."><parameter name="orgPartyId"/></default-response></transition>
    <transition name="createCategory">
        <actions>
            <if condition="ec.web.request.method != 'POST' || !ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken"><return error="true" message="Submit the form with a valid session token."/></if>
            <service-call name="zenith.inventory.CatalogueServices.create#Catalogue" in-map="[orgPartyId:orgPartyId,categoryName:categoryName,description:description]" out-map="catalogueResult"/>
            <if condition="!ec.message.hasError()"><set field="productCategoryId" from="catalogueResult.productCategoryId"/><set field="orgPartyId" from="catalogueResult.selOrg"/></if>
        </actions>
        <default-response url="."><parameter name="productCategoryId"/><parameter name="orgPartyId"/></default-response>
    </transition>
    <transition name="addProduct">
        <actions>
            <if condition="ec.web.request.method != 'POST' || !ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken"><return error="true" message="Submit the form with a valid session token."/></if>
            <service-call name="zenith.inventory.CatalogueServices.add#CatalogueProduct" in-map="[orgPartyId:orgPartyId,productCategoryId:productCategoryId,productId:productId]" out-map="catalogueResult"/>
        </actions>
        <default-response url="."><parameter name="productCategoryId"/><parameter name="orgPartyId"/></default-response>
    </transition>
    <transition name="removeProduct">
        <actions>
            <if condition="ec.web.request.method != 'POST' || !ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken"><return error="true" message="Submit the form with a valid session token."/></if>
            <service-call name="zenith.inventory.CatalogueServices.remove#CatalogueProduct" in-map="[orgPartyId:orgPartyId,productCategoryId:productCategoryId,productId:productId]" out-map="catalogueResult"/>
        </actions>
        <default-response url="."><parameter name="productCategoryId"/><parameter name="orgPartyId"/></default-response>
    </transition>
    <actions>
        <service-call name="zenith.inventory.CatalogueServices.get#CatalogueScope" in-map="[orgPartyId:orgPartyId]" out-map="context"/>
        <set field="orgPartyId" from="selOrg"/>
        <set field="_hasActiveOrg" from="selOrg &amp;&amp; !showOrgPicker"/>
        <script><![CDATA[
            catalogueRows = []; memberView = []; selCat = null; eligibleProducts = []
            if (selOrg) {
                def cats = ec.entity.find('mantle.product.category.ProductCategory').condition('ownerPartyId',selOrg).orderBy('categoryName').list()
                eligibleProducts = ec.entity.find('mantle.product.Product').condition('ownerPartyId',selOrg)
                    .conditionDate('salesIntroductionDate','salesDiscontinuationDate',ec.user.nowTimestamp).orderBy('productName').list()
                def ownProducts = eligibleProducts.collectEntries { [(it.productId):it] }
                def members = cats ? ec.entity.find('mantle.product.category.ProductCategoryMember')
                        .condition('productCategoryId','in',cats*.productCategoryId).conditionDate('fromDate','thruDate',ec.user.nowTimestamp).orderBy('sequenceNum,productId').list() : []
                def grouped = members.findAll { ownProducts.containsKey(it.productId) }.groupBy { it.productCategoryId }
                cats.each { c ->
                    def validMembers = (grouped[c.productCategoryId] ?: []).unique { it.productId }
                    catalogueRows.add([productCategoryId:c.productCategoryId,categoryName:c.categoryName ?: c.productCategoryId,
                        description:c.description ?: '',itemCount:validMembers.size(),orgPartyId:selOrg])
                    if (c.productCategoryId == productCategoryId) {
                        selCat = c
                        memberView = validMembers.collect { m ->
                            def p = ownProducts[m.productId]
                            [productCategoryId:c.productCategoryId,productId:p.productId,orgPartyId:selOrg,productName:p.productName ?: p.productId,pseudoId:p.pseudoId ?: '']
                        }
                    }
                }
                if (productCategoryId && selCat == null) ec.message.addError('That catalogue is unavailable in the selected organization.')
            }
        ]]></script>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt"><![CDATA[<link rel="stylesheet" href="/zenithstatic/css/catalogues.css?v=4"/>]]></text></render-mode>
        <container id="cataloguesPage" style="catalogues-page">
        <!-- Header -->
        <container style="cat-page-head">
            <container>
                <label text="Catalogues" type="h1" style="cat-title"/>
                <label text="Group products into catalogues (categories). These become the filter tabs on the POS billing screen." type="p" style="cat-subtitle"/>

            </container>
            <section name="newCatBtn" condition="selOrg">
                <widgets>
                    <section name="newCatWrite"><condition><expression>invCanWrite</expression></condition><widgets>
                    <container-dialog id="NewCatalogueDialog" button-text="New Catalogue" button-icon="fa fa-plus" button-style="cat-primary">
                        <form-single name="NewCatalogueForm" transition="createCategory">
                            <field name="orgPartyId"><default-field><hidden/></default-field></field>
                            <field name="categoryName"><default-field title="Catalogue Name"><text-line size="40" maxlength="128"/>
                                <label text="Shown as a filter tab on the POS grid, e.g. ‘Beverages’, ‘Snacks’." style="text-grey-6 text-caption" type="p"/></default-field></field>
                            <field name="description"><default-field title="Description (optional)"><text-area rows="3" cols="40" maxlength="4000"/></default-field></field>
                            <field name="submitButton"><default-field title="Create Catalogue"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </widgets>
            </section>
        </container>

        <!-- Admin organization picker (only when there is no real active org) -->
        <section name="orgPickerSec" condition="showOrgPicker">
            <widgets>
                <container style="cat-card cat-org-picker">
                    <label text="${selOrg ? 'Switch organization' : 'Choose an organization'}" type="h6" style="cat-section-title"/>
                    <label text="You are a platform admin with no fixed organization. Pick the tenant whose catalogues you want to create or manage." type="p" style="text-grey-8 q-mb-sm"/>
                    <form-single name="OrgPickerForm" transition="selectOrg">
                        <field name="orgPartyId">
                            <!-- ZE-INV-IV-070 f/u: tenant -> hidden auto-fill; super-admin -> picker (see actions). -->
                            <conditional-field name="orgAutoFill" condition="_hasActiveOrg"><hidden/></conditional-field>
                            <default-field title="Organization">
                                <drop-down allow-empty="false">
                                    <list-options list="orgList" key="${partyId}" text="${organizationName} [${partyId}]"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="submitButton"><default-field title="Open"><submit/></default-field></field>
                    </form-single>
                </container>
            </widgets>
        </section>

        <!-- Prompt when an admin hasn't picked an org yet -->
        <section name="needOrgSec" condition="showOrgPicker &amp;&amp; !selOrg">
            <widgets>
                <label text="Select an organization above to see and create its catalogues." type="p" style="text-grey-6 q-pa-md"/>
            </widgets>
        </section>

        <!-- Main: list + manage (only once an org context exists) -->
        <section name="mainSec" condition="selOrg">
            <widgets>
                <container style="cat-card cat-list-card">
                    <label text="Your Catalogues" type="h6" style="cat-section-title"/>
                    <form-list name="CatalogueList" list="catalogueRows" skip-form="true">
                        <field name="categoryName">
                            <header-field title="Catalogue"/>
                            <default-field>
                                <label text="${categoryName}" type="strong" style="cat-name"/>
                            </default-field>
                        </field>
                        <field name="description"><header-field title="Description"/>
                            <default-field><label text="${description}" type="span" style="text-grey-7"/></default-field></field>
                        <field name="itemCount"><header-field title="Products"/>
                            <default-field><label text="${itemCount}" type="span" style="cat-count"/></default-field></field>
                        <field name="manageBtn">
                            <default-field title="">
                                <link url="." text="Manage products" parameter-map="[productCategoryId:productCategoryId, orgPartyId:orgPartyId]"
                                      style="cat-manage-button"/>
                            </default-field>
                        </field>
                    </form-list>
                    <section name="noCats" condition="!catalogueRows">
                        <widgets>
                            <label text="No catalogues yet — click ‘New Catalogue’ above to create your first one." type="p" style="text-grey-6 q-pa-md"/>
                        </widgets>
                    </section>
                </container>

                <section name="manageCat" condition="productCategoryId &amp;&amp; selCat">
                    <widgets>
                        <container style="cat-card cat-manager">
                            <link url="?orgPartyId=${java.net.URLEncoder.encode(selOrg ?: '', 'UTF-8')}" url-type="plain" text="Back to catalogues" style="cat-back"/>
                            <label text="Products in: ${selCat.categoryName ?: selCat.productCategoryId}" type="h6" style="cat-section-title"/>
                            <section name="addProductWrite"><condition><expression>invCanWrite</expression></condition><widgets>
                            <form-single name="AddProductForm" transition="addProduct">
                                <field name="productCategoryId"><default-field><hidden/></default-field></field>
                                <field name="orgPartyId"><default-field><hidden/></default-field></field>
                                <field name="productId">
                                    <default-field title="Add a product">
                                        <drop-down allow-empty="true">
                                            <entity-options key="${productId}" text="${productName}">
                                                <entity-find entity-name="mantle.product.Product">
                                                    <econdition field-name="ownerPartyId" from="selOrg"/>
                                                    <date-filter from-field-name="salesIntroductionDate" thru-field-name="salesDiscontinuationDate"/>
                                                    <order-by field-name="productName"/>
                                                </entity-find>
                                            </entity-options>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="submitButton"><default-field title="Add to catalogue"><submit/></default-field></field>
                            </form-single>
                            </widgets></section>

                            <form-list name="MemberList" list="memberView" transition="removeProduct">
                                <field name="productCategoryId"><default-field><hidden/></default-field></field>
                                <field name="productId"><default-field><hidden/></default-field></field>
                                <field name="orgPartyId"><default-field><hidden/></default-field></field>
                                <field name="productName"><header-field title="Product"/>
                                    <default-field><label text="${productName}" type="strong" style="text-dark"/></default-field></field>
                                <field name="pseudoId"><header-field title="Code"/>
                                    <default-field><label text="${pseudoId ?: '-'}" type="span" style="text-grey-7"/></default-field></field>
                                <field name="removeBtn"><header-field title="Action"/>
                                    <conditional-field name="remove_write" condition="invCanWrite" title="">
                                        <submit text="Remove"/>
                                    </conditional-field>
                                    <default-field><label text="" type="span"/></default-field>
                                </field>
                            </form-list>
                            <section name="noMembers" condition="!memberView">
                                <widgets>
                                    <label text="No products in this catalogue yet — use the dropdown above to add some." type="p" style="text-grey-6 q-pa-sm"/>
                                </widgets>
                            </section>
                        </container>
                    </widgets>
                </section>
            </widgets>
        </section>
        <container style="cat-footer">
            <label text="© 2024–2026 ZetaERP · Cloud ERP Platform" type="span"/>
            <link url="mailto:support@zetaclantech.com" url-type="plain" text="Support"/>
        </container>
        </container>
    </widgets>
</screen>
