<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Receive Inventory" default-menu-include="false">

    <parameter name="orderId" required="true"/>
    <parameter name="grnId"/>

    <transition name="findReceipt"><default-response url="../FindReceipt"/></transition>
    
    <!-- The GET-time Quasar renderer must discover this as an action form; writes remain POST-only. -->
    <transition name="receiveItem">
        <actions>
            <if condition="ec.web.request.method != 'POST'"><return error="true" message="Receiving stock requires a form submission."/></if>
            <if condition="!ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken"><return error="true" message="Your session expired. Reload Receiving and try again."/></if>
            <service-call name="zenith.inventory.ReceiptServices.receive#Stock"
                in-map="[orderId:orderId, orderItemSeqId:orderItemSeqId, facilityId:facilityId,
                    quantityAccepted:quantityAccepted, batchNumber:batchNumber ?: optionalBatchNumber, mrpAmount:mrpAmount,
                    manufacturingDate:manufacturingDate, expiryDate:expiryDate, grnId:grnId, grnReceivedBefore:grnReceivedBefore]"/>
        </actions><default-response url="." parameter-map="[orderId:orderId,grnId:grnId]"/>
    </transition>

    <actions>
        <!-- ZE-INV-IV-06A: org-isolation guard — don't render another tenant's PO (items/vendor/costs).
             A PO's owner is OrderPart.customerPartyId; block unless it's the caller's active org. -->
        <service-call name="zenith.inventory.ReceiptServices.get#PurchaseOrderAccess" in-map="[orderId:orderId]" out-map="_acc"/>
        <set field="noAccess" from="!_acc.allowed"/>
        <if condition="_acc.allowed">
        <entity-find-one entity-name="mantle.order.OrderHeader" value-field="order"/>

        <entity-find entity-name="mantle.order.OrderPart" list="orderParts">
            <econdition field-name="orderId"/>
        </entity-find>
        <set field="orderPart" from="orderParts?.getFirst()"/>

        <entity-find entity-name="mantle.order.OrderItem" list="orderItems">
            <econdition field-name="orderId"/>
            <econdition field-name="productId" operator="is-not-null"/>
            <order-by field-name="orderItemSeqId"/>
        </entity-find>

        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendor">
            <field-map field-name="partyId" from="orderPart?.vendorPartyId"/>
        </entity-find-one>

        <set field="grn" from="null"/>
        <set field="grnLines" from="[:]"/>
        <if condition="grnId">
            <entity-find-one entity-name="zenith.erp.purchase.GoodsReceiptNote" value-field="grn"><field-map field-name="grnId"/></entity-find-one>
            <if condition="!grn || grn.purchaseOrderId != orderId || grn.vendorPartyId != orderPart.vendorPartyId">
                <set field="noAccess" from="true"/>
                <set field="grn" from="null"/>
                <else>
                    <entity-find entity-name="zenith.erp.purchase.GoodsReceiptNoteItem" list="deliveryLines"><econdition field-name="grnId"/></entity-find>
                    <set field="grnLines" from="deliveryLines.findAll { it.orderItemSeqId != null }.collectEntries { [(it.orderItemSeqId):it] }"/>
                    <set field="orderItems" from="orderItems.findAll { grnLines.containsKey(it.orderItemSeqId) }"/>
                    <set field="facilityId" from="grn.facilityId"/>
                </else>
            </if>
        </if>
        <service-call name="zenith.inventory.ReceiptServices.get#PendingGrnQuantities" in-map="[orderId:orderId]" out-map="pendingGrns"/>
        <service-call name="zenith.inventory.ReceiptServices.get#OrderReceiptQuantities" in-map="[orderId:orderId]" out-map="receiptTotals"/>
        <!-- Only destinations in the active organization may receive its goods. -->
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
            <order-by field-name="facilityName"/>
        </entity-find>
        <set field="grnDestination" from="grn ? (facilityList.find { it.facilityId == grn.facilityId }?.facilityName ?: grn.facilityId) : null"/>
        </if>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt,vuet"><![CDATA[<link rel="stylesheet" href="/zenithstatic/css/receiving-stock.css?v=16"/>]]></text></render-mode>
        <container id="receivingStockDetail" style="receiving-page">
        <container style="receiving-detail-back">
            <link url="../FindReceipt" text="← Back to Receiving List" link-type="anchor"/>
        </container>

        <!-- ZE-INV-IV-06A: cross-tenant / missing PO — plain notice, never another org's PO -->
        <section name="NoAccess">
            <condition><expression>noAccess</expression></condition>
            <widgets>
                <container style="zenith-card q-pa-lg bg-white shadow-1 border-radius-md text-center">
                    <label text="That purchase order isn't part of your account." type="h5" style="text-grey-8 q-mb-xs"/>
                    <label text="It may belong to another organization, or it may not exist. Use “Back to Receiving List” above to return." type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <section name="TheReceipt">
        <condition><expression>!noAccess</expression></condition>
        <widgets>
        <container style="receiving-detail-heading">
            <label text="${grn ? 'Receive delivery' : 'Receive purchase order'}" type="h1" style="receiving-title"/>
            <container style="receiving-detail-meta">
                <container><label text="Purchase order" type="span"/><label text="${orderId}" type="strong"/></container>
                <container><label text="Supplier" type="span"/><label text="${vendor?.organizationName ?: [vendor?.firstName, vendor?.lastName].findAll().join(' ') ?: orderPart?.vendorPartyId ?: '—'}" type="strong"/></container>
                <section name="DeliveryReferences"><condition><expression>grn != null</expression></condition><widgets>
                    <container><label text="Goods receipt note" type="span"/><label text="${grnId}" type="strong"/></container>
                    <container><label text="Supplier invoice" type="span"/><label text="${grn.vendorInvoiceNumber ?: 'Awaiting invoice'}" type="strong"/></container>
                    <container><label text="Receiving location" type="span"/><label text="${grnDestination ?: '—'}" type="strong"/></container>
                </widgets></section>
            </container>
        </container>

        <!-- Items to Receive -->
        <container style="receiving-detail-items">
            <container style="receiving-items-heading">
                <label text="Items to receive" type="h2"/>
                <label text="Confirm the quantity that arrived for each item to add it to stock." type="p"/>
            </container>
            <container style="receiving-table-scroll">
            <form-list name="ReceiveItemsForm" list="orderItems" skip-form="true">
                <row-actions>
                    <entity-find-one entity-name="mantle.product.Product" value-field="product">
                        <field-map field-name="productId"/>
                    </entity-find-one>
                    
                    <set field="qtyReceived" from="receiptTotals.receivedByItem[orderItemSeqId] ?: 0G"/>
                    <set field="qtyRemaining" from="((quantity ?: 0G) - (quantityCancelled ?: 0G) - qtyReceived).max(0G)"/>
                    <set field="grnLine" from="grnLines[orderItemSeqId]"/>
                    <set field="grnReceivedBefore" from="grnLine?.inventoryReceivedQuantity ?: 0G"/>
                    <set field="qtyRemaining" from="grnLine ? qtyRemaining.min(((grnLine.plannedQuantity ?: 0G) - grnReceivedBefore).max(0G)) : (qtyRemaining - (pendingGrns.reservedByItem[orderItemSeqId] ?: 0G)).max(0G)"/>
                    <set field="canReceiveLine" from="qtyRemaining > 0 &amp;&amp; (order.statusId in ['OrderApproved','OrderCompleted']) &amp;&amp; (!grn || grn.statusId in ['GrnPending','GrnPartial'])"/>
                </row-actions>

                <field name="orderItemSeqId"><default-field title="#"><label text="${orderItemSeqId}" type="span" style="text-grey-7"/></default-field></field>
                
                <field name="productInfo"><default-field title="Product">
                    <label text="${product?.pseudoId ?: productId}" type="strong" style="block text-indigo-8"/>
                    <label text="${itemDescription ?: product?.productName}" type="span" style="block text-dark"/>
                </default-field></field>

                <field name="expectedQuantity"><default-field title="Expected"><label text="${ec.l10n.format((grnLine ? grnLine.plannedQuantity : quantity) ?: 0, '#,##0.######')}" type="span"/></default-field></field>
                <field name="receivedQuantity"><default-field title="Received"><label text="${ec.l10n.format(grnLine ? grnReceivedBefore : qtyReceived, '#,##0.######')}" type="span"/></default-field></field>
                <field name="remainingQuantity"><default-field title="Available to receive"><label text="${ec.l10n.format(qtyRemaining, '#,##0.######')}" type="strong" style="receiving-reference"/></default-field></field>
                
                <field name="receiveAction">
                    <header-field title="Receive"/>
                    <!-- ZE-INV-010 (IV-110): the receive form only for users with full Inventory write access; the
                         "Fully Received" status stays visible to everyone (read-only). Form name/transition untouched. -->
                    <conditional-field name="receive_write" condition="invCanWrite" title="Receive">
                        <container-dialog id="ReceiveDialog_${orderItemSeqId}" button-text="Receive item" width="560" condition="canReceiveLine">
                            <label text="${itemDescription ?: product?.productName ?: productId}" type="p" style="receiving-dialog-product"/>
                            <label condition="grn != null" text="Receiving location · ${grnDestination}" type="p" style="receiving-fixed-location"/>
                            <!-- ZE-INV-001 f/u: form-single name must be a STATIC identifier — Moqui does NOT
                                 interpolate ${} in it (the container-dialog id above does), so the old
                                 name="ReceiveForm_${orderItemSeqId}" left moquiFormName as that literal string and
                                 the submit re-rendered the screen instead of invoking receiveItem (0 PO receipts
                                 ever). Per-row values come from the hidden fields below, so a static name is fine. -->
                            <form-single name="ReceiveForm" transition="receiveItem">
                                <field name="orderId"><default-field><hidden/></default-field></field>
                                <field name="orderItemSeqId"><default-field><hidden/></default-field></field>
                                <field name="grnId"><default-field><hidden/></default-field></field>
                                <field name="grnReceivedBefore"><default-field><hidden/></default-field></field>
                                
                                <field name="facilityId">
                                    <conditional-field name="saved_grn_location" condition="grn != null">
                                        <hidden/>
                                    </conditional-field>
                                    <default-field title="Receiving location">
                                        <drop-down allow-empty="false">
                                            <list-options list="facilityList" key="${facilityId}" text="${facilityName}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                
                                <field name="quantityAccepted">
                                    <default-field title="Quantity received">
                                        <text-line size="10" default-value="${qtyRemaining.stripTrailingZeros().toPlainString()}"/>
                                    </default-field>
                                </field>
                                
                                <field name="batchNumber">
                                    <conditional-field name="tracked_batch" condition="product?.enableBatchTracking == 'Y'" title="Batch / lot number (required)">
                                        <text-line size="20"/>
                                    </conditional-field>
                                    <default-field><ignored/></default-field>
                                </field>
                                <field name="optionalBatchNumber">
                                    <conditional-field name="untracked_batch" condition="product?.enableBatchTracking != 'Y'" title="Batch / lot number">
                                        <text-line size="20"/>
                                    </conditional-field>
                                    <default-field><ignored/></default-field>
                                </field>
                                
                                <field name="manufacturingDate">
                                    <default-field title="Manufacturing Date"><date-time type="date"/></default-field>
                                </field>
                                
                                <field name="expiryDate">
                                    <default-field title="Expiry Date"><date-time type="date"/></default-field>
                                </field>
                                
                                <field name="mrpAmount">
                                    <default-field title="Batch MRP${companyCurrency ? ' (' + (currSymbol?.trim() ?: companyCurrency) + ')' : ''}">
                                        <text-line size="10" default-value="${product?.mrpAmount ?: ''}"/>
                                    </default-field>
                                </field>
                                
                                <field name="submitButton"><default-field title="Confirm Receipt"><submit/></default-field></field>
                                <field-layout>
                                    <field-ref name="orderId"/><field-ref name="orderItemSeqId"/>
                                    <field-ref name="grnId"/><field-ref name="grnReceivedBefore"/>
                                    <field-ref name="facilityId"/><field-ref name="quantityAccepted"/><field-ref name="batchNumber"/>
                                    <field-accordion active="false">
                                        <field-group title="Optional tracking details" style="receiving-tracking-fields">
                                            <field-ref name="optionalBatchNumber"/><field-ref name="manufacturingDate"/>
                                            <field-ref name="expiryDate"/><field-ref name="mrpAmount"/>
                                        </field-group>
                                    </field-accordion>
                                    <field-ref name="submitButton"/>
                                </field-layout>
                            </form-single>
                        </container-dialog>

                        <label text="${grn || !(pendingGrns.reservedByItem[orderItemSeqId] ?: 0G) ? 'Fully Received' : 'Queued on GRN'}" type="span" style="zenith-badge success" condition="qtyRemaining &lt;= 0"/>
                    </conditional-field>
                    <default-field title="Receive">
                        <label text="${grn || !(pendingGrns.reservedByItem[orderItemSeqId] ?: 0G) ? 'Fully Received' : 'Queued on GRN'}" type="span" style="zenith-badge success" condition="qtyRemaining &lt;= 0"/>
                    </default-field>
                </field>
            </form-list>
            </container>
        </container>
        <!-- The Bootstrap renderer names an accordion after its form, which is shared by every receipt row. -->
        <render-mode><text type="html"><![CDATA[<script>
            document.querySelectorAll('#receivingStockDetail .modal[id^="ReceiveDialog_"]').forEach(function (dialog) {
                var fields = dialog.querySelector('.receiving-tracking-fields');
                if (!fields) return;
                var group = fields.closest('.panel-group');
                var panel = fields.closest('.panel-collapse');
                var heading = group.querySelector('.panel-heading');
                var toggle = heading.querySelector('a');
                group.id = dialog.id + '-tracking';
                panel.id = group.id + '-fields';
                heading.id = group.id + '-heading';
                toggle.setAttribute('data-parent', '#' + group.id);
                toggle.setAttribute('href', '#' + panel.id);
                toggle.setAttribute('aria-controls', panel.id);
                toggle.setAttribute('aria-expanded', String(panel.classList.contains('in')));
                panel.setAttribute('aria-labelledby', heading.id);
            });
        </script>]]></text></render-mode>
        </widgets>
        </section>

        <container style="receiving-footer">
            <label text="© 2024-${ec.l10n.format(ec.user.nowTimestamp, 'yyyy')} ZetaERP · Cloud ERP Platform" type="span"/>
            <render-mode><text type="html,qvt,vuet"><![CDATA[<a href="mailto:support@zetaclantech.com">Support</a>]]></text></render-mode>
        </container>
        </container>
    </widgets>
</screen>
