<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Recruitment" default-menu-index="6">

    <always-actions>
        <set field="html_title" value="Recruitment"/>
    </always-actions>

    <subscreens default-item="Applications"/>

    <transition name="goHr"><default-response url="../Hr/Employees"/></transition>
    <transition name="goContacts"><default-response url="../Contacts/FindContact"/></transition>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
