<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Contacts" default-menu-index="2">

    <always-actions>
        <set field="html_title" value="Contacts"/>
    </always-actions>

    <subscreens default-item="ContactsDashboard">
        <!-- ZE-CONTACTS-NAV: tab order prioritises the most-used views (All Contacts, Customers) before Dashboard.
             menu-index on the subscreens-item overrides each screen's default-menu-index:
             All Contacts(1), Customers(2), Dashboard(3), Suppliers(4), Customer Groups(5), Merge Contacts(6). -->
        <subscreens-item name="ContactsDashboard" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/ContactsDashboard.xml" menu-index="1"/>
        <subscreens-item name="Customers" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/Customers.xml" menu-index="3"/>
        <subscreens-item name="Vendors" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/Vendors.xml" menu-index="4"/>
        <subscreens-item name="FindContact" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/FindContact.xml" menu-title="All Contacts" menu-index="2"/>
        <subscreens-item name="CustomerGroups" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/CustomerGroups.xml"
                         menu-title="Customer Groups" menu-index="5"/>
        <subscreens-item name="MergeContacts" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/MergeContacts.xml"
                         menu-title="Merge" menu-index="6"/>
        <subscreens-item name="MergeHistory" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/MergeHistory.xml" menu-include="false"/>
        <subscreens-item name="EditContact" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/EditContact.xml"/>
        <subscreens-item name="ContactProfile" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/ContactProfile.xml" menu-include="false"/>
        <subscreens-item name="EditCustomerGroup" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/EditCustomerGroup.xml" menu-include="false"/>
    </subscreens>
    
    <transition name="goSales"><default-response url="../sales/SalesDashboard"/></transition>
    <transition name="goPurchase"><default-response url="../Purchase/RfqList"/></transition>
    <transition name="goAccounting"><default-response url="../Accounting/Invoices"/></transition>
    <transition name="goCrm"><default-response url="../Crm/Leads"/></transition>
    <transition name="goHr"><default-response url="../Hr/Employees"/></transition>
    <transition name="goMarketing"><default-response url="../marketing/Campaigns"/></transition>

    <widgets>
        <container style="zcontacts-page"><subscreens-active/></container>
    </widgets>
</screen>
