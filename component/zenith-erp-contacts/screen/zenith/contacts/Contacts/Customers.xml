<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Customers" default-menu-index="2">

    <!-- ZE-CUST-LIST/FINAL: inline filter params (Customer Type + Status + Show Disabled), read from the GET URL. -->
    <parameter name="showDisabled"/>
    <parameter name="quickSearch"/>
    <parameter name="statusFilter"/>

    <transition name="createPerson">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyPerson', roleTypeId:'Customer']"/>
        <error-response url="."/>
        <default-response url="../EditContact"/>
    </transition>
    <transition name="createOrganization">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyOrganization', roleTypeId:'Customer']"/>
        <error-response url="."/>
        <default-response url="../EditContact"/>
    </transition>

    <!-- ZE-CONTACTS-027 / CT-166: real XLSX export (Moqui 4.0 has no xlsx render mode — see
         build#ListXlsx). Exports the filtered, org-scoped customer list (columns match the
         on-screen list); org isolation is enforced by the ownerPartyId econdition (transitions run
         outside the active-org entity filter, so scope explicitly). Read-only. -->
    <!-- Null, empty and _NA_ active-org preferences all deny list/export scope, including direct transitions. -->
    <transition name="export" read-only="true">
        <parameter name="format"/>
        <actions>
            <entity-find entity-name="mantle.party.PartyDetailAndRole" list="customerList">
                <!-- Moqui still honors explicit paging with paginate=false; clear it for a full filtered export. -->
                <search-form-inputs skip-fields="ownerPartyId" input-fields-map="ec.context + [pageIndex:null, pageSize:null]" paginate="false" default-order-by="organizationName,firstName"/>
                <econdition field-name="roleTypeId" operator="in" value="Customer,CustomerBillTo"/>
                <!-- Org isolation: only the active organization's customers; no active org returns no rows. -->
                <econdition field-name="ownerPartyId" from="_contactOrg?.activeOrgId ?: '__NO_ORGANIZATION__'"/>
                <!-- ZE-CUST-FINAL: Status/Show-Disabled drive these (disabledNe hides disabled; disabledEq = only disabled). -->
                <econdition field-name="disabled" operator="not-equals" from="disabledNe" or-null="true" ignore-if-empty="true"/>
                <econdition field-name="disabled" operator="equals" from="disabledEq" ignore-if-empty="true"/>
                <!-- ZE-CONTACTS-010: GSTIN/PAN/CIN/email/phone search resolves to partyIds in screen actions. -->
                <econdition field-name="partyId" operator="in" from="searchPartyIds" ignore-if-empty="true"/>
                <!-- We want a unique list of parties, but PartyDetailAndRole can have multiple roles.
                     Moqui will fetch them, so we just group by partyId if needed, or assume standard roles. -->
            </entity-find>
            <script><![CDATA[
                def rows = []
                def seen = new HashSet()
                for (r in customerList) {
                    if (!seen.add(r.partyId)) continue   // PartyDetailAndRole repeats a party across roles
                    def party = ec.entity.find("mantle.party.Party").condition("partyId", r.partyId).one()
                    def gstList = ec.entity.find("zenith.erp.india.IndiaGstin").condition("partyId", r.partyId).list()
                    def nm = r.organizationName ?: (((r.firstName ?: '') + ' ' + (r.lastName ?: '')).trim())
                    def typ = (r.partyTypeEnumId == 'PtyOrganization') ? 'Business' : 'Individual'
                    rows.add([ (r.partyId ?: ''), (nm ?: 'Unknown'), typ, (gstList ? gstList[0].gstin : ''), (party?.panNumber ?: '') ])
                }
                context.expHeaders = ['ID', 'Customer Name', 'Type', 'GST Number', 'PAN']
                context.expRows = rows
            ]]></script>
            <if condition="format == 'csv'">
                <service-call name="zenith.contacts.ContactServices.build#ListCsv"
                              in-map="[headers:expHeaders, rows:expRows]" out-map="context"/>
                <script><![CDATA[
                    ec.web.response.setContentType("text/csv; charset=utf-8")
                    ec.web.response.setHeader("Content-Disposition", "attachment; filename=\"Customers.csv\"")
                    def os = ec.web.response.outputStream
                    os.write(csvText.getBytes("UTF-8"))
                    os.flush()
                ]]></script>
                <else>
                    <service-call name="zenith.contacts.ContactServices.build#ListXlsx"
                                  in-map="[sheetName:'Customers', headers:expHeaders, rows:expRows]" out-map="context"/>
                    <script><![CDATA[
                        ec.web.response.setContentType("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet")
                        ec.web.response.setHeader("Content-Disposition", "attachment; filename=\"Customers.xlsx\"")
                        def os = ec.web.response.outputStream
                        os.write(xlsxBase64.decodeBase64())
                        os.flush()
                    ]]></script>
                </else>
            </if>
        </actions>
        <default-response type="none"/>
    </transition>

    <always-actions>
        <service-call name="zenith.contacts.ContactServices.get#AuthorizedActiveOrganization" out-map="_contactOrg"/>
        <!-- plan-aware action buttons: hide links to modules not in the tenant plan -->
        <set field="planGate" from="isSaasTenant &amp;&amp; !saasHasAllAccess &amp;&amp; saasAllowedModules != null"/>
        <set field="showSalesBtn" from="!planGate || saasAllowedModules.contains('sales')"/>
        <set field="showAccountingBtn" from="!planGate || saasAllowedModules.contains('accounting')"/>
        <!-- ZE-CUST-FINAL: Status filter (All/Active/Inactive) + Show Disabled toggle drive the `disabled` field.
             active -> disabled != Y; inactive -> disabled == Y; All -> hide disabled unless Show Disabled is on. -->
        <script><![CDATA[
            def sf = (statusFilter ?: '')
            disabledNe = null; disabledEq = null
            if (sf == 'inactive') disabledEq = 'Y'
            else if (sf == 'active') disabledNe = 'Y'
            else if (showDisabled != 'Y') disabledNe = 'Y'
        ]]></script>
        <!-- ZE-CUST-FINAL: default the page size to 20 (mockup) unless the user picks another via the page-size
             dropdown. The form-list reads pageSize from the request params, so seed it there when absent. -->
        <script><![CDATA[
            if (ec.web != null) {
                def p = ec.web.parameters
                def cur = p?.pageSize
                if (cur == null || cur.toString().trim().isEmpty()) {
                    ec.context.pageSize = 20
                    try { p.put("pageSize", "20") } catch (Throwable _t) { }
                }
            }
        ]]></script>
        <!-- ZE-CONTACTS-010: let the Find Options dialog search by GSTIN / PAN / CIN / email / phone.
             These live on IndiaGstin / Party / ContactMech, not the PartyDetailAndRole search view, so
             resolve each provided term to matching partyIds; the list then filters on `searchPartyIds`.
             Multiple terms AND together; a term that matches nothing yields an empty result. -->
        <script><![CDATA[
            def _sets = []
            // Search the complete authorized directory, not just rows on the visible page.
            def _quick = quickSearch?.toString()?.trim()
            if (_quick) {
                def cf = ec.entity.conditionFactory
                _quick.split(/\s+/).each { term ->
                    def matches = ['organizationName','firstName','lastName','partyId'].collect { field ->
                        cf.makeCondition(field, org.moqui.entity.EntityCondition.LIKE, '%' + term + '%').ignoreCase()
                    }
                    def matched = ec.entity.find('zenith.erp.contacts.ContactListView')
                        .condition('ownerPartyId', _contactOrg?.activeOrgId ?: '__NO_ORGANIZATION__')
                        .condition(cf.makeCondition(matches, org.moqui.entity.EntityCondition.OR))
                        .list().collect { it.partyId }.unique()
                    _sets.add(matched ?: ['__NO_MATCH__'])
                }
            }
            if (gstinSearch?.trim()) _sets.add(ec.entity.find("zenith.erp.india.IndiaGstin").condition("gstin","like","%"+gstinSearch.trim().toUpperCase()+"%").list().collect{it.partyId}.findAll{it}.unique())
            if (panSearch?.trim()) _sets.add(ec.entity.find("mantle.party.Party").condition("panNumber","like","%"+panSearch.trim().toUpperCase()+"%").list().collect{it.partyId}.findAll{it}.unique())
            if (cinSearch?.trim()) _sets.add(ec.entity.find("mantle.party.Party").condition("cinNumber","like","%"+cinSearch.trim().toUpperCase()+"%").list().collect{it.partyId}.findAll{it}.unique())
            if (emailSearch?.trim()) _sets.add(ec.entity.find("mantle.party.contact.PartyContactMechInfo").condition("contactMechTypeEnumId","CmtEmailAddress").condition("infoString","like","%"+emailSearch.trim()+"%").list().collect{it.partyId}.findAll{it}.unique())
            if (phoneSearch?.trim()) _sets.add(ec.entity.find("mantle.party.contact.PartyContactMechTelecomNumber").condition("contactNumber","like","%"+phoneSearch.trim()+"%").list().collect{it.partyId}.findAll{it}.unique())
            searchPartyIds = null
            if (_sets) {
                searchPartyIds = _sets[0]
                for (int i = 1; i < _sets.size(); i++) searchPartyIds = searchPartyIds.intersect(_sets[i])
                if (!searchPartyIds) searchPartyIds = ['__NO_MATCH__']
            }
        ]]></script>
    </always-actions>

    <widgets>
        <!-- Freshness: if the browser restores this list from the back/forward cache (e.g. after adding a
             customer and navigating back), force a reload so a newly-created contact always shows without F5. -->
        <render-mode><text type="html"><![CDATA[<script>window.addEventListener('pageshow',function(e){if(e.persisted){location.reload();}});</script>]]></text></render-mode>
        <!-- ZE-CUST-HEAD: page header + action bar consolidated into ONE row on the title line (was `row
             justify-between` = a /apps no-op that stacked the Add buttons below the title, plus a separate export
             row underneath). Add Person first (spec); both CSV + Excel exports kept as clean buttons. ZE-CUST-FINAL:
             title is near-black per the final mockup (`.cust-title`, was brand violet). -->
        <container style="zc-page-head">
            <container style="zc-page-head__titles">
                <label text="Customers" type="h3" style="cust-title text-weight-bold q-my-none"/>
                <label text="Everyone you sell to. Add a customer, search the list, or open one to see their details, orders and invoices." type="p" style="text-grey-7 q-mt-xs q-mb-none"/>
            </container>
            <container style="cust-actions">
              <section name="Customers_write">
                <condition><expression>modCanWrite</expression></condition>
                <widgets>
                <!-- ZE-CUST-FINAL: "+ New Customer" primary dropdown (per the final mockup) — consolidates the two Add
                     buttons into one prominent CTA. The menu items proxy-click the hidden real dialog triggers below
                     (cpe-tabs.js), which open the same Bootstrap modal (/apps) or q-dialog (/qapps). Consolidated (not
                     plus the reference's direct Add Person and Add Company actions; the create flow is unchanged. -->
                <render-mode><text type="html,qvt,vuet"><![CDATA[
                    <button type="button" class="cust-nc-solo cust-nc-ghost" data-nctext="Add Person"><span class="material-icons" aria-hidden="true">person_add</span>Add Person</button>
                    <button type="button" class="cust-nc-solo cust-nc-ghost" data-nctext="Add Company"><span class="material-icons" aria-hidden="true">apartment</span>Add Company</button>
                    <div class="cust-newcust">
                      <button type="button" class="cust-nc-trigger" aria-expanded="false"><span class="material-icons cust-nc-plus">add</span>New Customer<span class="material-icons cust-nc-caret">arrow_drop_down</span></button>
                      <div class="cust-nc-menu">
                        <button type="button" class="cust-nc-item cust-nc-person"><span class="cust-nc-ico material-icons">person</span>Add a Person</button>
                        <button type="button" class="cust-nc-item cust-nc-org"><span class="cust-nc-ico material-icons">apartment</span>Add a Company</button>
                      </div>
                    </div>
                ]]></text></render-mode>
                <!-- Real create dialogs — triggers hidden (container-dialog IGNORES button-class on BOTH surfaces) and
                     proxied by the menu items above (cpe-tabs.js matches the trigger by its button text). Wrapped in
                     .cust-nc-src so CSS hides the in-flow triggers (/apps button[data-target], /qapps .q-btn) while the
                     dialog body still shows: the /apps modal has no data-target; the /qapps q-dialog portals to <body>. -->
                <container style="cust-nc-src">
                <container-dialog id="NewPersonDialog" button-text="Add Person" button-icon="person" width="600">
                    <container style="q-pa-md">
                        <label text="Add a person as a customer" type="h5" style="text-primary text-weight-bold q-mb-md"/>
                        <form-single name="NewPersonForm" transition="createPerson">
                            <field name="firstName"><default-field title="First Name"><text-line size="30"/></default-field></field>
                            <field name="lastName"><default-field title="Last Name"><text-line size="30"/></default-field></field>
                            <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                            <field name="countryCode"><default-field title="Country Code"><text-line size="4" default-value="91"/></default-field></field>
                            <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>
                            <field name="panNumber"><default-field title="PAN"><text-line size="10" maxlength="10"/></default-field></field>
                            <field name="tdsApplicable"><default-field title="TDS Applicable">
                                <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>
                            <field name="submitButton"><default-field title="Save customer"><submit class="q-btn--unelevated bg-primary text-white full-width q-mt-md"/></default-field></field>
                        </form-single>
                    </container>
                </container-dialog>
                <container-dialog id="NewOrgDialog" button-text="Add Company" button-icon="apartment" width="600">
                    <container style="q-pa-md">
                        <label text="Add a company as a customer" type="h5" style="text-primary text-weight-bold q-mb-md"/>
                        <!-- Same rich fields as the Contacts Dashboard so the button behaves the same everywhere.
                             All fields except the name are optional. Role is fixed to Customer on this screen. -->
                        <form-single name="NewOrgForm" transition="createOrganization">
                            <field name="organizationName"><default-field title="Business Name"><text-line size="60"/></default-field></field>
                            <field name="businessStructureEnumId"><default-field title="Business Structure">
                                <drop-down allow-empty="true">
                                    <option key="Proprietorship"/><option key="Partnership"/><option key="LLP"/>
                                    <option key="Pvt Ltd"/><option key="Public Ltd"/><option key="HUF"/><option key="Trust"/>
                                </drop-down>
                            </default-field></field>
                            <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                            <field name="countryCode"><default-field title="Country Code"><text-line size="4" default-value="91"/></default-field></field>
                            <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>
                            <field name="gstin"><default-field title="GSTIN"><text-line size="15" maxlength="15"/></default-field></field>
                            <field name="gstRegistrationType"><default-field title="GST Registration">
                                <drop-down no-current-selected-key="Regular">
                                    <option key="Regular"/><option key="Composition"/>
                                    <option key="Unregistered"/><option key="SEZ"/><option key="Overseas"/>
                                </drop-down>
                            </default-field></field>
                            <field name="panNumber"><default-field title="PAN"><text-line size="10" maxlength="10"/></default-field></field>
                            <field name="tdsApplicable"><default-field title="TDS Applicable">
                                <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>
                            <field name="submitButton"><default-field title="Save customer"><submit class="q-btn--unelevated bg-primary text-white full-width q-mt-md"/></default-field></field>
                        </form-single>
                    </container>
                </container-dialog>
                </container>
                </widgets>
              </section>
              <!-- ZE-CONTACTS-027/025: CSV/Excel export via the shared export transition (the native show-csv-button
                   dropped ID/Name and leaked the header). CSV visible; Excel in the ⋮ overflow (kept, not removed). -->
              <!-- Both exports as Moqui <link>s (surface-aware, correct transition URL on /apps AND /qapps). Kept
                   CSV stays visible in the reference toolbar; the Excel transition remains available. -->
              <link url="export" text="Export to CSV" parameter-map="[format:'csv']" link-type="anchor" target-window="_blank" style="cust-export"/>
              <link url="export" text="Export to Excel" parameter-map="[format:'xlsx']" link-type="anchor" target-window="_blank" style="cust-export contacts-excel"/>
            </container>
        </container>

        <label text="Tip: use Find Options (top-right) to search by name, company, or ID — then click a customer's name or ID to open their full profile." type="p" style="text-grey-6 text-caption q-mb-md"/>

        <!-- ZE-CUST-LIST/FINAL: inline filter bar — Customer Type + Status dropdowns (native <details>, no JS) + a
             Show Disabled toggle-switch (GET-param filters; each control preserves the other two params). Reuses the
             shared list-filter styling (sup-*). Default (all empty) = active-only = MARUTHI no-op. -->
        <render-mode><text type="html,qvt,vuet"><![CDATA[
            <#assign _t = (partyTypeEnumId)!''><#assign _sd = (showDisabled)!''><#assign _st = (statusFilter)!''>
            <#assign _tName><#if _t == 'PtyOrganization'>Business<#elseif _t == 'PtyPerson'>Individual<#else>All</#if></#assign>
            <#assign _stName><#if _st == 'active'>Active<#elseif _st == 'inactive'>Inactive<#else>All</#if></#assign>
            <div class="sup-filterbar2">
              <span class="sup-flabel">Customer Type:</span>
              <details class="sup-dd">
                <summary class="sup-dd-btn"><span>${_tName}</span><span class="sup-dd-caret">&#9660;</span></summary>
                <div class="sup-dd-menu">
                  <a href="?partyTypeEnumId=&amp;statusFilter=${_st}&amp;showDisabled=${_sd}" class="sup-dd-item<#if _t == ''> on</#if>">All</a>
                  <a href="?partyTypeEnumId=PtyOrganization&amp;statusFilter=${_st}&amp;showDisabled=${_sd}" class="sup-dd-item<#if _t == 'PtyOrganization'> on</#if>">Business</a>
                  <a href="?partyTypeEnumId=PtyPerson&amp;statusFilter=${_st}&amp;showDisabled=${_sd}" class="sup-dd-item<#if _t == 'PtyPerson'> on</#if>">Individual</a>
                </div>
              </details>
              <span class="sup-flabel">Status:</span>
              <details class="sup-dd">
                <summary class="sup-dd-btn"><span>${_stName}</span><span class="sup-dd-caret">&#9660;</span></summary>
                <div class="sup-dd-menu">
                  <a href="?statusFilter=&amp;partyTypeEnumId=${_t}&amp;showDisabled=${_sd}" class="sup-dd-item<#if _st == ''> on</#if>">All</a>
                  <a href="?statusFilter=active&amp;partyTypeEnumId=${_t}&amp;showDisabled=${_sd}" class="sup-dd-item<#if _st == 'active'> on</#if>">Active</a>
                  <a href="?statusFilter=inactive&amp;partyTypeEnumId=${_t}&amp;showDisabled=${_sd}" class="sup-dd-item<#if _st == 'inactive'> on</#if>">Inactive</a>
                </div>
              </details>
              <span class="sup-fspacer"></span>
              <a href="?showDisabled=<#if _sd == 'Y'><#else>Y</#if>&amp;partyTypeEnumId=${_t}&amp;statusFilter=${_st}" class="sup-switch-link<#if _sd == 'Y'> sup-switch-on</#if>">Show Disabled</a>
            </div>
        ]]></text></render-mode>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md sup-compact contacts-list-card">
            <render-mode><text type="html,qvt,vuet"><![CDATA[
              <form method="get" action="" class="sup-searchrow contacts-quick-search">
                <input class="sup-search-input" type="search" name="quickSearch" aria-label="Search contacts" placeholder="Search by name or contact ID..." value="${(quickSearch!'')?html}"/>
                <button type="submit" class="sup-filters-btn contacts-search-submit" aria-label="Search contacts">Search</button>
                <button type="button" class="sup-filters-btn">Filters</button>
              </form>
            ]]></text></render-mode>
            <form-list name="FindCustomerList" list="customerList" skip-form="true" header-dialog="true" show-page-size="true">
                <entity-find entity-name="mantle.party.PartyDetailAndRole" list="customerList">
                    <search-form-inputs skip-fields="ownerPartyId" default-order-by="organizationName,firstName"/>
                    <econdition field-name="roleTypeId" operator="in" value="Customer,CustomerBillTo"/>
                    <!-- Org isolation: only the active organization's customers; no active org returns no rows. -->
                    <econdition field-name="ownerPartyId" from="_contactOrg?.activeOrgId ?: '__NO_ORGANIZATION__'"/>
                    <!-- ZE-CUST-FINAL: Status/Show-Disabled drive these (disabledNe hides disabled; disabledEq = only disabled). -->
                    <econdition field-name="disabled" operator="not-equals" from="disabledNe" or-null="true" ignore-if-empty="true"/>
                    <econdition field-name="disabled" operator="equals" from="disabledEq" ignore-if-empty="true"/>
                    <!-- ZE-CONTACTS-010: GSTIN/PAN/CIN/email/phone search resolves to partyIds in screen actions. -->
                    <econdition field-name="partyId" operator="in" from="searchPartyIds" ignore-if-empty="true"/>
                    <!-- We want a unique list of parties, but PartyDetailAndRole can have multiple roles.
                         Moqui will fetch them, so we just group by partyId if needed, or assume standard roles. -->
                </entity-find>

                <row-actions>
                    <entity-find-one entity-name="mantle.party.Party" value-field="partyDetail">
                        <field-map field-name="partyId" from="partyId"/>
                    </entity-find-one>
                    <entity-find-one entity-name="zenith.erp.india.IndiaGstin" value-field="gstinRec">
                        <field-map field-name="partyId" from="partyId"/>
                    </entity-find-one>
                    <!-- ZE-CUST-LIST: per-row display — name, avatar initial+colour, type, primary email/phone. -->
                    <script><![CDATA[
                        dispName = organizationName ?: (((firstName ?: '') + ' ' + (lastName ?: '')).trim()) ?: 'Unknown'
                        avatarInitial = dispName.trim().take(1).toUpperCase()
                        isBiz = (partyTypeEnumId == 'PtyOrganization')
                        // ZE-CUST-DS: customers-design-system §7.4 avatar palette = purple/green/amber/red/blue ONLY
                        // (NO pink/teal — the doc reserves those for Suppliers). Variants a=purple g=green d=amber h=red b=blue.
                        def _pal = ['a','g','d','h','b']
                        avatarColor = _pal[(((partyId ?: '').hashCode() % _pal.size()) + _pal.size()) % _pal.size()]
                        rowEmail = null; rowPhone = null
                        try {
                            def _em = ec.entity.find("mantle.party.contact.PartyContactMechInfo")
                                        .condition("partyId", partyId).condition("contactMechTypeEnumId", "CmtEmailAddress")
                                        .conditionDate("fromDate", "thruDate", ec.user.nowTimestamp)
                                        .orderBy("-contactMechPurposeId").list()
                            if (_em) rowEmail = _em[0].infoString
                            def _ph = ec.entity.find("mantle.party.contact.PartyContactMechTelecomNumber")
                                        .condition("partyId", partyId)
                                        .conditionDate("fromDate", "thruDate", ec.user.nowTimestamp)
                                        .orderBy("-contactMechPurposeId").list()
                            if (_ph) rowPhone = _ph[0].contactNumber
                        } catch (Throwable _t) { }
                        // ZE-CUST-DS: Actions = single pencil icon (customers-components §7.10 "single icon-only button").
                        // Keep the name's profile link and give the pencil its actual edit destination.
                        def _pid = partyId
                        actionsHtml = "<div class='sup-act'>" +
                          "<a class='sup-act-edit' href='/apps/zenith/Contacts/EditContact?partyId=" + _pid + "' title='Edit customer' aria-label='Edit customer'><svg viewBox='0 0 24 24' width='16' height='16' aria-hidden='true'><path fill='currentColor' d='M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z'/></svg></a></div>"
                    ]]></script>
                <set field="selectionHtml" value="&lt;input type='checkbox' class='contacts-row-check' aria-label='Select this contact on this page'/&gt;"/>
                </row-actions>

                <!-- ZE-CUST-LIST: Party ID column removed (ID now shown under the name); kept as a Find-Options search. -->
                <field name="selection"><header-field title="Select"/><default-field><display text="${selectionHtml}" encode="false"/></default-field></field>
                <field name="partyId"><header-field title="ID Search"><text-find/></header-field><default-field><hidden/></default-field></field>

                <field name="organizationName"><header-field title="Company Search"><text-find/></header-field><default-field><hidden/></default-field></field>
                <field name="firstName"><header-field title="First Name Search"><text-find/></header-field><default-field><hidden/></default-field></field>
                <field name="lastName"><header-field title="Last Name Search"><text-find/></header-field><default-field><hidden/></default-field></field>

                <!-- ZE-CONTACTS-010: search by GSTIN / PAN / CIN / email / phone (resolved to partyIds in actions) -->
                <field name="gstinSearch"><header-field title="GSTIN Search"><text-line size="18"/></header-field><default-field><hidden/></default-field></field>
                <field name="panSearch"><header-field title="PAN Search"><text-line size="12"/></header-field><default-field><hidden/></default-field></field>
                <field name="cinSearch"><header-field title="CIN Search"><text-line size="22"/></header-field><default-field><hidden/></default-field></field>
                <field name="emailSearch"><header-field title="Email Search"><text-line size="30"/></header-field><default-field><hidden/></default-field></field>
                <field name="phoneSearch"><header-field title="Phone Search"><text-line size="15"/></header-field><default-field><hidden/></default-field></field>
                <!-- Status and Show Disabled are controlled by the compact toolbar above. Declaring them
                     again as list header fields rendered a redundant full-width active-filter row. -->

                <field name="name">
                    <header-field title="Customer Name" show-order-by="true"/>
                    <default-field>
                        <!-- ZE-CUST-LIST: avatar + bold name + ID underneath (name opens the profile; ID column removed). -->
                        <container style="sup-namecell">
                            <label text="${avatarInitial}" type="span" style="sup-avatar sup-av-${avatarColor}"/>
                            <container style="sup-nametext">
                                <link url="../ContactProfile" text="${dispName}" parameter-map="[partyId:partyId]" link-type="anchor" style="sup-name zenith-contact-name"/>
                                <label text="ID: ${partyId}" type="span" style="sup-id"/>
                            </container>
                        </container>
                    </default-field>
                </field>

                <!-- ZE-CUST-LIST: Contact Information — the customer's primary email + phone (real data). -->
                <field name="contactInfo">
                    <header-field title="Contact Information"/>
                    <default-field>
                        <container style="sup-stack">
                            <container style="sup-cline"><label text="mail" type="span" style="material-icons sup-cicon" condition="rowEmail"/><label text="${rowEmail}" type="span" style="sup-cval" condition="rowEmail"/></container>
                            <container style="sup-cline"><label text="call" type="span" style="material-icons sup-cicon" condition="rowPhone"/><label text="${rowPhone}" type="span" style="sup-cval" condition="rowPhone"/></container>
                            <label text="No contact info" type="span" style="sup-cval sup-cempty" condition="!rowEmail &amp;&amp; !rowPhone"/>
                        </container>
                    </default-field>
                </field>

                <field name="partyTypeEnumId">
                    <header-field title="Customer Type">
                        <drop-down allow-empty="true">
                            <option key="PtyOrganization" text="Organization"/>
                            <option key="PtyPerson" text="Person"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <label text="${isBiz ? 'Business' : 'Individual'}" type="span" style="sup-badge ${isBiz ? 'sup-b-blue' : 'sup-b-green'}"/>
                    </default-field>
                </field>

                <field name="gstin">
                    <header-field title="GSTIN (For ITC)"/>
                    <default-field>
                        <container style="sup-stack">
                            <!-- ZE-CUST-DS §7.7: simpler than Suppliers — plain monospace GSTIN (no "GST registered"
                                 badge, no "Not Provided/No ITC" warning); empty renders a muted em-dash. -->
                            <label text="${gstinRec?.gstin}" type="span" style="sup-gstin" condition="gstinRec?.gstin"/>
                            <label text="—" type="span" style="sup-gstin sup-dash" condition="!gstinRec?.gstin"/>
                        </container>
                    </default-field>
                </field>

                <field name="pan">
                    <header-field title="PAN (Tax ID)"/>
                    <default-field>
                        <label text="${partyDetail?.panNumber ?: '-'}" type="span" style="sup-gstin"/>
                    </default-field>
                </field>

                <!-- ZE-CUST-LIST: Status badge from the real `disabled` field (shown customers read Active; the
                     Show Disabled toggle reveals Disabled ones). -->
                <field name="status">
                    <header-field title="Status"/>
                    <default-field>
                        <label text="${partyDetail?.disabled == 'Y' ? 'Disabled' : 'Active'}" type="span" style="sup-badge ${partyDetail?.disabled == 'Y' ? 'sup-b-grey' : 'sup-b-green'}"/>
                    </default-field>
                </field>

                <!-- The name opens the profile; the pencil opens the customer editor. -->
                <field name="actions">
                    <header-field title="Actions"/>
                    <default-field><display text="${actionsHtml}" encode="false"/></default-field>
                </field>

                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
