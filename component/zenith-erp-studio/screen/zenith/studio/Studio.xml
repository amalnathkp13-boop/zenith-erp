<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Studio" default-menu-index="25">

    <always-actions>
        <set field="html_title" value="Studio"/>
    </always-actions>

    <subscreens default-item="CustomFields"/>

    <transition name="goSettings"><default-response url="../settings/Users"/></transition>
    <transition name="goIntegrations"><default-response url="../integrations/PortalConfig"/></transition>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
