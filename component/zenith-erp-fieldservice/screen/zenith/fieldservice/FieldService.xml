<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Field Service" default-menu-index="8">

    <always-actions>
        <set field="html_title" value="Field Service"/>
    </always-actions>

    <subscreens default-item="Tasks"/>

    <transition name="goContacts"><default-response url="../Contacts/Customers"/></transition>
    <transition name="goHelpdesk"><default-response url="../helpdesk/Tickets"/></transition>
    <transition name="goMaintenance"><default-response url="../maintenance/MaintenanceDashboard"/></transition>
    <transition name="goInventory"><default-response url="../Inventory/FindProduct"/></transition>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
