<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Accounting" default-menu-index="4">

    <always-actions>
        <set field="html_title" value="Accounting"/>
    </always-actions>

    <!-- Plan-gated server-side: tenants whose plan excludes 'accounting' are redirected to the
         Dashboard by the central module gate in ZenithApp.xml (one gate covers all modules). -->

    <subscreens default-item="AcctgDashboard">
        <subscreens-item name="AcctgDashboard" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/AcctgDashboard.xml"/>
        <subscreens-item name="ChartOfAccounts" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/ChartOfAccounts.xml"/>
        <subscreens-item name="ManualJournalEntry" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/ManualJournalEntry.xml"/>
        <subscreens-item name="JournalHistory" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/JournalHistory.xml"/>
        <subscreens-item name="Invoices" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/Invoices.xml"/>
        <subscreens-item name="Payments" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/Payments.xml"/>
        
        <!-- We'll keep these in the router but they might remain generic if we don't rewrite them yet -->
        <subscreens-item name="TdsRegister" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/TdsRegister.xml"/>
        <subscreens-item name="GstReports" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/GstReports.xml"/>
        <subscreens-item name="McaAuditLog" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/McaAuditLog.xml"/>
        <subscreens-item name="MsmeAgingReport" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/MsmeAgingReport.xml"/>
        <subscreens-item name="AutoBrs" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/AutoBrs.xml"/>
        <subscreens-item name="Schedule3Statements" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/Schedule3Statements.xml"/>
        <subscreens-item name="ProfitAndLoss" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/ProfitAndLoss.xml" menu-title="Profit &amp; Loss (Sch. III)"/>
        <subscreens-item name="Gstr2Report" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/Gstr2Report.xml" menu-title="GSTR-2"/>
        <subscreens-item name="Gstr3bReport" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/Gstr3bReport.xml" menu-title="GSTR-3B"/>
        <subscreens-item name="TallyExport" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/TallyExport.xml" menu-title="Tally Export"/>
        <subscreens-item name="PostDatedCheques" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/PostDatedCheques.xml" menu-title="Post-Dated Cheques"/>
        <subscreens-item name="ChequeTemplates" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/ChequeTemplates.xml" menu-title="Cheque Templates"/>
        <subscreens-item name="VoucherAudit" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/VoucherAudit.xml" menu-title="Voucher Audit"/>
        <subscreens-item name="TrialBalance" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/TrialBalance.xml" menu-title="Trial Balance"/>
        <subscreens-item name="CashFlowStatement" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/CashFlowStatement.xml" menu-title="Cash Flow Statement"/>
        <subscreens-item name="AgingReport" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/AgingReport.xml" menu-title="AR/AP Aging"/>
        <subscreens-item name="Budgets" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/Budgets.xml" menu-title="Budgets"/>
        <subscreens-item name="RecurringInvoices" location="component://zenith-erp-accounting/screen/zenith/accounting/Accounting/RecurringInvoices.xml" menu-title="Recurring Invoices"/>
    </subscreens>
    
    <transition name="goSales"><default-response url="../sales/SalesDashboard"/></transition>
    <transition name="goPurchase"><default-response url="../Purchase/RfqList"/></transition>
    <transition name="goContacts"><default-response url="../Contacts/FindContact"/></transition>
    <transition name="goInventory"><default-response url="../Inventory/FindProduct"/></transition>
    <transition name="goPayroll"><default-response url="../payroll/PayrollRuns"/></transition>
    <transition name="goExpenses"><default-response url="../expenses/MyExpenses"/></transition>
    <transition name="goPos"><default-response url="../pos/Dashboard"/></transition>
    <transition name="goIntegrations"><default-response url="../integrations/GstReturns"/></transition>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
