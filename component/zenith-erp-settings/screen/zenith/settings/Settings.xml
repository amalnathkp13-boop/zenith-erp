<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Settings &amp; Roles" default-menu-index="90">

    <!-- Explicitly require ZENITH_ADMIN or base permissions depending on strictness. 
         For now, we leave require-authentication="true" which is default. 
         Only users with Z_SETTINGS_APP Authz (i.e. ZENITH_ADMIN) should see this app. -->
    <pre-actions><script>context.canManageSettings = ec.user.isInGroup('ZENITH_ADMIN') || ec.user.isInGroup('ADMIN')
        // ZE-SETTINGS-003: the Roles &amp; Access catalogue is platform-admin-only; hide its menu item from tenant admins.
        context.isPlatformAdmin = ec.user.isInGroup('ADMIN')</script></pre-actions>

    <transition name="apps"><default-response url="/apps"/></transition>

    <subscreens default-item="CompanySetup">
        <subscreens-item name="CompanySetup" location="component://zenith-erp-settings/screen/zenith/settings/Settings/CompanySetup.xml" menu-title="Company Setup"/>
        <!-- ZE-SETTINGS-003: Roles &amp; Access (platform role catalogue) is platform-admin-only. menu-include is
             static in Moqui, so it is kept OUT of the shared popup menu here and surfaced via a conditional
             link below (isPlatformAdmin); tenant admins are also redirected away in Roles.xml pre-actions. -->
        <subscreens-item name="Roles" location="component://zenith-erp-settings/screen/zenith/settings/Settings/Roles.xml" menu-include="false"/>
        <subscreens-item name="Users" location="component://zenith-erp-settings/screen/zenith/settings/Settings/Users.xml"/>
        <!-- ChangePassword moved to a top-level "My Password" screen (ZenithApp.xml) so all staff — not just
             admins — can self-serve; kept here as a hidden alias so any old /Settings/ChangePassword link still resolves. -->
        <subscreens-item name="ChangePassword" location="component://zenith-erp-settings/screen/zenith/settings/Settings/ChangePassword.xml" menu-include="false"/>
        <subscreens-item name="EditRole" location="component://zenith-erp-settings/screen/zenith/settings/Settings/EditRole.xml" menu-include="false"/>
    </subscreens>

    <transition name="goStudio"><default-response url="../studio/CustomFields"/></transition>
    <transition name="goIntegrations"><default-response url="../integrations/PortalConfig"/></transition>
    <transition name="goHr"><default-response url="../Hr/Employees"/></transition>

    <widgets>

        <!-- Glassmorphism header container -->
        <container style="zenith-header glass-panel">
            <container layout="horizontal">
                <label text="Settings &amp; Custom Roles" type="h2"/>
            </container>
            <container layout="horizontal" style="items-center q-gutter-sm">
                <subscreens-menu type="popup" title="Settings Menu"/>
                <!-- ZE-SETTINGS-003: platform-admin-only entry to the role catalogue; hidden from tenant admins. -->
                <section name="gate_roles_platform" condition="isPlatformAdmin"><widgets>
                    <link url="Roles" text="Roles &amp; Access" icon="fa fa-key" btn-type="primary" style="q-btn--dense"/>
                </widgets></section>
            </container>
        </container>

        <!-- Main content container -->
        <container style="zenith-body">
            <section name="SettingsAccessGate">
                <condition><expression>canManageSettings</expression></condition>
                <widgets><subscreens-active/></widgets>
                <fail-widgets>
                    <container style="text-center q-pa-xl">
                        <render-mode><text type="html"><![CDATA[<q-icon name="lock" class="text-h1 text-grey-5"/>]]></text></render-mode>
                        <label text="Access Restricted" type="h4" style="text-negative text-weight-bold q-mt-md"/>
                        <label text="Settings — company configuration, users and roles — can only be managed by an administrator. Please contact your organization's admin." type="p" style="text-grey-7 q-mt-sm"/>
                    </container>
                </fail-widgets>
            </section>
        </container>
    </widgets>
</screen>
